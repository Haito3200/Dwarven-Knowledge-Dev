#!/usr/bin/env python3
"""Precursor ruins (doc 68, section 6; built 19 November 2026, doc 69): the sites, the Excavation panel of the province
view and its Unseal button, the expeditions and their charters, the finds, the lost works and the marvels they reveal.

    python3 "Claude files/tools/build_ruin_excavation.py" .                 apply
    python3 "Claude files/tools/build_ruin_excavation.py" . check           report only
    python3 "Claude files/tools/build_ruin_excavation.py" . art             the panel's textures

Safe to re-run. The tables are in elven_data.py.

How it works
  * A site is a great ruin (13 provinces, six rings), a Fragment site (Anbennar's Fragments of the Precursor leave a
    province modifier; six rings), a lesser ruin (the 25 provinces producing Precursor relics in 1444 and Ameion's ten
    excavation sites; three rings) or a Temple Complex of Haless (three rings). Ameion's sites are ruins for everyone.
  * DA_RX_ring (province) is the number of rings unsealed. An expedition (province flag DA_RX_out, the timed modifier
    DA_RX_party) works on the next ring; when the modifier ends, the monthly pulse fires the hidden roll DA_RX_event.1,
    which picks a find (or a lost work) and sends its report. One or two reports a ring; after the last the ring is
    unsealed, unless the expedition withdrew or was lost.
  * Who may unseal (doc 68, section 6.4): a country of the Precursor heritage every ring of its own ruins, the lost works
    and the marvels; anyone else ring I, and rings II-III with the mod's Precursor Archaeologist (DA_translator_found),
    at double price, and no lost work.
  * No dice in a button: every roll is in a hidden event. Plain ifs in the scripted effects (doc 35).
"""
import os, re, sys

ROOT = sys.argv[1] if len(sys.argv) > 1 else '.'
MODE = sys.argv[2] if len(sys.argv) > 2 else 'build'
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import elven_data as E  # noqa: E402

HEAD = '# Generated by "Claude files/tools/build_ruin_excavation.py" from elven_data.py. Change the tables there and re-run.\n'
REPORT = []
LOC = {}
EV = 'DA_RX_event'
R = E.ROMAN
GFX = 'gfx/interface/DA_Ruin_Excavation'
PANEL_W, PANEL_H = 540, 480
BANNER = (18, 40, 504, 84)
ROW_X, ROW_Y, ROW_W, ROW_H, ROW_P = 18, 146, 240, 25, 28
COL_X, COL_W = 272, 250
SEAL_Y, SEAL = 168, 36
CH_W, CH_H = 122, 26
CH_XY = [(COL_X, 330), (COL_X + 128, 330), (COL_X, 358), (COL_X + 128, 358)]
SEND = (200, 34)
SEND_XY = (COL_X + (COL_W - SEND[0]) // 2, 424)
WAYGATE = (240, 28)
WAYGATE_XY = (ROW_X, 430)
MARK = 16
PANEL_BEGIN = '# BEGIN DA_RX_PANEL (build_ruin_excavation.py)'
PANEL_END = '# END DA_RX_PANEL'
BUTTON_BEGIN = '# BEGIN DA_RX_BUTTON (build_ruin_excavation.py)'
BUTTON_END = '# END DA_RX_BUTTON'
SLOT4 = '#Row  3 Slot 4 - region specific interactions'
OTHER_PANELS = ['DA_province_mega_engineering_open', 'DA_province_medicine_open', 'DA_province_fortifications_open']


def L(k, v):
    if k in LOC and LOC[k] != v:
        raise SystemExit('two texts for %s' % k)
    LOC[k] = v


def path(rel):
    return os.path.join(ROOT, rel)


def write(rel, text, crlf=True, bom=False):
    data = text.replace('\r\n', '\n')
    if crlf:
        data = data.replace('\n', '\r\n')
    raw = data.encode('utf-8' if rel.endswith('.yml') else 'latin-1')
    if bom:
        raw = b'\xef\xbb\xbf' + raw
    full = path(rel)
    old = open(full, 'rb').read() if os.path.exists(full) else None
    if old == raw:
        REPORT.append('same    ' + rel)
        return
    REPORT.append(('would write ' if MODE == 'check' else ('changed ' if old else 'new     ')) + rel)
    if MODE != 'check':
        os.makedirs(os.path.dirname(full) or '.', exist_ok=True)
        open(full, 'wb').write(raw)


def ind(lines, n=1):
    return ['\t' * n + l if l else l for l in lines]


def lore(n):
    return '%s%d Lore§!' % (E.LORE_C, n)


HER = 'owner = { DA_EL_heritage = yes }'
NHER = 'owner = { NOT = { DA_EL_heritage = yes } }'
GN = 'owner = { NOT = { DA_EL_heritage = yes } DA_GN_surveys = yes }'              # DA_EL (doc 72): gnomes with Gommo Surveys
OTHER = 'owner = { NOT = { DA_EL_heritage = yes } NOT = { DA_GN_surveys = yes } }'
RB = 'owner = { DA_EL_heritage = yes DA_EL_is_ruinborn = yes }'
EL = 'owner = { DA_EL_heritage = yes NOT = { DA_EL_is_ruinborn = yes } }'


def at_ring(n):
    """the expedition works on ring n (n - 1 unsealed)"""
    return 'is_variable_equal = { which = DA_RX_ring value = %d }' % (n - 1)


def ring_in(a, b):
    """the ring worked on is between a and b"""
    t = []
    if a > 1:
        t.append('check_variable = { which = DA_RX_ring value = %d }' % (a - 1))
    t.append('NOT = { check_variable = { which = DA_RX_ring value = %d } }' % b)
    return ' '.join(t)


# ---------------------------------------------------------------------------
# Triggers (province scope unless said)
# ---------------------------------------------------------------------------
def gen_triggers():
    o = [HEAD, '# The sites (doc 68, section 6.1). Province scope.']
    o += ['DA_RX_great = {', '\tOR = {'] + ['\t\tprovince_id = %d' % p for p in E.GREAT] + ['\t}', '}']
    o += ['DA_RX_fragment = {', '\tOR = {'] + ['\t\thas_province_modifier = %s' % m for m in E.FRAGMENTS] + ['\t}', '}']
    o += ['DA_RX_lesser = {', '\tOR = {'] + ['\t\tprovince_id = %d' % p for p in E.LESSER] + ['\t}', '}']
    o += ['DA_RX_temple = {', '\tOR = {'] + ['\t\thas_province_modifier = %s' % m for m in E.TEMPLE_MODS] + ['\t}', '}']
    o += ['DA_RX_corrupt = {', '\tOR = {'] + ['\t\thas_province_modifier = %s' % m for m in E.CORRUPT_MODS] + ['\t}', '}']
    o += ['DA_RX_site = {', '\tOR = {', '\t\tDA_RX_great = yes', '\t\tDA_RX_fragment = yes', '\t\tDA_RX_lesser = yes',
          '\t\tDA_RX_temple = yes', '\t}', '}',
          '# Six rings: a great ruin or a Fragment site; three for the rest', 'DA_RX_deep = {', '\tOR = {',
          '\t\tDA_RX_great = yes', '\t\tDA_RX_fragment = yes', '\t}', '}',
          '# The Temple Complex\'s own rings (a complex that is also a great ruin keeps the city\'s)', 'DA_RX_temple_rings = {',
          '\tDA_RX_temple = yes', '\tNOT = { DA_RX_deep = yes }', '}',
          '# The deepest ring the owner may reach here', 'DA_RX_room = {', '\tOR = {',
          '\t\tAND = {', '\t\t\t%s' % HER, '\t\t\tDA_RX_deep = yes', '\t\t\tNOT = { check_variable = { which = DA_RX_ring value = 6 } }', '\t\t}',
          '\t\tAND = {', '\t\t\t%s' % HER, '\t\t\tNOT = { DA_RX_deep = yes }', '\t\t\tNOT = { check_variable = { which = DA_RX_ring value = 3 } }', '\t\t}',
          '\t\tAND = {', '\t\t\t%s' % NHER, '\t\t\tNOT = { check_variable = { which = DA_RX_ring value = 1 } }', '\t\t}',
          '\t\tAND = {', '\t\t\t%s' % NHER, '\t\t\towner = { has_country_flag = DA_translator_found }',
          '\t\t\tNOT = { check_variable = { which = DA_RX_ring value = 3 } }', '\t\t}',
          '\t\tAND = {\t# DA_EL (doc 72): gnomes with Gommo Surveys', '\t\t\t%s' % GN,
          '\t\t\tNOT = { check_variable = { which = DA_RX_ring value = 3 } }', '\t\t}', '\t}', '}',
          'DA_RX_room_tt = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_RX_room_tt', '\t\tDA_RX_room = yes', '\t}', '}',
          'DA_RX_idle = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_RX_idle_tt', '\t\tNOT = { has_province_flag = DA_RX_out }',
          '\t}', '}']
    L('DA_RX_room_tt', 'A ring here that we can unseal: every ring for a people of the Precursor heritage; ring §YI§! for '
      'anyone else, rings §YII§! and §YIII§! with a Precursor Archaeologist or, for gnomes, §YGommo Surveys§!')
    L('DA_RX_idle_tt', 'No expedition already in the ruin')
    # the charter chosen (none: the Wayfarers)
    for c in E.CHARTERS:
        if c['id'] == 'wayfarers':
            o += ['DA_RX_charter.wayfarers = {', '\tOR = {', '\t\t%s' % NHER] + ['\t\tAND = { %s NOT = { %s } }' % (
                HER, ' '.join('has_province_flag = DA_RX_ch.%s' % x['id'] for x in E.CHARTERS if x['id'] != 'wayfarers'))] + \
                 ['\t}', '}']
        else:
            o += ['DA_RX_charter.%s = {' % c['id'], '\t%s' % HER, '\thas_province_flag = DA_RX_ch.%s' % c['id'], '}']
    # the third lost work: closed to the tags whose own missions tell the ruin's story
    closed = [(p, tags) for p, (_, _, _, tags) in E.GREAT.items() if tags]
    o += ['# The third lost work is closed to the tags whose own missions tell the ruin\'s story (doc 68, section 6.3)',
          'DA_RX_lw3_closed = {', '\tOR = {'] + ['\t\tAND = { province_id = %d owner = { OR = { %s } } }' % (
              p, ' '.join('tag = %s' % t for t in tags)) for p, tags in closed] + ['\t}', '}']
    # the price of the next ring: can the owner pay it
    o += ['# The price of the next ring, as DA_RX_send charges it', 'DA_RX_affordable = {', '\tOR = {']
    for kind, n, c, gold, mana, ess, days in cases():
        o.append('\t\tAND = { %s %s DA_RX_charter.%s = yes owner = { treasury = %d%s%s } }' % (
            kind_trig(kind), at_ring(n), c, gold,
            (' OR = { ai = yes has_mana = { amount = %d } }' % mana) if mana else '',
            (' check_variable = { which = DA_alchemy_reagents_total value = %d }' % ess) if ess else ''))
    o += ['\t}', '}', 'DA_RX_affordable_tt = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_RX_affordable_tt',
          '\t\tDA_RX_affordable = yes', '\t}', '}']
    L('DA_RX_affordable_tt', 'We can pay the expedition\'s price (the panel shows it)')
    # the AI's next ring: a ruin of its own, idle, with room, the price twice over in the treasury
    o += ['DA_RX_ai_target = {', '\tDA_RX_site = yes', '\tNOT = { has_province_flag = DA_RX_out }', '\tDA_RX_room = yes', '\tOR = {']
    for n in range(1, 7):
        o.append('\t\tAND = { %s owner = { treasury = %d } }' % (at_ring(n), 2 * E.RING_PRICE[n]))
    o += ['\t}', '}']
    o += survey_triggers()   # DA_EL (doc 72)
    return '\n'.join(o) + '\n'


def kind_trig(kind):
    return {'el': EL, 'rb': RB, 'gn': GN, 'other': OTHER}[kind]


def cases():
    """(kind, ring, charter, ducats, mana, essence, days) of every expedition the panel can send"""
    out = []
    for kind in ('el', 'rb', 'gn', 'other'):
        for n in range(1, 7):
            if kind in ('gn', 'other') and n > 3:
                continue
            for c in E.CHARTERS:
                if kind in ('gn', 'other') and c['id'] != 'wayfarers':
                    continue
                gold = int(round(E.RING_PRICE[n] * c['price']))
                if kind == 'other' and n > 1:
                    gold *= E.OTHERS_PRICE
                mana = 0 if kind in ('gn', 'other') else E.RING_MANA[n]
                if kind == 'rb':
                    mana = int(mana * E.RUINBORN_MANA)
                days = int(round(E.RING_DAYS[n] * c['time']))
                out.append((kind, n, c['id'], gold, mana, c['essence'], days))
    return out


# ---------------------------------------------------------------------------
# Effects
# ---------------------------------------------------------------------------
def gen_effects():
    o = [HEAD, '# Precursor ruins (doc 68, section 6). Province scope unless said. Plain ifs only (Claude files/35).', '']
    # open and close the panel
    o += ['DA_RX_toggle = {', '\tif = {', '\t\tlimit = { has_province_flag = DA_RX_open }', '\t\tclr_province_flag = DA_RX_open',
          '\t\tset_province_flag = DA_RX_was_open', '\t}', '\tif = {', '\t\tlimit = { NOT = { has_province_flag = DA_RX_was_open } }',
          '\t\tset_province_flag = DA_RX_open', '\t\tclr_province_flag = DA_LE_open', '\t\tclr_province_flag = DA_HX_open',
          '\t\tFROM = {'] + ['\t\t\tclr_country_flag = %s' % f for f in OTHER_PANELS] + ['\t\t}', '\t}',
          '\tclr_province_flag = DA_RX_was_open', '}']
    # choose a charter
    for c in E.CHARTERS:
        o += ['DA_RX_choose.%s = {' % c['id']] + ['\tclr_province_flag = DA_RX_ch.%s' % x['id'] for x in E.CHARTERS] + \
             (['\tset_province_flag = DA_RX_ch.%s' % c['id']] if c['id'] != 'wayfarers' else []) + ['}']
    # send
    o += ['# Send the expedition: its price, by the owner\'s people, the ring and the charter', 'DA_RX_send = {']
    for kind, n, c, gold, mana, ess, days in cases():
        pay = ['add_treasury = -%d' % gold]
        if mana:
            pay += ['if = {', '\tlimit = { ai = no }', '\tDA_EL_pay_mana = { amount = %d }' % mana, '}']
        if ess:
            pay.append('DA_EL_pay_essence = { amount = %d }' % ess)
        o += ['\tif = {', '\t\tlimit = { %s %s DA_RX_charter.%s = yes }' % (kind_trig(kind), at_ring(n), c),
              '\t\towner = {'] + ind(pay, 3) + ['\t\t}',
              '\t\tadd_province_modifier = { name = DA_RX_party duration = %d }' % days,
              '\t\thidden_effect = { set_variable = { which = DA_RX_reps value = %d } }' % E.RING_REPORTS[n], '\t}']
    o += ['\tcustom_tooltip = DA_RX_send_eff_tt', '\thidden_effect = {', '\t\tset_province_flag = DA_RX_out',
          '\t\tclr_province_flag = DA_RX_failed', '\t\towner = {', '\t\t\tchange_variable = { which = DA_RX_parties value = 1 }',
          '\t\t\tset_country_flag = DA_RX_any_out', '\t\t\tif = {', '\t\t\t\tlimit = { has_country_flag = DA_RX_guided }',
          '\t\t\t\tclr_country_flag = DA_RX_guided', '\t\t\t\tPREV = { set_province_flag = DA_RX_guided_here }', '\t\t\t}', '\t\t}', '\t}', '}']
    L('DA_RX_send_eff_tt', 'An expedition sets out for the next ring. Its reports come back when it has done its work.')
    # the AI's expedition: the Wayfarers, without mana
    o += ['# The AI: the Wayfarers, ducats only (doc 68, section 14)', 'DA_RX_ai_send = {']
    for n in range(1, 7):
        o += ['\tif = {', '\t\tlimit = { %s }' % at_ring(n), '\t\towner = { add_treasury = -%d }' % E.RING_PRICE[n],
              '\t\tadd_province_modifier = { name = DA_RX_party duration = %d }' % E.RING_DAYS[n],
              '\t\tset_variable = { which = DA_RX_reps value = %d }' % E.RING_REPORTS[n], '\t}']
    o += ['\tclr_province_flag = DA_RX_ch.wardbreakers', '\tclr_province_flag = DA_RX_ch.relics', '\tclr_province_flag = DA_RX_ch.glyphs',
          '\tset_province_flag = DA_RX_out', '\tclr_province_flag = DA_RX_failed',
          '\towner = { change_variable = { which = DA_RX_parties value = 1 } set_country_flag = DA_RX_any_out }', '}']
    # marks of the ring being worked on
    o += ['# A find\'s mark on the ring being worked on', 'DA_RX_mark = {']
    for n in range(1, 7):
        o += ['\tif = {', '\t\tlimit = { %s }' % at_ring(n), '\t\tset_province_flag = DA_RX_m%d_$kind$' % n, '\t}']
    o += ['}']
    # Lore by band (doc 68, section 6.6); and for anyone else, a little prestige
    o += ['# Every report: Precursor Lore by band, for a people of the Precursor heritage', 'DA_RX_report_lore = {']
    for n in range(1, 7):
        o += ['\tif = {', '\t\tlimit = { %s %s }' % (at_ring(n), HER), '\t\towner = { DA_EL_add_lore = { amount = %d } }' % E.LORE_BAND[n], '\t}']
    o += ['}']
    # materials by band
    for k in ('metal', 'building', 'essence'):
        o += ['DA_RX_band_%s = {' % k]
        for n in range(1, 7):
            o += ['\tif = {', '\t\tlimit = { %s }' % at_ring(n), '\t\towner = { DA_EL_add_%s = { amount = %d } }' % (k, E.MAT_BAND[n]), '\t}']
        o += ['}']
    o += ['DA_RX_band_gold = {']
    for n in range(1, 7):
        o += ['\tif = {', '\t\tlimit = { %s }' % at_ring(n), '\t\towner = { add_treasury = %d }' % (50 * (1 + (n - 1) // 2)), '\t}']
    o += ['}']
    # Lore, or prestige for anyone else
    o += ['# Lore for a people of the Precursor heritage; anyone else takes prestige from what it cannot read',
          'DA_RX_gain = {', '\tif = {', '\t\tlimit = { %s }' % HER, '\t\towner = { DA_EL_add_lore = { amount = $lore$ } }', '\t}',
          '\tif = {', '\t\tlimit = { %s }' % NHER, '\t\towner = { add_prestige = $prestige$ }', '\t}', '}']
    # after a report
    o += ['# After a report: the next one in ten days; after the last, the ring is unsealed (unless the expedition withdrew)',
          'DA_RX_after_report = {', '\tif = {', '\t\tlimit = {', '\t\t\tcheck_variable = { which = DA_RX_reps value = 1 }',
          '\t\t\tNOT = { has_province_flag = DA_RX_failed }', '\t\t}', '\t\tset_province_flag = DA_RX_reporting',
          '\t\tprovince_event = { id = %s.1 days = 10 }' % EV, '\t}',
          '\tif = {', '\t\tlimit = {', '\t\t\tNOT = { check_variable = { which = DA_RX_reps value = 1 } }',
          '\t\t\tNOT = { has_province_flag = DA_RX_failed }', '\t\t}', '\t\tDA_RX_unseal = yes', '\t}',
          '\tif = {', '\t\tlimit = {', '\t\t\tOR = {', '\t\t\t\thas_province_flag = DA_RX_failed',
          '\t\t\t\tNOT = { check_variable = { which = DA_RX_reps value = 1 } }', '\t\t\t}', '\t\t}', '\t\tDA_RX_end = yes', '\t}', '}',
          'DA_RX_end = {', '\tclr_province_flag = DA_RX_out', '\tclr_province_flag = DA_RX_failed', '\tclr_province_flag = DA_RX_guided_here',
          '\tset_variable = { which = DA_RX_reps value = 0 }', '\tremove_province_modifier = DA_RX_party',
          '\towner = { change_variable = { which = DA_RX_parties value = -1 } }', '}']
    # unseal
    o += ['# A ring is unsealed: its codex at ring III, the deepest ring of the owner, the great ruins at ring IV and VI',
          'DA_RX_unseal = {', '\tchange_variable = { which = DA_RX_ring value = 1 }', '\tprovince_event = { id = %s.2 }' % EV]
    for n in range(1, 7):
        o += ['\tif = {', '\t\tlimit = { is_variable_equal = { which = DA_RX_ring value = %d } }' % n, '\t\towner = {', '\t\t\tif = {',
              '\t\t\t\tlimit = { NOT = { check_variable = { which = DA_EL_ring_max value = %d } } }' % n,
              '\t\t\t\tset_variable = { which = DA_EL_ring_max value = %d }' % n, '\t\t\t}', '\t\t}', '\t}']
    o += ['\tif = {', '\t\tlimit = { DA_RX_great = yes is_variable_equal = { which = DA_RX_ring value = 4 } NOT = { has_province_flag = DA_RX_g4 } }',
          '\t\tset_province_flag = DA_RX_g4', '\t\towner = { change_variable = { which = DA_EL_great4 value = 1 } }', '\t}',
          '\tif = {', '\t\tlimit = { DA_RX_great = yes is_variable_equal = { which = DA_RX_ring value = 6 } }',
          '\t\towner = { set_country_flag = DA_EL_great6 }', '\t}',
          '\tif = {', '\t\tlimit = { is_variable_equal = { which = DA_RX_ring value = 3 } %s }' % HER]
    for p, (name, sid, _, _) in E.GREAT.items():
        if sid:
            o += ['\t\tif = {', '\t\t\tlimit = { province_id = %d }' % p, '\t\t\towner = { DA_EL_give_codex.%s = yes }' % sid, '\t\t}']
    for mod, (name, sid) in E.FRAGMENTS.items():
        o += ['\t\tif = {', '\t\t\tlimit = { has_province_modifier = %s }' % mod, '\t\t\towner = { DA_EL_give_codex.%s = yes }' % sid, '\t\t}']
    o += ['\t\tif = {', '\t\t\tlimit = { DA_RX_temple_rings = yes NOT = { DA_RX_corrupt = yes } }',
          '\t\t\towner = { DA_EL_give_codex.conjuration = yes }', '\t\t}', '\t}', '\towner = { DA_RX_count = yes }', '}']
    o += ['# Country scope: the ruins of ours with a ring unsealed', 'DA_RX_count = {', '\tset_variable = { which = DA_RX_open value = 0 }',
          '\tevery_owned_province = {', '\t\tlimit = { check_variable = { which = DA_RX_ring value = 1 } }',
          '\t\towner = { change_variable = { which = DA_RX_open value = 1 } }', '\t}', '}']
    # monthly: the expeditions that are back
    o += ['# Country scope, monthly: an expedition whose time is up sends its first report',
          'DA_RX_monthly = {', '\tclr_country_flag = DA_RX_any_out', '\tevery_owned_province = {',
          '\t\tlimit = { has_province_flag = DA_RX_out }', '\t\towner = { set_country_flag = DA_RX_any_out }', '\t\tif = {',
          '\t\t\tlimit = {', '\t\t\t\tNOT = { has_province_modifier = DA_RX_party }', '\t\t\t\tNOT = { has_province_flag = DA_RX_reporting }',
          '\t\t\t}', '\t\t\tset_province_flag = DA_RX_reporting', '\t\t\tprovince_event = { id = %s.1 }' % EV, '\t\t}', '\t}', '}']
    # waygates (Conjuration III): a great ruin at ring IV
    w = E.WORK['waygate']
    o += ['# Open a Waygate (Conjuration III): a great ruin of ours unsealed to ring IV', 'DA_RX_waygate = {',
          '\towner = {', '\t\tadd_treasury = -%d' % w['gold'], '\t\tDA_EL_pay_lore = { amount = %d }' % w['lore'],
          '\t\tif = {', '\t\t\tlimit = { ai = no }', '\t\t\tDA_EL_pay_mana = { amount = %d }' % w['mana'], '\t\t}',
          '\t\thidden_effect = { change_variable = { which = DA_EL_waygates value = 1 } }', '\t}',
          '\tadd_permanent_province_modifier = { name = DA_RX_waygate duration = -1 }', '\tset_province_flag = DA_RX_waygate', '}']
    o += survey_effects()   # DA_EL (doc 72)
    return '\n'.join(o) + '\n'


# ---------------------------------------------------------------------------
# Modifiers
# ---------------------------------------------------------------------------
def gen_modifiers():
    o = [HEAD, 'DA_RX_party = {', '}', 'DA_RX_guides = {', '}',
         'DA_RX_waygate = {'] + ['\t%s = %s' % (k, E.fmtv(v)) for k, v in E.WORK['waygate']['pmod'].items()] + ['}',
         'DA_RX_ley_knot = {', '\tmages_mana_regen = 0.1', '}', 'DA_RX_fey_harvest = {', '\tlocal_unrest = -2', '}',
         'DA_RX_guardian = {', '\tlocal_defensiveness = 0.25', '\tlocal_hostile_attrition = 1', '}',
         'DA_RX_starmap = {', '\trange = 0.2', '}', 'DA_RX_cache_artifice = {', '\tartificers_capacity = 5', '}']
    o += survey_modifiers()   # DA_EL (doc 72)
    L('DA_RX_party', 'An Expedition in the Ruins')
    L('DA_RX_party_desc', 'Archaeologists, porters and guards are at work in the rings of this ruin.')
    L('DA_RX_guides', 'Ruinborn Guides')
    L('DA_RX_guides_desc', 'Ruinborn wayfinders lead our expeditions here: half the foes.')
    L('DA_RX_waygate', 'Waygate')
    L('DA_RX_waygate_desc', 'A Precursor waygate, woken in the ruin\'s Skyward Docks.')
    L('DA_RX_ley_knot', 'Ley Knot')
    L('DA_RX_ley_knot_desc', 'A knot of ley lines under the ruin: a little mana every month (up to five).')
    L('DA_RX_fey_harvest', 'A Fey Harvest')
    L('DA_RX_fey_harvest_desc', 'The fey left a harvest at the crossing. Nobody here goes hungry.')
    L('DA_RX_guardian', 'A Precursor Guardian')
    L('DA_RX_guardian_desc', 'A guardian of white stone and gold watches over the ruin, and over us.')
    L('DA_RX_starmap', 'The Starmap Ceiling')
    L('DA_RX_cache_artifice', 'A Relic Cache')
    # the lost works
    for p, works in E.LOST.items():
        for k, wk in enumerate(works, 1):
            if wk[1] in ('mod', 'prov'):
                name = 'DA_RX_lw.%d.%d' % (p, k)
                o += [name + ' = {'] + ['\t%s = %s' % (a, E.fmtv(b)) for a, b in wk[3].items()] + ['}']
                L(name, wk[0])
                L(name + '_desc', wk[2])
    return '\n'.join(o) + '\n'


# ---------------------------------------------------------------------------
# Events
# ---------------------------------------------------------------------------
# Event pictures: Anbennar's (GENIE_RUINS, DARK_EXPEDITION) and vanilla's (GOOD_WITH_MONARCH). Not Anbennar's
# ynnic_ruinborn_elf_* variants: they are commented out in its anb_eventpictures.gfx (fixed 19 November 2026, doc 72).
def ev(id_, title, desc, options, pic='GENIE_RUINS_eventPicture', hidden=False, immediate=None, province=True, extra=(),
       descs=None, ai=None):
    """descs (DA_EL, doc 72): [(trigger, loc key)] for a description chosen by triggers, in order; ai: an ai_chance per option"""
    kind = 'province_event' if province else 'country_event'
    o = ['%s = {' % kind, '\tid = %s.%s' % (EV, id_)]
    if hidden:
        o += ['\thidden = yes', '\tis_triggered_only = yes']
    else:
        o += ['\ttitle = %s.%s.t' % (EV, id_)]
        if descs:
            for trig, key in descs:
                o += ['\tdesc = {', '\t\ttrigger = { %s }' % trig, '\t\tdesc = %s' % key, '\t}']
        else:
            o.append('\tdesc = %s.%s.d' % (EV, id_))
            L('%s.%s.d' % (EV, id_), desc)
        o += ['\tpicture = %s' % pic, '\tis_triggered_only = yes']
        L('%s.%s.t' % (EV, id_), title)
    o += ['\t' + x for x in extra]
    if immediate:
        o += ['\timmediate = {'] + ind(immediate, 2) + ['\t}']
    for k, (name, trig, eff) in enumerate(options):
        key = '%s.%s.o%d' % (EV, id_, k + 1)
        o += ['\toption = {', '\t\tname = %s' % key]
        if trig:
            o += ['\t\ttrigger = {'] + ind(trig, 3) + ['\t\t}']
        if ai:
            o += ['\t\tai_chance = {'] + ['\t\t\t' + x for x in ai[k]] + ['\t\t}']
        o += ind(eff, 2) + ['\t}']
        L(key, name)
    if hidden and not options:
        o.append('\toption = { name = DA_RX_hidden_ok }')
        L('DA_RX_hidden_ok', 'OK')
    o.append('}')
    return o


AFTER = 'hidden_effect = { DA_RX_after_report = yes }'
FOE_HALF = ['modifier = { factor = 0.5 OR = { has_province_modifier = DA_RX_guides has_province_flag = DA_RX_guided_here } }',
            'modifier = { factor = 1.5 DA_RX_corrupt = yes }']


def roll_entries():
    """the random list of the hidden roll: every find, then every lost work"""
    out = []
    for f in E.FINDS:
        mods = ['modifier = { factor = 0 NOT = { %s } }' % ring_in(*f['rings'])]
        if f['kind'] == 'relic':
            mods.append('modifier = { factor = 2 has_province_flag = DA_RX_ch.relics }')
        if f['kind'] == 'lore':
            mods.append('modifier = { factor = 2 has_province_flag = DA_RX_ch.glyphs }')
        if f['kind'] == 'foe':
            mods += FOE_HALF
        if f['id'] in ('guardian', 'surge', 'degenerates'):
            mods.append('modifier = { factor = 0 has_province_flag = DA_RX_ch.wardbreakers }')
        extra = {
            'codex': ['modifier = { factor = 0 %s }' % NHER, 'modifier = { factor = 0 owner = { check_variable = { which = DA_EL_codices value = 9 } } }'],
            'shard': ['modifier = { factor = 0 %s }' % NHER, 'modifier = { factor = 0 NOT = { DA_RX_deep = yes } }',
                      'modifier = { factor = 0 owner = { has_country_flag = DA_EL_codex.fragment } }'],
            'sleeper': ['modifier = { factor = 0 %s }' % NHER],
            'echo': ['modifier = { factor = 0 %s }' % NHER],
            'records': ['modifier = { factor = 0 NOT = { superregion = taychend_superregion } }'],
            'degenerates': ['modifier = { factor = 0 superregion = effelai_superregion has_global_flag = DA_EL_seedthralls_gone }'],
            'fey': ['modifier = { factor = 0 NOT = { superregion = eordand_superregion } }'],
            'wayfinders': ['modifier = { factor = 0 has_province_flag = DA_RX_wayfinders }'],
            'knot': ['modifier = { factor = 0 has_province_modifier = DA_RX_ley_knot }',
                     'modifier = { factor = 0 owner = { num_of_owned_provinces_with = { value = 5 has_province_modifier = DA_RX_ley_knot } } }'],
            'skydock': ['modifier = { factor = 0 DA_RX_temple_rings = yes }'],
            'starmap': ['modifier = { factor = 0.25 owner = { has_country_flag = DA_EL_codex.divination } }'],
            'murals': ['modifier = { factor = 0.5 owner = { has_country_flag = DA_EL_codex.evocation } }'],
        }.get(f['id'], [])
        mods += extra
        out.append((f['w'], mods, ['province_event = { id = %s.%d }' % (EV, f['ev'])] if f['id'] != 'codex' else
                    ['owner = { DA_EL_random_codex = yes }', 'province_event = { id = %s.%d }' % (EV, f['ev'])]))
    idx = 0
    for p, works in E.LOST.items():
        tags = E.GREAT[p][3]
        for k, wk in enumerate(works, 1):
            idx += 1
            a, b = {1: (3, 4), 2: (4, 5), 3: (5, 6)}[k]
            mods = ['modifier = { factor = 0 NOT = { province_id = %d } }' % p, 'modifier = { factor = 0 %s }' % NHER,
                    'modifier = { factor = 0 NOT = { %s } }' % ring_in(a, b),
                    'modifier = { factor = 0 has_province_flag = DA_RX_lw%d }' % k]
            if k > 1:
                mods.append('modifier = { factor = 0 NOT = { has_province_flag = DA_RX_lw%d } }' % (k - 1))
            if k == 3 and tags:
                mods.append('modifier = { factor = 0 DA_RX_lw3_closed = yes }')
            out.append((E.LOST_WEIGHT, mods, ['province_event = { id = %s.%d }' % (EV, 100 + idx)]))
    out.append((1, [], ['province_event = { id = %s.46 }' % EV]))   # never nothing: quiet halls
    return out


def gen_events():
    o = [HEAD, 'namespace = %s' % EV, '']
    # .1 the roll
    imm = ['clr_province_flag = DA_RX_reporting', 'change_variable = { which = DA_RX_reps value = -1 }',
           'if = {', '\tlimit = { has_province_flag = DA_RX_vault_next }', '\tclr_province_flag = DA_RX_vault_next',
           '\tprovince_event = { id = %s.42 }' % EV, '}', 'if = {', '\tlimit = { NOT = { has_province_flag = DA_RX_vault_pending } }',
           '\trandom_list = {']
    for w, mods, eff in roll_entries():
        imm += ['\t\t%d = {' % w] + ['\t\t\t' + m for m in mods] + ['\t\t\t' + e for e in eff] + ['\t\t}']
    imm += ['\t}', '}', 'clr_province_flag = DA_RX_vault_pending']
    o += ev(1, None, None, [], hidden=True, immediate=['if = {', '\tlimit = { has_province_flag = DA_RX_vault_next }',
                                                        '\tset_province_flag = DA_RX_vault_pending', '}'] + imm)
    # .2 a ring unsealed
    o += ev(2, 'A Ring Unsealed', '[Root.DA_RX_GetUnsealed]', [('Onwards.', [], [])], pic='DARK_EXPEDITION_eventPicture')
    for n in range(1, 7):
        L('DA_RX_unsealed_%d' % n, 'Our expedition has unsealed §Y%s§!, the %s ring of [Root.GetName]. %s' % (
            E.RINGS[n], ['first', 'second', 'third', 'fourth', 'fifth', 'sixth'][n - 1], RING_PROSE[n]))
    for n in range(1, 4):
        L('DA_RX_unsealed_t%d' % n, 'Our expedition has unsealed §Y%s§! of the Temple Complex of [Root.GetName]. %s' % (
            E.TEMPLE_RINGS[n], TEMPLE_PROSE[n]))
    # .3 the AI's yearly expedition (country, hidden)
    o += ev(3, None, None, [], hidden=True, province=False, immediate=[
        'random = {', '\tchance = 20', '\trandom_owned_province = {', '\t\tlimit = { DA_RX_ai_target = yes }', '\t\tDA_RX_ai_send = yes',
        '\t}', '}'])
    # the finds
    for f in E.FINDS:
        o += find_event(f)
    # follow-ups: .40 survivors, .41 the guardian wakes (hidden roll), .42 the sealed vault
    o += ev(40, 'Survivors Return', 'Months after the sky-dock fell on them, three members of our expedition to [Root.GetName] '
            'walked out of the jungle. They are thin and quiet, and they have notes.',
            [('Welcome them home.', [], ['DA_RX_gain = { lore = 3 prestige = 5 }'])], pic='DARK_EXPEDITION_eventPicture')
    o += ev(41, None, None, [], hidden=True, immediate=[
        'random_list = {', '\t60 = { add_permanent_province_modifier = { name = DA_RX_guardian duration = -1 } province_event = { id = %s.43 } }' % EV,
        '\t40 = { set_province_flag = DA_RX_failed province_event = { id = %s.44 } }' % EV, '}'])
    o += ev(43, 'The Guardian Stands Watch', 'The construct rose, looked at our archaeologists for a long moment, and turned to '
            'face the jungle. It has not moved since. Nothing comes near the ruin now.',
            [('Let it watch.', [], ['custom_tooltip = DA_RX_guardian_tt', AFTER])], pic='GENIE_RUINS_eventPicture')
    L('DA_RX_guardian_tt', 'The ruin gains a §YPrecursor Guardian§!: §G+25%§! Local Fort Defense, §G+1§! Local Attrition for Enemies')
    o += ev(44, 'The Guardian Wakes Angry', 'The construct woke as the Precursors made it to wake: to an intruder. The survivors '
            'of our expedition fled with what they could carry. The ring stays sealed.',
            [('Mourn them.', [], ['owner = { add_prestige = -5 }', AFTER])], pic='GENIE_RUINS_eventPicture')
    o += ev(42, 'The Sealed Vault', 'The echo led our archaeologists to a door that was not on any plan. Behind it, untouched '
            'since the Ruin: shelves of sealed jars, a rack of steel plates, and a ledger in a clear hand.',
            [('Open it all.', [], ['DA_RX_mark = { kind = relic }', 'DA_RX_report_lore = yes', 'DA_RX_gain = { lore = 3 prestige = 10 }',
                                   'DA_RX_band_building = yes', 'DA_RX_band_essence = yes', AFTER])], pic='GENIE_RUINS_eventPicture')
    o += ev(46, 'Quiet Halls', 'Our expedition walked the halls of [Root.GetName] for weeks and found them empty: swept clean by '
            'the centuries, or by someone who came before us. Its maps, at least, are good.',
            [('Note the way.', [], ['DA_RX_mark = { kind = kin }', 'DA_RX_report_lore = yes', AFTER])],
            pic='DARK_EXPEDITION_eventPicture')
    # the lost works
    idx = 0
    for p, works in E.LOST.items():
        name = E.GREAT[p][0]
        for k, wk in enumerate(works, 1):
            idx += 1
            eff = ['DA_RX_report_lore = yes', 'owner = { DA_EL_add_lore = { amount = %d } }' % E.LOST_LORE,
                   'hidden_effect = { set_province_flag = DA_RX_lw%d }' % k]
            if wk[1] == 'marvel':
                mid = E.GREAT[p][2]
                eff += ['custom_tooltip = DA_RX_marvel_found_tt.%s' % mid, 'hidden_effect = { set_province_flag = DA_EL_mv_found }']
                L('DA_RX_marvel_found_tt.%s' % mid, 'The marvel §Y%s§! is found: it can be raised from the Marvels page of the '
                  'Remnant Archive' % E.MARVEL[mid]['name'])
            elif wk[1] == 'lore':
                eff.append('owner = { DA_EL_add_lore = { amount = %d } }' % wk[3])
            elif wk[1] == 'codex':
                eff.append('hidden_effect = { owner = { DA_EL_random_codex = yes } }')
                eff.append('custom_tooltip = DA_RX_lost_codex_tt')
            elif wk[1] == 'mod':
                eff.append('owner = { add_country_modifier = { name = DA_RX_lw.%d.%d duration = %d } }' % (p, k, E.LOST_YEARS * 365))
            elif wk[1] == 'prov':
                eff.append('add_permanent_province_modifier = { name = DA_RX_lw.%d.%d duration = -1 }' % (p, k))
            eff.append(AFTER)
            o += ev(100 + idx, wk[0], '%s\n\nIt is the %s of the three lost works of %s.' % (
                wk[2], ['first', 'second', 'third'][k - 1], name), [('A treasure of the Precursors.', [], eff)],
                pic='HIGH_TEMPLE_IN_DISTANCE_eventPicture', immediate=['DA_RX_mark = { kind = kin }'])
    L('DA_RX_lost_codex_tt', 'A codex not yet read is read (or %s if all nine are)' % lore(5))
    o += survey_events()   # DA_EL (doc 72)
    return '\n'.join(o) + '\n'


RING_PROSE = {
    1: 'The streets the forest swallowed are cleared, and our camp stands where a market once did.',
    2: 'The plazas and houses of the old city are mapped, every shrine counted.',
    3: 'The Lyceum is open: its schools and reading rooms, and whatever the centuries left on their shelves.',
    4: 'The towers and sky-docks are climbed. From the highest, the whole ruin lies below like a map.',
    5: 'The Sealed Vaults are open. Some of what they kept was meant to be kept.',
    6: 'Our archaeologists stand in the Ley Heart, the city\'s power core. It is still warm.',
}
TEMPLE_PROSE = {
    1: 'The courts where pilgrims once waited are swept and safe.',
    2: 'The galleries of spirit-shrines are mapped, every binding counted.',
    3: 'The Binding-Heart is open: the knot of wards that holds the spirits of Haless in check.',
}


def find_event(f):
    fid = f['id']
    mark = 'DA_RX_mark = { kind = %s }' % f['kind']
    pic = {'lore': 'ELVEN_CONSTELLATION_eventPicture', 'relic': 'GENIE_RUINS_eventPicture',
           'kin': 'DARK_EXPEDITION_eventPicture', 'foe': 'GENIE_RUINS_eventPicture'}[f['kind']]
    base = ['DA_RX_report_lore = yes']
    if f['kind'] == 'relic':   # DA_EL (doc 72): a relic sample for a gnomish Workshop with Gommo Surveys
        base.append('DA_RX_gn_samples = yes')
    o = None
    if fid == 'shelves':
        o = ev(f['ev'], f['name'], 'In a reading room of the Lyceum of [Root.GetName], whole shelves of Precursor books have '
               'survived the centuries, sealed in glass.', [
                   ('Copy them for the Archive.', [], base + ['DA_RX_gain = { lore = 3 prestige = 5 }', AFTER]),
                   ('Send them to our scholars at work.', [HER, 'owner = { DA_EL_researching = yes }'],
                    base + ['owner = { custom_tooltip = DA_RX_push10_tt hidden_effect = { DA_EL_push_target = { pct = 0.1 } } }', AFTER])],
               pic=pic, immediate=[mark])
        L('DA_RX_push10_tt', 'The running research of the §YElven§! page advances by §G10%§! of its target')
    if fid == 'codex':
        o = ev(f['ev'], f['name'], 'Bound in pale stone and gold, a codex of the old schools lay in a sealed niche of [Root.GetName]. '
               'Our archaeologists carried it out wrapped in their own cloaks.\n\n[Root.Owner.DA_EL_GetNewCodex]',
               [('Bring it to the Archive.', [], base + [AFTER])], pic=pic, immediate=[mark])
    if fid == 'starmap':
        o = ev(f['ev'], f['name'], 'The ceiling of a hall in [Root.GetName] is a map of the stars, with routes drawn between them '
               'in gold. Some of the routes end at coasts our captains have never seen.', [
                   ('Copy the charts.', [HER, 'owner = { NOT = { has_country_flag = DA_EL_codex.divination } }'],
                    base + ['owner = { DA_EL_give_codex.divination = yes }', AFTER]),
                   ('Give the routes to our captains.', [], base + ['owner = { add_country_modifier = { name = DA_RX_starmap duration = 3650 } }', AFTER])],
               pic='ELVEN_CONSTELLATION_eventPicture', immediate=[mark])
    if fid == 'echo':
        o = ev(f['ev'], f['name'], 'In a quiet room of [Root.GetName] our archaeologists heard a voice, and then saw its owner: '
               'a Precursor scholar, translucent, still at work on something nobody else can see. It noticed them.', [
                   ('Speak with it.', [], base + ['DA_RX_gain = { lore = 4 prestige = 5 }', AFTER]),
                   ('Follow it.', [], base + ['custom_tooltip = DA_RX_follow_tt', 'hidden_effect = { set_province_flag = DA_RX_vault_next }', AFTER]),
                   ('Lay it to rest.', [], base + ['owner = { add_prestige = 10 }', AFTER])], pic='ELVEN_EYE_eventPicture', immediate=[mark])
        L('DA_RX_follow_tt', 'The next report from this ruin is §YThe Sealed Vault§!')
    if fid == 'murals':
        o = ev(f['ev'], f['name'], 'A long wall of [Root.GetName] is painted with the War of Broken Chains: the Dragonguard in '
               'their ranks, the dragons falling, the chains breaking.', [
                   ('Show them to the court.', [], base + ['owner = { add_prestige = 10 add_legitimacy = 5 }', AFTER]),
                   ('Study the Dragonguard.', [HER, 'owner = { NOT = { has_country_flag = DA_EL_codex.evocation } }'],
                    base + ['owner = { DA_EL_give_codex.evocation = yes }', AFTER])], pic='DRAGON_ATTACK_eventPicture', immediate=[mark])
    if fid == 'shard':
        o = ev(f['ev'], f['name'], 'In the Ley Heart of [Root.GetName] lies a shard of diamond-bright light, no bigger than a fist. '
               'It is warm, and it hums when a mage comes near. It is a piece of the God Fragment.', [
                   ('Read it.', [], base + ['owner = { DA_EL_give_codex.fragment = yes }', AFTER])], pic='MAGE_MOON_eventPicture',
               immediate=[mark])
    if fid == 'damestear':
        o = ev(f['ev'], f['name'], 'Behind a collapsed wall of [Root.GetName] a vein of damestear glows blue in the dark.', [
                   ('Open a mine.', [], base + ['change_trade_goods = damestear', AFTER]),
                   ('Cut it out for our smiths.', [], base + ['DA_RX_band_metal = yes', AFTER])], pic=pic, immediate=[mark])
    if fid == 'steel':
        o = ev(f['ev'], f['name'], 'Stacked in a workshop of [Root.GetName]: plates of Precursor steel, as bright as the day they '
               'were rolled.', [('Carry them home.', [], base + ['DA_RX_band_building = yes', AFTER])], pic=pic, immediate=[mark])
    if fid == 'jars':
        o = ev(f['ev'], f['name'], 'Sealed jars line the shelves of an apothecary in [Root.GetName]. Whatever is inside them is '
               'still liquid.', [('For our alchemists.', [], base + ['DA_RX_band_essence = yes', AFTER]),
                                 ('Read their labels.', [], base + ['DA_RX_gain = { lore = 2 prestige = 3 }', AFTER])],
               pic=pic, immediate=[mark])
    if fid == 'cache':
        o = ev(f['ev'], f['name'], 'Someone hid this cache in [Root.GetName] long after the Ruin: coins, tools and small relics, '
               'wrapped in oilcloth.', [('Into the treasury.', [], base + ['DA_RX_band_gold = yes', AFTER]),
                                        ('For our artificers.', ['owner = { has_country_flag = artificery_unlocked }'],
                                         base + ['owner = { add_country_modifier = { name = DA_RX_cache_artifice duration = 3650 } }', AFTER])],
               pic='TREASURE_FLEET_SHIP_eventPicture', immediate=[mark])
    if fid == 'knot':
        o = ev(f['ev'], f['name'], 'Under [Root.GetName] the ley lines tie themselves into a knot. The air hums, and our mages\' '
               'spells come easier here.', [('Tap it.', [], base + ['add_permanent_province_modifier = { name = DA_RX_ley_knot duration = -1 }',
                                                                    'hidden_effect = { owner = { update_mana_regen_vars = yes } }', AFTER])],
               pic='MAGE_MOON_ALTER_eventPicture', immediate=[mark])
    if fid == 'wayfinders':
        o = ev(f['ev'], f['name'], 'Ruinborn wayfinders have watched our expedition for days. Today they came to the camp at '
               '[Root.GetName], and offered to show us the safe ways in.', [
                   ('Take them as guides.', [], base + ['add_province_modifier = { name = DA_RX_guides duration = 3650 }', AFTER]),
                   ('Ask them to settle here.', [], base + ['add_base_manpower = 1', AFTER]),
                   ('Send gifts to their people.', ['owner = { treasury = 50 }'], base + [
                       'owner = { add_treasury = -50 every_neighbor_country = { limit = { DA_RH_primary_ruinborn = yes } '
                       'add_opinion = { who = PREV modifier = DA_EL_gifts } } }', AFTER])],
               pic='DARK_EXPEDITION_eventPicture', immediate=[mark, 'set_province_flag = DA_RX_wayfinders'])
    if fid == 'sleeper':
        o = ev(f['ev'], f['name'], 'In a crystal pod in the Sealed Vaults of [Root.GetName] lies an elf of the Precursors, asleep '
               'since before the Ruin. The pod still works.', [
                   ('Wake the Sleeper now.', [EL], base + ['owner = { define_advisor = { type = court_mage skill = 3 cost_multiplier = 0.5 } }', AFTER]),
                   ('Wake the Sleeper now.', [RB], base + ['owner = { create_general = { tradition = 70 add_fire = 1 add_shock = 1 } }', AFTER]),
                   ('Keep the Sleeper for the Archive.', [], base + ['custom_tooltip = DA_RX_keep_sleeper_tt',
                                                                     'hidden_effect = { owner = { change_variable = { which = DA_EL_sleepers value = 1 } } }', AFTER])],
               pic='MAGE_MOON_ALTER_eventPicture', immediate=[mark])
        L('DA_RX_keep_sleeper_tt', 'A Sleeper is kept: §YWake a Sleeper§! (Necromancy IV and the Archive at level §YVI§!) can wake it')
    if fid == 'records':
        o = ev(f['ev'], f['name'], 'The archives of [Root.GetName] hold the records of the Slaver-Nobles who ruled Taychend: '
               'names, prices, punishments, all in a careful hand.', [
                   ('Publish them.', [], base + ['owner = { add_prestige = 15 every_country = { limit = { culture_group = devandi_ruinborn_elf } '
                                                 'add_opinion = { who = PREV modifier = DA_EL_gifts } } }', AFTER]),
                   ('Keep them in the Archive.', [], base + ['DA_RX_gain = { lore = 4 prestige = 5 }', AFTER])], pic=pic, immediate=[mark])
    if fid == 'fey':
        o = ev(f['ev'], f['name'], 'Beyond a gate of [Root.GetName] the air smells of flowers that do not grow in Eordand. It is a '
               'crossing into the fey lands, and something on the other side has noticed us.', [
                   ('Strike a bargain.', [HER, 'owner = { NOT = { has_country_flag = DA_EL_codex.illusion } }'],
                    base + ['owner = { DA_EL_give_codex.illusion = yes add_stability = -1 add_prestige = -10 }', AFTER]),
                   ('Accept their harvest.', [], base + ['add_province_modifier = { name = DA_RX_fey_harvest duration = 3650 }', AFTER])],
               pic='FEYFOREST_eventPicture', immediate=[mark])
    if fid == 'degenerates':
        o = ev(f['ev'], '[Root.DA_RX_GetDegenerates]', 'Our expedition in [Root.GetName] has been attacked. They are elves, or '
               'they were: the [Root.DA_RX_GetDegenerates] of these ruins, who never left them.', [
                   ('Fight our way in.', [], base + ['owner = { add_manpower = -1 }', AFTER]),
                   ('Withdraw.', [], ['custom_tooltip = DA_RX_withdraw_tt', 'hidden_effect = { set_province_flag = DA_RX_failed }', AFTER])],
               pic='UNDEAD_ARMY_eventPicture', immediate=[mark])
        L('DA_RX_withdraw_tt', 'The expedition comes home: §Rthe ring stays sealed§!')
    if fid == 'guardian':
        o = ev(f['ev'], f['name'], 'A construct of white stone and gold kneels in a hall of [Root.GetName], as tall as three men, '
               'its teal core dim. It has been waiting.', [
                   ('Study it.', [], base + ['owner = { DA_EL_add_school_exp = { school = Arcane_Arts amount = 150 } }', AFTER]),
                   ('Wake it.', [], base + ['custom_tooltip = DA_RX_wake_tt', 'hidden_effect = { province_event = { id = %s.41 } }' % EV]),
                   ('Salvage it.', [], base + ['DA_RX_band_metal = yes', AFTER])], pic=pic, immediate=[mark])
        L('DA_RX_wake_tt', '§G60%§!: it guards the ruin from now on. §R40%§!: it guards the ruin against us, and the expedition is lost.')
    if fid == 'surge':
        o = ev(f['ev'], f['name'], 'Something in [Root.GetName] answered our mages\' wards with a storm of raw magic. Trees grew '
               'and died in an hour; the camp burnt with cold fire.', [
                   ('Count the cost.', [], base + ['add_devastation = 10', 'owner = { if = { limit = { ai = no has_mana = { amount = 10 } } '
                                                   'DA_EL_pay_mana = { amount = 10 } } }', AFTER])], pic='MAGE_MOON_eventPicture', immediate=[mark])
    if fid == 'skydock':
        o = ev(f['ev'], f['name'], 'The sky-dock our expedition was climbing in [Root.GetName] gave way. Nobody saw the bottom of '
               'the fall.', [('Search for survivors.', [], ['custom_tooltip = DA_RX_lost_tt', 'hidden_effect = { set_province_flag = DA_RX_failed '
                                                            'random = { chance = 50 province_event = { id = %s.40 days = 270 random = 180 } } }' % EV, AFTER])],
               pic=pic, immediate=[mark])
        L('DA_RX_lost_tt', 'The expedition is lost: §Rthe ring stays sealed§!. Survivors may yet walk out of the ruin.')
    if fid == 'overgrowth':
        o = ev(f['ev'], f['name'], 'The forest has swallowed the streets of [Root.GetName] whole. Our expedition spent its days '
               'with axes, not brushes, and found a city under the roots.', [
                   ('Map the streets.', [], base + ['owner = { add_prestige = 3 }', AFTER]),
                   ('Push on.', [], base + [AFTER])], pic='DARK_EXPEDITION_eventPicture', immediate=[mark])
    assert o, fid
    # the skydock is random in an option's hidden effect: move it to the hidden event .45
    return o


def fix_skydock(text):
    """dice belong in hidden events: the skydock's survivors are rolled in .45"""
    return text.replace('random = { chance = 50 province_event = { id = %s.40 days = 270 random = 180 } }' % EV,
                        'province_event = { id = %s.45 }' % EV)


def survivors_event():
    return '\n'.join(ev(45, None, None, [], hidden=True, immediate=[
        'random = {', '\tchance = 50', '\tprovince_event = { id = %s.40 days = 270 random = 180 }' % EV, '}'])) + '\n'


def gen_on_actions():
    return '\n'.join([HEAD, '# Additive hooks: they merge with the other files\' on-actions.', '',
                      'on_monthly_pulse = {', '\tif = {', '\t\tlimit = { has_country_flag = DA_RX_any_out }', '\t\tDA_RX_monthly = yes',
                      '\t}', '\tif = {\t# DA_EL (doc 72): a survey abroad whose ring is done reports',
                      '\t\tlimit = {', '\t\t\thas_country_flag = DA_RX_sv_out', '\t\t\tNOT = { has_country_modifier = DA_RX_surveying }',
                      '\t\t\tNOT = { has_country_flag = DA_RX_sv_reporting }', '\t\t}', '\t\tset_country_flag = DA_RX_sv_reporting',
                      '\t\tcountry_event = { id = %s.61 }' % EV, '\t}', '}', '', 'on_yearly_pulse = {', '\tif = {', '\t\tlimit = { any_owned_province = { has_province_flag = DA_RX_out } }',
                      '\t\tset_country_flag = DA_RX_any_out', '\t}', '\tif = {',
                      '\t\tlimit = { ai = yes DA_EL_heritage = yes NOT = { DA_AI_level_none = yes } any_owned_province = { DA_RX_site = yes } }',
                      '\t\tcountry_event = { id = %s.3 }' % EV, '\t}', '}', '']) + '\n'


# ---------------------------------------------------------------------------
# DA_EL (doc 72): surveys abroad (doc 68, section 6.4). Country scope: a country has one survey out at a time; the site is
# the province id in DA_RX_sv_site, the ring worked on DA_RX_sv_ring, the last ring DA_RX_sv_max. A Precursor heritage
# surveys rings I-II, gnomes with Gommo Surveys rings I-III. Nothing is done to the province: finds and Lore (relic
# samples for the gnomes), no ring stays unsealed, no lost work. The dice are thrown in the hidden event .61.
#   .60 the chooser (regions)  .70+ the sites of a region  .61 the roll  .62 the report  .63 the survey comes home
#   .64 the owner is asked for leave  .65 leave given  .66 leave refused
# ---------------------------------------------------------------------------
SV_GROUPS = E.SURVEY_GROUPS
SV_FINDS = [E.FIND[f] for f in E.SURVEY_FINDS]
SV_EL_GOLD = sum(E.RING_PRICE[n] for n in range(1, E.SURVEY_RINGS['el'] + 1))
SV_EL_MANA = sum(E.RING_MANA[n] for n in range(1, E.SURVEY_RINGS['el'] + 1))
SV_RB_MANA = int(SV_EL_MANA * E.RUINBORN_MANA)
SV_GN_GOLD = sum(E.RING_PRICE[n] for n in range(1, E.SURVEY_RINGS['gn'] + 1))
SV_SITE = 'is_variable_equal = { which = DA_RX_sv_site value = %d }'
SV_RING = 'is_variable_equal = { which = DA_RX_sv_ring value = %d }'
SV_COOL = 'OR = { NOT = { has_country_flag = DA_RX_sv.%d } had_country_flag = { flag = DA_RX_sv.%d days = %d } }'
SV_KIND_EL = 'DA_EL_heritage = yes'
SV_KIND_GN = 'NOT = { DA_EL_heritage = yes }'


def sv_ring_in(a, b):
    t = []
    if a > 1:
        t.append('check_variable = { which = DA_RX_sv_ring value = %d }' % a)
    t.append('NOT = { check_variable = { which = DA_RX_sv_ring value = %d } }' % (b + 1))
    return ' '.join(t)


def survey_triggers():
    o = ['', '# ---- Surveys abroad (doc 72) ----', '# The ruins a survey can go to', 'DA_RX_survey_site = {', '\tOR = {'] + \
        ['\t\tprovince_id = %d' % p for p in E.SURVEY_SITES] + ['\t}', '}',
        '# Province scope, ROOT the country that would survey: a ruin it may survey (its own cooldown is the chooser\'s)',
        'DA_RX_survey_ok = {', '\tDA_RX_survey_site = yes', '\thas_discovered = ROOT', '\tNOT = { owned_by = ROOT }',
        '\tOR = {', '\t\tis_empty = yes', '\t\towner = { DA_EL_heritage = yes }', '\t}', '}',
        '# Country scope: who surveys (a people of the Precursor heritage; gnomes with Gommo Surveys)',
        'DA_RX_surveyor = {', '\tOR = {', '\t\tDA_EL_heritage = yes', '\t\tDA_GN_surveys = yes', '\t}', '}',
        'DA_RX_can_survey = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_RX_surveyor_tt', '\t\tDA_RX_surveyor = yes', '\t}',
        '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_RX_sv_idle_tt', '\t\tNOT = { has_country_flag = DA_RX_sv_out }',
        '\t\tNOT = { has_country_flag = DA_RX_sv_asking }', '\t}',
        '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_RX_sv_price_tt', '\t\tOR = {',
        '\t\t\tAND = { %s treasury = %d OR = { ai = yes DA_RX_sv_mana_ok = yes } }' % (SV_KIND_EL, SV_EL_GOLD),
        '\t\t\tAND = { %s treasury = %d }' % (SV_KIND_GN, SV_GN_GOLD), '\t\t}', '\t}',
        '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_RX_sv_any_tt', '\t\tOR = {'] + \
        ['\t\t\t%d = { DA_RX_survey_ok = yes }' % p for p in E.SURVEY_SITES] + ['\t\t}', '\t}', '}',
        'DA_RX_sv_mana_ok = {', '\tOR = {', '\t\tAND = { DA_EL_is_ruinborn = yes has_mana = { amount = %d } }' % SV_RB_MANA,
        '\t\thas_mana = { amount = %d }' % SV_EL_MANA, '\t}', '}']
    L('DA_RX_surveyor_tt', 'A people of the Precursor heritage, or gnomes with §YGommo Surveys§! (Gnomish page)')
    L('DA_RX_sv_idle_tt', 'No survey of ours out, and no leave asked for')
    L('DA_RX_sv_price_tt', 'We can pay for the survey: §Y%d¤§! and §M%d mana§! (Ruinborn §M%d§!) for a people of the Precursor '
      'heritage, rings §YI§! and §YII§!; §Y%d¤§! for gnomes, rings §YI§! to §YIII§!' % (SV_EL_GOLD, SV_EL_MANA, SV_RB_MANA, SV_GN_GOLD))
    L('DA_RX_sv_any_tt', 'A Precursor ruin we have discovered and do not own, either nobody\'s or a country\'s of the Precursor '
      'heritage that may give us leave')
    return o


def survey_effects():
    o = ['', '# ---- Surveys abroad (doc 72). Country scope. ----',
         '# Open the chooser (from the Archive\'s Ruin Expeditions plate, or the Workshop\'s Precursor view)',
         'DA_RX_open_survey = {', '\tcountry_event = { id = %s.60 }' % EV, '}',
         '# The price, the first ring, the cooldown of the site (DA_RX_sv_site)',
          'DA_RX_sv_start = {', '\tif = {', '\t\tlimit = { %s }' % SV_KIND_EL, '\t\tadd_treasury = -%d' % SV_EL_GOLD,
          '\t\tif = {', '\t\t\tlimit = { ai = no DA_EL_is_ruinborn = yes }', '\t\t\tDA_EL_pay_mana = { amount = %d }' % SV_RB_MANA, '\t\t}',
          '\t\tif = {', '\t\t\tlimit = { ai = no NOT = { DA_EL_is_ruinborn = yes } }', '\t\t\tDA_EL_pay_mana = { amount = %d }' % SV_EL_MANA,
          '\t\t}', '\t\thidden_effect = { set_variable = { which = DA_RX_sv_max value = %d } }' % E.SURVEY_RINGS['el'], '\t}',
          '\tif = {', '\t\tlimit = { %s }' % SV_KIND_GN, '\t\tadd_treasury = -%d' % SV_GN_GOLD,
          '\t\thidden_effect = { set_variable = { which = DA_RX_sv_max value = %d } }' % E.SURVEY_RINGS['gn'], '\t}',
          '\tcustom_tooltip = DA_RX_sv_go_tt', '\thidden_effect = {', '\t\tclr_country_flag = DA_RX_sv_asking',
          '\t\tclr_country_flag = DA_RX_sv_reporting', '\t\tset_country_flag = DA_RX_sv_out',
          '\t\tset_variable = { which = DA_RX_sv_ring value = 1 }',
          '\t\tadd_country_modifier = { name = DA_RX_surveying duration = %d }' % E.RING_DAYS[1]]
    for p in E.SURVEY_SITES:
        o.append('\t\tif = { limit = { %s } clr_country_flag = DA_RX_sv.%d set_country_flag = DA_RX_sv.%d }' % (SV_SITE % p, p, p))
    o += ['\t}', '}',
          '# After a report: the next ring, or home (also when the survey is called home)',
          'DA_RX_sv_after = {', '\tclr_country_flag = DA_RX_sv_reporting', '\tif = {', '\t\tlimit = {',
          '\t\t\tNOT = { has_country_flag = DA_RX_sv_home }', '\t\t\tNOT = { check_variable = { which = DA_RX_sv_ring which = DA_RX_sv_max } }',
          '\t\t}', '\t\tchange_variable = { which = DA_RX_sv_ring value = 1 }']
    for n in (2, 3):
        o.append('\t\tif = { limit = { %s } add_country_modifier = { name = DA_RX_surveying duration = %d } }' % (SV_RING % n, E.RING_DAYS[n]))
    o += ['\t}', '\tif = {', '\t\tlimit = {', '\t\t\tOR = {', '\t\t\t\thas_country_flag = DA_RX_sv_home',
          '\t\t\t\tNOT = { has_country_modifier = DA_RX_surveying }', '\t\t\t}', '\t\t}',
          '\t\tclr_country_flag = DA_RX_sv_out', '\t\tclr_country_flag = DA_RX_sv_home', '\t\tremove_country_modifier = DA_RX_surveying',
          '\t\tcountry_event = { id = %s.63 days = 1 }' % EV, '\t}', '}',
          '# Relic samples for the Workshop (province scope: an expedition of a gnomish country with Gommo Surveys)',
          'DA_RX_gn_samples = {', '\tif = {', '\t\tlimit = { %s %s }' % (GN, at_ring(3)), '\t\towner = { DA_RX_add_samples = { amount = 2 } }', '\t}',
          '\tif = {', '\t\tlimit = { %s NOT = { %s } }' % (GN, at_ring(3)), '\t\towner = { DA_RX_add_samples = { amount = 1 } }', '\t}', '}',
          '# Country scope: relic samples, shown as a plain line (doc 66)', 'DA_RX_add_samples = {',
          '\tcustom_tooltip = DA_RX_samples_tt.$amount$', '\thidden_effect = { change_variable = { which = DA_GN_samples value = $amount$ } }', '}']
    for a in (1, 2):
        L('DA_RX_samples_tt.%d' % a, 'The Gommo Workshop gains §Y%d§! relic sample%s, for §YAssay a Relic§!' % (a, '' if a == 1 else 's'))
    L('DA_RX_sv_ask_tt', 'Its owner is asked for leave first')
    L('DA_RX_sv_go_tt', 'A survey sets out for the ruin. Its reports come back ring by ring.')
    return o


def sv_reward(f, ring_word=None):
    """the effect of a survey report's main option, by find (country scope)"""
    fid, kind = f['id'], f['kind']
    eff = []
    lore = {'overgrowth': 1, 'wayfinders': 2, 'shelves': 3, 'starmap': 3, 'murals': 2, 'records': 3, 'fey': 2, 'knot': 3,
            'cache': 1, 'damestear': 1, 'jars': 1, 'steel': 1, 'degenerates': 1, 'surge': 1, 'guardian': 2}[fid]
    eff += ['if = {', '\tlimit = { %s }' % SV_KIND_EL, '\tDA_EL_add_lore = { amount = %d }' % lore, '}']
    if kind in ('lore', 'kin'):
        eff += ['if = {', '\tlimit = { %s }' % SV_KIND_GN, '\tadd_prestige = %d' % (2 * lore)] + \
               (['\tchange_innovativeness = 1'] if kind == 'lore' else []) + ['}']
    if fid in E.SAMPLE_FINDS:
        mat = E.SAMPLE_FINDS[fid]
        if mat == 'gold':
            eff.append('add_treasury = 50')
        elif mat != 'lore':
            eff += ['if = {', '\tlimit = { %s }' % SV_RING % 3, '\tDA_EL_add_%s = { amount = %d }' % (mat, E.MAT_BAND[3]), '}',
                    'if = {', '\tlimit = { NOT = { %s } }' % SV_RING % 3, '\tDA_EL_add_%s = { amount = %d }' % (mat, E.MAT_BAND[1]), '}']
        eff += ['if = {', '\tlimit = { DA_GN_surveys = yes %s }' % SV_RING % 3, '\tDA_RX_add_samples = { amount = 2 }', '}',
                'if = {', '\tlimit = { DA_GN_surveys = yes NOT = { %s } }' % SV_RING % 3, '\tDA_RX_add_samples = { amount = 1 }', '}']
    if fid == 'murals':
        eff.append('add_prestige = 5')
    return eff


SV_TEXT = {   # what the surveyors report, by find (the ruin is [DA_RX_sv_site.GetName])
    'overgrowth': 'The forest has swallowed the streets of [DA_RX_sv_site.GetName] whole. Our surveyors cut their way in and '
                  'mapped a city under the roots.',
    'cache': 'Someone hid a cache in [DA_RX_sv_site.GetName] long after the Ruin: coins, tools and small relics wrapped in '
             'oilcloth. Our surveyors carried it out.',
    'wayfinders': 'Ruinborn wayfinders watched our surveyors for days, then came to their camp at [DA_RX_sv_site.GetName] and '
                  'showed them the safe ways in.',
    'shelves': 'In a reading room of [DA_RX_sv_site.GetName], whole shelves of Precursor books have survived, sealed in glass. '
               'Our surveyors copied what they could.',
    'starmap': 'The ceiling of a hall in [DA_RX_sv_site.GetName] is a map of the stars, with routes drawn between them in gold. '
               'Our surveyors copied it as best they could.',
    'murals': 'A long wall of [DA_RX_sv_site.GetName] is painted with the War of Broken Chains: the Dragonguard in their ranks, '
              'the dragons falling, the chains breaking.',
    'damestear': 'Behind a collapsed wall of [DA_RX_sv_site.GetName] a vein of damestear glows blue in the dark. Our surveyors '
                 'cut out what they could carry.',
    'jars': 'Sealed jars line the shelves of an apothecary in [DA_RX_sv_site.GetName]. Whatever is inside them is still '
            'liquid. Our surveyors packed them in straw.',
    'fey': 'Beyond a gate of [DA_RX_sv_site.GetName] the air smells of flowers that do not grow in Eordand. Our surveyors '
           'left a gift at the crossing and came back with a basket of fruit.',
    'degenerates': 'Our surveyors were attacked in [DA_RX_sv_site.GetName] by elves, or what used to be elves: the degenerated '
                   'elves of these ruins, who never left them.',
    'surge': 'Something in [DA_RX_sv_site.GetName] answered our surveyors\' lanterns with a storm of raw magic. The camp burnt '
             'with cold fire.',
    'steel': 'Stacked in a workshop of [DA_RX_sv_site.GetName]: plates of Precursor steel, as bright as the day they were rolled.',
    'knot': 'Under [DA_RX_sv_site.GetName] the ley lines tie themselves into a knot. Our surveyors measured it for a week.',
    'records': 'The archives of [DA_RX_sv_site.GetName] hold the records of the Slaver-Nobles who ruled Taychend: names, '
               'prices, punishments, all in a careful hand.',
    'guardian': 'A construct of white stone and gold kneels in a hall of [DA_RX_sv_site.GetName], as tall as three men, its '
                'teal core dim. Our surveyors drew it from every side and did not touch it.',
}


def sv_roll_entries():
    out = []
    for f in SV_FINDS:
        a, b = f['rings']
        mods = ['modifier = { factor = 0 NOT = { %s } }' % sv_ring_in(a, min(b, 3))]
        if f['kind'] == 'relic':
            mods.append('modifier = { factor = 1.5 DA_GN_surveys = yes }')
        if f['id'] == 'records':
            mods.append('modifier = { factor = 0 event_target:DA_RX_sv_site = { NOT = { superregion = taychend_superregion } } }')
        if f['id'] == 'fey':
            mods.append('modifier = { factor = 0 event_target:DA_RX_sv_site = { NOT = { superregion = eordand_superregion } } }')
        if f['id'] == 'degenerates':
            mods.append('modifier = { factor = 0 has_global_flag = DA_EL_seedthralls_gone '
                        'event_target:DA_RX_sv_site = { superregion = effelai_superregion } }')
        out.append((f['w'], mods, ['set_country_flag = DA_RX_svf.%s' % f['id']]))
    return out


def survey_events():
    o = []
    groups = ''.join(' %d = { DA_RX_survey_ok = yes }' % p for p in E.SURVEY_SITES)
    # .60 the chooser: a region
    opts = []
    for k, (gid, gname, ps) in enumerate(SV_GROUPS):
        trig = ['OR = {'] + ['\tAND = { %d = { DA_RX_survey_ok = yes } %s }' % (p, SV_COOL % (p, p, 365 * E.SURVEY_YEARS)) for p in ps] + ['}']
        opts.append(('%s.' % gname, trig, ['country_event = { id = %s.%d }' % (EV, 70 + k)]))
    opts.append(('Not now.', [], []))
    o += ev(60, 'Send a Survey', '[Root.DA_RX_GetSvRules]', opts, pic='DARK_EXPEDITION_eventPicture', province=False)
    L('DA_RX_sv_rules_el', 'Our surveyors can walk rings §YI§! and §YII§! of a Precursor ruin we do not own: a ruin nobody owns, '
      'or one of a people of the Precursor heritage that gives us leave. They bring back what they find and what they can '
      'read, and leave the ruin as they found it: §Ynothing is unsealed§!, and no lost work can be found that way.\n\n'
      'The survey costs §Y%d¤§! and §M%d mana§! (the Ruinborn §M%d§!) and takes about §Y%d§! days. The same ruin can be '
      'surveyed again after §Y%d§! years.\n\nWhere shall they go?' % (SV_EL_GOLD, SV_EL_MANA, SV_RB_MANA,
                                                                      E.RING_DAYS[1] + E.RING_DAYS[2], E.SURVEY_YEARS))
    L('DA_RX_sv_rules_gn', 'Gommo surveyors can walk rings §YI§! to §YIII§! of a Precursor ruin we do not own: a ruin nobody owns, '
      'or one of a people of the Precursor heritage that gives us leave. They bring back what they find, and a §Yrelic '
      'sample§! from every relic find (two from ring §YIII§!) for §YAssay a Relic§!. They leave the ruin as they found it: '
      '§Ynothing is unsealed§!.\n\nThe survey costs §Y%d¤§! and takes about §Y%d§! days. The same ruin can be surveyed again '
      'after §Y%d§! years.\n\nWhere shall they go?' % (SV_GN_GOLD, E.RING_DAYS[1] + E.RING_DAYS[2] + E.RING_DAYS[3], E.SURVEY_YEARS))
    # .70+ the sites of a region
    for k, (gid, gname, ps) in enumerate(SV_GROUPS):
        opts = []
        for p in ps:
            name = E.SITE_NAMES[p] + (', a great ruin' if p in E.GREAT else '')
            # nobody's: the survey sets out; a country's: it is asked for leave first
            opts.append(('%s.' % name, ['%d = { DA_RX_survey_ok = yes }' % p, SV_COOL % (p, p, 365 * E.SURVEY_YEARS)],
                         ['hidden_effect = { set_variable = { which = DA_RX_sv_site value = %d } }' % p,
                          'if = {', '\tlimit = { %d = { is_empty = yes } }' % p, '\tDA_RX_sv_start = yes', '}',
                          'if = {', '\tlimit = { %d = { NOT = { is_empty = yes } } }' % p, '\tcustom_tooltip = DA_RX_sv_ask_tt',
                          '\thidden_effect = {', '\t\tset_country_flag = DA_RX_sv_asking',
                          '\t\t%d = { save_event_target_as = DA_RX_sv_site owner = { country_event = { id = %s.64 } } }' % (p, EV),
                          '\t}', '}']))
        opts.append(('Somewhere else.', [], ['country_event = { id = %s.60 }' % EV]))
        o += ev(70 + k, gname, 'Our surveyors know of these ruins in %s. Which of them shall they walk?' % gname, opts,
                pic='DARK_EXPEDITION_eventPicture', province=False)
    # .61 the roll (hidden)
    imm = ['clr_country_flag = DA_RX_svf.%s' % f['id'] for f in SV_FINDS] + ['clr_country_flag = DA_RX_svf.quiet']
    for p in E.SURVEY_SITES:
        imm.append('if = { limit = { %s } %d = { save_event_target_as = DA_RX_sv_site } }' % (SV_SITE % p, p))
    imm.append('random_list = {')
    for w, mods, eff in sv_roll_entries():
        imm += ['\t%d = {' % w] + ['\t\t' + m for m in mods] + ['\t\t' + e for e in eff] + ['\t}']
    imm += ['\t25 = { set_country_flag = DA_RX_svf.quiet }', '}', 'country_event = { id = %s.62 }' % EV]
    o += ev(61, None, None, [], hidden=True, immediate=imm, province=False)
    # .62 the report
    descs = []
    for f in SV_FINDS:
        L('%s.62.d.%s' % (EV, f['id']), '§Y%s§!\n\n%s' % (f['name'], SV_TEXT[f['id']]))
        descs.append(('has_country_flag = DA_RX_svf.%s' % f['id'], '%s.62.d.%s' % (EV, f['id'])))
    L('%s.62.d.quiet' % EV, '§YQuiet Halls§!\n\nOur surveyors walked the halls of [DA_RX_sv_site.GetName] for weeks and found them '
      'empty, swept clean by the centuries. Their maps, at least, are good.')
    descs.append(('always = yes', '%s.62.d.quiet' % EV))
    AFTER_SV = 'hidden_effect = { DA_RX_sv_after = yes }'
    opts = []
    for f in SV_FINDS:
        fl = 'has_country_flag = DA_RX_svf.%s' % f['id']
        if f['kind'] == 'foe':
            if f['id'] == 'degenerates':
                push = ['add_manpower = -0.5']
            elif f['id'] == 'surge':
                push = ['if = {', '\tlimit = { ai = no %s has_mana = { amount = 10 } }' % SV_KIND_EL, '\tDA_EL_pay_mana = { amount = 10 }', '}',
                        'if = {', '\tlimit = { %s }' % SV_KIND_GN, '\tadd_prestige = -5', '}']
            else:   # the guardian: study it and go on
                push = ['DA_research_school_exp = { school = Arcane_Arts }']
            opts.append(('Push on.' if f['id'] != 'guardian' else 'Draw it, and go on.', [fl], sv_reward(f) + push + [AFTER_SV]))
            opts.append(('Call the survey home.', [fl], ['custom_tooltip = DA_RX_sv_home_tt',
                                                         'hidden_effect = { set_country_flag = DA_RX_sv_home }', AFTER_SV]))
        else:
            word = {'lore': 'Copy what can be copied.', 'kin': 'Note the way.', 'relic': 'Carry it home.'}[f['kind']]
            opts.append((word, [fl], sv_reward(f) + [AFTER_SV]))
    opts.append(('Note the way.', ['has_country_flag = DA_RX_svf.quiet'],
                 ['if = {', '\tlimit = { %s }' % SV_KIND_EL, '\tDA_EL_add_lore = { amount = 1 }', '}', AFTER_SV]))
    o += ev(62, 'A Survey Reports', None, opts, pic='DARK_EXPEDITION_eventPicture', province=False, descs=descs)
    L('DA_RX_sv_home_tt', 'The survey comes home: §Rthe rings it has not seen stay unseen§!')
    # .63 home
    o += ev(63, 'The Survey Comes Home', 'Our surveyors are back from [DA_RX_sv_site.GetName], thinner and browner than they '
            'left, with their notebooks full. The ruin is as they found it; the rest is in the Archive now.',
            [('Welcome them home.', [], [])], pic='DARK_EXPEDITION_eventPicture', province=False)
    # .64 the owner is asked; .65 leave given; .66 refused
    o += ev(64, 'A Survey Asks Leave', 'Surveyors of [From.GetName] ask leave to walk the outer rings of [DA_RX_sv_site.GetName]. '
            'They promise to unseal nothing, to take nothing from the lost works, and to share what they read.',
            [('Give them leave.', [], ['add_opinion = { who = FROM modifier = DA_EL_gifts }',
                                       'FROM = { country_event = { id = %s.65 } }' % EV]),
             ('Refuse.', [], ['FROM = { country_event = { id = %s.66 } }' % EV])],
            pic='GOOD_WITH_MONARCH_eventPicture', province=False,
            ai=[('factor = 1', 'modifier = { factor = 0 NOT = { has_opinion = { who = FROM value = 50 } } }'),
                ('factor = 1', 'modifier = { factor = 0 has_opinion = { who = FROM value = 50 } }')])
    o += ev(65, 'Leave Given', '[From.GetName] has given our surveyors leave to walk the outer rings of '
            '[DA_RX_sv_site.GetName].', [('Send them.', [], ['DA_RX_sv_start = yes'])],
            pic='DARK_EXPEDITION_eventPicture', province=False)
    o += ev(66, 'Leave Refused', '[From.GetName] will not have our surveyors in the rings of [DA_RX_sv_site.GetName].',
            [('Another time.', [], ['hidden_effect = { clr_country_flag = DA_RX_sv_asking }'])],
            pic='GOOD_WITH_MONARCH_eventPicture', province=False)
    return o


def survey_defined_texts():
    return [('DA_RX_GetSvRules', [('DA_RX_sv_rules_el', SV_KIND_EL)], 'DA_RX_sv_rules_gn')]


def survey_modifiers():
    L('DA_RX_surveying', 'A Survey Abroad')
    L('DA_RX_surveying_desc', 'Our surveyors are walking the rings of a Precursor ruin abroad. Their report comes when this ends.')
    return ['DA_RX_surveying = {', '}']


# ---------------------------------------------------------------------------
# DA_EL (doc 72): Hire a Precursor Archaeologist (decisions/DA_Ancient_dwarven_knowledge.txt): free for a people of the
# Precursor heritage, and open to anyone who owns a Precursor ruin (rings II-III, doc 68, section 6.4)
# ---------------------------------------------------------------------------
DECISION = 'decisions/DA_Ancient_dwarven_knowledge.txt'
DECISION_EDITS = [
    ("""		potential = {
			NOT = { has_country_flag = DA_translator_found }
			any_owned_province = {
				has_province_flag = DA_Ducaniel_lab_found
			}
		}
		
		provinces_to_highlight = {
			has_province_flag = DA_Ducaniel_lab_found
		}
		
		allow = {
			treasury = 500
		}
		
		effect = {
			add_treasury = -500
""",
     """		potential = {
			NOT = { has_country_flag = DA_translator_found }
			OR = {	# DA_EL archaeologist: anyone who owns a Precursor ruin, too (doc 72)
				any_owned_province = {
					has_province_flag = DA_Ducaniel_lab_found
				}
				AND = {
					NOT = { DA_EL_heritage = yes }
					any_owned_province = { DA_RX_site = yes }
				}
			}
		}
		
		provinces_to_highlight = {
			OR = {	# DA_EL archaeologist
				has_province_flag = DA_Ducaniel_lab_found
				AND = { DA_RX_site = yes owned_by = ROOT }
			}
		}
		
		allow = {
			OR = {	# DA_EL archaeologist: a people of the Precursor heritage reads the script itself
				treasury = 500
				DA_EL_heritage = yes
			}
		}
		
		effect = {
			if = {	# DA_EL archaeologist
				limit = { NOT = { DA_EL_heritage = yes } }
				add_treasury = -500
			}
			if = {	# DA_EL archaeologist
				limit = { DA_EL_heritage = yes }
				custom_tooltip = DA_EL_reads_precursor_tt
			}
			custom_tooltip = DA_EL_archaeologist_rings_tt
"""),
]


def patch_decision():
    t, crlf = read(DECISION)
    if '# DA_EL archaeologist' in t:
        return
    for old, new in DECISION_EDITS:
        if t.count(old) != 1:
            raise SystemExit('%s: the text to change occurs %d times' % (DECISION, t.count(old)))
        t = t.replace(old, new)
    write(DECISION, t, crlf)


def decision_loc():
    L('DA_EL_reads_precursor_tt', 'Our own scholars read Precursor script: the archaeologist costs us §Gnothing§!')
    L('DA_EL_archaeologist_rings_tt', 'Rings §YII§! and §YIII§! of our Precursor ruins open to our expeditions, at double price')


# ---------------------------------------------------------------------------
# The province view: the Unseal button and the Excavation panel
# ---------------------------------------------------------------------------
def cg(kind, name, lines):
    return ['%s = {' % kind, '\tname = %s' % name] + ['\t' + l for l in lines] + ['}']


SEL_NONE_CH = ' '.join('NOT = { has_province_flag = DA_RX_ch.%s }' % c['id'] for c in E.CHARTERS if c['id'] != 'wayfarers')


def gen_custom_gui():
    o = [HEAD.rstrip(), '# Province view: ROOT is the selected province, FROM the viewing country. Only the owner sees any of it.', '']
    o += cg('custom_button', 'DA_RX_unseal_button', ['tooltip = DA_RX_unseal_button_tt',
                                                     'potential = { owned_by = FROM DA_RX_site = yes }',
                                                     'trigger = { owned_by = FROM }', 'effect = { hidden_effect = { DA_RX_toggle = yes } }'])
    L('DA_RX_unseal_button_tt', '§YUnseal§!\nOpen the §YExcavation§! panel of this Precursor ruin.')
    pot = ['potential = {', '\towned_by = FROM', '\thas_province_flag = DA_RX_open', '\tNOT = { has_province_flag = DA_LE_open }',
           '\tDA_RX_site = yes', '\tFROM = { ' + ' '.join('NOT = { has_country_flag = %s }' % f for f in OTHER_PANELS) + ' }', '}']
    o += cg('custom_window', 'DA_province_ruin_panel', pot)
    o += cg('custom_button', 'DA_RX_close', ['potential = { always = yes }', 'effect = { hidden_effect = { clr_province_flag = DA_RX_open } }'])
    for nm in ('name', 'depth', 'subtitle', 'next', 'status', 'hint', 'lost_line', 'charter_line'):
        pot = {'next': 'NOT = { has_province_flag = DA_RX_out } DA_RX_room = yes',
               'status': 'OR = { has_province_flag = DA_RX_out NOT = { DA_RX_room = yes } }',
               'charter_line': 'NOT = { has_province_flag = DA_RX_out } DA_RX_room = yes',
               'lost_line': 'DA_RX_great = yes'}.get(nm, 'always = yes')
        o += cg('custom_text_box', 'DA_RX_' + nm, ['potential = { %s }' % pot])
    o += cg('custom_icon', 'DA_RX_banner', ['potential = { always = yes }', 'frame = { number = 3 trigger = { DA_RX_temple_rings = yes } }',
                                           'frame = { number = 2 trigger = { DA_RX_lesser = yes NOT = { DA_RX_deep = yes } } }',
                                           'frame = { number = 1 trigger = { always = yes } }'])
    for n in range(1, 7):
        pot = 'always = yes' if n <= 3 else 'DA_RX_deep = yes'
        frames = [(4, 'check_variable = { which = DA_RX_ring value = %d }' % n),
                  (3, '%s has_province_flag = DA_RX_out' % at_ring(n)),
                  (2, at_ring(n)), (1, 'always = yes')]
        o += cg('custom_icon', 'DA_RX_row_%d' % n, ['potential = { %s }' % pot, 'tooltip = DA_RX_row_tt.%d' % n] +
                ['frame = { number = %d trigger = { %s } }' % (k, t) for k, t in frames])
        o += cg('custom_text_box', 'DA_RX_rn_%d' % n, ['potential = { %s }' % pot])
        for k, _ in E.KINDS:
            o += cg('custom_icon', 'DA_RX_mark_%d_%s' % (n, k), ['potential = { %s has_province_flag = DA_RX_m%d_%s }' % (pot, n, k),
                                                               'tooltip = DA_RX_mark_tt.%s' % k])
    for k, name in E.KINDS:
        L('DA_RX_mark_tt.%s' % k, '§Y%s§!\nA find of this kind was reported from this ring.' % name)
    for k in (1, 2, 3):
        o += cg('custom_icon', 'DA_RX_seal_%d' % k, ['potential = { DA_RX_great = yes }', 'tooltip = DA_RX_seal_tt.%d' % k,
                                                     'frame = { number = 2 trigger = { has_province_flag = DA_RX_lw%d } }' % k,
                                                     'frame = { number = 1 trigger = { always = yes } }'])
    for c in E.CHARTERS:
        sel = 'DA_RX_charter.%s = yes' % c['id']
        o += cg('custom_button', 'DA_RX_charter_%s' % c['id'], [
            'tooltip = DA_RX_charter_tt.%s' % c['id'], 'potential = { %s NOT = { has_province_flag = DA_RX_out } DA_RX_room = yes }' % HER,
            'frame = { number = 2 trigger = { %s } }' % sel, 'frame = { number = 1 trigger = { always = yes } }',
            'effect = { hidden_effect = { DA_RX_choose.%s = yes } }' % c['id']])
        L('DA_RX_charter_tt.%s' % c['id'], '§Y%s§!\n%s\n%s' % (c['name'], c['line'], c['tt']))
        L('DA_RX_CH_%s' % c['id'].upper(), c['name'])
    o += cg('custom_button', 'DA_RX_send', ['tooltip = DA_RX_send_tt', 'potential = { NOT = { has_province_flag = DA_RX_out } DA_RX_room = yes }',
                                            'trigger = {', '\towned_by = FROM', '\tDA_RX_idle = yes', '\tDA_RX_room_tt = yes',
                                            '\tDA_RX_affordable_tt = yes', '}',
                                            'effect = {', '\tplay_sound = diggy_diggy_pickaxe_sfx', '\tDA_RX_send = yes', '}'])
    w = E.WORK['waygate']
    o += cg('custom_button', 'DA_RX_waygate_btn', [
        'tooltip = DA_RX_waygate_tt', 'potential = { DA_RX_great = yes %s owner = { has_country_flag = DA_PR_done.%s } '
        'NOT = { has_province_flag = DA_RX_waygate } }' % (HER, w['tile']),
        'trigger = {', '\tcustom_trigger_tooltip = { tooltip = DA_RX_ring4_tt check_variable = { which = DA_RX_ring value = 4 } }',
        '\towner = {', '\t\ttreasury = %d' % w['gold'], '\t\tDA_EL_has_lore = { amount = %d }' % w['lore'],
        '\t\tOR = { ai = yes DA_EL_has_mana = { amount = %d } }' % w['mana'],
        '\t\tcustom_trigger_tooltip = { tooltip = DA_RX_waygates_room_tt NOT = { check_variable = { which = DA_EL_waygates value = %d } } }' % w['max'],
        '\t}', '}', 'effect = { DA_RX_waygate = yes }'])
    L('DA_RX_waygate_tt', '§YOpen a Waygate§!\nPrice §Y%d¤§!, %s and §M%d mana§!\nThe province: %s. Up to §Y%d§! waygates.' % (
        w['gold'], lore(w['lore']), w['mana'], ', '.join(E.mod_lines(w['pmod'])), w['max']))
    L('DA_RX_ring4_tt', 'The ruin unsealed to ring §YIV§!, the Skyward Docks')
    L('DA_RX_waygates_room_tt', 'Fewer than §Y%d§! waygates open' % w['max'])
    L('DA_RX_WAYGATE', 'Open a Waygate')
    L('DA_RX_send_tt', '§YSend the Expedition§!')
    L('DA_RX_SEND', 'Send the Expedition')
    return '\n'.join(o) + '\n'


def defined_texts():
    """(name, [(key, trigger)], fallback)"""
    D = []
    L('DA_RX_title', 'Precursor Ruin')
    L('DA_RX_name', '[Root.GetName]')
    L('DA_RX_depth', '[Root.DA_RX_GetDepth]')
    pairs = []
    for n in range(6, 0, -1):
        L('DA_RX_depth_%d' % n, 'Unsealed to ring §Y%s§!' % R[n])
        pairs.append(('DA_RX_depth_%d' % n, 'check_variable = { which = DA_RX_ring value = %d }' % n))
    L('DA_RX_depth_0', '§gStill sealed§!')
    D.append(('DA_RX_GetDepth', pairs, 'DA_RX_depth_0'))
    L('DA_RX_subtitle', '[Root.DA_RX_GetKind]')
    L('DA_RX_kind_great', 'A great ruin of the Precursors: six rings, three lost works')
    L('DA_RX_kind_fragment', 'A Fragment site of the Precursors: six rings')
    L('DA_RX_kind_temple', 'A Temple Complex of Haless: three rings')
    L('DA_RX_kind_lesser', 'A lesser ruin of the Precursors: three rings')
    D.append(('DA_RX_GetKind', [('DA_RX_kind_great', 'DA_RX_great = yes'), ('DA_RX_kind_fragment', 'DA_RX_fragment = yes'),
                                ('DA_RX_kind_temple', 'DA_RX_temple_rings = yes')], 'DA_RX_kind_lesser'))
    for n in range(1, 7):
        L('DA_RX_rn_%d' % n, '[Root.DA_RX_GetRn%d]' % n)
        L('DA_RX_rnc_%d' % n, '%s  %s' % (R[n], E.RINGS[n]))
        if n <= 3:
            L('DA_RX_rnt_%d' % n, '%s  %s' % (R[n], E.TEMPLE_RINGS[n]))
            D.append(('DA_RX_GetRn%d' % n, [('DA_RX_rnt_%d' % n, 'DA_RX_temple_rings = yes')], 'DA_RX_rnc_%d' % n))
        else:
            D.append(('DA_RX_GetRn%d' % n, [], 'DA_RX_rnc_%d' % n))
        L('DA_RX_row_tt.%d' % n, '§Y%s: %s§!\nPrice §Y%d¤§!%s; the expedition takes about §Y%d§! days and sends §Y%d§! %s.\nDanger %s.' % (
            R[n], E.RINGS[n], E.RING_PRICE[n], (', §M%d mana§! for the elves' % E.RING_MANA[n]) if E.RING_MANA[n] else '',
            E.RING_DAYS[n], E.RING_REPORTS[n], 'report' if E.RING_REPORTS[n] == 1 else 'reports', E.RING_DANGER[n]))
    # the next expedition: by people, ring and charter
    L('DA_RX_next', '[Root.DA_RX_GetNext]')
    pairs = []
    for kind, n, c, gold, mana, ess, days in cases():
        key = 'DA_RX_next.%s.%d.%s' % (kind, n, c)
        price = '§Y%d¤§!' % gold + (', §M%d mana§!' % mana if mana else '') + (', §M%d Essence§!' % ess if ess else '')
        L(key, '§YThe Next Expedition§!\nRing §Y%s§! · danger %s\n%s · about §Y%d§! days' % (R[n], E.RING_DANGER[n], price, days))
        pairs.append((key, '%s %s DA_RX_charter.%s = yes' % (kind_trig(kind), at_ring(n), c)))
    L('DA_RX_next_none', '§YThe Next Expedition§!')
    D.append(('DA_RX_GetNext', pairs, 'DA_RX_next_none'))
    L('DA_RX_status', '[Root.DA_RX_GetStatus]')
    L('DA_RX_status_out', '§YAn expedition is at work§! in the next ring. Its reports come back when it is done.')
    L('DA_RX_status_done', '§GEvery ring is unsealed.§! The ruin has given up its secrets.')
    L('DA_RX_status_others', '§gThe deeper rings are closed to us.§! Only a people of the Precursor heritage reads their wards; '
      'a §YPrecursor Archaeologist§!, or §YGommo Surveys§! for gnomes, takes anyone else to ring §YIII§!.')
    D.append(('DA_RX_GetStatus', [('DA_RX_status_out', 'has_province_flag = DA_RX_out'),
                                  ('DA_RX_status_done', 'OR = { check_variable = { which = DA_RX_ring value = 6 } AND = { NOT = { DA_RX_deep = yes } '
                                   'check_variable = { which = DA_RX_ring value = 3 } } }')], 'DA_RX_status_others'))
    L('DA_RX_hint', '[Root.DA_RX_GetHint]')
    L('DA_RX_hint_el', 'Every ring is open to us. Deeper rings open the Archive\'s levels and the later Elven tiles.')
    L('DA_RX_hint_other', 'Ring §YI§! is open to anyone; rings §YII§! and §YIII§! with a Precursor Archaeologist, at double price.')
    L('DA_RX_hint_gn', 'Gommo Surveys open rings §YI§! to §YIII§! to us at the plain price; relic finds bring relic samples '
      'for the Workshop.')   # DA_EL (doc 72)
    D.append(('DA_RX_GetHint', [('DA_RX_hint_el', HER), ('DA_RX_hint_gn', GN)], 'DA_RX_hint_other'))
    L('DA_RX_lost_line', '§YThe Lost Works§!')
    L('DA_RX_charter_line', '[Root.DA_RX_GetCharterLine]')
    for c in E.CHARTERS:
        L('DA_RX_chl_%s' % c['id'], '§Y%s§!: %s' % (c['name'], c['line']))
    L('DA_RX_chl_plain', 'A plain expedition: guides and porters.')
    D.append(('DA_RX_GetCharterLine', [('DA_RX_chl_plain', NHER)] + [('DA_RX_chl_%s' % c['id'], 'DA_RX_charter.%s = yes' % c['id'])
                                                                    for c in E.CHARTERS], 'DA_RX_chl_plain'))
    # the seals of the lost works
    for k in (1, 2, 3):
        pairs = []
        for p, works in E.LOST.items():
            key = 'DA_RX_seal.%d.%d' % (p, k)
            L(key, '§Y%s§!\n%s' % (works[k - 1][0], works[k - 1][2]))
            pairs.append((key, 'province_id = %d has_province_flag = DA_RX_lw%d' % (p, k)))
        L('DA_RX_seal_none.%d' % k, '§YThe %s lost work§!\nNot found yet. It lies in ring §Y%s§! or §Y%s§!.' % (
            ['first', 'second', 'third'][k - 1], R[k + 2], R[k + 3]))
        L('DA_RX_seal_tt.%d' % k, '[Root.DA_RX_GetSeal%d]' % k)
        D.append(('DA_RX_GetSeal%d' % k, pairs, 'DA_RX_seal_none.%d' % k))
    # the event texts
    pairs = []
    for n in range(1, 4):
        pairs.append(('DA_RX_unsealed_t%d' % n, 'DA_RX_temple_rings = yes is_variable_equal = { which = DA_RX_ring value = %d }' % n))
    for n in range(1, 7):
        pairs.append(('DA_RX_unsealed_%d' % n, 'is_variable_equal = { which = DA_RX_ring value = %d }' % n))
    D.append(('DA_RX_GetUnsealed', pairs, 'DA_RX_unsealed_1'))
    pairs = []
    for reg, name in E.DEGENERATES:
        key = 'DA_RX_deg_%s' % name.replace(' ', '_')
        L(key, name)
        pairs.append((key, '%s = %s' % ('superregion' if reg.endswith('superregion') else 'region', reg)))
    L('DA_RX_deg_none', 'Degenerated Elves')
    D.append(('DA_RX_GetDegenerates', pairs, 'DA_RX_deg_none'))
    D += survey_defined_texts()   # DA_EL (doc 72)
    return D


def gen_custom_loc():
    out = [HEAD.rstrip()]
    for name, pairs, fb in defined_texts():
        o = ['defined_text = {', '\tname = %s' % name, '\trandom = no']
        for key, trig in pairs:
            o.append('\ttext = {\n\t\tlocalisation_key = %s\n\t\ttrigger = { %s }\n\t}' % (key, trig))
        o.append('\ttext = {\n\t\tlocalisation_key = %s\n\t\ttrigger = { always = yes }\n\t}' % fb)
        o.append('}')
        out.append('\n'.join(o))
    return '\n\n'.join(out) + '\n'


def gui(kind, **kw):
    lines = ['%s = {' % kind]
    for k, v in kw.items():
        if k == 'position':
            v = '{ x = %d y = %d }' % v
        elif isinstance(v, str) and k in ('name', 'spriteType', 'quadTextureSprite', 'text', 'font', 'buttonText', 'buttonFont'):
            v = '"%s"' % v
        lines.append('\t%s = %s' % (k, v))
    lines.append('}')
    return '\n'.join(lines)


def txt(name, x, y, w, h, font='vic_18', fmt='left', scripted=True):
    d = dict(name='DA_RX_' + name, position=(x, y), font=font, text='DA_RX_' + name, maxWidth=w, maxHeight=h, format=fmt)
    if scripted:
        d['scripted'] = 'yes'
    d['alwaystransparent'] = 'yes'
    return gui('instantTextBoxType', **d)


def row_y(n):
    return ROW_Y + ROW_P * (n - 1)


def mark_xy(n, j):
    return ROW_X + ROW_W - 8 - (len(E.KINDS) - j) * (MARK + 1), row_y(n) + (ROW_H - MARK) // 2


def panel_elements():
    bx, by, bw, bh = BANNER
    els = [gui('iconType', name='DA_RX_background', spriteType='GFX_DA_RX_panel_bg', position=(0, 0)),
           txt('title', 18, 13, 320, 25, font='vic_22', scripted=False),
           gui('guiButtonType', name='DA_RX_close', quadTextureSprite='GFX_closebutton2', position=(PANEL_W - 30, 10), scripted='yes'),
           gui('iconType', name='DA_RX_banner', spriteType='GFX_DA_RX_banner', position=(bx, by), scripted='yes'),
           txt('name', bx + 10, by + bh - 29, 290, 25, font='vic_22'),
           txt('depth', bx + bw - 190, by + bh - 25, 180, 20, fmt='right'),
           txt('subtitle', 18, by + bh + 4, bw, 18)]
    for n in range(1, 7):
        els.append(gui('iconType', name='DA_RX_row_%d' % n, spriteType='GFX_DA_RX_row', position=(ROW_X, row_y(n)), scripted='yes'))
        els.append(txt('rn_%d' % n, ROW_X + 8, row_y(n) + 3, ROW_W - 80, 20))
        for j, (k, _) in enumerate(E.KINDS):
            els.append(gui('iconType', name='DA_RX_mark_%d_%s' % (n, k), spriteType='GFX_DA_RX_mark_%s' % k, position=mark_xy(n, j),
                           scripted='yes'))
    els.append(txt('hint', ROW_X, row_y(6) + ROW_H + 8, ROW_W, 54))
    els.append(txt('lost_line', COL_X, ROW_Y - 2, COL_W, 20))
    for k in (1, 2, 3):
        els.append(gui('iconType', name='DA_RX_seal_%d' % k, spriteType='GFX_DA_RX_seal', position=(COL_X + (k - 1) * 46, SEAL_Y),
                       scripted='yes'))
    els += [txt('next', COL_X, 226, COL_W, 58), txt('status', COL_X, 226, COL_W, 90)]
    for c, xy in zip(E.CHARTERS, CH_XY):
        els.append(gui('guiButtonType', name='DA_RX_charter_%s' % c['id'], quadTextureSprite='GFX_DA_RX_charter', position=xy,
                       scripted='yes', buttonText='DA_RX_CH_%s' % c['id'].upper(), buttonFont='vic_18'))
    els.append(txt('charter_line', COL_X, 287, COL_W, 40))
    els.append(gui('guiButtonType', name='DA_RX_send', quadTextureSprite='GFX_DA_RX_send', position=SEND_XY, scripted='yes',
                   buttonText='DA_RX_SEND', buttonFont='vic_22'))
    els.append(gui('guiButtonType', name='DA_RX_waygate_btn', quadTextureSprite='GFX_DA_RX_waygate', position=WAYGATE_XY, scripted='yes',
                   buttonText='DA_RX_WAYGATE', buttonFont='vic_18'))
    return els


def gen_province_panel():
    body = '\n'.join(['name = "DA_province_ruin_panel"', 'position = { x = %d y = %d }', 'size = { x = %d y = %d }' % (PANEL_W, PANEL_H),
                      'scripted = yes', 'moveable = 0'] + panel_elements())
    return 'windowType = {\n' + '\n'.join(ind(body.split('\n'))) + '\n}'


SPRITES = [('GFX_DA_RX_panel_bg', 'DA_RX_panel_bg', 1), ('GFX_DA_RX_banner', 'DA_RX_banner', 3), ('GFX_DA_RX_row', 'DA_RX_row', 4),
           ('GFX_DA_RX_seal', 'DA_RX_seal', 2), ('GFX_DA_RX_charter', 'DA_RX_charter', 2), ('GFX_DA_RX_send', 'DA_RX_send', 1),
           ('GFX_DA_RX_waygate', 'DA_RX_waygate', 1), ('GFX_DA_RX_unseal_button', 'DA_RX_unseal_button', 1)] + \
          [('GFX_DA_RX_mark_%s' % k, 'DA_RX_mark_%s' % k, 1) for k, _ in E.KINDS]


def gen_gfx():
    o = [HEAD.rstrip(), 'spriteTypes = {']
    for name, tex, frames in SPRITES:
        s = '\tspriteType = {\n\t\tname = "%s"\n\t\ttexturefile = "%s/%s.dds"\n' % (name, GFX, tex)
        if frames > 1:
            s += '\t\tnoOfFrames = %d\n' % frames
        o.append(s + '\t\ttransparencecheck = yes\n\t}')
    o.append('}')
    return '\n'.join(o) + '\n'


def read(rel):
    raw = open(path(rel), 'rb').read()
    text = raw.decode('utf-8-sig') if rel.endswith('.yml') else raw.decode('latin-1')
    return text.replace('\r\n', '\n'), '\r\n' in text


def patch_provinceview():
    """The panel before each Medicine panel (as the Hold Exploration panel), and the Unseal button in Row 3, Slot 4 of the
    three province button grids. Each block is taken out and put back the same way each run."""
    rel = 'interface/provinceview.gui'
    t, crlf = read(rel)
    t = re.sub(r'[ \t]*' + re.escape(PANEL_BEGIN) + r'\n.*?' + re.escape(PANEL_END) + r'\n', '', t, flags=re.S)
    t = re.sub(r'[ \t]*' + re.escape(BUTTON_BEGIN) + r'\n.*?' + re.escape(BUTTON_END) + r'\n', '', t, flags=re.S)
    panel = gen_province_panel()
    out, pos, count = [], 0, 0
    # before the Hold Exploration panel where it stands right before the Medicine panel, else before the Medicine panel:
    # each builder takes its own block out and puts it back in the same place, whichever of the two runs last
    for m in re.finditer(r'(\t*)windowType = \{\n\t*name = "DA_province_medicine_panel"', t):
        tabs = m.group(1)
        at = m.start()
        before = t[pos:at].rstrip('\t')
        if before.endswith('# END DA_HOLD_EXPLORATION_PANEL\n'):
            hb = t.rfind('# BEGIN DA_HOLD_EXPLORATION_PANEL', pos, at)
            at = t.rfind('\n', 0, hb) + 1
        xy = (490, 95) if count == 0 else (10, 142)
        blk = '\n'.join(ind((panel % xy).split('\n'), len(tabs)))
        out.append(t[pos:at])
        out.append('%s%s\n%s\n%s%s\n' % (tabs, PANEL_BEGIN, blk, tabs, PANEL_END))
        pos = at
        count += 1
    if count != 2:
        raise SystemExit('provinceview.gui: expected 2 medicine panels, found %d' % count)
    out.append(t[pos:])
    t = ''.join(out)
    # the button: Row 3, Slot 4 of each grid (112, 176 in the vertical one; 169, 124 in the two others)
    out, pos, count = [], 0, 0
    for m in re.finditer(r'(\t*)' + re.escape(SLOT4) + r'\n', t):
        tabs = m.group(1)
        xy = (112, 176) if count == 0 else (169, 124)
        btn = ['guiButtonType = {', '\tname = "DA_RX_unseal_button"', '\tquadTextureSprite = "GFX_DA_RX_unseal_button"',
               '\tposition = { x = %d y = %d }' % xy, '\tscripted = yes', '\tclicksound = back_click', '}']
        out.append(t[pos:m.end()])
        out.append('%s%s\n%s\n%s%s\n' % (tabs, BUTTON_BEGIN, '\n'.join(tabs + l for l in btn), tabs, BUTTON_END))
        pos = m.end()
        count += 1
    if count != 3:
        raise SystemExit('provinceview.gui: expected Row 3, Slot 4 in three grids, found it %d times' % count)
    out.append(t[pos:])
    write(rel, ''.join(out), crlf)


# ---------------------------------------------------------------------------
# Art: the panel's textures (stone, gold and teal, as the Archive)
# ---------------------------------------------------------------------------
def art():
    import struct
    import numpy as np
    from PIL import Image, ImageDraw, ImageFilter, ImageEnhance

    def write_dds(img, name):
        img = img.convert('RGBA')
        w, h = img.size
        a = np.array(img)
        data = a[:, :, [2, 1, 0, 3]].tobytes()
        hdr = struct.pack('<4s7I44s8I5I', b'DDS ', 124, 0x100f, h, w, w * 4, 0, 1, b'\0' * 44,
                          32, 0x41, 0, 32, 0xff0000, 0xff00, 0xff, 0xff000000, 0x1000, 0, 0, 0, 0)
        rel = '%s/%s.dds' % (GFX, name)
        full = path(rel)
        data = hdr + data
        old = open(full, 'rb').read() if os.path.exists(full) else None
        REPORT.append(('same    ' if old == data else ('changed ' if old else 'new     ')) + rel)
        if old != data and MODE != 'check':
            os.makedirs(os.path.dirname(full), exist_ok=True)
            open(full, 'wb').write(data)
    GOLD = (222, 184, 104)
    TEAL = (86, 214, 196)
    rs = np.random.RandomState(69)

    def panel(w, h, base=(20, 44, 46)):
        g = rs.normal(0, 1, (h, w))
        g = np.array(Image.fromarray(((g * 40) + 128).clip(0, 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(0.8))).astype(float) - 128
        g *= 4 / (g.std() + 1e-9)
        a = np.zeros((h, w, 4))
        a[..., :3] = np.array(base)[None, None, :] + g[..., None]
        a[..., 3] = 245
        return Image.fromarray(a.clip(0, 255).astype(np.uint8), 'RGBA')
    # the background: a dark teal panel in a stone and gold rim
    bg = panel(PANEL_W, PANEL_H)
    d = ImageDraw.Draw(bg)
    d.rectangle([0, 0, PANEL_W - 1, PANEL_H - 1], outline=(196, 182, 150, 255), width=5)
    d.rectangle([5, 5, PANEL_W - 6, PANEL_H - 6], outline=GOLD + (255,), width=2)
    d.rectangle([8, 8, PANEL_W - 9, PANEL_H - 9], outline=(110, 90, 50, 200), width=1)
    d.line([COL_X - 8, ROW_Y, COL_X - 8, PANEL_H - 20], fill=(150, 124, 70, 160), width=1)
    write_dds(bg, 'DA_RX_panel_bg')
    # the banner: three crops of your marvels (a great ruin, a lesser ruin, a temple complex) until the banners come
    bw, bh = BANNER[2], BANNER[3]
    strip = Image.new('RGBA', (bw * 3, bh), (0, 0, 0, 0))
    for k, pic in enumerate(('spire_gardens', 'gleaming_laboratory', 'elemental_wells')):
        p = path('Claude files/art_sources/elven_marvels/%s.png' % pic)
        if os.path.exists(p):
            im = Image.open(p).convert('RGBA')
            r = bw / im.size[0]
            im = im.resize((bw, int(im.size[1] * r)), Image.LANCZOS)
            y0 = int(im.size[1] * (0.30 if k == 0 else 0.45))
            im = im.crop((0, y0, bw, y0 + bh))
        else:
            im = panel(bw, bh, (30, 60, 60))
        a = np.array(im).astype(float)
        xx = np.arange(bw)[None, :]
        shade = np.clip((xx - 0) / 260.0, 0, 1)
        a[..., :3] *= (0.45 + 0.55 * shade)[..., None]
        yy = np.arange(bh)[:, None]
        a[..., :3] *= (1 - 0.5 * np.clip((yy - 40) / 44.0, 0, 1))[..., None]
        im = Image.fromarray(a.clip(0, 255).astype(np.uint8), 'RGBA')
        ImageDraw.Draw(im).rectangle([0, 0, bw - 1, bh - 1], outline=GOLD + (255,), width=1)
        strip.paste(im, (k * bw, 0))
    write_dds(strip, 'DA_RX_banner')
    # the rows: sealed, the next ring, an expedition at work, unsealed
    rw, rh = ROW_W, ROW_H
    rows = Image.new('RGBA', (rw * 4, rh), (0, 0, 0, 0))
    for k, (fill, line) in enumerate((((16, 26, 28), (70, 80, 76)), ((24, 50, 50), GOLD), ((30, 64, 56), (230, 200, 120)),
                                      ((26, 70, 68), TEAL))):
        im = Image.new('RGBA', (rw, rh), (0, 0, 0, 0))
        dd = ImageDraw.Draw(im)
        dd.rounded_rectangle([0, 0, rw - 1, rh - 1], radius=4, fill=fill + (235,), outline=line + (255,), width=1)
        if k == 2:
            dd.rounded_rectangle([2, 2, rw - 3, rh - 3], radius=3, outline=(230, 200, 120, 120), width=1)
        rows.paste(im, (k * rw, 0))
    write_dds(rows, 'DA_RX_row')
    # the find marks
    cols = {'lore': TEAL, 'relic': GOLD, 'kin': (150, 200, 120), 'foe': (210, 80, 60)}
    for k, _ in E.KINDS:
        im = Image.new('RGBA', (MARK, MARK), (0, 0, 0, 0))
        dd = ImageDraw.Draw(im)
        if k == 'lore':
            dd.rectangle([3, 2, 12, 13], fill=cols[k] + (255,), outline=(20, 30, 30, 255))
        elif k == 'relic':
            dd.polygon([(8, 1), (14, 8), (8, 14), (2, 8)], fill=cols[k] + (255,), outline=(40, 30, 10, 255))
        elif k == 'kin':
            dd.ellipse([2, 2, 13, 13], fill=cols[k] + (255,), outline=(20, 40, 20, 255))
        else:
            dd.polygon([(8, 1), (14, 14), (2, 14)], fill=cols[k] + (255,), outline=(40, 10, 10, 255))
        write_dds(im, 'DA_RX_mark_%s' % k)
    # the seals of the lost works: sealed, found
    seal = Image.new('RGBA', (SEAL * 2, SEAL), (0, 0, 0, 0))
    for k, (face, ring) in enumerate((((26, 34, 36), (110, 100, 80)), ((40, 90, 86), GOLD))):
        im = Image.new('RGBA', (SEAL, SEAL), (0, 0, 0, 0))
        dd = ImageDraw.Draw(im)
        dd.ellipse([2, 2, SEAL - 3, SEAL - 3], fill=face + (255,), outline=ring + (255,), width=3)
        c = SEAL // 2
        dd.polygon([(c, 9), (SEAL - 10, c), (c, SEAL - 10), (9, c)], outline=ring + (255,), width=2)
        if k == 1:
            dd.ellipse([c - 3, c - 3, c + 3, c + 3], fill=TEAL + (255,))
        seal.paste(im, (k * SEAL, 0))
    write_dds(seal, 'DA_RX_seal')

    def glass(w, h, frames=1, rad=6):
        s = Image.new('RGBA', (w * frames, h), (0, 0, 0, 0))
        for k in range(frames):
            im = Image.new('RGBA', (w, h), (0, 0, 0, 0))
            dd = ImageDraw.Draw(im)
            dd.rounded_rectangle([0, 0, w - 1, h - 1], radius=rad, fill=(40, 30, 14, 255))
            dd.rounded_rectangle([1, 1, w - 2, h - 2], radius=rad, fill=(206, 168, 96, 255) if k == 0 else (250, 226, 150, 255))
            dd.rounded_rectangle([2, 2, w - 3, h - 3], radius=rad - 1, fill=(110, 84, 40, 255))
            dd.rounded_rectangle([3, 3, w - 4, h - 4], radius=rad - 2, fill=(22, 58, 60, 255) if k == 0 else (30, 92, 88, 255))
            dd.line([7, 4, w - 8, 4], fill=(70, 128, 124, 255))
            s.paste(im, (k * w, 0))
        return s
    write_dds(glass(CH_W, CH_H, 2), 'DA_RX_charter')
    write_dds(glass(*SEND, rad=8), 'DA_RX_send')
    write_dds(glass(*WAYGATE), 'DA_RX_waygate')
    # the Unseal button of the province view: a seal of teal light on stone
    im = Image.new('RGBA', (36, 36), (0, 0, 0, 0))
    dd = ImageDraw.Draw(im)
    dd.ellipse([1, 1, 34, 34], fill=(196, 182, 150, 255), outline=(90, 70, 40, 255), width=2)
    dd.ellipse([5, 5, 30, 30], fill=(20, 52, 54, 255), outline=GOLD + (255,), width=2)
    dd.polygon([(18, 9), (27, 18), (18, 27), (9, 18)], outline=TEAL + (255,), width=2)
    dd.ellipse([15, 15, 21, 21], fill=TEAL + (255,))
    write_dds(im, 'DA_RX_unseal_button')


# ---------------------------------------------------------------------------
def esc(s):
    return s.replace('"', '\\"').replace('\n', '\\n')


def gen_loc():
    return 'l_english:\n' + '\n'.join(' %s:0 "%s"' % (k, esc(v)) for k, v in LOC.items()) + '\n'


def generated():
    LOC.clear()
    decision_loc()   # DA_EL (doc 72)
    files = {'common/scripted_triggers/DA_RX_triggers.txt': gen_triggers(),
             'common/scripted_effects/DA_RX_effects.txt': gen_effects(),
             'common/event_modifiers/DA_RX_modifiers.txt': gen_modifiers(),
             'events/DA_RX_events.txt': fix_skydock(gen_events()) + survivors_event(),
             'common/on_actions/DA_RX_on_actions.txt': gen_on_actions(),
             'common/custom_gui/DA_RX_Ruin_Excavation.txt': gen_custom_gui(),
             'customizable_localization/DA_RX_custom_loc.txt': gen_custom_loc(),
             'interface/DA_Ruin_Excavation.gfx': gen_gfx()}
    files['localisation/DA_RX_l_english.yml'] = gen_loc()
    return files


def validate(files):
    probs = []
    for rel, text in files.items():
        if rel.endswith('.yml'):
            continue
        t = re.sub(r'#[^\n]*', '', text)
        if t.count('{') != t.count('}'):
            probs.append('%s: braces do not balance' % rel)
        try:
            text.encode('latin-1')
        except UnicodeError as e:
            probs.append('%s: not latin-1 (%s)' % (rel, e))
    if re.search(r'\belse(_if)?\s*=', re.sub(r'#[^\n]*', '', files['common/scripted_effects/DA_RX_effects.txt'])):
        probs.append('an else in DA_RX_effects.txt')
    if re.search(r'\brandom(_list|_owned_province)?\s*=', re.sub(r'#[^\n]*', '', files['common/custom_gui/DA_RX_Ruin_Excavation.txt'])):
        probs.append('dice in a button')
    ev_text = files['events/DA_RX_events.txt']
    for blk in re.split(r'\n(?=(?:province|country)_event = \{)', ev_text):
        if 'hidden = yes' in blk:
            continue
        if re.search(r'\brandom(_list)?\s*=', re.sub(r'#[^\n]*', '', blk)):
            probs.append('dice in a visible event: %s' % re.search(r'id = (\S+)', blk).group(1))
    return probs


def preview(out):
    """The Excavation panel as the game draws it (eu4_gui.py): a great ruin of an elven country, unsealed to ring III,
    the Glyph-Readers chosen, finds reported on rings I-III, the first lost work found."""
    import eu4_gui as UI
    files = generated()
    mod = UI.Mod(ROOT, overrides=files, windows={'DA_province_ruin_panel': gen_province_panel() % (0, 0)})
    flags = ['DA_RX_open', 'DA_RX_ch.glyphs', 'DA_RX_m1_kin', 'DA_RX_m1_relic', 'DA_RX_m2_lore', 'DA_RX_m3_foe', 'DA_RX_m3_lore',
             'DA_RX_lw1', 'DA_PR_done.EL_Con3']
    vars_ = {'DA_RX_ring': 3}
    answers = {'owned_by': True, 'DA_RX_great': True, 'DA_RX_fragment': False, 'DA_RX_lesser': False, 'DA_RX_temple': False,
               'DA_RX_corrupt': False, 'DA_LE_open': False, 'owner': True, 'FROM': True, 'province_id': True}
    texts = {'Root.GetName': 'Antir Soara'}
    st = UI.State(flags, vars_, answers=answers, texts=texts)
    rep, _ = UI.render(mod, 'DA_province_ruin_panel', st, out)
    REPORT.append('preview ' + out)
    return ['%s: %s' % (e, i) for e, i in rep if e != '(trigger)']


def main():
    if MODE == 'preview':
        for p_ in preview(sys.argv[3]):
            REPORT.append('preview: ' + p_)
        print('\n'.join(r for r in REPORT if not r.startswith('same')))
        return
    if MODE == 'art':
        art()
        print('\n'.join(r for r in REPORT if not r.startswith('same')))
        return
    files = generated()
    for rel, text in files.items():
        write(rel, text, bom=rel.endswith('.yml'))
    patch_provinceview()
    patch_decision()   # DA_EL (doc 72): the Precursor Archaeologist
    probs = validate(files)
    print('\n'.join(r for r in REPORT if MODE == 'check' or not r.startswith('same')))
    print('great ruins %d, lesser %d, finds %d, lost works %d, mode %s' % (len(E.GREAT), len(E.LESSER), len(E.FINDS),
                                                                         sum(len(w) for w in E.LOST.values()), MODE))
    print('PROBLEMS:' if probs else 'no problems found')
    for p in probs:
        print('  ' + p)
    if probs:
        sys.exit(1)


if __name__ == '__main__':
    main()
