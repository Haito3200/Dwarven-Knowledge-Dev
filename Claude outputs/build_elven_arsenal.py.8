def rune_option(r, cls):
    L = ['\toption = {', '\t\tDA_SCH_pick_rune = { unit = %s token = %s } # DA_SCH' % (cls, r['token']),
         '\t\tname = "DA_Metallurgy_events.52.%s"' % r['token'], '\t\thighlight = yes', '\t\ttrigger = {',
