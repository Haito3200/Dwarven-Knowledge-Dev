# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------
def path(rel):
    return os.path.join(ROOT, rel)


def read(rel):
    raw = open(path(rel), 'rb').read()
    text = raw.decode('utf-8-sig' if rel.endswith('.yml') else 'latin-1')
    return text.replace('\r\n', '\n'), ('\r\n' in text)


def write(rel, text, crlf=True):
    if crlf:
        text = text.replace('\n', '\r\n')
    data = text.encode('utf-8' if rel.endswith('.yml') else 'latin-1')
    if rel.endswith('.yml'):
        data = b'\xef\xbb\xbf' + data
    full = path(rel)
    old = open(full, 'rb').read() if os.path.exists(full) else None
    if old == data:
        REPORT.append('same   ' + rel)
        return
    REPORT.append(('would write ' if MODE == 'check' else 'wrote  ') + rel)
    if MODE != 'check':
        os.makedirs(os.path.dirname(full) or '.', exist_ok=True)
        open(full, 'wb').write(data)


def block_end(text, open_brace):
    clean = re.sub(r'#[^\n]*', lambda m: ' ' * len(m.group(0)), text)
    depth = 0
    for i in range(open_brace, len(clean)):
        if clean[i] == '{':
            depth += 1
        elif clean[i] == '}':
            depth -= 1
            if depth == 0:
                return i + 1
    raise SystemExit('unbalanced braces')


# ---------------------------------------------------------------------------
# Numbers (as build_obsidian_tech.py)
# ---------------------------------------------------------------------------
def pts(p):
    return 3 * p[0] + p[1] + p[2] - 2 * p[3] - 2 * p[4] if p else 0


def bp_cost(bp):
    return pts(bp['s']) + pts(bp.get('m')) + pts(bp.get('e')) + 4 * bp['slots'] - DISC[bp['tier']]


def rune_profile(r, cls):
    if cls == 'ARTIL' and not r.get('e'):
        p = r['p']
        return r.get('a') or (p[0], p[1] + max(0, -p[3]), p[2] + max(0, -p[4]), 0, 0)
    return r['p']


def rune_cost(r, cls):
    p = rune_profile(r, cls)
    v = pts(p)
    c = max(1, int(math.floor(1.2 * math.sqrt(max(v, 1)) - 0.2 + 0.5)))
    if r.get('e'):
        c += 2
    if r.get('u'):
        c += SURCHARGE.get(r['u'], 1)
    return c


def num(v, rec=False):
    if v == 0:
        return '-0.00' if rec else '0.00'
    return '%.2f' % (v / 100.0)


def classes(bp):
    return [LETTER[c] for c in bp['cls']]


