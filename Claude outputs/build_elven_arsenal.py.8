def gen_modifiers():
    L = [HEAD, '# The fixed effect of the Primary Technology Dragonguard Spellforms, one per class.']
    for cls in CLASSES:
        L.append('DA_Unique_mod.PUNK.%s.%s = {' % (cls, PATH['token']))
        L += ['\t%s = %s' % (k, v) for k, v in PATH['fixed'].items()]
        L += ['\t%s = yes' % UNIT_MARK[cls], '}']
    return '\n'.join(L) + '\n'


def gen_loc():
    L = ['l_english:']

    def add(k, v):
        L.append(' %s:0 "%s"' % (k, v.replace('"', '\\"').replace('\n', '\\n')))

    add('DA_Metallurgy_events.49.%s' % PATH['token'], '§YPrimary Technology§!: %s' % PATH['name'])
    for cls in CLASSES:
        add('DA_Unique_mod.PUNK.%s.%s' % (cls, PATH['token']), 'Primary Technology: %s' % PATH['name'])
    for bp in BLUEPRINTS:
        add('DA_Metallurgy_events.50.%s' % bp['token'], '§T%s:§! %s' % (TIER_WORD[bp['tier']], bp['name']))
    for r in RUNES:
        add('DA_Metallurgy_events.52.%s' % r['token'], '§M%s:§! %s' % r['label'])
    return '\n'.join(L) + '\n'


# ---------------------------------------------------------------------------
# Validation (as build_obsidian_tech.py)
# ---------------------------------------------------------------------------
def validate(special):
    mods = ''
    for fn in os.listdir(path('common/event_modifiers')):
        mods += open(os.path.join(path('common/event_modifiers'), fn), encoding='latin-1').read()
    mods += gen_modifiers()
    loc = set()
    for sub in ('localisation', 'localisation/replace'):
        d = path(sub)
        if os.path.isdir(d):
            for fn in os.listdir(d):
                if fn.endswith('.yml') and fn != 'DA_EL_arsenal_l_english.yml':
                    loc.update(re.findall(r'^\s*([\w.\-]+):\d*\s*"', open(os.path.join(d, fn), encoding='utf-8-sig').read(), re.M))
    loc.update(re.findall(r'^\s*([\w.\-]+):\d*\s*"', gen_loc(), re.M))
    special = special.replace('\r', '')
    removal = special
    for rel in ('common/scripted_effects/DA_RB_effects.txt', 'common/scripted_effects/DA_OBS_effects.txt'):
        if os.path.exists(path(rel)):
            removal += read(rel)[0]

    def wired(typ, cls, tok):
        if not re.search(r'^DA_Unique_mod\.%s\.%s\.%s\s*=' % (typ, cls, re.escape(tok)), mods, re.M):
            PROBLEMS.append('modifier DA_Unique_mod.%s.%s.%s is not defined' % (typ, cls, tok))
        if not re.search(r'DA_unit = %s DA_type = %s DA_modifier = %s\s' % (cls, typ, re.escape(tok)), special):
            PROBLEMS.append('%s %s is never granted to %s' % (typ, tok, cls))
        if not re.search(r'remove_country_modifier = DA_Unique_mod\.%s\.(%s|\$DA_unit\$)\.%s\s' % (typ, cls, re.escape(tok)), removal):
            PROBLEMS.append('%s %s of %s is never removed' % (typ, tok, cls))
        if not re.search(r'clr_country_flag = DA_Unique_mod\.%s\.Flag\.\$DA_unit\$\.%s\s' % (typ, re.escape(tok)), special):
            PROBLEMS.append('the draft flag of %s %s is never cleared' % (typ, tok))

    for cls in CLASSES:
        wired('PUNK', cls, PATH['token'])
    if PATH['cost'] != 1 + PATH['S'] + PATH['M'] + PATH['E']:
        PROBLEMS.append('the path costs %d, the rule says %d' % (PATH['cost'], 1 + PATH['S'] + PATH['M'] + PATH['E']))
    for bp in BLUEPRINTS:
        lo, hi = BAND[bp['tier']]
        if not lo <= bp_cost(bp) <= hi:
            PROBLEMS.append('%s costs %d, outside %d-%d' % (bp['token'], bp_cost(bp), lo, hi))
        if bp['tier'] != 'electric' and bp.get('e'):
            PROBLEMS.append('%s has an electric part below the electric tier' % bp['token'])
        for cls in classes(bp):
            for u in bp['u']:
                wired('BLUEPRINT', cls, u)
        vals = [bp['s'] or (0,) * 5] + [x for x in (bp.get('m'), bp.get('e')) if x]
        keys = ['DA_Cost.tt.%d' % bp_cost(bp), 'DA_RuneSlots.tt.%d' % bp['slots']]
        for p in vals:
            keys += ['%s.tt.%s' % (k, num(p[i], i >= 3)) for i, k in enumerate(TT_KEYS)]
        for k in keys:
            if k not in loc:
                PROBLEMS.append('preview text %s (%s) is missing' % (k, bp['token']))
    for r in RUNES:
        for cls in CLASSES:
            wired('RUNE', cls, r['u'])
            p = rune_profile(r, cls)
            keys = ['DA_Cost.tt.%d' % rune_cost(r, cls)] + ['%s.tt.%s' % (k, num(p[i], i >= 3)) for i, k in enumerate(TT_KEYS)]
            if r.get('e'):
                keys += ['%s.tt.%s' % (k, num(E_STD[i], i >= 3)) for i, k in enumerate(TT_KEYS)]
            for k in keys:
                if k not in loc:
                    PROBLEMS.append('preview text %s (%s %s) is missing' % (k, r['token'], cls))
    for k in ('DA_Cost.tt.%d' % PATH['cost'], 'DA_Metal_strength_stat.%d' % PATH['S'], 'DA_Metal_MC_stat.%d' % PATH['M'],
              'DA_Metal_EC_stat.%d' % PATH['E'], 'DA_Unique_PUNK_TT', 'DA_selected_the_right_punk_for_BP_tt'):
        if k not in loc:
            PROBLEMS.append('text %s is missing' % k)
    toks = [x['token'] for x in BLUEPRINTS + RUNES]
    if len(set(toks)) != len(toks):
        PROBLEMS.append('two items share a token')
    # every option in place, once, inside our block and first in its event
    for cls in CLASSES:
        for n, want in ((0, 1), (1, len([b for b in BLUEPRINTS if cls in classes(b)])), (3, len(RUNES))):
            rel = 'events/DA_Metallurgy_events_%s_%d.txt' % (cls, n)
            text = read(rel)[0] if MODE != 'check' else ''
            if not text:
                continue
            blocks = BLOCK.findall(text)
            got = sum(len(re.findall(r'DA_SCH_pick(?:_rune)? = \{', b)) for b in blocks)
            if len(blocks) != (1 if want else 0) or got != want:
                PROBLEMS.append('%s: %d DA_EL block(s) with %d options, expected %d' % (rel, len(blocks), got, want))
            if blocks:
                j = text.index('\t# BEGIN DA_EL ')
                if any(0 <= text.find(x) < j for x in ANCHORS[n]):
                    PROBLEMS.append('%s: a block of another builder stands before ours' % rel)


def picks():
    """the designer options with a pick hook this builder writes (check_secondary_tech.py counts them)"""
    return len(CLASSES) + sum(len(classes(b)) for b in BLUEPRINTS) + len(RUNES) * len(CLASSES)


def main():
    patch_designer()
    special = patch_special()
    write('common/event_modifiers/DA_EL_arsenal_modifiers.txt', gen_modifiers())
    write('localisation/DA_EL_arsenal_l_english.yml', gen_loc())
    validate(special)
    print('\n'.join(REPORT))
    print('%d blueprints, %d sigils, %d designer options with a pick hook' % (len(BLUEPRINTS), len(RUNES), picks()))
    for bp in BLUEPRINTS:
        print('  %-26s %-8s %-4s %2d points, %d slot(s)' % (bp['name'], bp['tier'], bp['cls'], bp_cost(bp), bp['slots']))
    for r in RUNES:
        print('  %-26s %s points (artillery %d)' % (r['title'], rune_cost(r, 'INFAN'), rune_cost(r, 'ARTIL')))
    print('PROBLEMS:' if PROBLEMS else 'no problems found')
    for p in PROBLEMS:
        print('  ' + p)
    if PROBLEMS:
        sys.exit(1)


if __name__ == '__main__':
    main()
