    L.append('\t\t}')
    L += rune_apply(r, cls, '\t\t')
    L.append('\t}')
    return '\n'.join(L)


BLOCK = re.compile(r'[ \t]*# BEGIN DA_EL [^\n]*\n.*?# END DA_EL [^\n]*\n', re.S)
ANCHORS = {0: ('\t# BEGIN DA_KB ', '\t# BEGIN DA_GB ', '\t# BEGIN DA_GN ', '\t# BEGIN DA_OBSIDIAN '),
           1: ('\t# BEGIN DA_OBSIDIAN ', '\t# BEGIN DA_SS_LIVING'),
           3: ('\t# BEGIN DA_OBSIDIAN ', '\t# BEGIN DA_RUNE_REWORK new runes')}
WHAT = {0: 'primary technology', 1: 'blueprints', 3: 'sigils'}


def insert_first(text, n, body):
    """our block before every other builder's block of the event (else before its "after")"""
    text = BLOCK.sub('', text)
    a = text.index('\n\tafter = {') + 1
    found = [j for j in (text.find(x) for x in ANCHORS[n]) if 0 <= j < a]
    i = min(found) if found else a
    block = '\t# BEGIN DA_EL %s (build_elven_arsenal.py)\n%s\n\t# END DA_EL %s\n' % (WHAT[n], body, WHAT[n])
    return text[:i] + block + text[i:]


def patch_designer():
    for cls in CLASSES:
        rel = 'events/DA_Metallurgy_events_%s_0.txt' % cls
        text, crlf = read(rel)
        write(rel, insert_first(text, 0, path_option(cls)), crlf)
        opts = [bp_option(bp, cls) for bp in BLUEPRINTS if cls in classes(bp)]
        if opts:
            rel = 'events/DA_Metallurgy_events_%s_1.txt' % cls
            text, crlf = read(rel)
            write(rel, insert_first(text, 1, '\n'.join(opts)), crlf)
        rel = 'events/DA_Metallurgy_events_%s_3.txt' % cls
        text, crlf = read(rel)
        write(rel, insert_first(text, 3, '\n'.join(rune_option(r, cls) for r in RUNES)), crlf)


# ---------------------------------------------------------------------------
# DA_Metallurgy_special_mod_effects.txt: the path's grant, removal and clean-up lines (the blueprints' and sigils' fixed
# effects are the library's: their lines are there already)
# ---------------------------------------------------------------------------
def patch_special():
    text, crlf = read(SPECIAL)
    added = [0]

    def span(name):
        m = re.search(r'^%s\s*=\s*\{' % re.escape(name), text, re.M)
        if not m:
            raise SystemExit('%s: %s not found' % (SPECIAL, name))
        ob = text.index('{', m.start())
        return ob + 1, block_end(text, ob) - 1

    def ensure(name, line):
        nonlocal text
        a, b = span(name)
        core = line.split('#')[0].strip()
        if re.search(r'^[ \t]*' + re.escape(core) + r'[ \t]*(#[^\n]*)?$', text[a:b], re.M):
            return
        ls = text.rfind('\n', 0, b) + 1
        text = text[:ls] + '\t' + line + '\n' + text[ls:]
        added[0] += 1

    for cls in CLASSES:
        ensure('DA_give_Unique_Metallurgy_modifiers_' + cls,
               'DA_if_flag_give_modifier_effect = { DA_unit = %s DA_type = PUNK DA_modifier = %s } # DA_EL' % (cls, PATH['token']))
        ensure('DA_remove_Unique_Metallurgy_modifiers_blueprints_' + cls,
               'remove_country_modifier = DA_Unique_mod.PUNK.%s.%s # DA_EL' % (cls, PATH['token']))
    ensure('DA_remove_Unique_Metallurgy_modifiers_flags', 'clr_country_flag = DA_Unique_mod.PUNK.Flag.$DA_unit$.%s # DA_EL' % PATH['token'])
    REPORT.append('%d lines added in %s' % (added[0], SPECIAL))
    write(SPECIAL, text, crlf)
    return text


