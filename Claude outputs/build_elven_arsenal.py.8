def punk_apply(cls, ind):
    return [ind + 'DA_apply_Punk = {', ind + '\tDA_unit = %s' % cls, ind + '\tDA_Cost = %d' % PATH['cost'],
            ind + '\tDA_Strength = %d' % PATH['S'], ind + '\tDA_Magic_Conductivity = %d' % PATH['M'],
            ind + '\tDA_Electrical_Conductivity = %d' % PATH['E'], ind + '\tDA_Unique = %s' % PATH['token'], ind + '}']


def bp_apply(bp, cls, ind):
    s = bp['s'] or (0, 0, 0, 0, 0)
    L = [ind + 'DA_apply_Blueprint = {', ind + '\tDA_unit = %s' % cls, ind + '\tDA_Cost = %d' % bp_cost(bp),
         ind + '\tDA_RUNE_SLOTS = %d' % bp['slots']]
    L += [ind + '\t%s = %s' % (k, num(s[i], i >= 3)) for i, k in enumerate(KEYS)]
    L.append(ind + '\tDA_Unique = %s' % bp['u'][0])
    if len(bp['u']) > 1:
        L.append(ind + '\tDA_Unique_2 = %s' % bp['u'][1])
    if bp.get('m'):
        L.append(ind + '\tDA_Magical = yes')
        L += [ind + '\t%s.Magical = %s' % (k, num(bp['m'][i], i >= 3)) for i, k in enumerate(KEYS)]
    if bp.get('e'):
        L.append(ind + '\tDA_Electrical = yes')
        L += [ind + '\t%s.electric = %s' % (k, num(bp['e'][i], i >= 3)) for i, k in enumerate(KEYS)]
    L.append(ind + '}')
    return L


def rune_apply(r, cls, ind):
    p = rune_profile(r, cls)
    L = [ind + 'DA_apply_Runes = {', ind + '\tDA_unit = %s' % cls, ind + '\tDA_Cost = %d' % rune_cost(r, cls)]
    L += [ind + '\t%s = %s' % (k, num(p[i], i >= 3)) for i, k in enumerate(KEYS)]
    L.append(ind + '\tDA_Unique = %s' % r['u'])
    if r.get('e'):
        L.append(ind + '\tDA_Electrical = yes')
        L += [ind + '\t%s.electric = %s' % (k, num(E_STD[i], i >= 3)) for i, k in enumerate(KEYS)]
    L.append(ind + '}')
    return L


