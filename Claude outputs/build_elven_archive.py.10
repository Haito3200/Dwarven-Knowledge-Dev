#!/usr/bin/env python3
"""The Remnant Archive: the elves' and the Ruinborn's hall (doc 68; built 19 November 2026, doc 69).

    python3 "Claude files/tools/build_elven_archive.py" .                 apply
    python3 "Claude files/tools/build_elven_archive.py" . check           report only
    python3 "Claude files/tools/build_elven_archive.py" . art             the window's textures
    python3 "Claude files/tools/build_elven_archive.py" . preview OUT.png the textures and the previews

Safe to re-run. The tables are in elven_data.py; the Elven page itself is written by build_projects_research.py, the
ruins by build_ruin_excavation.py, the window by elven_archive_ui.py (imported here).

What it writes
  * Precursor Lore (DA_EL_lore): one effect for every gain (DA_EL_add_lore), one for every price (DA_EL_pay_lore).
  * The codices (DA_EL_codex.<school>): Read the Fleet Logs (elves), Raise a Dotim Pole (Ruinborn), the heritage codex of
    each elven culture (an event when the Archive is built; moon, star and eclipse elves choose), the ruins.
  * The Archive's seven levels (DA_EL_level), its works, the Ley Tithe.
  * The Archaeomancers (estate_da_archaeomancers) and the nine arts, their privileges, on Anbennar's mana.
  * The school works: wardstones and spires (placed in a hidden event), Prophecy, the Dragonguard Captain, Raise the
    Veil, Wake a Sleeper; the diplomatic actions Concord of the Remnant and Guide the Elves.
  * The six marvels (a tier kept in their ruin's province), their rulings, the Elemental Wells' elements.
  * The AI: its codices and a tile of the Elven page (DA_EL_ai_act, from the racial pulse).
No dice in any button: every roll is in a hidden event. Plain ifs only in the scripted effects (doc 35). Every
variable effect a player could see is in a hidden_effect with a plain line in its place (doc 66).
"""
import os, re, sys

ROOT = sys.argv[1] if len(sys.argv) > 1 else '.'
MODE = sys.argv[2] if len(sys.argv) > 2 else 'build'
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import elven_data as E  # noqa: E402

HEAD = '# Generated by "Claude files/tools/build_elven_archive.py" from elven_data.py. Change the tables there and re-run.\n'
REPORT = []
EV = E.EVENT_NS
LOC = {}
MAT = {k: v[0] for k, v in E.MATERIALS.items()}
MATN = {k: v[1] for k, v in E.MATERIALS.items()}
S = E.SCHOOLS
LC = E.LORE_C


def L(k, v):
    if k in LOC and LOC[k] != v:
        raise SystemExit('two texts for %s' % k)
    LOC[k] = v


def path(rel):
    return os.path.join(ROOT, rel)


def write(rel, text, crlf=True, bom=False):
    data = text.replace('\r\n', '\n')
    if crlf:
        data = data.replace('\n', '\r\n')
    raw = data.encode('utf-8' if rel.endswith('.yml') else 'latin-1')
    if bom:
        raw = b'\xef\xbb\xbf' + raw
    full = path(rel)
    old = open(full, 'rb').read() if os.path.exists(full) else None
    if old == raw:
        REPORT.append('same    ' + rel)
        return
    REPORT.append(('would write ' if MODE == 'check' else ('changed ' if old else 'new     ')) + rel)
    if MODE != 'check':
        os.makedirs(os.path.dirname(full) or '.', exist_ok=True)
        open(full, 'wb').write(raw)


def ind(lines, n=1):
    return ['\t' * n + l if l else l for l in lines]


def B(head, body):
    return ['%s = {' % head] + ind(body) + ['}']


def IF(limit, body):
    return B('if', B('limit', limit) + body)


def fmt(v):
    return E.fmtv(v)


def done(nid):
    return 'has_country_flag = DA_PR_done.%s' % nid


def gold(n):
    return '§Y%d¤§!' % n


def lore(n):
    return '%s%d Lore§!' % (LC, n)


def mat(k, n):
    return '§M%d %s§!' % (n, MATN[k])


def mana(n):
    return '§M%d mana§!' % n


def price_text(gold_=0, lore_=0, metal=0, building=0, essence=0, mana_=0, mil=0):
    parts = []
    if gold_:
        parts.append(gold(gold_))
    if lore_:
        parts.append(lore(lore_))
    if mana_:
        parts.append(mana(mana_))
    if metal:
        parts.append(mat('metal', metal))
    if building:
        parts.append(mat('building', building))
    if essence:
        parts.append(mat('essence', essence))
    if mil:
        parts.append('§Y%d§! military power' % mil)
    if not parts:
        return 'nothing'
    return ', '.join(parts[:-1]) + ' and ' + parts[-1] if len(parts) > 1 else parts[0]


def price_trig(gold_=0, lore_=0, metal=0, building=0, essence=0, mana_=0, mil=0):
    t = []
    if gold_:
        t.append('treasury = %d' % gold_)
    if lore_:
        t.append('DA_EL_has_lore = { amount = %d }' % lore_)
    if mana_:
        t.append('DA_EL_has_mana = { amount = %d }' % mana_)
    if metal:
        t.append('DA_EL_has_metal = { amount = %d }' % metal)
    if building:
        t.append('DA_EL_has_building = { amount = %d }' % building)
    if essence:
        t.append('DA_EL_has_essence = { amount = %d }' % essence)
    if mil:
        t.append('mil_power = %d' % mil)
    return t


def price_pay(gold_=0, lore_=0, metal=0, building=0, essence=0, mana_=0, mil=0):
    e = []
    if gold_:
        e.append('add_treasury = -%d' % gold_)
    if mil:
        e.append('add_mil_power = -%d' % mil)
    if lore_:
        e.append('DA_EL_pay_lore = { amount = %d }' % lore_)
    if mana_:
        e.append('DA_EL_pay_mana = { amount = %d }' % mana_)
    if metal:
        e.append('DA_EL_pay_metal = { amount = %d }' % metal)
    if building:
        e.append('DA_EL_pay_building = { amount = %d }' % building)
    if essence:
        e.append('DA_EL_pay_essence = { amount = %d }' % essence)
    return e


AMOUNTS = sorted(set(range(1, 61)) | {75, 80, 100, 120, 150, 200, 250, 300})


# ---------------------------------------------------------------------------
# Scripted triggers
# ---------------------------------------------------------------------------
def cooldown_trigger(w, years):
    return 'OR = { NOT = { has_country_flag = DA_EL_cd.%s } had_country_flag = { flag = DA_EL_cd.%s days = %d } }' % (
        w, w, years * 365)


def gen_triggers():
    o = [HEAD, '# The Precursor heritage (doc 68, section 4): elven or Ruinborn, the country\'s race or a former race kept.',
         'DA_EL_heritage = {', '\tOR = {', '\t\tDA_RH_active_elven = yes', '\t\tDA_RH_active_ruinborn = yes', '\t}', '}',
         '# The elven or Ruinborn texts of the window: the Ruinborn\'s own when that is the country\'s race.',
         'DA_EL_is_ruinborn = {', '\tDA_RH_primary_ruinborn = yes', '\tNOT = { DA_RH_primary_elven = yes }', '}', '']
    o.append('# A codex is read (the first tile of its family needs it)')
    for s in S:
        o += ['DA_EL_codex_read.%s = {' % s['id'], '\tcustom_trigger_tooltip = {',
              '\t\ttooltip = DA_EL_codex_read_tt.%s' % s['id'], '\t\thas_country_flag = DA_EL_codex.%s' % s['id'], '\t}', '}']
        L('DA_EL_codex_read_tt.%s' % s['id'], 'Codex: §Y%s§!' % s['codex'])
    o.append('# The deepest ring unsealed in a ruin of ours (build_ruin_excavation.py keeps DA_EL_ring_max)')
    for n in range(1, 7):
        o += ['DA_EL_ring.%d = {' % n, '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_ring_tt.%d' % n,
              '\t\tcheck_variable = { which = DA_EL_ring_max value = %d }' % n, '\t}', '}']
        L('DA_EL_ring_tt.%d' % n, 'A Precursor ruin of ours unsealed to ring §Y%s§!' % E.ROMAN[n])
    o += ['DA_EL_great4.2 = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_great4_tt',
          '\t\tcheck_variable = { which = DA_EL_great4 value = 2 }', '\t}', '}']
    L('DA_EL_great4_tt', 'Two great ruins unsealed to ring §YIV§!')
    tower = [m for m in E.MARVELS if m['id'] == 'tower'][0]['prov']
    stacks = [m for m in E.MARVELS if m['id'] == 'stacks'][0]['prov']
    gardens = [m for m in E.MARVELS if m['id'] == 'gardens'][0]['prov']
    o += ['DA_EL_matrix_ok = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_matrix_tt', '\t\tOR = {',
          '\t\t\tcheck_variable = { which = DA_EL_waygates value = 3 }',
          '\t\t\t%d = { owned_by = ROOT check_variable = { which = DA_EL_mv value = 2 } }' % tower, '\t\t}', '\t}', '}']
    L('DA_EL_matrix_tt', 'Three waygates open, or the §YVanetavanem§! raised to tier §YII§!')
    # DA_EL (doc 72): the Warden of Soara hears the command-tongue of the Fleet (le_rules.py, its parley_if)
    o += ['# The Warden of Soara answers: the Fleet Charms codex read and the art Fleet-Charm Crews in practice',
          'DA_EL_can_command_warden = {', '\tDA_EL_heritage = yes', '\thas_country_flag = DA_EL_codex.enchantment',
          '\thas_country_flag = DA_EL_art_on.enchantment', '}']
    o += ['DA_EL_pillar_ok = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_pillar_tt', '\t\tOR = {',
          '\t\t\tcheck_variable = { which = DA_EL_ring_max value = 6 }',
          '\t\t\t%d = { owned_by = ROOT check_variable = { which = DA_EL_mv value = 2 } }' % stacks, '\t\t}', '\t}', '}']
    L('DA_EL_pillar_tt', 'The §YDeep Stacks of Degalistéa§! raised to tier §YII§!, or a ruin of ours unsealed to ring §YVI§!')
    o += ['DA_EL_sleeper_found = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_sleeper_found_tt',
          '\t\tcheck_variable = { which = DA_EL_sleepers value = 1 }', '\t}', '}']
    L('DA_EL_sleeper_found_tt', 'A Sleeper in Stasis found and kept')
    o += ['DA_EL_spire_gardens_2 = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_spire_gardens_2_tt',
          '\t\t%d = { owned_by = ROOT check_variable = { which = DA_EL_mv value = 2 } }' % gardens, '\t}', '}']
    L('DA_EL_spire_gardens_2_tt', 'The §YSpire Gardens§! of Antir Soara raised to tier §YII§!')
    o.append('# The Archive\'s level')
    for n in range(1, 8):
        o += ['DA_EL_level_at.%d = {' % n, '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_level_at_tt.%d' % n,
              '\t\tcheck_variable = { which = DA_EL_level value = %d }' % n, '\t}', '}']
        L('DA_EL_level_at_tt.%d' % n, 'The Remnant Archive at level §Y%s§! or more' % E.ROMAN[n])
    o.append('# Prices: Lore, mana, materials (the amount in a custom tooltip, doc 66)')
    o += ['DA_EL_has_lore = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_has_lore_tt.$amount$',
          '\t\tcheck_variable = { which = DA_EL_lore value = $amount$ }', '\t}', '}',
          'DA_EL_has_mana = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_has_mana_tt.$amount$',
          '\t\thas_mana = { amount = $amount$ }', '\t}', '}']
    for k in ('metal', 'building', 'essence'):
        o += ['DA_EL_has_%s = {' % k, '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_has_%s_tt.$amount$' % k,
              '\t\tcheck_variable = { which = %s value = $amount$ }' % MAT[k], '\t}', '}']
    for a in AMOUNTS:
        L('DA_EL_has_lore_tt.%d' % a, 'Has at least %s' % lore(a))
        L('DA_EL_has_mana_tt.%d' % a, 'Has at least %s' % mana(a))
        for k in ('metal', 'building', 'essence'):
            L('DA_EL_has_%s_tt.%d' % (k, a), 'Has at least %s' % mat(k, a))
    o.append('# An Elven research is running')
    o += ['DA_EL_researching = {', '\tOR = {'] + ['\t\thas_country_flag = DA_research_flag.PR_%s' % t for t in E.TILE_IDS] + \
         ['\t}', '}']
    o += ['DA_EL_researching_tt = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_researching_tt',
          '\t\tDA_EL_researching = yes', '\t}', '}']
    L('DA_EL_researching_tt', 'A research of the §YElven§! page is running')
    o.append('# A work rested long enough since its last use')
    for w, d in E.WORK.items():
        if d.get('cool'):
            o += ['DA_EL_rested.%s = {' % w, '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_rested_tt.%s' % w,
                  '\t\t' + cooldown_trigger(w, d['cool']), '\t}', '}']
            L('DA_EL_rested_tt.%s' % w, 'Not done in the last §Y%d§! years' % d['cool'])
    o.append('# The arts (doc 68, section 8.2)')
    for s in S:
        sid = s['id']
        a = E.ARTS[sid]
        o += ['DA_EL_art_recovered.%s = {' % sid, '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_art_recovered_tt.%s' % sid,
              '\t\t%s' % done(E.tid(sid, 1)), '\t}', '}']
        L('DA_EL_art_recovered_tt.%s' % sid, 'The art recovered: §Y%s§! (%s I)' % (a['name'], s['name']))
        o += ['DA_EL_mana_for.%s = {' % sid, '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_mana_for_tt.%s' % sid,
              '\t\tOR = {', '\t\t\tai = yes', '\t\t\tcheck_variable = { which = mages_mana_regen_val value = %s }' % fmt(a['upkeep']),
              '\t\t}', '\t}', '}']
        L('DA_EL_mana_for_tt.%s' % sid, 'The month\'s mana stays at §Y0§! or more after its upkeep of §M%s§!' % fmt(a['upkeep']))
        o += ['DA_EL_unaside.%s = {' % sid, '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_unaside_tt',
              '\t\tOR = {', '\t\t\tNOT = { has_country_flag = DA_EL_aside.%s }' % sid,
              '\t\t\thad_country_flag = { flag = DA_EL_aside.%s days = 365 }' % sid, '\t\t}', '\t}', '}']
    L('DA_EL_unaside_tt', 'Not set aside in the last year')
    o += ['DA_EL_has_estate = {', '\tcustom_trigger_tooltip = {', '\t\ttooltip = DA_EL_has_estate_tt',
          '\t\thas_estate = %s' % E.EST, '\t}', '}']
    L('DA_EL_has_estate_tt', 'The §YArchaeomancers§! are an estate of ours')
    o.append('# Read the Fleet Logs and Raise a Dotim Pole: a codex of theirs is still unread')
    for wid, order in (('logs', E.FLEET), ('poles', E.TOTEMS)):
        o += ['DA_EL_%s_left = {' % wid, '\tOR = {'] + ['\t\tNOT = { has_country_flag = DA_EL_codex.%s }' % sid for sid in order] + \
             ['\t}', '}']
    o += ['# Recollection: an Elven research runs that has not been recollected', 'DA_EL_can_recollect = {', '\tOR = {']
    for tile in E.TILE_IDS:
        o.append('\t\tAND = { has_country_flag = DA_research_flag.PR_%s NOT = { has_country_flag = DA_EL_rec.%s } }' % (tile, tile))
    o += ['\t}', '}']
    o += ['# A country of the heritage that can take the diplomatic actions (doc 68, section 7.4)',
          'DA_EL_kin = {', '\tOR = {', '\t\tDA_RH_primary_elven = yes', '\t\tDA_RH_primary_ruinborn = yes', '\t}', '}']
    return '\n'.join(o) + '\n'


# ---------------------------------------------------------------------------
# Scripted effects
# ---------------------------------------------------------------------------
def give_codex(sid):
    return ['if = {', '\tlimit = { NOT = { has_country_flag = DA_EL_codex.%s } }' % sid,
            '\tcustom_tooltip = DA_EL_codex_gain_tt.%s' % sid, '\thidden_effect = {',
            '\t\tset_country_flag = DA_EL_codex.%s' % sid, '\t\tchange_variable = { which = DA_EL_codices value = 1 }', '\t}', '}']


def gen_effects():
    o = [HEAD, '# The Remnant Archive (doc 68). Plain ifs only: no else in these effects (Claude files/35).', '',
         '# Precursor Lore: every gain and every price through these two (doc 66: a plain line, the variable hidden)',
         'DA_EL_add_lore = {', '\tcustom_tooltip = DA_EL_lore_gain_tt.$amount$',
         '\thidden_effect = { change_variable = { which = %s value = $amount$ } }' % E.LORE, '}',
         'DA_EL_pay_lore = {', '\tcustom_tooltip = DA_EL_lore_cost_tt.$amount$',
         '\thidden_effect = { change_variable = { which = %s value = -$amount$ } }' % E.LORE, '}',
         '# Mana: Anbennar\'s own change_mana', 'DA_EL_pay_mana = {', '\tcustom_tooltip = DA_EL_mana_cost_tt.$amount$',
         '\thidden_effect = { change_mana = { amount = -$amount$ } }', '}']
    for a in AMOUNTS:
        L('DA_EL_lore_gain_tt.%d' % a, 'Gain %s' % lore(a).replace('Lore', E.LORE_NAME))
        L('DA_EL_lore_cost_tt.%d' % a, 'Pay %s' % lore(a))
        L('DA_EL_mana_cost_tt.%d' % a, 'Pay %s' % mana(a))
    for k in ('metal', 'building', 'essence'):
        o += ['DA_EL_pay_%s = {' % k, '\tcustom_tooltip = DA_EL_%s_cost_tt.$amount$' % k,
              '\thidden_effect = { change_variable = { which = %s value = -$amount$ } }' % MAT[k], '}',
              'DA_EL_add_%s = {' % k, '\tcustom_tooltip = DA_EL_%s_gain_tt.$amount$' % k,
              '\thidden_effect = { change_variable = { which = %s value = $amount$ } }' % MAT[k], '}']
        for a in AMOUNTS:
            L('DA_EL_%s_cost_tt.%d' % (k, a), 'Pay %s' % mat(k, a))
            L('DA_EL_%s_gain_tt.%d' % (k, a), 'Gain %s' % mat(k, a))
    # experience in the mod's schools
    o += ['# Experience in one of the mod\'s schools (Alchemy, Medicine, Arcane Arts)',
          'DA_EL_add_school_exp = {', '\tcustom_tooltip = DA_EL_exp_tt.$school$.$amount$',
          '\thidden_effect = { change_variable = { which = DA_$school$_exp value = $amount$ } }', '}']
    for sc, nm in (('Alchemy', 'Alchemy'), ('Medicine', 'Medicine'), ('Arcane_Arts', 'Arcane Arts')):
        for a in (100, 150, 200, 250):
            L('DA_EL_exp_tt.%s.%d' % (sc, a), 'Gain §Y%d§! experience in the school of §Y%s§!' % (a, nm))
    # the codices
    o += ['', '# The codices (doc 68, section 5.1)']
    for s in S:
        o += ['DA_EL_give_codex.%s = {' % s['id']] + ind(give_codex(s['id'])) + ['}']
        L('DA_EL_codex_gain_tt.%s' % s['id'], 'The codex §Y%s§! is read: the §Y%s§! family of the Elven page opens' % (
            s['codex'], s['name']))
    o += ['# A codex not yet read, at random: only from hidden events (no dice in a button). DA_EL_new_codex.<school> names',
          '# it for the report (DA_EL_GetNewCodex).', 'DA_EL_random_codex = {'] + \
         ['\tclr_country_flag = DA_EL_new_codex.%s' % s['id'] for s in S] + ['\trandom_list = {'] + \
         sum([['\t\t10 = {', '\t\t\tmodifier = { factor = 0 has_country_flag = DA_EL_codex.%s }' % s['id'],
               '\t\t\tDA_EL_give_codex.%s = yes' % s['id'], '\t\t\tset_country_flag = DA_EL_new_codex.%s' % s['id'], '\t\t}'] for s in S], []) + [
          '\t\t1 = {', '\t\t\tmodifier = { factor = 0 NOT = { check_variable = { which = DA_EL_codices value = 9 } } }',
          '\t\t\tDA_EL_add_lore = { amount = 5 }', '\t\t}', '\t}', '}']
    # refresh
    o += ['', '# The counts the window and the tiles read: codices, family progress, arts in practice and their upkeep.',
          'DA_EL_refresh = {', '\tset_variable = { which = DA_EL_codices value = 0 }',
          '\tset_variable = { which = DA_EL_arts_on value = 0 }', '\tset_variable = { which = DA_EL_upkeep value = 0 }']
    for s in S:
        sid = s['id']
        o += ['\tif = { limit = { has_country_flag = DA_EL_codex.%s } change_variable = { which = DA_EL_codices value = 1 } }' % sid,
              '\tset_variable = { which = DA_EL_fam_%s value = 0 }' % sid]
        for n in range(1, len(E.TILES[sid]) + 1):
            o.append('\tif = { limit = { %s } change_variable = { which = DA_EL_fam_%s value = 1 } }' % (done(E.tid(sid, n)), sid))
        o += ['\tif = {', '\t\tlimit = { has_country_flag = DA_EL_art_on.%s }' % sid,
              '\t\tchange_variable = { which = DA_EL_arts_on value = 1 }',
              '\t\tchange_variable = { which = DA_EL_upkeep value = %s }' % fmt(E.ARTS[sid]['upkeep']), '\t}']
    o += ['\tupdate_mana_regen_vars = yes',
          '\texport_to_variable = { which = mages_mana_capacity_val value = modifier:mages_mana_capacity }',
          '\tDA_EL_wyrmbane_sync = yes', '}']
    # DA_EL (doc 72): Wyrmbane in the Legendary Encounters (le_rules.ARMY_BONUS reads the flag)
    o += ['# Wyrmbane (Evocation III) against the dragon legends: the flag le_rules.ARMY_BONUS reads, while the tile is done',
          '# and the Precursor heritage is active. From DA_EL_refresh and DA_EL_sync.',
          'DA_EL_wyrmbane_sync = {', '\tif = {', '\t\tlimit = { %s DA_EL_heritage = yes NOT = { has_country_flag = DA_EL_wyrmbane_on } }' % done('EL_Evo3'),
          '\t\tset_country_flag = DA_EL_wyrmbane_on', '\t}',
          '\tif = {', '\t\tlimit = { has_country_flag = DA_EL_wyrmbane_on NOT = { AND = { %s DA_EL_heritage = yes } } }' % done('EL_Evo3'),
          '\t\tclr_country_flag = DA_EL_wyrmbane_on', '\t}', '}']
    # window
    o += ['', '# The window (elven_archive_ui.py)', 'DA_EL_open_archive = {', '\thidden_effect = { DA_EL_refresh = yes }',
          '\tset_country_flag = DA_EL_archive_on', '}', 'DA_EL_close_archive = {', '\tclr_country_flag = DA_EL_archive_on', '}']
    # levels
    o += ['', '# The Archive\'s levels (doc 68, section 7.3): the Build button of each level']
    for lv in E.LEVELS:
        n = lv['n']
        eff = price_pay(lv['gold'], lv['lore'], building=lv['building'])
        eff += ['custom_tooltip = DA_EL_build_tt.%d' % n, 'hidden_effect = {', '\tset_variable = { which = DA_EL_level value = %d }' % n]
        if n == 1:
            eff += ['\tset_country_flag = DA_EL_built', '\tif = {', '\t\tlimit = { DA_RH_primary_elven = yes }',
                    '\t\tcountry_event = { id = %s.2 }' % EV, '\t}']
        if n == 2:
            eff += ['\tset_country_flag = DA_EL_estate']
        if lv['mod']:
            eff += ['\tDA_RH_grant_elven_level%d = yes' % n]
        if n == 4:
            eff += ['\tdefine_advisor = { type = court_mage skill = 2 cost_multiplier = 0.5 }']
        eff += ['\tDA_EL_refresh = yes', '}']
        if n == 4:
            eff.insert(-1, '')
        o += ['DA_EL_build.%d = {' % n] + ind([x for x in eff if x != '']) + ['}']
        L('DA_EL_build_tt.%d' % n, 'The Remnant Archive reaches level §Y%s§!, §Y%s§!: %s' % (E.ROMAN[n], lv['name'], lv['brings']))
    # works of the Archive page
    fleet = E.FLEET
    o += ['', '# Read the Fleet Logs (elves) and Raise a Dotim Pole (Ruinborn): one codex each time, in order']
    for wid, order in (('logs', fleet), ('poles', E.TOTEMS)):
        o += ['DA_EL_%s = {' % wid, '\tadd_treasury = -%d' % E.WORK['logs']['gold'], '\thidden_effect = { clr_country_flag = DA_EL_given }']
        for sid in order:
            o += ['\tif = {', '\t\tlimit = {', '\t\t\tNOT = { has_country_flag = DA_EL_given }',
                  '\t\t\tNOT = { has_country_flag = DA_EL_codex.%s }' % sid, '\t\t}', '\t\tDA_EL_give_codex.%s = yes' % sid,
                  '\t\thidden_effect = { set_country_flag = DA_EL_given }', '\t}']
        o += ['\thidden_effect = { clr_country_flag = DA_EL_given DA_EL_refresh = yes }', '}']
    o += ['DA_EL_study = {', '\tDA_EL_add_lore = { amount = %d }' % E.WORK['study']['gain'],
          '\thidden_effect = { clr_country_flag = DA_EL_cd.study set_country_flag = DA_EL_cd.study }', '}']
    # research pushes
    o += ['', '# The running research advances: by a share of its target, or of what remains',
          'DA_EL_research_percent = {', '\tset_variable = { which = DA_research_progress_percent which = DA_research_progress }',
          '\tdivide_variable = { which = DA_research_progress_percent which = DA_research_progress_MAX }',
          '\tmultiply_variable = { which = DA_research_progress_percent value = 100 }', '}',
          'DA_EL_push_target = {', '\tset_variable = { which = DA_EL_dp which = DA_research_progress_MAX }',
          '\tmultiply_variable = { which = DA_EL_dp value = $pct$ }',
          '\tchange_variable = { which = DA_research_progress which = DA_EL_dp }', '\tDA_EL_research_percent = yes', '}',
          'DA_EL_push_remaining = {', '\tset_variable = { which = DA_EL_dp which = DA_research_progress_MAX }',
          '\tsubtract_variable = { which = DA_EL_dp which = DA_research_progress }',
          '\tmultiply_variable = { which = DA_EL_dp value = $pct$ }',
          '\tchange_variable = { which = DA_research_progress which = DA_EL_dp }', '\tDA_EL_research_percent = yes', '}']
    o += ['# Recollection: 5 Lore, the running Elven research advances by 25% of what remains, once per tile',
          'DA_EL_recollect = {', '\tDA_EL_pay_lore = { amount = %d }' % E.WORK['recollect']['lore'],
          '\tcustom_tooltip = DA_EL_recollect_eff_tt', '\thidden_effect = {']
    for t in E.TILE_IDS:
        o += ['\t\tif = {', '\t\t\tlimit = {', '\t\t\t\thas_country_flag = DA_research_flag.PR_%s' % t,
              '\t\t\t\tNOT = { has_country_flag = DA_EL_rec.%s }' % t, '\t\t\t}', '\t\t\tset_country_flag = DA_EL_rec.%s' % t,
              '\t\t\tDA_EL_push_remaining = { pct = 0.25 }', '\t\t}']
    o += ['\t}', '}']
    L('DA_EL_recollect_eff_tt', 'The running research of the §YElven§! page advances by §G25%§! of what remains')
    o += ['DA_EL_vigil = {', '\tadd_treasury = -%d' % E.WORK['vigil']['gold'], '\tDA_EL_pay_lore = { amount = %d }' % E.WORK['vigil']['lore'],
          '\tadd_stability = 1', '\tadd_prestige = 10', '\thidden_effect = { clr_country_flag = DA_EL_cd.vigil set_country_flag = DA_EL_cd.vigil }', '}']
    o += ['DA_EL_commune = {', '\tadd_treasury = -%d' % E.WORK['commune']['gold'], '\tif = {',
          '\t\tlimit = { NOT = { DA_EL_is_ruinborn = yes } }', '\t\tDA_EL_pay_lore = { amount = %d }' % E.WORK['commune']['lore'], '\t}',
          '\tcustom_tooltip = DA_EL_commune_eff_tt',
          '\thidden_effect = { clr_country_flag = DA_EL_cd.commune set_country_flag = DA_EL_cd.commune country_event = { id = %s.3 } }' % EV,
          '}']
    L('DA_EL_commune_eff_tt', 'An echo answers: the running research advances by §G15%%§! of its target, or %s' % lore(10))
    o += ['DA_EL_tithe_on = {', '\tadd_country_modifier = { name = DA_EL_tithe duration = -1 }',
          '\thidden_effect = { set_country_flag = DA_EL_tithe update_mana_regen_vars = yes }', '}',
          'DA_EL_tithe_off = {', '\tremove_country_modifier = DA_EL_tithe',
          '\thidden_effect = { clr_country_flag = DA_EL_tithe update_mana_regen_vars = yes }', '}']
    # arts
    o += ['', '# The arts (doc 68, section 8): privileges of the Archaeomancers, granted and revoked only here']
    o += ['DA_EL_art_granted = {', '\thidden_effect = {', '\t\tset_country_flag = DA_EL_art_on.$s$', '\t\tDA_EL_refresh = yes', '\t}', '}',
          'DA_EL_art_removed = {', '\thidden_effect = {', '\t\tif = {', '\t\t\tlimit = { has_country_flag = DA_EL_art_on.$s$ }',
          '\t\t\tclr_country_flag = DA_EL_aside.$s$', '\t\t\tset_country_flag = DA_EL_aside.$s$', '\t\t}',
          '\t\tclr_country_flag = DA_EL_art_on.$s$', '\t\tDA_EL_refresh = yes', '\t}', '}']
    for s in S:
        sid = s['id']
        a = E.ARTS[sid]
        up = a['up']
        o += ['DA_EL_practise.%s = {' % sid, '\tcustom_tooltip = DA_EL_practise_eff_tt.%s' % sid,
              '\thidden_effect = { set_estate_privilege = DA_EL_art_%s }' % sid, '}',
              'DA_EL_set_aside.%s = {' % sid, '\tcustom_tooltip = DA_EL_aside_eff_tt.%s' % sid,
              '\thidden_effect = { remove_estate_privilege = DA_EL_art_%s }' % sid, '}',
              'DA_EL_upgrade.%s = {' % sid, '\tDA_EL_pay_lore = { amount = %d }' % up[2],
              '\tDA_EL_pay_essence = { amount = %d }' % up[3], '\tcustom_tooltip = DA_EL_upgrade_eff_tt.%s' % sid,
              '\thidden_effect = { set_country_flag = DA_EL_up.%s DA_EL_refresh = yes }' % sid, '}']
        L('DA_EL_practise_eff_tt.%s' % sid, 'The Archaeomancers put §Y%s§! into practice: %s, §R-%s§! Monthly Mana' % (
            a['name'], ', '.join(E.mod_lines(a['mod'])), fmt(a['upkeep'])))
        L('DA_EL_aside_eff_tt.%s' % sid, '§Y%s§! is set aside: its upkeep of §M%s§! mana a month comes back. It can be '
          'practised again in a year.' % (a['name'], fmt(a['upkeep'])))
        L('DA_EL_upgrade_eff_tt.%s' % sid, '§Y%s§!: %s while §Y%s§! is in practice' % (up[0], ', '.join(E.mod_lines(up[1])), a['name']))
    # shortfall
    o += ['# The yearly pass: while the month\'s mana is below 0, the dearest arts are set aside (doc 68, section 8.2, rule 5)',
          'DA_EL_shortfall = {', '\tupdate_mana_regen_vars = yes', '\tif = {',
          '\t\tlimit = { NOT = { check_variable = { which = mages_mana_regen_val value = 0 } } }',
          '\t\tset_variable = { which = DA_EL_m which = mages_mana_regen_val }']
    for sid in E.SHORTFALL_ORDER:
        o += ['\t\tif = {', '\t\t\tlimit = {', '\t\t\t\tNOT = { check_variable = { which = DA_EL_m value = 0 } }',
              '\t\t\t\thas_country_flag = DA_EL_art_on.%s' % sid, '\t\t\t}', '\t\t\tremove_estate_privilege = DA_EL_art_%s' % sid,
              '\t\t\tchange_variable = { which = DA_EL_m value = %s }' % fmt(E.ARTS[sid]['upkeep']),
              '\t\t\tset_country_flag = DA_EL_short.%s' % sid, '\t\t}']
    o += ['\t\tcountry_event = { id = %s.5 }' % EV, '\t}', '}']
    # school works
    o += ['', '# The school works (doc 68, section 7.4)']
    w = E.WORK['wardstone']
    o += ['DA_EL_raise_wardstone = {'] + ind(price_pay(w['gold'], w['lore'], building=w['building'])) + [
          '\tcustom_tooltip = DA_EL_wardstone_eff_tt', '\thidden_effect = { country_event = { id = %s.6 } }' % EV, '}']
    L('DA_EL_wardstone_eff_tt', 'A wardstone is raised in §Y12§! months, in a fortified province of ours (a border fort '
      'first): %s' % ', '.join(E.mod_lines(w['pmod'])))
    w = E.WORK['spire']
    o += ['DA_EL_raise_spire = {'] + ind(price_pay(w['gold'], w['lore'], building=w['building'])) + [
          '\tcustom_tooltip = DA_EL_spire_eff_tt', '\thidden_effect = { country_event = { id = %s.7 } }' % EV, '}']
    L('DA_EL_spire_eff_tt', 'A monolith spire is raised in §Y12§! months, in our most developed province without one: %s' %
      ', '.join(E.mod_lines(w['pmod'])))
    o += ['DA_EL_prophecy = {', '\tcustom_tooltip = DA_EL_prophecy_eff_tt',
          '\thidden_effect = { clr_country_flag = DA_EL_cd.prophecy set_country_flag = DA_EL_cd.prophecy country_event = { id = %s.4 } }' % EV,
          '}']
    L('DA_EL_prophecy_eff_tt', 'The star-observatory reads the next ten years: one of three prophecies, chosen')
    w = E.WORK['captain']
    o += ['DA_EL_captain = {'] + ind(price_pay(w['gold'], w['lore'], metal=w['metal'], mil=w['mil'])) + [
          '\tcreate_general = { tradition = 80 add_fire = 1 add_shock = 1 }',
          '\thidden_effect = { clr_country_flag = DA_EL_cd.captain set_country_flag = DA_EL_cd.captain }', '}']
    w = E.WORK['veil']
    o += ['DA_EL_veil = {', '\tDA_EL_pay_mana = { amount = %d }' % w['mana'],
          '\tadd_country_modifier = { name = DA_EL_veil duration = 730 }', '\thidden_effect = { set_country_flag = DA_EL_veil_war }', '}']
    w = E.WORK['sleeper']
    o += ['DA_EL_wake = {'] + ind(price_pay(w['gold'], w['lore'], metal=w['metal'])) + [
          '\tcustom_tooltip = DA_EL_wake_eff_tt',
          '\thidden_effect = { change_variable = { which = DA_EL_sleepers value = -1 } country_event = { id = %s.13 } }' % EV, '}']
    L('DA_EL_wake_eff_tt', 'A Sleeper is woken: a court mage of skill §Y3§! at half pay, or a general of the Precursor '
      'legions (the Ruinborn: the general)')
    # marvels
    o += ['', '# The marvels (doc 68, section 9): a tier in the ruin\'s province (DA_EL_mv), raised from the Marvels page']
    for m in E.MARVELS:
        for t in (1, 2, 3):
            p = E.MARVEL_PRICE[t]
            o += ['DA_EL_raise.%s.%d = {' % (m['id'], t)] + ind(price_pay(p['gold'], p['lore'], building=p['building'])) + [
                  '\tif = {', '\t\tlimit = { ai = no }', '\t\tDA_EL_pay_mana = { amount = %d }' % p['mana'], '\t}',
                  '\tcustom_tooltip = DA_EL_raise_eff_tt.%s.%d' % (m['id'], t), '\thidden_effect = {',
                  '\t\t%d = {' % m['prov'], '\t\t\tset_province_flag = DA_EL_mv_raising',
                  '\t\t\tadd_province_modifier = { name = DA_EL_mv_timer duration = %d hidden = yes }' % (p['months'] * 30),
                  '\t\t}', '\t\tset_country_flag = DA_EL_raising', '\t}', '}']
            L('DA_EL_raise_eff_tt.%s.%d' % (m['id'], t), '§Y%s§! rises to tier §Y%s§! in §Y%d§! months: %s' % (
                m['name'], E.ROMAN[t], p['months'], m['tiers'][t - 1]))
    # monthly and yearly
    o += ['', '# Monthly: the works and marvels being raised (DA_EL_raising)', 'DA_EL_monthly = {', '\tif = {',
          '\t\tlimit = { has_country_flag = DA_EL_raising }', '\t\tclr_country_flag = DA_EL_raising', '\t\tevery_owned_province = {',
          '\t\t\tlimit = { OR = { has_province_flag = DA_EL_mv_raising has_province_flag = DA_EL_ws_raising '
          'has_province_flag = DA_EL_sp_raising } }', '\t\t\towner = { set_country_flag = DA_EL_raising }', '\t\t}']
    for m in E.MARVELS:
        o += ['\t\tif = {', '\t\t\tlimit = { %d = { owned_by = ROOT has_province_flag = DA_EL_mv_raising '
              'NOT = { has_province_modifier = DA_EL_mv_timer } } }' % m['prov'],
              '\t\t\t%d = { province_event = { id = %s.%d } }' % (m['prov'], EV, 80 + m['n']), '\t\t}']
    o += ['\t\tevery_owned_province = {', '\t\t\tlimit = { has_province_flag = DA_EL_ws_raising NOT = { has_province_modifier = DA_EL_works_timer } }',
          '\t\t\tclr_province_flag = DA_EL_ws_raising', '\t\t\tset_province_flag = DA_EL_ws',
          '\t\t\tadd_permanent_province_modifier = { name = DA_EL_wardstone duration = -1 }', '\t\t}',
          '\t\tevery_owned_province = {', '\t\t\tlimit = { has_province_flag = DA_EL_sp_raising NOT = { has_province_modifier = DA_EL_works_timer } }',
          '\t\t\tclr_province_flag = DA_EL_sp_raising', '\t\t\tset_province_flag = DA_EL_sp',
          '\t\t\tadd_permanent_province_modifier = { name = DA_EL_spire duration = -1 }', '\t\t}', '\t}', '}']
    gardens, stacks, lab = (next(m for m in E.MARVELS if m['id'] == k)['prov'] for k in ('gardens', 'stacks', 'lab'))
    o += ['# Yearly, for a country of the heritage with the Archive built', 'DA_EL_yearly = {', '\tDA_EL_refresh = yes',
          '\tif = {', '\t\tlimit = { ai = no has_country_flag = DA_EL_estate }', '\t\tDA_EL_shortfall = yes', '\t}',
          '\tif = {', '\t\tlimit = { %s }' % done('EL_Nec2'), '\t\tDA_EL_add_lore = { amount = 1 }', '\t}',
          '\tif = {', '\t\tlimit = { %d = { owned_by = ROOT check_variable = { which = DA_EL_mv value = 1 } } }' % stacks,
          '\t\tDA_EL_add_lore = { amount = 2 }', '\t\tif = {', '\t\t\tlimit = { has_country_flag = DA_EL_ruled.stacks_keep }',
          '\t\t\tDA_EL_add_lore = { amount = 1 }', '\t\t}', '\t}',
          '\tif = {', '\t\tlimit = {', '\t\t\t%d = { owned_by = ROOT check_variable = { which = DA_EL_mv value = 1 } }' % lab,
          '\t\t\tOR = { NOT = { has_country_flag = DA_EL_lab_cd } had_country_flag = { flag = DA_EL_lab_cd days = 1825 } }',
          '\t\t}', '\t\tclr_country_flag = DA_EL_lab_cd', '\t\tset_country_flag = DA_EL_lab_cd',
          '\t\tDA_EL_add_school_exp = { school = Alchemy amount = 200 }',
          '\t\tif = {', '\t\t\tlimit = { %d = { check_variable = { which = DA_EL_mv value = 2 } } }' % lab,
          '\t\t\tDA_EL_add_essence = { amount = 10 }', '\t\t}',
          '\t\tif = {', '\t\t\tlimit = { %d = { check_variable = { which = DA_EL_mv value = 3 } } }' % lab,
          '\t\t\tDA_EL_add_school_exp = { school = Medicine amount = 200 }', '\t\t}',
          '\t\tif = {', '\t\t\tlimit = { has_country_flag = DA_EL_ruled.lab_grow }', '\t\t\tDA_EL_add_essence = { amount = 10 }', '\t\t}',
          '\t}',
          '\tif = {', '\t\tlimit = { has_country_flag = DA_EL_veil_war NOT = { is_at_war = yes } }',
          '\t\tclr_country_flag = DA_EL_veil_war', '\t}', '}']
    # sync (the heritage turns dormant or active again)
    o += ['# The heritage turns dormant: every art is set aside (their privileges are no longer valid). Racial pulse hook.',
          'DA_EL_sync = {', '\tif = {', '\t\tlimit = { NOT = { DA_EL_heritage = yes } }']
    for s in S:
        o += ['\t\tif = {', '\t\t\tlimit = { has_country_flag = DA_EL_art_on.%s }' % s['id'],
              '\t\t\tremove_estate_privilege = DA_EL_art_%s' % s['id'], '\t\t}']
    o += ['\t}', '\tDA_EL_wyrmbane_sync = yes\t# DA_EL: Wyrmbane in the Legendary Encounters (doc 72)', '}']
    # the AI
    o += ['', '# The AI (doc 68, section 14): its codices once, then the next tile of the Elven page (from DA_RH_ai_pulse)',
          'DA_EL_ai_init = {', '\tset_country_flag = DA_EL_ai_init', '\tif = {', '\t\tlimit = { DA_EL_is_ruinborn = yes }'] + \
         ['\t\tset_country_flag = DA_EL_codex.%s' % sid for sid in E.TOTEMS] + ['\t}', '\tif = {',
          '\t\tlimit = { NOT = { DA_EL_is_ruinborn = yes } }'] + ['\t\tset_country_flag = DA_EL_codex.%s' % sid for sid in E.FLEET]
    by_codex = {}
    for cul, sid in E.HERITAGE_CODEX.items():
        by_codex.setdefault(sid, []).append(cul)
    for sid, cults in by_codex.items():
        o += ['\t\tif = {', '\t\t\tlimit = { OR = { %s } }' % ' '.join('primary_culture = %s' % c for c in cults),
              '\t\t\tset_country_flag = DA_EL_codex.%s' % sid, '\t\t}']
    fixed = sorted(E.HERITAGE_CODEX)
    o += ['\t\tif = {', '\t\t\tlimit = { NOT = { OR = { %s } } }' % ' '.join('primary_culture = %s' % c for c in fixed),
          '\t\t\tset_country_flag = DA_EL_codex.%s' % E.AI_CHOICE, '\t\t}', '\t}', '\tDA_EL_refresh = yes', '}']
    o += ['DA_EL_ai_act = {', '\tif = {', '\t\tlimit = { NOT = { has_country_flag = DA_EL_ai_init } }', '\t\tDA_EL_ai_init = yes', '\t}']
    for nid in E.TILE_IDS:
        d = E.NODES[nid]
        lines = ['DA_start_research = {', '\tflag = PR_%s' % nid, '\ttime = %d' % d['time'], '\t%s = yes' % d['era']]
        if d.get('unstoppable'):
            lines.append('\tunstoppable = yes')
        lines.append('}')
        o += ['\tif = {', '\t\tlimit = {', '\t\t\tDA_available_research = yes', '\t\t\tNOT = { %s }' % done(nid)] + \
             ['\t\t\t' + r for r in d['req']] + ['\t\t}'] + ind(lines, 2) + ['\t}']
    o += ['}']
    return '\n'.join(o) + '\n'


# ---------------------------------------------------------------------------
# Modifiers
# ---------------------------------------------------------------------------
def modblock(name, mod, extra=()):
    return [name + ' = {'] + ['\t%s = %s' % (k, fmt(v)) for k, v in mod.items()] + ['\t' + x for x in extra] + ['}']


def gen_modifiers():
    o = [HEAD, '# The Archive\'s levels: living bonuses of the Precursor heritage (racial_heritage_data.LIVING)']
    for lv in E.LEVELS:
        if lv['mod']:
            o += modblock('DA_EL_level.%d' % lv['n'], lv['mod'])
            L('DA_EL_level.%d' % lv['n'], 'Remnant Archive: %s' % lv['name'])
    o += ['# The Ley Tithe'] + modblock('DA_EL_tithe', E.WORK['tithe']['mod'])
    L('DA_EL_tithe', 'The Ley Tithe')
    L('DA_EL_tithe_desc', 'The Archaeomancers draw on the ley lines under our workshops. The mana is welcome; the workshops '
      'run cold.')
    o += ['# Province works'] + modblock('DA_EL_wardstone', E.WORK['wardstone']['pmod']) + \
        modblock('DA_EL_spire', E.WORK['spire']['pmod']) + ['DA_EL_works_timer = {', '}', 'DA_EL_mv_timer = {', '}']
    L('DA_EL_wardstone', 'Wardstone')
    L('DA_EL_wardstone_desc', 'A standing stone cut with Precursor wards and fed from the ley.')
    L('DA_EL_spire', 'Monolith Spire')
    L('DA_EL_spire_desc', 'A spire of living stone, grown rather than built, the tallest thing for leagues.')
    L('DA_EL_works_timer', 'Precursor Works under Way')
    L('DA_EL_works_timer_desc', 'The Archaeomancers are at work here.')
    L('DA_EL_mv_timer', 'A Marvel Rising')
    L('DA_EL_mv_timer_desc', 'The Archaeomancers are waking a marvel of the Precursors here.')
    o += ['# Raise the Veil (Illusion IV): two years'] + modblock('DA_EL_veil', {'hostile_attrition': 2, 'defensiveness': 0.10})
    L('DA_EL_veil', 'The Verdant Veil')
    L('DA_EL_veil_desc', 'Our lands are hidden behind the oldest Glamours: roads that lead nowhere, fords that are not there.')
    o += ['# Prophecy (Divination IV): ten years']
    for pid, name, mod in E.PROPHECIES:
        o += modblock('DA_EL_prophecy.%s' % pid, mod)
        L('DA_EL_prophecy.%s' % pid, 'Prophecy: %s' % name)
    o += ['# The marvels: the province\'s modifiers by tier (they stay with the province)']
    for m in E.MARVELS:
        for t, mod in sorted(m['p'].items()):
            o += modblock('DA_EL_mvp.%s.%d' % (m['id'], t), mod)
            L('DA_EL_mvp.%s.%d' % (m['id'], t), '%s, tier %s' % (m['name'], E.ROMAN[t]))
    o += modblock('DA_EL_mvp.gardens.keep', {'local_development_cost': -0.10})
    L('DA_EL_mvp.gardens.keep', 'The Seed-Bank of the Spire Gardens')
    o += modblock('DA_EL_seedbank', {'local_development_cost': -0.05})
    L('DA_EL_seedbank', 'Seeds from the Spire Gardens')
    o += ['# The rulings (25 years)']
    rul = {'docks_launch': {'naval_morale': 0.10}, 'tower_trade': {'trade_efficiency': 0.10},
           'tower_route': {'trade_steering': 0.05}, 'stacks_publish': {'global_institution_spread': 0.10}}
    for k, mod in rul.items():
        o += modblock('DA_EL_ruling.%s' % k, mod)
    L('DA_EL_ruling.docks_launch', 'The Last Ship')
    L('DA_EL_ruling.tower_trade', 'The Vanetavanem\'s Trade')
    L('DA_EL_ruling.tower_route', 'Tacenie\'s Old Route')
    L('DA_EL_ruling.stacks_publish', 'The Deep Stacks Published')
    o += ['# The Elemental Wells\' elements (triggered modifiers below give them)']
    o += ['# Ruins: what a lost work or a find leaves (build_ruin_excavation.py writes its own; these are the Archive\'s)']
    # DA_EL (doc 72): the legends of the ruins
    o += ['# The Warden of Soara guards the city (its parley, DA_EL_event.120)'] + \
        modblock('DA_EL_warden_guard', {'local_defensiveness': 0.33, 'local_hostile_attrition': 1, 'local_unrest': -1})
    L('DA_EL_warden_guard', 'The Warden Keeps the City')
    L('DA_EL_warden_guard_desc', 'A guardian of white stone and gold stands at the gate, as it stood before the Fleet sailed.')
    o += ['# The Challúmaton Dragon destroyed (DA_EL_event.122): 25 years'] + \
        modblock('DA_EL_challumaton_bones', {'mages_mana_capacity': 50, 'land_morale': 0.05})
    L('DA_EL_challumaton_bones', 'The Bones of the Challúmaton')
    L('DA_EL_challumaton_bones_desc', 'The bone-white frame of the Slaver-Nobles\' masterwork, empty at last, lies in our '
      'arsenals. The mages study it and the soldiers walk past it on their way to drill.')
    return '\n'.join(o) + '\n'


def gen_triggered_modifiers():
    o = [HEAD, '# The marvels\' country effects: while the province is ours and the heritage active (living bonuses)']
    for m in E.MARVELS:
        for t, mod in sorted(m['c'].items()):
            name = 'DA_EL_mvc_%s_%d' % (m['id'], t)
            cond = ['%d = { owned_by = ROOT check_variable = { which = DA_EL_mv value = %d } }' % (m['prov'], t), E.HERITAGE]
            o += [name + ' = {', '\tpotential = {', '\t\t%s' % cond[0], '\t}', '\ttrigger = {'] + ['\t\t' + c for c in cond] + \
                 ['\t}'] + ['\t%s = %s' % (k, fmt(v)) for k, v in mod.items()] + ['}']
            L(name, '%s, tier %s' % (m['name'], E.ROMAN[t]))
    wells = next(m for m in E.MARVELS if m['id'] == 'wells')['prov']
    for eid, ename, mod in E.ELEMENTS:
        cond = ['%d = { owned_by = ROOT check_variable = { which = DA_EL_mv value = 2 } }' % wells, E.HERITAGE,
                'has_country_flag = DA_EL_wells_el.%s' % eid]
        o += ['DA_EL_wells_%s = {' % eid, '\tpotential = {', '\t\thas_country_flag = DA_EL_wells_el.%s' % eid, '\t}',
              '\ttrigger = {'] + ['\t\t' + c for c in cond] + ['\t}'] + ['\t%s = %s' % (k, fmt(v)) for k, v in mod.items()] + ['}']
        L('DA_EL_wells_%s' % eid, 'The Elemental Wells: %s' % ename)
        o += ['DA_EL_wells_%s_open = {' % eid, '\tpotential = {', '\t\thas_country_flag = DA_EL_wells_el.%s' % eid,
              '\t\thas_country_flag = DA_EL_ruled.wells_open', '\t}', '\ttrigger = {'] + ['\t\t' + c for c in cond] + \
             ['\t\thas_country_flag = DA_EL_ruled.wells_open', '\t}'] + ['\t%s = %s' % (k, fmt(v / 2.0)) for k, v in mod.items()] + ['}']
        L('DA_EL_wells_%s_open' % eid, 'The Elemental Wells Opened: %s' % ename)
    o += ['# Wyrmbane (Evocation III): at war with a kobold or Dragon Cult country', 'DA_EL_wyrmbane = {', '\tpotential = {',
          '\t\t%s' % done('EL_Evo3'), '\t}', '\ttrigger = {', '\t\t%s' % E.HERITAGE, '\t\tany_country = {',
          '\t\t\twar_with = ROOT', '\t\t\tOR = {', '\t\t\t\tDA_RH_primary_kobold = yes', '\t\t\t\treligion = kobold_dragon_cult',
          '\t\t\t}', '\t\t}', '\t}', '\tland_morale = 0.1', '\tdiscipline = 0.05', '}']
    L('DA_EL_wyrmbane', 'Wyrmbane')
    L('DA_EL_wyrmbane_desc', 'Every song of the Dragonguard ends with a dragon falling.')
    return '\n'.join(o) + '\n'


def gen_opinion_modifiers():
    o = [HEAD, 'DA_EL_concord = {', '\topinion = 50', '\tyearly_decay = 2', '}',
         'DA_EL_guided = {', '\topinion = 25', '\tyearly_decay = 1', '}',
         'DA_EL_gifts = {', '\topinion = 25', '\tyearly_decay = 1', '}']
    L('DA_EL_concord', 'Concord of the Remnant')
    L('DA_EL_guided', 'Guided Our Elves')
    L('DA_EL_gifts', 'Gifts from the Ruins')
    return '\n'.join(o) + '\n'


# ---------------------------------------------------------------------------
# The Archaeomancers and the arts (estate, privileges, preload)
# ---------------------------------------------------------------------------
def gen_estate():
    o = [HEAD, '# The Archaeomancers (doc 68, section 8.4): elven scholar-mages who excavate the ruins and practise the magic',
         '# they recover. The estate of a country of the Precursor heritage with the Archive at level II; its privileges',
         '# are the nine arts (DA_EL_arts.txt), granted and revoked only in the Remnant Archive.',
         '%s = {' % E.EST, '\ticon = 11', '', '\ttrigger = {', '\t\thas_country_flag = DA_EL_estate', '\t\t%s' % E.HERITAGE, '\t}', '',
         '\tcountry_modifier_happy = {', '\t\ttechnology_cost = -0.05', '\t\tmages_monthly_experience = 1', '\t}',
         '\tcountry_modifier_neutral = {', '\t\ttechnology_cost = -0.025', '\t}',
         '\tcountry_modifier_angry = {', '\t\ttechnology_cost = 0.05', '\t\tmages_mana_regen = -0.25', '\t}',
         '\tland_ownership_modifier = {', '\t\tDA_Archaeomancers_loyalty_modifier = 0.2', '\t}', '',
         '\tprovince_independence_weight = {', '\t\tfactor = 1', '\t\tmodifier = {', '\t\t\tfactor = 1.5', '\t\t\thas_building = university',
         '\t\t}', '\t}', '', '\tbase_influence = 10', '\tinfluence_modifier = {', '\t\tdesc = DA_EL_EST_BUSY', '\t\ttrigger = {',
         '\t\t\tcheck_variable = { which = DA_EL_arts_on value = 5 }', '\t\t}', '\t\tinfluence = 10', '\t}',
         '\tloyalty_modifier = {', '\t\tdesc = DA_EL_EST_UNIS', '\t\ttrigger = {',
         '\t\t\tnum_of_owned_provinces_with = { value = 3 has_building = university }', '\t\t}', '\t\tloyalty = 5', '\t}',
         '\tloyalty_modifier = {', '\t\tdesc = DA_EL_EST_RING6', '\t\ttrigger = {', '\t\t\thas_country_flag = DA_EL_great6',
         '\t\t}', '\t\tloyalty = 5', '\t}',
         '\tloyalty_modifier = {', '\t\tdesc = DA_EL_EST_TITHE', '\t\ttrigger = {', '\t\t\thas_country_flag = DA_EL_tithe', '\t\t}',
         '\t\tloyalty = -5', '\t}', '', '\tcolor = { 72 196 186 }', '', '\tprivileges = {'] + \
        ['\t\tDA_EL_art_%s' % s['id'] for s in S] + ['\t}', '\tagendas = { }', '\tinfluence_from_dev_modifier = 0.5', '}']
    L(E.EST, E.EST_NAME)
    L(E.EST + '_desc', 'Elven scholar-mages who excavate the Precursor ruins and practise again the magic they recover '
      'there: archaeologists, researchers and practitioners of the old arts in one order. They keep the Fleet\'s records.')
    L('DA_EL_EST_BUSY', 'Five arts or more in practice')
    L('DA_EL_EST_UNIS', 'Three universities or more')
    L('DA_EL_EST_RING6', 'A great ruin unsealed to its Ley Heart')
    L('DA_EL_EST_TITHE', 'The Ley Tithe')
    return '\n'.join(o) + '\n'


def gen_preload():
    o = [HEAD, '# The modifiers of the Archaeomancers (DA_EL_archaeomancers.txt).', '%s = {' % E.EST]
    for typ, key in (('loyalty', 'DA_Archaeomancers_loyalty_modifier'), ('influence', 'DA_Archaeomancers_influence_modifier'),
                     ('privileges', 'DA_Archaeomancers_privilege_slots')):
        o += ['\tmodifier_definition = {', '\t\ttype = %s' % typ, '\t\tkey = %s' % key, '\t\ttrigger = {',
              '\t\t\thas_estate = %s' % E.EST, '\t\t}', '\t}']
    o.append('}')
    L('DA_Archaeomancers_loyalty_modifier', 'Archaeomancers Loyalty Equilibrium')
    L('DA_Archaeomancers_influence_modifier', 'Archaeomancers Influence')
    L('DA_Archaeomancers_privilege_slots', 'Archaeomancers Privilege Slots')
    return '\n'.join(o) + '\n'


def gen_privileges():
    o = [HEAD, '# The nine arts (doc 68, section 8.2): privileges of the Archaeomancers, put into practice and set aside in the',
         '# Remnant Archive (a player cannot pick them here; the AI never practises them). Each gives its privilege slot back.',
         '# The upkeep is a penalty: Anbennar\'s mages_mana_regen.', '']
    for s in S:
        sid = s['id']
        a = E.ARTS[sid]
        up = a['up']
        o += ['DA_EL_art_%s = {' % sid, '\ticon = %s' % a['icon'], '\tmax_absolutism = 0', '\tloyalty = 0', '\tinfluence = 0',
              '\tis_valid = {', '\t\t%s' % E.HERITAGE, '\t\t%s' % done(E.tid(sid, 1)), '\t}',
              '\tcan_select = {', '\t\tcustom_trigger_tooltip = {', '\t\t\ttooltip = DA_EL_in_archive_tt', '\t\t\talways = no', '\t\t}', '\t}',
              '\tcan_revoke = {', '\t\tcustom_trigger_tooltip = {', '\t\t\ttooltip = DA_EL_in_archive_tt', '\t\t\talways = no', '\t\t}', '\t}',
              '\ton_granted = {', '\t\tDA_EL_art_granted = { s = %s }' % sid, '\t}',
              '\ton_revoked = {', '\t\tDA_EL_art_removed = { s = %s }' % sid, '\t}',
              '\ton_invalid = {', '\t\tDA_EL_art_removed = { s = %s }' % sid, '\t}',
              '\tpenalties = {', '\t\tmages_mana_regen = -%s' % fmt(a['upkeep']), '\t}',
              '\tbenefits = {'] + ['\t\t%s = %s' % (k, fmt(v)) for k, v in a['mod'].items()] + \
             ['\t\tDA_Archaeomancers_privilege_slots = 1', '\t}',
              '\tconditional_modifier = {', '\t\ttrigger = { has_country_flag = DA_EL_up.%s }' % sid, '\t\tmodifier = {'] + \
             ['\t\t\t%s = %s' % (k, fmt(v)) for k, v in up[1].items()] + ['\t\t}', '\t}', '\tai_will_do = {', '\t\tfactor = 0', '\t}', '}', '']
        L('DA_EL_art_%s' % sid, a['name'])
        L('DA_EL_art_%s_desc' % sid, '%s Upgrade: §Y%s§! (%s).' % (E.ART_DESC[sid], up[0], ', '.join(E.mod_lines(up[1]))))
    L('DA_EL_in_archive_tt', 'An art is put into practice or set aside in the §YRemnant Archive§!')
    return '\n'.join(o) + '\n'


# ---------------------------------------------------------------------------
# Events
# ---------------------------------------------------------------------------
def ev(id_, title, desc, options, pic='ELVEN_CONSTELLATION_eventPicture', hidden=False, immediate=None, province=False):
    kind = 'province_event' if province else 'country_event'
    o = ['%s = {' % kind, '\tid = %s.%s' % (EV, id_)]
    if hidden:
        o += ['\thidden = yes', '\tis_triggered_only = yes']
    else:
        o += ['\ttitle = %s.%s.t' % (EV, id_), '\tdesc = %s.%s.d' % (EV, id_), '\tpicture = %s' % pic, '\tis_triggered_only = yes']
        L('%s.%s.t' % (EV, id_), title)
        L('%s.%s.d' % (EV, id_), desc)
    if immediate:
        o += ['\timmediate = {'] + ind(immediate, 2) + ['\t}']
    for k, (name, trig, eff) in enumerate(options):
        key = '%s.%s.o%d' % (EV, id_, k + 1)
        o += ['\toption = {', '\t\tname = %s' % key]
        if trig:
            o += ['\t\ttrigger = {'] + ind(trig, 3) + ['\t\t}']
        o += ind(eff, 2) + ['\t}']
        if name is not None:
            L(key, name)
    if hidden and not options:
        o.append('\toption = { name = DA_EL_hidden_ok }')
        L('DA_EL_hidden_ok', 'OK')
    o.append('}')
    return o


def gen_events():
    o = [HEAD, 'namespace = %s' % EV, '']
    # .2 the heritage codex
    by_codex = {}
    for cul, sid in E.HERITAGE_CODEX.items():
        by_codex.setdefault(sid, []).append(cul)
    opts = []
    for sid, cults in by_codex.items():
        opts.append(('Read %s.' % E.SCHOOL[sid]['codex'], ['OR = { %s }' % ' '.join('primary_culture = %s' % c for c in cults)],
                     ['DA_EL_give_codex.%s = yes' % sid, 'hidden_effect = { set_country_flag = DA_EL_heritage_codex DA_EL_refresh = yes }']))
    fixed = sorted(E.HERITAGE_CODEX)
    for sid in E.CHOICE:
        opts.append(('%s: %s.' % (E.SCHOOL[sid]['name'], E.SCHOOL[sid]['codex']),
                     ['NOT = { OR = { %s } }' % ' '.join('primary_culture = %s' % c for c in fixed)],
                     ['DA_EL_give_codex.%s = yes' % sid, 'hidden_effect = { set_country_flag = DA_EL_heritage_codex DA_EL_refresh = yes }']))
    o += ev(2, 'Our Own Codex', 'Every elven people kept something back when the Fleet landed: a codex of its own, written by '
            'its own scholars and copied by its own scribes. The sun elves keep the Dragonguard\'s; the wood elves the '
            'Glamours of the Deepwoods; the dawn, horizon and sea elves the Living Stone of Aelantir.\n\nThe moon, star '
            'and eclipse elves kept the Fleet\'s own logs and little else. Their archivists must choose which old school '
            'to rebuild first.', opts, pic='MAGIC_STUDY_AND_RELAX_eventPicture')
    # .3 commune with an echo
    o += ev(3, 'An Echo Answers', 'In the Echo Chamber the archaeomancers call up what a Precursor scholar left behind. '
            'Tonight it answers. It will answer one question, and it will not answer it twice.',
            [('Ask about our research.', ['DA_EL_researching_tt = yes'],
              ['custom_tooltip = DA_EL_push15_tt', 'hidden_effect = { DA_EL_push_target = { pct = 0.15 } }']),
             ('Ask about the ruins.', [], ['DA_EL_add_lore = { amount = 10 }'])], pic='ELVEN_EYE_eventPicture')
    L('DA_EL_push15_tt', 'The running research of the §YElven§! page advances by §G15%§! of its target')
    # .4 prophecy
    opts = [(name + '.', [], ['add_country_modifier = { name = DA_EL_prophecy.%s duration = 3650 }' % pid]) for pid, name, _ in E.PROPHECIES]
    o += ev(4, 'A Prophecy', 'The star-observatory has read the next ten years. The astrologers agree, which is rare, and '
            'they agree that the stars allow us one thing. Which shall we prepare for?', opts, pic='ELVEN_CONSTELLATION_eventPicture')
    # .5 shortfall
    eff = []
    for s in S:
        eff += ['if = {', '\tlimit = { has_country_flag = DA_EL_short.%s }' % s['id'], '\tcustom_tooltip = DA_EL_short_tt.%s' % s['id'],
                '\thidden_effect = { clr_country_flag = DA_EL_short.%s }' % s['id'], '}']
        L('DA_EL_short_tt.%s' % s['id'], '§Y%s§! is set aside' % E.ARTS[s['id']]['name'])
    o += ev(5, 'The Mana Runs Short', 'The ley lines no longer carry enough for every art the Archaeomancers practise, and '
            'the month\'s mana has fallen below nothing. They have set aside the hungriest arts until it returns. A Mages '
            'privilege revoked, the Ley Tithe lifted or a level of the Archive lost to a dormant heritage can all cause '
            'it; a new level or a Ley Knot brings the mana back.', [('So be it.', [], eff)], pic='MAGES_ESTATE_eventPicture')
    # .6 wardstone placed, .7 spire placed (hidden: random placement is here, not in a button)
    def place(flag, timer_flag, tiers):
        e = ['clr_country_flag = DA_EL_placed']
        for lim in tiers:
            e += ['if = {', '\tlimit = {', '\t\tNOT = { has_country_flag = DA_EL_placed }', '\t\tany_owned_province = {',
                  '\t\t\t%s' % lim, '\t\t\tNOT = { has_province_flag = %s }' % flag, '\t\t\tNOT = { has_province_flag = %s }' % timer_flag,
                  '\t\t}', '\t}', '\trandom_owned_province = {', '\t\tlimit = {', '\t\t\t%s' % lim,
                  '\t\t\tNOT = { has_province_flag = %s }' % flag, '\t\t\tNOT = { has_province_flag = %s }' % timer_flag, '\t\t}',
                  '\t\tset_province_flag = %s' % timer_flag,
                  '\t\tadd_province_modifier = { name = DA_EL_works_timer duration = 365 }', '\t}',
                  '\tset_country_flag = DA_EL_placed', '\tset_country_flag = DA_EL_raising', '}']
        return e
    o += ev(6, None, None, [], hidden=True, immediate=place('DA_EL_ws', 'DA_EL_ws_raising', [
        'fort_level = 1 any_neighbor_province = { NOT = { owned_by = ROOT } }', 'fort_level = 1', 'always = yes']) + [
        'if = { limit = { has_country_flag = DA_EL_placed } change_variable = { which = DA_EL_wardstones value = 1 } }'])
    o += ev(7, None, None, [], hidden=True, immediate=place('DA_EL_sp', 'DA_EL_sp_raising', [
        'development = 30', 'development = 20', 'development = 12', 'always = yes']) + [
        'if = { limit = { has_country_flag = DA_EL_placed } change_variable = { which = DA_EL_spires value = 1 } }'])
    # .9 the Ashen Omen (hidden roll), .10 its report
    o += ev(9, None, None, [], hidden=True, immediate=['random = {', '\tchance = 5', '\tcountry_event = { id = %s.10 }' % EV, '}'])
    o += ev(10, 'An Ashen Omen', 'The Fragment answered our scholars, and the sky above [Root.Capital.GetName] turned the '
            'colour of ash for three days. Nothing burnt. Nobody who saw it will forget it, and the fields round the city '
            'have stopped growing.',
            [('Cover the shard.', [], ['capital_scope = { add_devastation = 25 }'])], pic='MAGE_MOON_eventPicture')
    # .13 wake a sleeper
    o += ev(13, 'A Sleeper Wakes', 'The crystal clouds, then clears, and the elf inside it opens eyes that last saw the sky '
            'of Aelantir. It takes a day for the Sleeper to speak, and a week to believe what the archaeomancers tell it. '
            'Then it asks what it can do.',
            [('Teach our mages.', ['NOT = { DA_EL_is_ruinborn = yes }'],
              ['define_advisor = { type = court_mage skill = 3 cost_multiplier = 0.5 }']),
             ('Lead our armies.', [], ['create_general = { tradition = 80 add_fire = 1 add_shock = 1 add_manuever = 1 add_siege = 1 }'])],
            pic='MAGE_MOON_ALTER_eventPicture')
    # .80+ marvel tier reached (hidden, province), .90+ rulings, .101/.102 elements
    for m in E.MARVELS:
        imm = ['clr_province_flag = DA_EL_mv_raising', 'change_variable = { which = DA_EL_mv value = 1 }']
        for t, _ in sorted(m['p'].items()):
            imm += ['if = {', '\tlimit = { is_variable_equal = { which = DA_EL_mv value = %d } }' % t,
                    '\tadd_permanent_province_modifier = { name = DA_EL_mvp.%s.%d duration = -1 }' % (m['id'], t), '}']
        if m['id'] == 'stacks':   # tier III: a codex not yet read (the roll is here, in the hidden event)
            imm += ['if = {', '\tlimit = { is_variable_equal = { which = DA_EL_mv value = 3 } }', '\towner = { DA_EL_random_codex = yes }', '}']
        imm += ['owner = { country_event = { id = %s.%d } }' % (EV, 110 + m['n'])]
        o += ev(80 + m['n'], None, None, [], hidden=True, immediate=imm, province=True)
        # the report of a tier: the ruling at III; the Wells' elements at II and III
        o += ev(110 + m['n'], 'A Marvel Wakes: %s' % m['name'], 'The archaeomancers have done their work at %s. '
                '[Root.DA_EL_GetMarvelTier_%s]' % (m['ruin'], m['id']),
                [('Marvellous.', [], ['hidden_effect = {', '\tif = {',
                                      '\t\tlimit = { %d = { is_variable_equal = { which = DA_EL_mv value = 3 } } }' % m['prov'],
                                      '\t\tcountry_event = { id = %s.%d }' % (EV, 90 + m['n']), '\t}'] +
                  (['\tif = {', '\t\tlimit = { %d = { check_variable = { which = DA_EL_mv value = 2 } } }' % m['prov'],
                    '\t\tcountry_event = { id = %s.101 }' % EV, '\t}'] if m['id'] == 'wells' else []) +
                  ['\tDA_EL_refresh = yes', '}'])], pic='HIGH_TEMPLE_CITY_eventPicture')
        a_name, a_tt, b_name, b_tt = m['ruling']
        o += ev(90 + m['n'], 'A Ruling on %s' % m['name'], 'The last of the lost works of %s has been read, and the '
                'archaeomancers bring the question to court. What shall become of what they found?' % m['ruin'],
                [(a_name + '.', [], ruling_effect(m, 'a') + ['hidden_effect = { set_country_flag = DA_EL_ruled.%s }' % m['id']]),
                 (b_name + '.', [], ruling_effect(m, 'b') + ['hidden_effect = { set_country_flag = DA_EL_ruled.%s }' % m['id']])],
                pic='HIGH_TEMPLE_CITY_eventPicture')
    opts = []
    for eid, ename, mod in E.ELEMENTS:
        opts.append(('%s: %s.' % (ename, ', '.join(E.mod_lines(mod)).replace('§G', '').replace('§!', '')),
                     ['NOT = { has_country_flag = DA_EL_wells_el.%s }' % eid],
                     ['custom_tooltip = DA_EL_wells_el_tt.%s' % eid, 'hidden_effect = { set_country_flag = DA_EL_wells_el.%s }' % eid]))
        L('DA_EL_wells_el_tt.%s' % eid, 'The Elemental Wells pour %s into our realm: %s, while the Wells are ours' % (
            ename, ', '.join(E.mod_lines(mod))))
    o += ev(101, 'The Wells Awaken', 'One of the four Elemental Wells of Harathíl burns brighter than the others. The '
            'archaeomancers can feed it, and let its element run through our realm.', opts, pic='HIGH_TEMPLE_CITY_eventPicture')
    o += legend_events()
    return '\n'.join(o) + '\n'


# ---------------------------------------------------------------------------
# DA_EL (doc 72): the legends of the ruins are Legendary Encounters (le_rules.py). Their parley and victory events: the
# encounter fires them on the owner of the province (ROOT); the province's end flag is set here for the parley and by
# the encounter for a victory.
# ---------------------------------------------------------------------------
def legend_events():
    warden = next(g for g in E.LEGENDS if g['id'] == 'warden')['prov']
    pattern = ['custom_tooltip = DA_EL_warden_pattern_tt', 'hidden_effect = { set_country_flag = DA_EL_bp_warden }']
    L('DA_EL_warden_pattern_tt', 'The pattern of the §YWardshield§! is ours: the blueprint can be chosen with the Primary '
      'Technology §YDragonguard Spellforms§! without the §YWardstones§! tile')
    o = ev(120, 'The Warden Stands Down', 'Our charm-singer went down alone, as the Fleet\'s logs say its captains did, and '
           'spoke the words cut into the Warden\'s Gate. The Warden stopped in mid-stride. It heard out the rest of the order '
           'with its lance lowered; then it turned, climbed the stair, and took up its post at the gate of the city. It has '
           'not moved from it since.\n\nOur smiths have been allowed close enough to draw its shield.',
           [('Let it keep the city.', [], ['%d = {' % warden, '\tadd_permanent_province_modifier = { name = DA_EL_warden_guard duration = -1 }',
                                           '\thidden_effect = { set_province_flag = DA_EL_warden_done }', '}'] + pattern +
             ['DA_EL_add_lore = { amount = 10 }'])], pic='GENIE_RUINS_eventPicture')
    o += ev(121, 'The Warden Falls', 'After [Root.DA_LE_last_rounds.GetValue] rounds in the deepest rings of Antir Soara the '
            'teal light in the Warden\'s chest flickered and went out, and the construct knelt where it stood, as if it had '
            'been ordered to. It cost us [Root.DA_LE_last_lost.GetValue] regiments.\n\nOur smiths are already measuring its '
            'plates.', [('Salvage it.', [], ['DA_EL_add_metal = { amount = 30 }', 'DA_EL_add_lore = { amount = 15 }',
                                             'add_prestige = 15'] + pattern)], pic='GENIE_RUINS_eventPicture')
    o += ev(122, 'The Challúmaton Falls', 'For [Root.DA_LE_last_rounds.GetValue] rounds the vault under the Blue House shook. '
            'Then the screaming stopped, all of it at once, and the bone-white frame fell apart into its pieces and stayed '
            'that way. Whatever the Slaver-Nobles poured into it is gone, and our exorcists swear it went somewhere better. '
            'We lost [Root.DA_LE_last_lost.GetValue] regiments.',
            [('Gather the bones.', [], ['DA_EL_add_metal = { amount = 40 }', 'DA_EL_add_lore = { amount = 20 }', 'add_prestige = 25',
                                        'add_country_modifier = { name = DA_EL_challumaton_bones duration = 9125 }'])],
            pic='DRAGON_ATTACK_eventPicture')
    o += ev(123, 'The Mother of Seeds Burns', 'The heart burnt for [Root.DA_LE_last_rounds.GetValue] rounds before it stopped '
            'mending itself. When it went out, every Seedthrall in the ruins of the Effelai fell where it stood, and the '
            'jungle closed over them in a week. We lost [Root.DA_LE_last_lost.GetValue] regiments in the roots.',
            [('Let the jungle have the ash.', [], ['custom_tooltip = DA_EL_seedthralls_gone_tt',
                                                    'hidden_effect = { set_global_flag = DA_EL_seedthralls_gone }',
                                                    'DA_EL_add_essence = { amount = 40 }', 'DA_EL_add_lore = { amount = 15 }',
                                                    'add_prestige = 20'])], pic='GENIE_RUINS_eventPicture')
    L('DA_EL_seedthralls_gone_tt', 'No §YSeedthralls§! attack expeditions in the ruins of the Effelai any more')
    return o


def ruling_effect(m, which):
    mid = m['id']
    prov = m['prov']
    if mid == 'gardens':
        return ['capital_scope = { area_for_scope_province = { limit = { owned_by = ROOT } add_permanent_province_modifier = '
                '{ name = DA_EL_seedbank duration = -1 } } }'] if which == 'a' else \
               ['%d = { add_permanent_province_modifier = { name = DA_EL_mvp.gardens.keep duration = -1 } }' % prov]
    if mid == 'docks':
        return ['add_country_modifier = { name = DA_EL_ruling.docks_launch duration = 9125 }'] if which == 'a' else \
               ['DA_EL_add_metal = { amount = 30 }', 'add_prestige = 15']
    if mid == 'tower':
        return ['add_country_modifier = { name = DA_EL_ruling.tower_trade duration = 9125 }'] if which == 'a' else \
               ['add_prestige = 25', 'add_country_modifier = { name = DA_EL_ruling.tower_route duration = 9125 }']
    if mid == 'wells':
        return ['add_stability = 1'] if which == 'a' else ['hidden_effect = { set_country_flag = DA_EL_ruled.wells_open }',
                                                           'custom_tooltip = DA_EL_wells_open_tt']
    if mid == 'stacks':
        return ['add_country_modifier = { name = DA_EL_ruling.stacks_publish duration = 9125 }'] if which == 'a' else \
               ['custom_tooltip = DA_EL_stacks_keep_tt', 'hidden_effect = { set_country_flag = DA_EL_ruled.stacks_keep }']
    if mid == 'lab':
        return ['custom_tooltip = DA_EL_lab_grow_tt', 'hidden_effect = { set_country_flag = DA_EL_ruled.lab_grow }'] if which == 'a' \
            else ['add_prestige = 25']
    return []


def ruling_texts():
    L('DA_EL_wells_open_tt', 'The Wells\' elements count one and a half times')
    L('DA_EL_stacks_keep_tt', '%s+1 %s§! a year more from the Deep Stacks' % (LC, E.LORE_NAME))
    L('DA_EL_lab_grow_tt', '§M+10 Alchemical Essence§! more every five years from the Gleaming Laboratory')


