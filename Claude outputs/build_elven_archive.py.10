def gen_on_actions():
    return '\n'.join([HEAD, '# Additive hooks: they merge with the other files\' on-actions.', '',
                      'on_monthly_pulse = {', '\tif = {', '\t\tlimit = { has_country_flag = DA_EL_raising }', '\t\tDA_EL_monthly = yes',
                      '\t}', '}', '', 'on_yearly_pulse = {', '\tif = {', '\t\tlimit = { has_country_flag = DA_EL_built DA_EL_heritage = yes }',
                      '\t\tDA_EL_yearly = yes', '\t}', '}', '']) + '\n'


def gen_diplomatic_actions():
    c = E.WORK['concord']
    o = [HEAD, '# ROOT is the country that acts, FROM the one it acts on. The AI never sends these (EU4).', '',
         '# Concord of the Remnant (Enchantment IV): an elven or Ruinborn country\'s opinion and trust',
         'DA_EL_concord_action = {', '\tcategory = influence', '\trequire_acceptance = no', '\tis_visible = {',
         '\t\t%s' % done(c['tile']), '\t\tFROM = { DA_EL_kin = yes }', '\t}', '\tis_allowed = {', '\t\ttreasury = %d' % c['gold'],
         '\t\tDA_EL_has_lore = { amount = %d }' % c['lore'], '\t\tDA_EL_rested.concord = yes', '\t}', '\ton_accept = {',
         '\t\tadd_treasury = -%d' % c['gold'], '\t\tDA_EL_pay_lore = { amount = %d }' % c['lore'],
         '\t\tFROM = { add_opinion = { who = ROOT modifier = DA_EL_concord } add_trust = { who = ROOT value = 20 } }',
         '\t\thidden_effect = { clr_country_flag = DA_EL_cd.concord set_country_flag = DA_EL_cd.concord }', '\t}',
         '\tai_will_do = {', '\t\talways = no', '\t}', '}', '',
         '# Guide the Elves (the Ruinborn): our wayfinders guide an elven country\'s next expedition',
         'DA_EL_guide_action = {', '\tcategory = influence', '\trequire_acceptance = no', '\tis_visible = {',
         '\t\tDA_EL_is_ruinborn = yes', '\t\tDA_EL_level_at.2 = yes', '\t\tFROM = { DA_RH_primary_elven = yes }', '\t}',
         '\tis_allowed = {', '\t\tDA_EL_rested.guide = yes', '\t}', '\ton_accept = {', '\t\tadd_treasury = 100',
         '\t\tFROM = { add_opinion = { who = ROOT modifier = DA_EL_guided } }', '\t\tcustom_tooltip = DA_EL_guide_eff_tt',
         '\t\thidden_effect = {', '\t\t\tFROM = { set_country_flag = DA_RX_guided }',
         '\t\t\tclr_country_flag = DA_EL_cd.guide', '\t\t\tset_country_flag = DA_EL_cd.guide', '\t\t}', '\t}',
         '\tai_will_do = {', '\t\talways = no', '\t}', '}']
    L('DA_EL_concord_action_title', 'Concord of the Remnant')
    L('DA_EL_concord_action_desc', 'Shall our heralds bring the colours of Oldhome to [From.GetName]? It costs §Y%d¤§! and '
      '%s, once in twenty years.\n\n[From.GetName] gains §G+50§! opinion of us and §G+20§! trust.' % (c['gold'], lore(c['lore'])))
    L('DA_EL_concord_action_tooltip', 'Our heralds speak for every people of the Remnant: opinion and trust.')
    L('DA_EL_guide_action_title', 'Guide the Elves')
    L('DA_EL_guide_action_desc', 'Shall our wayfinders guide the next expedition of [From.GetName] into the ruins? Its '
      'expedition meets half the foes, and [From.GetName] pays us §Y100¤§! and thinks better of us.')
    L('DA_EL_guide_action_tooltip', 'Our wayfinders know the ruins: half the foes for their next expedition.')
    L('DA_EL_guide_eff_tt', 'The next expedition of [From.GetName] meets half the foes')
    return '\n'.join(o) + '\n'


# ---------------------------------------------------------------------------
# Texts
# ---------------------------------------------------------------------------
def esc(s):
    return s.replace('"', '\\"').replace('\n', '\\n')


def gen_loc():
    lines = ['l_english:']
    for k, v in LOC.items():
        lines.append(' %s:0 "%s"' % (k, esc(v)))
    return '\n'.join(lines) + '\n'


def tester():
    o = ['# The Remnant Archive (doc 69): run DA_EL_tester.txt in the console, as an elven or Ruinborn country.',
         '# Block A opens the Archive with its first levels. The other blocks are commented out: remove the # signs.', '',
         '# A. 5,000 gold, 100 Lore, 50 of each material, 150 mana, the Archive at level III with every codex, the window',
         'add_treasury = 5000', 'change_variable = { which = DA_EL_lore value = 100 }',
         'change_variable = { which = DA_arcane_metal_total value = 50 }',
         'change_variable = { which = DA_enchanted_building_material_total value = 50 }',
         'change_variable = { which = DA_alchemy_reagents_total value = 50 }', 'change_mana = { amount = 150 }',
         'set_variable = { which = DA_EL_level value = 3 }', 'set_country_flag = DA_EL_built', 'set_country_flag = DA_EL_estate',
         'DA_RH_grant_elven_level3 = yes'] + ['set_country_flag = DA_EL_codex.%s' % s['id'] for s in S] + [
         'DA_EL_refresh = yes', 'DA_EL_open_archive = yes', '',
         '# B. Every first tile done (every art recovered)'] + \
        ['#set_country_flag = DA_PR_done.%s' % E.tid(s['id'], 1) for s in S] + ['#DA_EL_refresh = yes', '',
         '# C. A ruin of ours unsealed to ring VI (the ring conditions of the tiles and levels)',
         '#set_variable = { which = DA_EL_ring_max value = 6 }', '#set_variable = { which = DA_EL_great4 value = 2 }', '',
         '# D. The marvels found in their provinces (own them first)'] + \
        ['#%d = { set_province_flag = DA_EL_mv_found }' % m['prov'] for m in E.MARVELS] + ['',
         '# E. The yearly pass now (shortfall, Lore from the tiles and the marvels)', '#DA_EL_yearly = yes']
    # DA_EL (doc 72): the legends, Wyrmbane, the Warden's parley, a survey
    w, c, m = (next(g['prov'] for g in E.LEGENDS if g['id'] == k) for k in ('warden', 'challumaton', 'mother'))
    o += ['', '# F (doc 72). The three legends seen and their way open (own Antir Soara %d, Nagar Vyechei %d and Serpentfall '
          'East %d first, and put regiments in them); then open the province view: the Legendary Encounter button' % (w, c, m),
          '#%d = { set_province_flag = DA_RX_lw2 set_province_flag = DA_RX_lw3 }' % w,
          '#%d = { set_province_flag = DA_RX_lw2 set_province_flag = DA_RX_lw3 }' % c,
          '#%d = { set_variable = { which = DA_RX_ring value = 4 } }' % m, '',
          '# G (doc 72). Wyrmbane done (+15% against the dragon legends), and what the Warden\'s parley asks: the Fleet Charms '
          'codex and the art Fleet-Charm Crews in practice (practise it on Recovered Arts after block B)',
          '#set_country_flag = DA_PR_done.EL_Evo3 set_country_flag = DA_PR_done.EL_Evo2 DA_EL_refresh = yes',
          '#set_country_flag = DA_EL_codex.enchantment', '',
          '# H (doc 72). A survey abroad now, whatever its price (the regions list the ruins we may survey)',
          '#add_treasury = 500 change_mana = { amount = 20 } DA_RX_open_survey = yes']
    return '\n'.join(o) + '\n'


def generated():
    """what the build writes, as text (the previews and the fit report read these)"""
    import elven_archive_ui as UI
    LOC.clear()
    files = {
        'common/scripted_triggers/DA_EL_triggers.txt': gen_triggers(),
        'common/scripted_effects/DA_EL_effects.txt': gen_effects(),
        'common/event_modifiers/DA_EL_modifiers.txt': gen_modifiers(),
        'common/triggered_modifiers/DA_EL_triggered_modifiers.txt': gen_triggered_modifiers(),
        'common/opinion_modifiers/DA_EL_opinion_modifiers.txt': gen_opinion_modifiers(),
        'common/estates/DA_EL_archaeomancers.txt': gen_estate(),
        'common/estates_preload/DA_EL_estate_modifiers.txt': gen_preload(),
        'common/estate_privileges/DA_EL_arts.txt': gen_privileges(),
        'events/DA_EL_events.txt': gen_events(),
        'common/on_actions/DA_EL_on_actions.txt': gen_on_actions(),
        'common/new_diplomatic_actions/DA_EL_diplomatic_actions.txt': gen_diplomatic_actions(),
    }
    ruling_texts()
    files.update(UI.generate(E, LOC, L))
    files['localisation/DA_EL_l_english.yml'] = gen_loc()
    files['DA_EL_tester.txt'] = tester()
    return files


def validate(files):
    probs = []
    for rel, text in files.items():
        if rel.endswith('.yml'):
            continue
        t = re.sub(r'#[^\n]*', '', text)
        if t.count('{') != t.count('}'):
            probs.append('%s: braces do not balance' % rel)
    if re.search(r'\belse(_if)?\s*=', re.sub(r'#[^\n]*', '', files['common/scripted_effects/DA_EL_effects.txt'])):
        probs.append('an else in DA_EL_effects.txt')
    gui = re.sub(r'#[^\n]*', '', files['common/custom_gui/DA_EL_Remnant_Archive.txt'])
    if re.search(r'\brandom(_list|_owned_province)?\s*=', gui):
        probs.append('dice in a button')
    for rel, text in files.items():
        if rel.endswith('.yml'):
            try:
                text.encode('utf-8')
            except UnicodeError:
                probs.append('%s: not utf-8' % rel)
        else:
            try:
                text.encode('latin-1')
            except UnicodeError as e:
                probs.append('%s: not latin-1 (%s)' % (rel, e))
    return probs


def main():
    import elven_archive_ui as UI
    UI.ROOT, UI.MODE, UI.REPORT, UI.write = ROOT, MODE, REPORT, write
    if MODE in ('art', 'preview'):
        files = generated()
        UI.art(E, files, sys.argv[3] if MODE == 'preview' and len(sys.argv) > 3 else None)
        print('\n'.join(r for r in REPORT if not r.startswith('same')))
        return
    files = generated()
    for rel, text in files.items():
        write(rel, text, bom=rel.endswith('.yml'))
    UI.patch_topbar(files)
    probs = validate(files) + ['does not fit: ' + b for b in UI.fit_report(E, files)]
    print('\n'.join(r for r in REPORT if MODE == 'check' or not r.startswith('same')))
    print('elven tiles %d, arts %d, marvels %d, mode %s' % (len(E.NODES), len(E.ARTS), len(E.MARVELS), MODE))
    print('PROBLEMS:' if probs else 'no problems found')
    for p in probs:
        print('  ' + p)
    if probs:
        sys.exit(1)


if __name__ == '__main__':
    main()
