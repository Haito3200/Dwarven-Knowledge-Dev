def fmtv(v):
    s = ('%.3f' % v).rstrip('0').rstrip('.')
    return s if s not in ('-0', '') else '0'


def mod_line(k, v):
    """one tooltip line of a modifier: '§G+10%§! Fort Defense'"""
    name, kind = MOD_NAME[k]
    bad = kind.endswith('bad')
    if kind == '-lib':
        good = v > 0
        s = '-%s%%' % fmtv(v)
    elif kind.startswith('%'):
        good = (v < 0) if bad else (v > 0)
        s = '%+g%%' % (round(v * 1000) / 10.0)
    else:
        good = (v < 0) if bad else (v > 0)
        s = '%s%s' % ('+' if v > 0 else '', fmtv(v))
    return '%s%s§! %s' % ('§G' if good else '§R', s, name)


def mod_lines(mod):
    return [mod_line(k, v) for k, v in mod.items()]


def tid(school, n):
    return 'EL_%s%d' % (SCHOOL[school]['key'], n)


def tile_mod(school, n):
    s = SCHOOL[school]
    _, _, _, _, _, mod, _ = TILES[school][n - 1]
    mod = dict(mod)
    if s['exp'] and n in (1, 3):
        mod[s['exp']] = 0.10 if n == 1 else 0.15
    return mod


