def gen_gfx(E):
    o = ['# Generated by "Claude files/tools/build_elven_archive.py" (elven_archive_ui.py). Change the tables there and re-run.',
         'spriteTypes = {']
    for name, tex, frames, check in sprites(E):
        s = '\tspriteType = {\n\t\tname = "%s"\n\t\ttexturefile = "%s/%s.dds"\n' % (name, ART, tex)
        if check:
            s += '\t\ttransparencecheck = yes\n'
        if frames > 1:
            s += '\t\tnoOfFrames = %d\n' % frames
        o.append(s + '\t}')
