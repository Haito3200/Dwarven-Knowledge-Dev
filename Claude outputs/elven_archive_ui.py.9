def tb(name, x, y, w, h, font='vic_18', fmt='left', text=None, scripted=True):
    ex = ['textureFile = ""', 'font = "%s"' % font, 'borderSize = {x = 0 y = 0}', 'text = "%s"' % (text or name),
          'maxWidth = %d' % w, 'maxHeight = %d' % h, 'format = %s' % fmt]
    if scripted:
        ex.append('scripted = yes')
    ex.append('alwaystransparent = yes')
    return ['instantTextBoxType = {', '\tname = "%s"' % name, '\tposition = { x = %d y = %d }' % (x, y)] + \
        ['\t' + e for e in ex] + ['}']


def el(kind, name, x, y, sprite, extra=(), quad=False):
    return ['%s = {' % kind, '\tname = "%s"' % name, '\t%s = "%s"' % ('quadTextureSprite' if quad else 'spriteType', sprite),
            '\tposition = { x = %d y = %d }' % (x, y), '\tOrientation = "UPPER_LEFT"'] + ['\t' + e for e in extra] + ['}']


BTNX = ['scripted = yes', 'clicksound = back_click']
ICONX = ['scripted = yes', 'alwaystransparent = yes']


def label(text, font='vic_18'):
    return ['buttonText = "%s"' % text, 'buttonFont = "%s"' % font]


def button(name, x, y, sprite, text, font='vic_18'):
    return el('guiButtonType', name, x, y, sprite, label(text, font) + BTNX)


def row_y(k):
    return ROW_Y0 + k * ROW_P


