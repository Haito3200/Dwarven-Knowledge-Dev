}


def lg_states(lg):
    """[(state, trigger in country scope)], first match first"""
    p = lg['prov']
    ended = '%d = { has_province_flag = DA_EL_%s_done }' % (p, lg['id'])
    if lg.get('gone'):
        ended = 'OR = { %s %s }' % (ended, lg['gone'])
    out = [('ended', ended)]
    if lg['contain']:
        out.append(('held', '%d = { owned_by = ROOT has_province_modifier = DA_LE_contained_%s }' % (p, lg['id'])))
    out += [('open', '%d = { owned_by = ROOT DA_LE_is_%s = yes %s }' % (p, lg['id'], lg['open'])),
            ('seen', '%d = { owned_by = ROOT DA_LE_is_%s = yes }' % (p, lg['id'])),
            ('rumour', 'always = yes')]
    return out


