                                           'custom_trigger_tooltip = { tooltip = DA_EL_can_recollect_tt DA_EL_can_recollect = yes }'],
         ['DA_EL_recollect = yes']),
        ('DA_EL_w_vigil', PG_ARCHIVE, [lv % 3, 'treasury = %d' % W_['vigil']['gold'],
                                       'DA_EL_has_lore = { amount = %d }' % W_['vigil']['lore'], 'DA_EL_rested.vigil = yes'],
         ['DA_EL_vigil = yes']),
        ('DA_EL_w_commune', '%s %s' % (PG_ARCHIVE, NRB), [lv % 4, 'treasury = %d' % W_['commune']['gold'],
                                                         'DA_EL_has_lore = { amount = %d }' % W_['commune']['lore'],
                                                         'DA_EL_rested.commune = yes'], ['DA_EL_commune = yes']),
        ('DA_EL_w_speak', '%s %s' % (PG_ARCHIVE, RB), [lv % 4, 'treasury = %d' % W_['commune']['gold'], 'DA_EL_rested.commune = yes'],
         ['DA_EL_commune = yes']),
        ('DA_EL_w_tithe_on', '%s NOT = { has_country_flag = DA_EL_tithe }' % PG_ARCHIVE, [lv % 3], ['DA_EL_tithe_on = yes']),
