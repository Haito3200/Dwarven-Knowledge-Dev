                             'DA_EL_has_lore = { amount = %d }' % up[2], 'DA_EL_has_essence = { amount = %d }' % up[3]],
                    effect=['DA_EL_upgrade.%s = yes' % sid]))
        if sid in E.SCHOOL_WORK:
            wk = E.SCHOOL_WORK[sid]
            G.append(cb('DA_EL_sw_%s' % sid, 'DA_EL_sw_tt.%s' % wk, here, trigger=['DA_EL_heritage = yes'] + work_trig(E, wk),
                        effect=['DA_EL_%s = yes' % {'wardstone': 'raise_wardstone', 'spire': 'raise_spire', 'prophecy': 'prophecy',
                                                    'captain': 'captain', 'veil': 'veil', 'sleeper': 'wake'}[wk]]))
    G.append(ctb('DA_EL_as_line', '%s NOT = { %s }' % (PG_ARTS, SEL_NONE)))
    G.append(ctb('DA_EL_us_line', '%s NOT = { %s }' % (PG_ARTS, SEL_NONE)))
    G.append(ctb('DA_EL_ss_line', '%s OR = { %s }' % (PG_ARTS, ' '.join(SEL % E.SCHOOL[s]['n'] for s in E.SCHOOL_WORK))))
    G.append(ctb('DA_EL_art_note', '%s NOT = { %s }' % (PG_ARTS, SEL_NONE)))
    G.append(ctb('DA_EL_r2_none', 'OR = { AND = { %s %s } AND = { %s OR = { %s %s } } }' % (
        PG_ARTS, SEL_NONE, PG_MARVELS, SEL_NONE, ' '.join(SEL % lg['n'] for lg in E.LEGENDS))))
    # the Marvels page
    G.append(ctb('DA_EL_mv_price', '%s OR = { %s }' % (PG_MARVELS, ' '.join(SEL % m['n'] for m in E.MARVELS))))
    for m in E.MARVELS:
        for t in (1, 2, 3):
            p = E.MARVEL_PRICE[t]
            trig = ['DA_EL_heritage = yes', 'custom_trigger_tooltip = { tooltip = DA_EL_mv_ours_tt.%s %s }' % (
                m['id'], prov(m, 'owned_by = ROOT'))]
            trig += price_trig_ui(dict(gold=p['gold'], lore=p['lore'], building=p['building'], mana=p['mana']))
            if t == 2:
                trig.append('custom_trigger_tooltip = { tooltip = DA_EL_mv_lw_tt.2 %s }' % prov(m, 'has_province_flag = DA_RX_lw2'))
            if t == 3:
                trig.append('custom_trigger_tooltip = { tooltip = DA_EL_mv_lw_tt.3 %s }' % prov(
                    m, 'OR = { has_province_flag = DA_RX_lw3 DA_RX_lw3_closed = yes }'))
            pot = '%s %s %s %s NOT = { %s }' % (PG_MARVELS, SEL % m['n'], prov(m, 'has_province_flag = DA_EL_mv_found'),
                                                 tier_is(m, t - 1), prov(m, 'has_province_flag = DA_EL_mv_raising'))
            G.append(cb('DA_EL_raise_%s_%d' % (m['id'], t), 'DA_EL_raise_tt.%s.%d' % (m['id'], t), pot, trigger=trig,
                        effect=['DA_EL_raise.%s.%d = yes' % (m['id'], t)]))
    # the Guide
    for nm in ('DA_EL_guide_l', 'DA_EL_guide_c', 'DA_EL_guide_r1', 'DA_EL_guide_r2'):
        G.append(ctb(nm, PG_GUIDE))
    # the plates
    G.append(ctb('DA_EL_store_lore', tooltip='DA_EL_store_lore_tt'))
    G.append(ctb('DA_EL_store_mat', tooltip='DA_EL_store_mat_tt'))
    G.append(ctb('DA_EL_ruins_text'))
    # DA_EL (doc 72): the Ruin Expeditions plate sends a survey abroad (build_ruin_excavation.py: DA_RX_open_survey)
    G.append(cb('DA_EL_survey', 'DA_EL_ruins_tt', trigger=['DA_RX_can_survey = yes'],
                effect=['hidden_effect = { DA_RX_open_survey = yes }']))
    return '\n'.join(G) + '\n'


def price_trig_ui(lv):
    t = []
    if lv.get('gold'):
        t.append('treasury = %d' % lv['gold'])
    if lv.get('lore'):
        t.append('DA_EL_has_lore = { amount = %d }' % lv['lore'])
    if lv.get('mana'):
        t.append('OR = { ai = yes DA_EL_has_mana = { amount = %d } }' % lv['mana'])
    if lv.get('building'):
        t.append('DA_EL_has_building = { amount = %d }' % lv['building'])
    if lv.get('ring'):
        t.append('DA_EL_ring.%d = yes' % lv['ring'])
    return t


def work_trig(E, wk):
    w = E.WORK[wk]
    t = ['custom_trigger_tooltip = { tooltip = DA_EL_tile_done_tt.%s has_country_flag = DA_PR_done.%s }' % (wk, w['tile'])]
    if wk == 'wardstone':
        t.append('custom_trigger_tooltip = { tooltip = DA_EL_ws_room_tt OR = { NOT = { check_variable = { which = DA_EL_wardstones '
                 'value = 3 } } AND = { has_country_flag = DA_PR_done.%s NOT = { check_variable = { which = DA_EL_wardstones '
                 'value = 6 } } } } }' % w['tile2'])
    if wk == 'spire':
        t.append('custom_trigger_tooltip = { tooltip = DA_EL_sp_room_tt NOT = { check_variable = { which = DA_EL_spires value = 3 } } }')
    if wk == 'veil':
        t += ['is_at_war = yes', 'custom_trigger_tooltip = { tooltip = DA_EL_veil_once_tt NOT = { has_country_flag = DA_EL_veil_war } }',
              'DA_EL_has_mana = { amount = %d }' % w['mana']]
    if wk == 'sleeper':
        t += ['DA_EL_level_at.%d = yes' % w['level'], 'DA_EL_sleeper_found = yes']
    if w.get('cool'):
        t.append('DA_EL_rested.%s = yes' % wk)
    for k, trig in (('gold', 'treasury = %d'), ('mil', 'mil_power = %d')):
        if w.get(k):
            t.append(trig % w[k])
    if w.get('lore'):
        t.append('DA_EL_has_lore = { amount = %d }' % w['lore'])
    if w.get('metal'):
        t.append('DA_EL_has_metal = { amount = %d }' % w['metal'])
    if w.get('building'):
        t.append('DA_EL_has_building = { amount = %d }' % w['building'])
    return t


