def read(rel):
    raw = open(os.path.join(ROOT, rel), 'rb').read()
    text = raw.decode('utf-8-sig') if rel.endswith('.yml') else raw.decode('latin-1')
    return text.replace('\r\n', '\n'), '\r\n' in text


def block_end(text, open_brace):
    depth = 0
    i = open_brace
    while i < len(text):
        c = text[i]
        if c == '#':
            j = text.find('\n', i)
            i = len(text) if j < 0 else j
            continue
        if c == '{':
            depth += 1
        elif c == '}':
            depth -= 1
            if depth == 0:
                return i + 1
        i += 1
    raise ValueError('unbalanced')


def patch_topbar(files):
    """The window inside the DA_BLOCK windows of topbar.gui (merge_topbar.py keeps the blocks), after the Brood-Forge's."""
    import elven_data as E
    rel = 'interface/topbar.gui'
    text, crlf = read(rel)
    win = gen_window(E)
    m = re.search(r'[ \t]*windowType = \{ #DA_EL_archive\n', text)
    if m:
        end = block_end(text, text.index('{', m.start()))
        if text[end:end + 1] == '\n':
            end += 1
        text = text[:m.start()] + win + text[end:]
    else:
        m = re.search(r'[ \t]*windowType = \{ #DA_KB_forge\n', text)
        if not m:
            raise SystemExit('topbar.gui: the Brood-Forge\'s window (the anchor) is missing')
        end = block_end(text, text.index('{', m.start()))
        if text[end:end + 1] == '\n':
            end += 1
        text = text[:end] + win + text[end:]
    write(rel, text, crlf)


