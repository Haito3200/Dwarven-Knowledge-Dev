def cb(name, tooltip=None, potential='always = yes', trigger=None, effect=None, frames=None):
    o = ['custom_button = {', '\tname = %s' % name]
    if tooltip:
        o.append('\ttooltip = %s' % tooltip)
    o.append('\tpotential = { %s }' % potential)
    for num, cond in (frames or []):
        o.append('\tframe = { number = %d trigger = { %s } }' % (num, cond))
    if trigger:
        o += ['\ttrigger = {'] + ['\t\t' + t for t in trigger] + ['\t}']
    if effect:
        o += ['\teffect = {'] + ['\t\t' + e for e in effect] + ['\t}']
    o.append('}')
    return '\n'.join(o)


def ctb(name, potential='always = yes', tooltip=None):
    o = ['custom_text_box = {', '\tname = %s' % name]
    if tooltip:
        o.append('\ttooltip = %s' % tooltip)
    return '\n'.join(o + ['\tpotential = { %s }' % potential, '}'])


def ci(name, potential='always = yes', tooltip=None, frames=None):
    o = ['custom_icon = {', '\tname = %s' % name]
    if tooltip:
        o.append('\ttooltip = %s' % tooltip)
    o.append('\tpotential = { %s }' % potential)
    for num, cond in (frames or []):
        o.append('\tframe = { number = %d trigger = { %s } }' % (num, cond))
    return '\n'.join(o + ['}'])


def prov(m, cond):
    return '%d = { %s }' % (m['prov'], cond)


def tier_at(m, t):
    return prov(m, 'check_variable = { which = DA_EL_mv value = %d }' % t)


def tier_is(m, t):
    return prov(m, 'is_variable_equal = { which = DA_EL_mv value = %d }' % t)


