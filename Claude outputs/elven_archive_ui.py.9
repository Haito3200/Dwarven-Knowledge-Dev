         [lv % 1, 'treasury = %d' % W_['logs']['gold']], ['DA_EL_poles = yes']),
        ('DA_EL_w_study', '%s %s NOT = { DA_EL_logs_left = yes }' % (PG_ARCHIVE, NRB), [lv % 1, 'DA_EL_rested.study = yes'],
         ['DA_EL_study = yes']),
        ('DA_EL_w_study_rb', '%s %s NOT = { DA_EL_poles_left = yes }' % (PG_ARCHIVE, RB), [lv % 1, 'DA_EL_rested.study = yes'],
         ['DA_EL_study = yes']),
