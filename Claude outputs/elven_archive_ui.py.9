def compact(gold_, lore_, building):
    """a price on one line: 700¤ · 15 Lore · 10 Building"""
    import elven_data as E
    parts = ['§Y%d¤§!' % gold_]
    if lore_:
        parts.append('%s%d Lore§!' % (E.LORE_C, lore_))
    if building:
        parts.append('§M%d Building§!' % building)
    return ' · '.join(parts)


def _pt(E, w):
    from build_elven_archive import price_text
    return price_text(w.get('gold', 0), w.get('lore', 0), metal=w.get('metal', 0), building=w.get('building', 0),
                      mil=w.get('mil', 0))


def gen_custom_loc():
    out = ['# Generated by "Claude files/tools/build_elven_archive.py" (elven_archive_ui.py). Change the tables there and re-run.']
    for name, pairs, fb in DT:
        o = ['defined_text = {', '\tname = %s' % name, '\trandom = no']
        for key, trig in pairs:
            o.append('\ttext = {\n\t\tlocalisation_key = %s\n\t\ttrigger = { %s }\n\t}' % (key, trig))
        o.append('\ttext = {\n\t\tlocalisation_key = %s\n\t\ttrigger = { always = yes }\n\t}' % fb)
        o.append('}')
        out.append('\n'.join(o))
    return '\n\n'.join(out) + '\n'


