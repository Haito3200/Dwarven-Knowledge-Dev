def sample_loc(files):
    loc = {}
    for line in files['localisation/DA_EL_l_english.yml'].splitlines()[1:]:
        m = re.match(r' ([\w.\-]+):0 "(.*)"$', line)
        if m:
            loc[m.group(1)] = m.group(2).replace('\\n', '\n').replace('\\"', '"')
    for k in list(loc):
        loc[k] = re.sub(r'\[Root\.[\w.]+\.GetValue\]', '888', loc[k])
    return loc


def fit_report(E, files):
    import eu4_text as T
    T.init(None, ROOT)
    loc = sample_loc(files)
    bad = []

    def fits(key, w, h, font='vic_18'):
        if key not in loc:
            return
        lines, shown, cut, widest, too_wide = T.fit(font, loc[key], w, h, T.PESSIMISTIC)
        if cut:
            bad.append('%s: %d lines in %d px' % (key, len(lines), h))
    # every variant of each defined text in its box
    boxes = {'DA_EL_GetLpHead': (LP[2] - 16, 20), 'DA_EL_GetLvNext': (LP[2] - 20, 62), 'DA_EL_GetEst': (LP[2] - 20, 150),
             'DA_EL_GetStrip': (LP[2], 24, 'vic_22'), 'DA_EL_GetLpMarvels': (LP[2] - 24, LP[3] - 28),
             'DA_EL_Get_rp_title': (R1[2] - 16, 24, 'vic_22'), 'DA_EL_Get_rp_meta': (R1[2] - 16, 18),
             'DA_EL_Get_rp_text': (R1[2] - 20, R1[3] - 60), 'DA_EL_GetAsLine': (STAT_W, 18), 'DA_EL_GetUsLine': (STAT_W, 18),
             'DA_EL_GetSsLine': (STAT_W, 18), 'DA_EL_GetArtNote': (R2[2] - 16, 44), 'DA_EL_GetR2None': (R2[2] - 20, R2[3] - 20),
             'DA_EL_GetMvPrice': (R2[2] - 20, 84), 'DA_EL_GetTitle': (TITLE[2], 32, 'vic_29')}
    for n in range(1, 8):
        boxes['DA_EL_GetLv%d' % n] = (LP[2] - 80, 20)
        boxes['DA_EL_GetLvs%d' % n] = (58, 20)
    for n in range(1, 10):
        boxes['DA_EL_GetCl%d' % n] = (CW - 4, 18)
    for wk in ('logs', 'recollect', 'vigil', 'commune', 'tithe'):
        boxes['DA_EL_GetWs_%s' % wk] = (STAT_W, 18)
    for name, pairs, fb in DT:
        if name not in boxes:
            continue
        spec = boxes[name]
        w, h = spec[0], spec[1]
        font = spec[2] if len(spec) > 2 else 'vic_18'
        for key in set([k for k, _ in pairs] + [fb]):
            fits(key, w, h, font)
    for key, w, h in (('DA_EL_mana_text', LP[2] - 20, 132), ('DA_EL_guide_l', LP[2] - 24, LP[3] - 24),
                      ('DA_EL_guide_c', COVER[2] - 24, COVER[3] - 24), ('DA_EL_guide_r1', R1[2] - 20, R1[3] - 14),
                      ('DA_EL_guide_r2', R2[2] - 20, R2[3] - 14), ('DA_EL_store_lore', BP[0][2] - 16, 42),
                      ('DA_EL_store_mat', BP[1][2] - 16, 42), ('DA_EL_ruins_text', BP[2][2] - 16, 42)):
        fits(key, w, h)
    # button labels
    for key in [k for k in loc if k.startswith('DA_EL_W_') or k.startswith('DA_EL_SW_')] + ['DA_EL_PRACTISE', 'DA_EL_SET_ASIDE',
                                                                                          'DA_EL_UPGRADE']:
        if T.game_width('vic_18', loc[key], T.PESSIMISTIC) > BTN[0] - 10:
            bad.append('%s: wider than its button' % key)
    for t in (1, 2, 3):
        if T.game_width('vic_18', loc['DA_EL_RAISE_%d' % t], T.PESSIMISTIC) > BTN_W[0] - 12:
            bad.append('DA_EL_RAISE_%d: wider than its button' % t)
    if T.game_width('vic_22', loc['DA_EL_BUILD'], T.PESSIMISTIC) > BTN_B[0] - 12:
        bad.append('DA_EL_BUILD: wider than its button')
    for k, key in enumerate(TAB_KEYS):
        if T.game_width('vic_22', loc['DA_EL_TAB_%s' % key.upper()], T.PESSIMISTIC) > TABS[k][2] - 16:
            bad.append('DA_EL_TAB_%s: wider than its tab' % key.upper())
    for k, key in ((0, 'DA_EL_RESEARCH'), (1, 'DA_EL_STUDIES')):
        if T.game_width('vic_18', loc[key], T.PESSIMISTIC) > SP[k][2] - 12:
            bad.append('%s: wider than its plate' % key)
    missing = [t for _, t, _, _ in sprites(E) if not os.path.exists(os.path.join(ROOT, ART, t + '.dds'))]
    if missing:
        REPORT.append('note    the window was not drawn: %d of its textures are not there yet (%s); run ". art"'
                      % (len(missing), ', '.join(missing[:3]) + (', ...' if len(missing) > 3 else '')))
        return bad
    return bad + render_report(E, files)


def preview_states(E):
    import eu4_gui as UI
    done = ['EL_Abj1', 'EL_Abj2', 'EL_Div1', 'EL_Enc1', 'EL_Ill1', 'EL_Tra1']
    flags = ['DA_PR_done.%s' % n for n in done] + ['DA_EL_codex.%s' % s for s in ('abjuration', 'divination', 'enchantment',
                                                                                'illusion', 'transmutation')]
    flags += ['DA_EL_art_on.abjuration', 'DA_EL_art_on.divination', 'DA_EL_up.abjuration', 'DA_EL_art_on.illusion',
              'DA_EL_built', 'DA_EL_estate', 'DA_EL_archive_on']
    vars_ = {'DA_EL_level': 3, 'DA_EL_lore': 34, 'DA_EL_codices': 5, 'DA_EL_ring_max': 3, 'currentMana': 143,
             'mages_mana_capacity_val': 200, 'mages_mana_regen_val': 0.75, 'DA_EL_arts_on': 3, 'DA_EL_upkeep': 0.5,
             'DA_arcane_metal_total': 12, 'DA_enchanted_building_material_total': 8, 'DA_alchemy_reagents_total': 5,
             'DA_EL_fam_abjuration': 2, 'DA_EL_fam_divination': 1, 'DA_EL_fam_enchantment': 1, 'DA_EL_fam_illusion': 1,
             'DA_EL_fam_transmutation': 1, 'DA_RX_parties': 1, 'DA_RX_open': 2, 'DA_EL_wardstones': 1}
    gardens = E.MARVEL['gardens']['prov']
    stacks = E.MARVEL['stacks']['prov']
    answers = {'DA_RH_primary_ruinborn': False, 'DA_RH_primary_elven': True, 'DA_RH_active_elven': True,
               'DA_RH_active_ruinborn': False, 'ai': False, 'is_at_war': False,
               'has_estate = %s' % E.EST: True, 'estate_loyalty': True}
    texts = {}
    out = [('archive', UI.State(flags, dict(vars_, DA_EL_sel=1), answers=answers))]
    out.append(('arts', UI.State(flags + ['DA_EL_pg_arts'], dict(vars_, DA_EL_sel=1), answers=answers)))
    mv_answers = dict(answers)
    mv_answers[str(gardens)] = True
    out.append(('marvels', UI.State(flags + ['DA_EL_pg_marvels'], dict(vars_, DA_EL_sel=1), answers=mv_answers)))
    out.append(('guide', UI.State(flags + ['DA_EL_pg_guide'], dict(vars_, DA_EL_sel=1), answers=answers)))
    return out


def render_report(E, files, out=None):
    import eu4_gui as UI
    mod = UI.Mod(ROOT, overrides=files, windows={WIN: gen_window(E)})
    probs = []
    for name, st in preview_states(E):
        target = None
        if out:
            root_, ext = os.path.splitext(out)
            target = out if name == 'archive' else root_ + '_' + name + ext
        rep_, _ = UI.render(mod, WIN, st, target)
        probs += ['%s page, %s: %s' % (name, e, issue) for e, issue in rep_ if e != '(trigger)']
        if target:
            REPORT.append('preview ' + target)
    return probs
