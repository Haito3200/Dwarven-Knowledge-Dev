def read_dds(full):
    import struct
    import numpy as np
    from PIL import Image
    raw = open(full, 'rb').read()
    if raw[84:88] != b'DX10':
        return Image.open(full).convert('RGBA')
    h, w = struct.unpack('<2I', raw[12:20])
    fmt = struct.unpack('<I', raw[128:132])[0]
    a = np.frombuffer(raw[148:148 + w * h * 4], np.uint8).reshape(h, w, 4)
    if fmt in (87, 91):
        a = a[:, :, [2, 1, 0, 3]]
    return Image.fromarray(a.copy(), 'RGBA')


TEAL = (86, 214, 196)
GOLD = (222, 184, 104)
DARK = (14, 34, 36)


def art(E, files, preview=None):
    import struct
    import numpy as np
    from PIL import Image, ImageDraw, ImageFilter, ImageEnhance, ImageOps

    def write_dds(img, rel):
        img = img.convert('RGBA')
        w, h = img.size
        a = np.array(img)
        data = a[:, :, [2, 1, 0, 3]].tobytes()
        hdr = struct.pack('<4s7I44s8I5I', b'DDS ', 124, 0x100f, h, w, w * 4, 0, 1, b'\0' * 44,
                          32, 0x41, 0, 32, 0xff0000, 0xff00, 0xff, 0xff000000, 0x1000, 0, 0, 0, 0)
        full = os.path.join(ROOT, rel)
        data = hdr + data
        old = open(full, 'rb').read() if os.path.exists(full) else None
        REPORT.append(('same    ' if old == data else ('changed ' if old else 'new     ')) + rel)
        if old != data and MODE != 'check':
            os.makedirs(os.path.dirname(full), exist_ok=True)
            open(full, 'wb').write(data)

    sizes = texture_sizes(E)

    def check(img, name):
        if img.size != tuple(sizes[name]):
            raise SystemExit('%s: drawn at %s, the layout wants %s' % (name, img.size, sizes[name]))
        write_dds(img, ART + '/%s.dds' % name)

    orig = Image.open(os.path.join(ROOT, SRC)).convert('RGBA')
    if orig.size != (1536, 1024):
        raise SystemExit('%s: expected 1536 x 1024, found %d x %d' % (SRC, orig.size[0], orig.size[1]))
    oa = np.array(orig).astype(np.float64)
    al = oa[..., 3:4]
    oa[..., :3] *= np.where(al < 230, (al / 230.0) ** 1.5, 1.0)     # the soft edge: a shadow over the map
    base = Image.fromarray(oa.clip(0, 255).astype(np.uint8), 'RGBA').convert('RGBa').resize((W, H), Image.LANCZOS).convert('RGBA')
    check(base, 'DA_EL_window')
    # the panel's plain fill: the median colour of the left panel and its grain
    ba = np.array(base).astype(np.float64)
    sx0, sy0 = LP[0] + 20, LP[1] + 20
    sample = ba[sy0:sy0 + 260, sx0:sx0 + 230, :3]
    med = np.median(sample.reshape(-1, 3), 0)
    rs = np.random.RandomState(68)

    def fill(w, h):
        g = rs.normal(0, 1, (h, w))
        g = np.array(Image.fromarray(((g * 40) + 128).clip(0, 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(0.7))).astype(float) - 128
        g *= (sample.std(axis=(0, 1)).mean() * 0.6) / (g.std() + 1e-9)
        a = np.zeros((h, w, 4))
        a[..., :3] = med[None, None, :] + g[..., None]
        a[..., 3] = 255
        return Image.fromarray(a.clip(0, 255).astype(np.uint8), 'RGBA')
    # the cover of the grid on the Guide page: a plain panel inside a gold rim, as the frame's own panels
    cw, ch = COVER[2], COVER[3]
    cov = fill(cw, ch)
    d = ImageDraw.Draw(cov)
    d.rectangle([0, 0, cw - 1, ch - 1], outline=(70, 52, 24, 255), width=3)
    d.rectangle([1, 1, cw - 2, ch - 2], outline=GOLD + (255,), width=1)
    d.rectangle([4, 4, cw - 5, ch - 5], outline=(120, 96, 56, 180), width=1)
    check(cov, 'DA_EL_cover')
    # tabs: the plate as painted; lit (the page shown) brighter, with a teal glow inside the rim
    for k, (x, y, w, h) in enumerate(TABS):
        box = (x - TAB_PAD, y - TAB_PAD, x + w + TAB_PAD, y + h + TAB_PAD)
        im = base.crop(box)
        lit = ImageEnhance.Brightness(im).enhance(1.25)
        glow = Image.new('RGBA', im.size, (0, 0, 0, 0))
        gd = ImageDraw.Draw(glow)
        for r, a in ((5, 200), (7, 110), (9, 50)):
            gd.rounded_rectangle([r, r - 1, im.size[0] - 1 - r, im.size[1] - r], radius=5, outline=TEAL + (a,), width=2)
        lit.alpha_composite(glow.filter(ImageFilter.GaussianBlur(0.8)))
        strip = Image.new('RGBA', (im.size[0] * 2, im.size[1]))
        strip.paste(im, (0, 0))
        strip.paste(lit, (im.size[0], 0))
        check(strip, 'DA_EL_tab_%d' % (k + 1))
    # the small plates, as painted
    check(base.crop((SP[0][0], SP[0][1], SP[0][0] + SP[0][2], SP[0][1] + SP[0][3])), 'DA_EL_plate_research')
    check(base.crop((SP[1][0], SP[1][1], SP[1][0] + SP[1][2], SP[1][1] + SP[1][3])), 'DA_EL_plate_studies')
    # the crystal: as painted, and glowing (the Guide shown)
    x, y, w, h = CRYSTAL
    cry = base.crop((x, y, x + w, y + h))
    lit = ImageEnhance.Brightness(cry).enhance(1.45)
    glow = Image.new('RGBA', cry.size, (0, 0, 0, 0))
    ImageDraw.Draw(glow).ellipse([3, 6, w - 4, h - 7], fill=TEAL + (90,))
    lit = Image.alpha_composite(lit, glow.filter(ImageFilter.GaussianBlur(4)))
    strip = Image.new('RGBA', (w * 2, h))
    strip.paste(cry, (0, 0))
    strip.paste(lit, (w, 0))
    check(strip, 'DA_EL_crystal')

    # buttons: dark teal glass in a gold rim, as the frame's plates
    def glass(w, h, rad=6):
        im = Image.new('RGBA', (w, h), (0, 0, 0, 0))
        dd = ImageDraw.Draw(im)
        dd.rounded_rectangle([0, 0, w - 1, h - 1], radius=rad, fill=(40, 30, 14, 255))
        dd.rounded_rectangle([1, 1, w - 2, h - 2], radius=rad, fill=(206, 168, 96, 255))
        dd.rounded_rectangle([2, 2, w - 3, h - 3], radius=rad - 1, fill=(110, 84, 40, 255))
        dd.rounded_rectangle([3, 3, w - 4, h - 4], radius=rad - 2, fill=(22, 58, 60, 255))
        dd.line([7, 4, w - 8, 4], fill=(70, 128, 124, 255))
        dd.line([7, h - 5, w - 8, h - 5], fill=(10, 30, 32, 255))
        return im
    check(glass(*BTN), 'DA_EL_btn')
    check(Image.new('RGBA', BP[2][2:], (0, 0, 0, 0)), 'DA_EL_plate_hit')   # DA_EL (doc 72): clear, over the plate
    check(glass(*BTN_W), 'DA_EL_btn_wide')
    check(glass(*BTN_B, rad=7), 'DA_EL_btn_build')
    # the selection frame of a cell
    sel = Image.new('RGBA', (CW, CH), (0, 0, 0, 0))
    sd = ImageDraw.Draw(sel)
    for r, a in ((1, 255), (3, 150), (5, 60)):
        sd.rounded_rectangle([r, r, CW - 1 - r, CH - 1 - r], radius=6, outline=(255, 226, 150, a), width=2)
    check(sel.filter(ImageFilter.GaussianBlur(0.5)), 'DA_EL_cell_sel')
    # pips
    pip = Image.new('RGBA', (PIP * 2, PIP), (0, 0, 0, 0))
    pd = ImageDraw.Draw(pip)
    pd.ellipse([1, 1, PIP - 2, PIP - 2], fill=(30, 46, 46, 255), outline=(110, 96, 70, 255))
    pd.ellipse([PIP + 1, 1, 2 * PIP - 2, PIP - 2], fill=TEAL + (255,), outline=(240, 220, 160, 255))
    check(pip, 'DA_EL_pip')

    # the emblems of the schools: Anbennar's magic school icons; the God Fragment's diamond drawn here
    anb = ANBENNAR or os.path.join(os.path.dirname(os.path.abspath(ROOT)), 'anbennar-eu4-dev-new-master')

    def emblem(sid, size=34):
        p = os.path.join(anb, 'gfx/interface/custom_gui/magic/magic_%s_icon.dds' % sid)
        if sid != 'fragment' and os.path.exists(p):
            try:
                im = read_dds(p)
                bb = im.getbbox()
                if bb:
                    im = im.crop(bb)
                im.thumbnail((size, size), Image.LANCZOS)
                return im
            except Exception:
                pass
        im = Image.new('RGBA', (size, size), (0, 0, 0, 0))
        dd = ImageDraw.Draw(im)
        c = size // 2
        dd.polygon([(c, 2), (size - 4, c), (c, size - 3), (3, c)], fill=(200, 236, 236, 255), outline=(255, 255, 255, 255))
        dd.polygon([(c, 8), (size - 10, c), (c, size - 9), (9, c)], fill=TEAL + (255,))
        return im

    def medallion(sid, state, shape='circle'):
        """state: 'dark', 'dim', 'lit', 'gold'"""
        im = Image.new('RGBA', (ICON, ICON), (0, 0, 0, 0))
        dd = ImageDraw.Draw(im)
        ring = {'dark': (70, 86, 86), 'dim': (90, 130, 126), 'lit': TEAL, 'gold': GOLD}[state]
        face = {'dark': (16, 28, 30), 'dim': (20, 44, 46), 'lit': (22, 62, 62), 'gold': (40, 52, 40)}[state]
        box = [3, 3, ICON - 4, ICON - 4]
        if shape == 'circle':
            dd.ellipse(box, fill=face + (255,), outline=ring + (255,), width=3)
        else:
            dd.rounded_rectangle(box, radius=9, fill=face + (255,), outline=ring + (255,), width=3)
        if state in ('lit', 'gold'):
            g = Image.new('RGBA', (ICON, ICON), (0, 0, 0, 0))
            gd = ImageDraw.Draw(g)
            if shape == 'circle':
                gd.ellipse([1, 1, ICON - 2, ICON - 2], outline=ring + (120,), width=3)
            else:
                gd.rounded_rectangle([1, 1, ICON - 2, ICON - 2], radius=10, outline=ring + (120,), width=3)
            im = Image.alpha_composite(g.filter(ImageFilter.GaussianBlur(1.5)), im)
        e = emblem(sid)
        if state == 'dark':
            e = ImageOps.grayscale(e.convert('RGB')).convert('RGBA')
            e.putalpha(Image.eval(emblem(sid).split()[3], lambda v: v * 30 // 100))
        elif state == 'dim':
            e = ImageEnhance.Color(e).enhance(0.45)
            e = ImageEnhance.Brightness(e).enhance(0.8)
        im.alpha_composite(e, ((ICON - e.size[0]) // 2, (ICON - e.size[1]) // 2))
        return im

    def strip(frames):
        s = Image.new('RGBA', (ICON * len(frames), ICON), (0, 0, 0, 0))
        for k, f in enumerate(frames):
            s.paste(f, (k * ICON, 0))
        return s
    for s in E.SCHOOLS:
        sid = s['id']
        check(strip([medallion(sid, 'dark'), medallion(sid, 'lit')]), 'DA_EL_cx_%s' % sid)
        check(strip([medallion(sid, st, 'square') for st in ('dark', 'dim', 'lit', 'gold')]), 'DA_EL_art_%s' % sid)

    # the marvels: your pictures, cropped to the left panel (280 x 310); dark until raised
    def picture(m):
        p = os.path.join(ROOT, MARVEL_SRC % m['pic'])
        im = Image.open(p).convert('RGBA')
        tw, th = LP[2], LP[3]
        r = max(tw / im.size[0], th / im.size[1])
        im = im.resize((int(round(im.size[0] * r)), int(round(im.size[1] * r))), Image.LANCZOS)
        x0 = (im.size[0] - tw) // 2
        y0 = (im.size[1] - th) // 2
        im = im.crop((x0, y0, x0 + tw, y0 + th))
        # the name strip: a dark band at the bottom
        a = np.array(im).astype(float)
        yy = np.arange(th)[:, None]
        shade = np.clip((yy - (th - 60)) / 40.0, 0, 1) * 0.75
        a[..., :3] *= (1 - shade)[..., None]
        # rounded inner corners, inside the panel's gold rim
        im = Image.fromarray(a.clip(0, 255).astype(np.uint8), 'RGBA')
        mask = Image.new('L', (tw, th), 0)
        ImageDraw.Draw(mask).rounded_rectangle([3, 3, tw - 4, th - 4], radius=6, fill=255)
        im.putalpha(mask)
        dark = ImageEnhance.Brightness(ImageEnhance.Color(im).enhance(0.25)).enhance(0.45)
        dark.putalpha(mask)
        return dark, im
    for m in E.MARVELS:
        dark, lit = picture(m)
        s = Image.new('RGBA', (LP[2] * 2, LP[3]), (0, 0, 0, 0))
        s.paste(dark, (0, 0))
        s.paste(lit, (LP[2], 0))
        check(s, 'DA_EL_pic_%s' % m['id'])
        # the cell: a round crop of the picture
        cut = lit.crop((40, 40, LP[2] - 40, LP[2] - 40)).resize((ICON - 8, ICON - 8), Image.LANCZOS)
        mk = Image.new('L', cut.size, 0)
        ImageDraw.Draw(mk).ellipse([0, 0, cut.size[0] - 1, cut.size[1] - 1], fill=255)

        def cell(state):
            im = Image.new('RGBA', (ICON, ICON), (0, 0, 0, 0))
            dd = ImageDraw.Draw(im)
            ring = {'dark': (70, 86, 86), 'dim': (120, 150, 140), 'gold': GOLD}[state]
            dd.ellipse([1, 1, ICON - 2, ICON - 2], fill=(16, 28, 30, 255), outline=ring + (255,), width=3)
            c = cut.copy()
            if state == 'dark':
                c = ImageEnhance.Brightness(ImageEnhance.Color(c).enhance(0.0)).enhance(0.25)
            if state == 'dim':
                c = ImageEnhance.Color(c).enhance(0.35)
            c.putalpha(mk)
            im.alpha_composite(c, (4, 4))
            return im
        check(strip([cell('dark'), cell('dim'), cell('gold')]), 'DA_EL_mv_%s' % m['id'])
    for lg in E.LEGENDS:
        im = Image.new('RGBA', (ICON, ICON), (0, 0, 0, 0))
        dd = ImageDraw.Draw(im)
        dd.ellipse([3, 3, ICON - 4, ICON - 4], fill=(18, 22, 26, 255), outline=(120, 110, 90, 255), width=3)
        c = ICON // 2
        if lg['id'] == 'warden':        # a shield
            dd.polygon([(c - 12, c - 13), (c + 12, c - 13), (c + 12, c + 2), (c, c + 15), (c - 12, c + 2)],
                       outline=(200, 190, 160, 255), width=2)
            dd.ellipse([c - 4, c - 6, c + 4, c + 2], fill=TEAL + (255,))
        elif lg['id'] == 'challumaton':  # a dragon's eye
            dd.ellipse([c - 15, c - 8, c + 15, c + 8], outline=(220, 220, 210, 255), width=2)
            dd.ellipse([c - 3, c - 8, c + 3, c + 8], fill=(160, 200, 230, 255))
        else:                            # a seed
            dd.ellipse([c - 9, c - 13, c + 9, c + 13], outline=(170, 200, 120, 255), width=2)
            dd.line([c, c - 10, c, c + 10], fill=(170, 200, 120, 255), width=2)
        check(im, 'DA_EL_lg_%s' % lg['id'])
    if preview:
        for p_ in render_report(E, files, preview):
            REPORT.append('preview: ' + p_)


