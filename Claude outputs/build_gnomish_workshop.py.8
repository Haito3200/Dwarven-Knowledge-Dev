    for key, text in loc.items():
        for pre, (w, h, font) in boxes.items():
            if key.startswith(pre) and not key.endswith('_tt'):
                lines, shown, cut, widest, too_wide = T.fit(font, text, w, h, T.PESSIMISTIC)
                if cut:
                    bad.append('%s: %d lines in %d px' % (key, len(lines), h))
    return bad + render_report()


def generated():
    """What the build writes, as text (the previews and the fit report read these, not the files on disk)."""
    return {'common/scripted_triggers/DA_GN_triggers.txt': gen_triggers(),
            'common/custom_gui/DA_GN_Workshop.txt': gen_custom_gui(),
            'customizable_localization/DA_GN_custom_loc.txt': gen_custom_loc(),
            'localisation/DA_GN_l_english.yml': fix_overcap_loc(gen_loc()),
            'interface/DA_GN_Workshop.gfx': gen_gfx()}


def preview_states():
    """bench: the Spyglass on the bench (7 of 12 months), patents in every state; gommo: the International Gommo
    view (two branches, a licence)."""
    import eu4_gui as UI
    sp = G.PATENT['spyglass']
    flags = ['DA_PR_done.GN_Workshop', 'DA_PR_done.GN_Bureau', 'DA_GN_on.cocolocogram', 'DA_GN_proto.recuverinator',
             'DA_GN_proto.dynamos', 'DA_GN_proto.crammers', 'DA_GN_bench_busy']
    vars_ = {'DA_GN_sel': i_of(sp), 'DA_GN_job': job_proto(sp), 'DA_GN_job_pct': 58, 'DA_GN_job_done': 7, 'DA_GN_job_months': 12,
             'DA_GN_branch_count': 2, 'DA_GN_lic_count': 1, 'DA_GN_lic_income': 24}
    answers = {'DA_GN_st_bench_spyglass': True, 'DA_RH_primary_gnomish': True, 'DA_GN_lead_mechanist': True}
    return [('bench', UI.State(flags, vars_, answers=answers)),
            ('hall', UI.State(flags + ['DA_GN_page_gommo'], vars_, answers=answers)),
            ('gommo', UI.State(flags + ['DA_GN_view_gommo'], vars_, answers=answers)),
            ('guide', UI.State(flags + ['DA_GN_guide'], vars_, answers=answers)),
            # DA_EL (doc 72): the Precursor view: Spire-Glass Lenses recovered and selected, two samples
            ('precursor', UI.State(flags + ['DA_GN_pv', 'DA_PR_done.GN_Surveys', 'DA_PR_done.GN_Assays', 'DA_PR_done.GN_Reverse',
                                            'DA_GN_pre.lenses'], dict(vars_, DA_GN_sel=i_of(PRE[0]), DA_GN_samples=2),
                                   answers=answers))]


def render_report(out=None, view=None):
    """Draw the window in one sample state (view; out: a .png) or lay out every state; the problems found."""
    import eu4_gui as UI
    mod = UI.Mod(ROOT, overrides=generated(), windows={'DA_GN_workshop': gen_window()})
    probs = []
    for name, st in preview_states():
        if view and name != view:
            continue
        rep_, _ = UI.render(mod, 'DA_GN_workshop', st, out if view else None)
        probs += ['%s: %s: %s' % (name, el_, issue) for el_, issue in rep_ if el_ != '(trigger)']
    if out and view:
        REPORT.append('preview ' + out)
    return probs


def draw_preview(base, out, Image=None, ImageDraw=None, ImageFont=None, view='bench'):
    """The window as the game draws it (eu4_gui.py): the generated GUI, its conditions, the game's own fonts."""
    for p_ in render_report(out, view):
        REPORT.append('preview: ' + p_)


