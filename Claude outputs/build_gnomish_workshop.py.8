    x0, y0, x1, y1 = cell(i)
    return (x0 + x1) // 2 - SLOT // 2, y0 + (y1 - y0 - SLOT - 20) // 2


def tb(name, x, y, w, h, font='vic_18', fmt='left', text='', scripted=True):
    ex = ['textureFile = ""', 'font = "%s"' % font, 'borderSize = {x = 0 y = 0}', 'text = "%s"' % text,
          'maxWidth = %d' % w, 'maxHeight = %d' % h, 'format = %s' % fmt]
    if scripted:
        ex.append('scripted = yes')
    ex.append('alwaystransparent = yes')
    return ['instantTextBoxType = {', '\tname = "%s"' % name, '\tposition = { x = %d y = %d }' % (x, y)] + ['\t' + e for e in ex] + ['}']


def el(kind, name, x, y, sprite, extra=(), quad=False):
