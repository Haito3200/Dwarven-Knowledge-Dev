SRC = 'Claude files/art_sources/racial_windows/gommo_workshop_frame_v3.png'
OLD_SRC = 'Claude files/art_sources/racial_windows/gommo_workshop_frame.png'
# where the gems of gommo_workshop_frame.png are (source pixels)
GEM_CENTRES = {'building': (870, 55), 'metal': (981, 55), 'essence': (1094, 55), 'capacity': (1206, 55)}
TEAL = (52, 112, 124)
TEAL_LIT = (120, 220, 228)
SEG_LIT = (92, 184, 192)           # the lit segments: a little darker, for the text over them
BRASS = (190, 148, 82)


def art(preview=None, view='bench'):
    import struct
    import numpy as np
    from PIL import Image, ImageDraw, ImageFilter, ImageEnhance

    def write_dds(img, rel):
        img = img.convert('RGBA')
        w, h = img.size
        a = np.array(img)
        data = a[:, :, [2, 1, 0, 3]].tobytes()
        hdr = struct.pack('<4s7I44s8I5I', b'DDS ', 124, 0x100f, h, w, w * 4, 0, 1, b'\0' * 44,
                          32, 0x41, 0, 32, 0xff0000, 0xff00, 0xff, 0xff000000, 0x1000, 0, 0, 0, 0)
        full = path(rel)
        data = hdr + data
        old = open(full, 'rb').read() if os.path.exists(full) else None
        REPORT.append(('same    ' if old == data else ('changed ' if old else 'new     ')) + rel)
        if old != data and MODE != 'check':
            os.makedirs(os.path.dirname(full), exist_ok=True)
            open(full, 'wb').write(data)

    orig = Image.open(path(SRC)).convert('RGBA')
    if orig.size != (1536, 1024):
        raise SystemExit('%s: expected 1536 x 1024, found %d x %d' % (SRC, orig.size[0], orig.size[1]))
    # 1. the large panel without its cells: the navy of the panel between its cells (its median colour, the grain of a
    #    cell's inside), feathered at its edges. The cells come back as an icon on the Patents page (DA_GN_grid), so
    #    the other pages have the whole panel for their text.
    oa = np.array(orig).astype(np.float64)
    # the picture's soft edge is a brown halo: over the map it reads better as a shadow
    al = oa[..., 3:4]
    oa[..., :3] *= np.where(al < 230, (al / 230.0) ** 1.5, 1.0)
    orig = Image.fromarray(oa.clip(0, 255).astype(np.uint8), 'RGBA')
    rgb = oa[..., :3]
    gx0, gy0, gx1, gy1 = SRC_GRID
    gw, gh = gx1 - gx0, gy1 - gy0
    gaps = np.concatenate([rgb[SRC_ROWS[0][1] + 4:SRC_ROWS[1][0] - 4, gx0 + 20:gx1 - 20].reshape(-1, 3),
                           rgb[gy0 + 20:gy1 - 20, SRC_COLS[0][1] + 4:SRC_COLS[1][0] - 4].reshape(-1, 3)])
    inside = rgb[SRC_ROWS[0][0] + 12:SRC_ROWS[0][1] - 12, SRC_COLS[0][0] + 12:SRC_COLS[0][1] - 12]
    hp = inside - np.array(Image.fromarray(inside.clip(0, 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(4))).astype(float)
    rs = np.random.RandomState(66)
    grain = rs.normal(0, 1, (gh, gw))
    grain = np.array(Image.fromarray(((grain * 40) + 128).clip(0, 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(0.6))).astype(float) - 128
    grain *= hp.std() / (grain.std() + 1e-9)
    low = rs.normal(0, 1, (gh // 40 + 2, gw // 40 + 2))
    low = np.array(Image.fromarray(((low * 40) + 128).clip(0, 255).astype(np.uint8)).resize((gw, gh), Image.BICUBIC)).astype(float) - 128
    low *= 2.0 / (low.std() + 1e-9)
    fillv = np.median(gaps, 0)[None, None, :] + (grain + low)[..., None]
    m = np.zeros((gh, gw))
    m[SRC_FILL[1] - gy0:SRC_FILL[3] - gy0, SRC_FILL[0] - gx0:SRC_FILL[2] - gx0] = 1
    m = np.array(Image.fromarray((m * 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(1.2))).astype(float) / 255
    oa2 = oa.copy()
    oa2[gy0:gy1, gx0:gx1, :3] = rgb[gy0:gy1, gx0:gx1] * (1 - m[..., None]) + fillv * m[..., None]
    empty = Image.fromarray(oa2.clip(0, 255).astype(np.uint8), 'RGBA')
    # scaled with premultiplied alpha: the picture's transparent pixels carry stray colours that would bleed in
    full = orig.convert('RGBa').resize((W, H), Image.LANCZOS).convert('RGBA')
    base = empty.convert('RGBa').resize((W, H), Image.LANCZOS).convert('RGBA')
    write_dds(full.crop(GRID), ART + '/DA_GN_grid.dds')
    # DA_EL (doc 72): the Precursor view: the first row of cells and the summary cell, the rest of the panel plain
    gpv = base.crop(GRID)
    for n in (1, 2, 3, 4, 5, 15):
        bx = cell(n)
        box = (bx[0] - 4, bx[1] - 4, bx[2] + 4, bx[3] + 4)
        gpv.paste(full.crop(box), (box[0] - GRID[0], box[1] - GRID[1]))
    write_dds(gpv, ART + '/DA_GN_grid_pv.dds')
    c15 = cell(15)
    write_dds(Image.new('RGBA', (c15[2] - c15[0], c15[3] - c15[1]), (0, 0, 0, 0)), ART + '/DA_GN_cell_hit.dds')
    # 2. the gems of the first frame beside the counters
    old = Image.open(path(OLD_SRC)).convert('RGB')
    for key, ci, row in COUNTERS:
        x0, y0 = CELLS[ci][0], CELLS[ci][1] + 4 + row * COUNTER_ROW
        cx, cy = GEM_CENTRES[key]
        gem = old.crop((cx - 13, cy - 13, cx + 13, cy + 13)).resize((GEM, GEM), Image.LANCZOS).convert('RGBA')
        mk = Image.new('L', (GEM, GEM), 0)
        ImageDraw.Draw(mk).ellipse([1, 1, GEM - 2, GEM - 2], fill=255)
        gem.putalpha(mk.filter(ImageFilter.GaussianBlur(0.6)))
        base.alpha_composite(gem, (x0 + 10, y0 + 3))
    write_dds(base, ART + '/DA_GN_window.dds')

    # 3. the tabs: the plate as painted, and lit (the page shown): brighter, with a teal glow inside its rim
    for k, (x0, y0, x1, y1) in enumerate(TABS, 1):
        box = (x0 - TAB_PAD, y0 - TAB_PAD, x1 + TAB_PAD, y1 + TAB_PAD)
        im = full.crop(box)
        lit = ImageEnhance.Brightness(im).enhance(1.25)
        glow = Image.new('RGBA', im.size, (0, 0, 0, 0))
        gd = ImageDraw.Draw(glow)
        w, h = im.size
        for r, a in ((0, 200), (2, 110), (4, 50)):
            gd.rounded_rectangle([TAB_PAD + 1 + r, TAB_PAD + 1 + r, w - TAB_PAD - 2 - r, h - TAB_PAD - 2 - r], radius=5,
                                 outline=TEAL_LIT + (a,), width=2)
        lit.alpha_composite(glow)
        strip = Image.new('RGBA', (w * 2, h))
        strip.paste(im, (0, 0))
        strip.paste(lit, (w, 0))
        write_dds(strip, ART + '/DA_GN_tab_%d.dds' % k)
    # 4. the three plates at the bottom, as painted
    for k, box in enumerate(BUTTONS, 1):
        write_dds(full.crop(box), ART + '/DA_GN_big_%d.dds' % k)
    # 5. a lit segment of the bar: teal light behind the glass
    sw = min(SEGS[k + 1] - SEGS[k] for k in range(14)) - 2
    sh = BAR[3] - BAR[1] - 2
    seg = Image.new('RGBA', (sw, sh), (0, 0, 0, 0))
    a = np.zeros((sh, sw, 4))
    yy = np.linspace(0, 1, sh)[:, None]
    for c in range(3):
        a[..., c] = TEAL[c] + (SEG_LIT[c] - TEAL[c]) * (1 - np.abs(yy - 0.4) * 1.6).clip(0, 1)
    a[..., 3] = 215
    seg = Image.fromarray(a.clip(0, 255).astype(np.uint8), 'RGBA')
    mk = Image.new('L', (sw, sh), 0)
    ImageDraw.Draw(mk).rounded_rectangle([1, 1, sw - 2, sh - 2], radius=3, fill=215)
    seg.putalpha(mk.filter(ImageFilter.GaussianBlur(0.8)))
    write_dds(seg, ART + '/DA_GN_bar_seg.dds')
    # 6. the brass rule between the two columns of The Gommo page
    rh = PANEL[3] - PANEL[1] - 28
    rule = Image.new('RGBA', (6, rh), (0, 0, 0, 0))
    rd = ImageDraw.Draw(rule)
    rd.line([2, 0, 2, rh], fill=BRASS + (255,), width=2)
    rd.line([4, 0, 4, rh], fill=(20, 16, 10, 170), width=1)
    rd.line([1, 0, 1, rh], fill=(240, 205, 140, 120), width=1)
    write_dds(rule, ART + '/DA_GN_page_rule.dds')

    # 7. the small buttons: brass rim, teal glass, as the plates of the frame
    def teal_button(w, h, rad=5):
        im = Image.new('RGBA', (w, h), (0, 0, 0, 0))
        dd = ImageDraw.Draw(im)
        dd.rounded_rectangle([0, 0, w - 1, h - 1], radius=rad, fill=(78, 52, 22, 255))
        dd.rounded_rectangle([1, 1, w - 2, h - 2], radius=rad, fill=(214, 170, 96, 255))
        dd.rounded_rectangle([2, 2, w - 3, h - 3], radius=rad - 1, fill=(118, 82, 38, 255))
        dd.rounded_rectangle([3, 3, w - 4, h - 4], radius=rad - 2, fill=TEAL + (255,))
        dd.line([6, 4, w - 7, 4], fill=(110, 170, 178, 255))
        dd.line([6, h - 5, w - 7, h - 5], fill=(24, 58, 66, 255))
        return im
    write_dds(teal_button(*BTN), ART + '/DA_GN_button_wide.dds')
    write_dds(teal_button(*SBTN), ART + '/DA_GN_button.dds')
    plus = teal_button(22, 20, rad=4)
    dd = ImageDraw.Draw(plus)
    dd.rectangle([10, 5, 11, 14], fill=(245, 214, 140, 255))
    dd.rectangle([6, 9, 15, 10], fill=(245, 214, 140, 255))
    write_dds(plus, ART + '/DA_GN_plus.dds')
    write_dds(Image.new('RGBA', (CELLS[0][2] - CELLS[0][0] - 8, COUNTER_ROW - 2), (0, 0, 0, 0)), ART + '/DA_GN_counter_tip.dds')

    # 8. patent icons: 5 frames (locked, ready, on the bench, prototyped, on) from Anbennar's invention buttons
    T = SLOT
    write_dds(slot_ring(Image, ImageDraw), ART + '/DA_GN_slot_sel.dds')
    for p in P:
        strip = Image.new('RGBA', (T * 5, T))
        for state in range(1, 6):
            strip.paste(patent_icon(p, state, T, Image, ImageDraw), ((state - 1) * T, 0))
        write_dds(strip, ART + '/DA_GN_patent_%s.dds' % p['id'])
    # DA_EL (doc 72): Assay a Relic and the Gommo Survey: brass and teal glass, greyed until their tile
    for key in ('assay', 'survey'):
        strip = Image.new('RGBA', (T * 2, T))
        strip.paste(commission_icon(key, False, T, Image, ImageDraw), (0, 0))
        strip.paste(commission_icon(key, True, T, Image, ImageDraw), (T, 0))
        write_dds(strip, ART + '/DA_GN_%s.dds' % key)
    if preview:
        draw_preview(base, preview, view=view)


ANBENNAR = os.environ.get('DA_ANBENNAR') or os.path.join(os.path.dirname(os.path.abspath(ROOT)), 'anbennar-eu4-dev-new-master')
INNOVATION = 'gfx/interface/custom_gui/artificery/artificery_innovation_%s.dds'   # Anbennar's invention buttons
STAR = ('gfx/interface/privileges/Artf_MaMi1.dds', (38, 37, 50, 48))            # the tier star of its invention privileges
BENCH_RING = (120, 210, 250)       # the bench's blue: a patent whose prototype is on the bench
SEL_RING = (250, 246, 232)         # the selected patent: white, as gold is Anbennar's colour for an active invention
_ICONS = {}


def anbennar_image(rel, Image):
    """A texture of Anbennar (the folder next to the mod, or DA_ANBENNAR), as RGBA. Its invention buttons are DX10
    B8G8R8A8 textures, which Pillow does not read."""
    import struct
    import numpy as np
    full = os.path.join(ANBENNAR, rel)
    if not os.path.exists(full):
        raise SystemExit('the patent icons are drawn from Anbennar\'s invention buttons: %s is missing. Put Anbennar next '
                         'to the mod or set DA_ANBENNAR to its folder.' % full)
    raw = open(full, 'rb').read()
    if raw[84:88] != b'DX10':
        return Image.open(full).convert('RGBA')
    h, w = struct.unpack('<2I', raw[12:20])
    fmt = struct.unpack('<I', raw[128:132])[0]
    if fmt not in (28, 29, 87, 91):
        raise SystemExit('%s: DXGI format %d is not read here' % (rel, fmt))
    a = np.frombuffer(raw[148:148 + w * h * 4], np.uint8).reshape(h, w, 4)
    if fmt in (87, 91):
        a = a[:, :, [2, 1, 0, 3]]
    return Image.fromarray(a.copy(), 'RGBA')


def greyed(im, Image):
    """Grey as Anbennar greys a locked invention (0.91 x the luminance of the unlocked button)."""
    import numpy as np
    a = np.asarray(im).astype(float)
    g = np.clip(0.91 * (0.299 * a[..., 0] + 0.587 * a[..., 1] + 0.114 * a[..., 2]) + 2, 0, 255)
    return Image.fromarray(np.dstack([g, g, g, a[..., 3]]).astype(np.uint8), 'RGBA')


def invention_frames(kind, T, Image):
    """Anbennar's invention button of this kind at T px: locked (grey), unlocked, active (a gold glow). Its 78-px
    buttons are scaled down (sharper than its 48-px ones). The society button has no grey frame in Anbennar (its
    first frame is coloured): one is made from the unlocked frame."""
    import numpy as np
    if (kind, T) not in _ICONS:
        im = anbennar_image(INNOVATION % kind, Image)
        w = im.size[1]
        fr = [im.crop((k * w, 0, (k + 1) * w, w)) for k in range(3)]
        a = np.asarray(fr[0]).astype(float)
        if np.abs(a[..., 0] - a[..., 2])[a[..., 3] > 200].mean() > 8:
            fr[0] = greyed(fr[1], Image)
        _ICONS[(kind, T)] = [f.resize((T, T), Image.LANCZOS) for f in fr]
    return _ICONS[(kind, T)]


def tier_stars(tier, grey, Image):
    """The stars Anbennar puts on its invention privileges, one per tier, 7 px apart."""
    if 'star' not in _ICONS:
        rel, box = STAR
        _ICONS['star'] = anbennar_image(rel, Image).crop(box)
        _ICONS['star_grey'] = greyed(_ICONS['star'], Image)
    st = _ICONS['star_grey' if grey else 'star']
    out = Image.new('RGBA', (st.size[0] + 7 * (tier - 1), st.size[1]), (0, 0, 0, 0))
    for j in range(tier):
        out.alpha_composite(st, (7 * j, 0))
    return out


def patent_icon(p, state, T, Image, ImageDraw):
    """The patent's button (doc 54): Anbennar's invention button of its kind, with its tier in Anbennar's stars.
    state: 1 locked (Anbennar's grey frame), 2 ready for a prototype (half its colour), 3 its prototype on the bench
    (the same, ringed in the bench's blue), 4 prototyped (Anbennar's unlocked frame), 5 on (Anbennar's active frame)."""
    from PIL import ImageEnhance
    locked, unlocked, active = invention_frames(p['icon'], T, Image)
    if state == 1:
        im = locked.copy()
    elif state in (2, 3):
        im = ImageEnhance.Brightness(Image.blend(unlocked, locked, 0.5)).enhance(0.85)
    else:
        im = (unlocked if state == 4 else active).copy()
    if p.get('precursor') and state > 1:   # DA_EL (doc 72): a Precursor patent glows teal, as the Precursor ruins
        glow = Image.new('RGBA', im.size, (0, 0, 0, 0))
        gd = ImageDraw.Draw(glow)
        for r, a in ((4, 120), (6, 70), (8, 30)):
            gd.rounded_rectangle([r, r, T - 1 - r, T - 1 - r], radius=5, outline=(110, 230, 220, a), width=2)
        im.alpha_composite(glow)
    if state == 3:
        ImageDraw.Draw(im).rounded_rectangle([3, 3, T - 4, T - 4], radius=4, outline=BENCH_RING + (255,), width=2)
    stars = tier_stars(p['tier'], state == 1, Image)
    im.alpha_composite(stars, (T - 3 - stars.size[0], T - 2 - stars.size[1]))
    return im


def commission_icon(key, lit, T, Image, ImageDraw):
    """DA_EL (doc 72): the buttons of Assay a Relic (a flask over a relic shard) and of a Gommo Survey (a compass rose), in
    the Workshop's brass and teal; grey until their tile is done."""
    import math
    im = Image.new('RGBA', (T, T), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)
    rim, glass, ink = ((214, 170, 96), (52, 112, 124), (245, 222, 160)) if lit else ((150, 150, 150), (70, 74, 78), (190, 190, 190))
    d.rounded_rectangle([1, 1, T - 2, T - 2], radius=8, fill=(40, 30, 16, 255))
    d.rounded_rectangle([3, 3, T - 4, T - 4], radius=7, fill=rim + (255,))
    d.rounded_rectangle([5, 5, T - 6, T - 6], radius=6, fill=glass + (255,))
    c = T // 2
    if key == 'assay':
        d.polygon([(c - 4, 11), (c + 4, 11), (c + 4, 19), (c + 12, 35), (c - 12, 35), (c - 4, 19)], outline=ink + (255,), width=2)
        d.line([c - 6, 11, c + 6, 11], fill=ink + (255,), width=2)
        d.polygon([(c - 9, 30), (c + 9, 30), (c + 11, 34), (c - 11, 34)], fill=(120, 230, 220, 255) if lit else (160, 160, 160, 255))
        d.polygon([(c + 8, 22), (c + 14, 18), (c + 16, 24)], fill=(120, 230, 220, 255) if lit else (160, 160, 160, 255))
    else:
        d.ellipse([c - 15, c - 15, c + 15, c + 15], outline=ink + (255,), width=2)
        for a in range(8):
            r = 13 if a % 2 == 0 else 8
            x, y = c + r * math.cos(a * math.pi / 4 - math.pi / 2), c + r * math.sin(a * math.pi / 4 - math.pi / 2)
            d.polygon([(c, c), (x, y), (c + 2 * math.cos(a * math.pi / 4), c + 2 * math.sin(a * math.pi / 4))],
                      fill=((120, 230, 220, 255) if a == 0 and lit else ink + (255,)))
        d.ellipse([c - 2, c - 2, c + 2, c + 2], fill=rim + (255,))
    return im


def slot_ring(Image, ImageDraw):
    """The selected patent: a white ring round its button, over the recess."""
    R = SLOT + 6
    im = Image.new('RGBA', (R, R), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)
    d.rounded_rectangle([0, 0, R - 1, R - 1], radius=6, outline=SEL_RING + (255,), width=2)
    d.rounded_rectangle([2, 2, R - 3, R - 3], radius=5, outline=SEL_RING + (110,), width=1)
    return im


def sample_loc():
    loc = {}
    for line in fix_overcap_loc(gen_loc()).splitlines()[1:]:
        m = re.match(r' ([\w.\-]+):0 "(.*)"$', line)
        if m:
            loc[m.group(1)] = m.group(2).replace('\\n', '\n').replace('\\"', '"')
