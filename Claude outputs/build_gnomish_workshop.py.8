#!/usr/bin/env python3
"""The Gommo Workshop: the gnomes' hall (doc 48; step 1 doc 52, step 2 doc 53).

    python3 "Claude files/tools/build_gnomish_workshop.py" .                  write scripts, window, texts, tester
    python3 "Claude files/tools/build_gnomish_workshop.py" . art              draw the textures (Pillow, numpy)
    python3 "Claude files/tools/build_gnomish_workshop.py" . preview F        draw a preview of the window into F (PNG)
    python3 "Claude files/tools/build_gnomish_workshop.py" . preview F gommo  ... with the International Gommo shown
    python3 "Claude files/tools/build_gnomish_workshop.py" . check            report only

Safe to re-run. The tables are in gnomish_data.py. The Gnomish page itself is written by build_projects_research.py,
the race and its living bonuses by build_racial_heritage.py, the hub plaque by build_racial_hub.py.

What it writes
  * The Gommo Artificer Corps: DA_GN_artificer_corps (the effects of DA_General_Research_events .11 and .14, without
    their requirements and without debuff_artifice_points_5), the day-one event DA_GN_event.1.
  * The second bench: DA_GN_has_bench, DA_GN_bench_free; one commission at a time (prototype, improvement, Inventors'
    Fair) with a monthly tick; the hidden event DA_GN_event.2 ends it (Serendipity and Misfire are rolled there, never
    in a button) and DA_GN_event.3 reports it.
  * Patents: switched on and off on Anbennar's artifice capacity, booked through DA_GN_booked_capacity on the Pioneer
    pattern (DA_GN_reconcile_capacity: take the booking off ArtificeUpkeep, count it again from the flags, add it back,
    update_artifice_points). Over capacity, the dearest patent switches off first (yearly).
  * The window DA_GN_workshop (topbar.gui, inside DA_BLOCK windows), its scripts, texts and art. The art (second
    version, 17 November) is the frame gommo_workshop_frame_v2.png, lit, with blueprint-paper panels; the round buttons
    come from gommo_nav_buttons.png, the plates and the counter gems from gommo_workshop_frame.png (all three in
    "Claude files/art_sources/racial_windows/"). "preview" also lists every text that would not fit its box.
    The patents' buttons (doc 54) are Anbennar's invention buttons (gfx/interface/custom_gui/artificery/
    artificery_innovation_<military|economic|society>.dds, the patent's "icon") with the stars of its invention
    privileges for the tier; art and preview read them from Anbennar next to the mod, or from DA_ANBENNAR.
  * The yearly pulse: the Corps check, Universal Sprockets, royalties, Reclaimed Homeland, the lead school, capacity.
  * DA_GN_tester.txt at the mod root.

Step 2 (doc 53)
  * Gommo Branches: the diplomatic action DA_GN_open_branch (common/new_diplomatic_actions/DA_GN_diplomatic_actions.txt)
    puts a branch on the bench for an ally or a subject; the host carries DA_GN_branch_<our tag> and its capital the
    modifier DA_GN_gommo_branch, renewed every year while it stays our ally or subject; DA_GN_branches_<n> gives us
    the artifice capacity. DA_GN_branches_upkeep counts them again and closes the lost ones.
  * Licences: the diplomatic action DA_GN_license_patent opens DA_GN_event.10 (which patent), the licensee answers in
    .11 (the AI by opinion and treasury), .12 tells us; the licensee carries DA_GN_lic_<patent>_<our tag> and the
    modifier DA_GN_lic_<patent> (15 years), and the opinion DA_GN_licence. DA_GN_licences_upkeep ends a licence
    whose patent is off, whose licensee is no longer an ally or subject, or whose heritage is dormant; the fees are
    paid yearly.
  * The Great Ideation Engine: a commission (the Workshop's International Gommo view), then DA_GN_engine_built: research
    speed (triggered modifier DA_GN_engine), commissions a quarter faster, innovativeness.
  * Gommo Calibration: a Primary Technology of the Unit Design (artillery, artificers) between "# BEGIN DA_GN" and
    "# END DA_GN" in events/DA_Metallurgy_events_<class>_0.txt, before the obsidian block; its lines in
    DA_Metallurgy_special_mod_effects.txt end with "# DA_GN". build_secondary_tech.py must run afterwards.
  * Dragonbreaker Harpoons: DA_GN_sync keeps the flag DA_GN_dragonbreaker, which build_legendary_encounters.py reads
    (le_rules.ARMY_BONUS); the triggered modifier DA_GN_harpoons_kobold.
  * The E++ Patent Dispute: DA_GN_event.13, once per game, from the yearly pulse.

The Precursor Assays (doc 68, section 13; built 19 November 2026, doc 72)
  * The Patents page has a Precursor view (flag DA_GN_pv), toggled by the summary cell (cell 15, the summary now in its
    tooltip): the three Precursor patents in cells 1-3, Assay a Relic in cell 4, a Gommo Survey in cell 5 (the survey
    itself is build_ruin_excavation.py's), what the assays do below. A Precursor patent is recovered by an assay
    (DA_GN_pre.<id>), not opened by a tile; Precursor Script Tables halve its booking; Ley-Coil Batteries book none.
  * Assay a Relic: a commission (job 700) that spends a relic sample (DA_GN_samples, from the Precursor ruins); its end,
    in the hidden event DA_GN_event.2, rolls a Precursor patent (after Reverse Engineering) or the relic's leaning
    (250 experience in its school, double with the Script Tables).
"""
import os, re, sys

ROOT = sys.argv[1] if len(sys.argv) > 1 else '.'
MODE = sys.argv[2] if len(sys.argv) > 2 else 'build'
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import gnomish_data as G  # noqa: E402

HEAD = '# Generated by "Claude files/tools/build_gnomish_workshop.py" from gnomish_data.py. Change the tables there and re-run.\n'
P = G.PATENTS
ROMAN = ['0', 'I', 'II', 'III', 'IV', 'V']
REPORT = []


def path(rel):
    return os.path.join(ROOT, rel)


def write(rel, text, crlf=True, bom=False):
    if crlf:
        text = text.replace('\r\n', '\n').replace('\n', '\r\n')
    data = (('﻿' + text).encode('utf-8') if bom else text.encode('latin-1'))
    full = path(rel)
    old = open(full, 'rb').read() if os.path.exists(full) else None
    if old == data:
        REPORT.append('same    ' + rel)
        return
    REPORT.append(('changed ' if old is not None else 'new     ') + rel)
    if MODE == 'check':
        return
    os.makedirs(os.path.dirname(full) or '.', exist_ok=True)
    open(full, 'wb').write(data)


def ind(lines, n):
    return '\n'.join('\t' * n + l if l else l for l in lines)


def i_of(p):
    return P.index(p) + 1


# DA_EL (doc 72): the Precursor patents (gnomish_data.PRECURSOR) come after the fourteen (i 15-17) and stand in cells
# 1-3 of the Precursor view; they open with an assay, not a tile.
NORMAL, PRE = G.NORMAL, G.PRECURSOR
PV = 'has_country_flag = DA_GN_pv'
NPV = 'NOT = { has_country_flag = DA_GN_pv }'
TABLES = 'has_country_flag = DA_PR_done.GN_Script_Tables'
A_ = G.ASSAY


def cell_of(p):
    return PRE.index(p) + 1 if p.get('precursor') else i_of(p)


def avail(p):
    """the flag that opens its prototype: its tile, or for a Precursor patent its recovery by an assay"""
    return 'DA_GN_pre.%s' % p['id'] if p.get('precursor') else 'DA_PR_done.%s' % p['tile']


def cap(p, mech=False, tables=False):
    c = p.get('books', G.CAPACITY[p['tier']])
    if mech:
        c *= G.MECHANIST_CAPACITY
    if tables and p.get('precursor'):
        c *= A_['tables_capacity']
    return int(round(c))


def cap_cases(p):
    """[(condition, capacity booked)] for every case of its booking"""
    if not p.get('precursor'):
        return [(MECH, cap(p, True)), ('NOT = { %s }' % MECH, cap(p))]
    return [('%s %s' % (MECH, TABLES), cap(p, True, True)), ('%s NOT = { %s }' % (MECH, TABLES), cap(p, True)),
            ('NOT = { %s } %s' % (MECH, TABLES), cap(p, False, True)), ('NOT = { %s } NOT = { %s }' % (MECH, TABLES), cap(p))]


def cap_tt(p):
    return 'DA_GN_cap_tt.%s' % p['id'] if p.get('precursor') else 'DA_GN_cap_tt.%d' % p['tier']


def on_cost(p, mech=False):
    c = G.ON_COST[p['tier']]
    return int(round(c * G.MECHANIST_COST)) if mech else c


def fast(m):
    return int(round(m * G.BRILLITE_TIME))


def job_call(code, months):
    """DA_GN_start_job with the four lengths: plain, Brillite Method, Great Ideation Engine, both."""
    return 'DA_GN_start_job = { code = %d months = %d fast = %d eng = %d both = %d }' % (
        code, months, fast(months), int(round(months * G.ENGINE['faster'])),
        int(round(months * G.BRILLITE_TIME * G.ENGINE['faster'])))


def tile_title(nid):
    return G.NODES[nid]['title']


MECH = 'has_country_flag = DA_PR_done.GN_Mechanist'
JOB = 'is_variable_equal = { which = DA_GN_job value = %d }'
SEL = 'is_variable_equal = { which = DA_GN_sel value = %d }'


def job_proto(p):
    return 100 + i_of(p)


def job_up(p, k):
    return (200 if k == 1 else 300) + i_of(p)


JOB_FAIR = 400
JOB_ASSAY = 700   # DA_EL (doc 72): Assay a Relic
JOB_BRANCH = 500
JOB_ENGINE = 600
ALLY = 'OR = { alliance_with = ROOT is_subject_of = ROOT }'   # in the scope of the other country
B_ = G.BRANCH
LIC = G.LICENCE
ENG = G.ENGINE
CAL = G.CALIBRATION


def mat_of(p):
    return G.MATERIALS[p['mat']] if p.get('mat') else None


def mat_check(key, n):
    return 'check_variable = { which = %s value = %d }' % (G.MATERIALS[key][0], n)


def mat_pay(key, n):
    return ['custom_tooltip = DA_GN_mat_pay_tt.%s.%d' % (key, n),
            'hidden_effect = { change_variable = { which = %s value = -%d } }' % (G.MATERIALS[key][0], n)]   # DA_VV


