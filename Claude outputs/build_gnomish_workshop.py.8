GN_BLOCK = re.compile(r'[ \t]*# BEGIN DA_GN [^\n]*\n.*?# END DA_GN [^\n]*\n', re.S)
SPECIAL = 'common/scripted_effects/DA_Metallurgy_special_mod_effects.txt'


def path_option(cls):
    c = CAL
    return '\n'.join([
        '\toption = {', '\t\tDA_SCH_pick = { unit = %s part = punk token = %s } # DA_SCH' % (cls, c['token']),
        '\t\tname = "DA_Metallurgy_events.49.%s"' % c['token'], '\t\ttrigger = {', '\t\t\t' + c['gate'], '\t\t}', '\t\t',
        '\t\tDA_apply_Punk = {', '\t\t\tDA_unit = %s' % cls, '\t\t\tDA_Cost = %d' % c['cost'], '\t\t\tDA_Strength = %d' % c['S'],
        '\t\t\tDA_Magic_Conductivity = %d' % c['M'], '\t\t\tDA_Electrical_Conductivity = %d' % c['E'],
        '\t\t\tDA_Unique = %s' % c['token'], '\t\t}', '\t}'])


def patch_designer():
    """The Primary Technology, before the obsidian block of build_obsidian_tech.py (or before the selector's "after"):
    each builder strips only its own block and puts it back at a place the other one does not move."""
    for cls in CAL['classes']:
        rel = 'events/DA_Metallurgy_events_%s_0.txt' % cls
        text, crlf = read(rel)
        text = GN_BLOCK.sub('', text)
        a = text.index('\n\tafter = {') + 1
        j = text.find('\t# BEGIN DA_OBSIDIAN')
        i = j if 0 <= j < a else a
        block = ('\t# BEGIN DA_GN primary technology (build_gnomish_workshop.py)\n' + path_option(cls) +
                 '\n\t# END DA_GN primary technology\n')
        write(rel, text[:i] + block + text[i:], crlf)


def patch_special():
    """Grant at the finish, removal at a redesign, the draft flag cleared by Reset: one line each, marked # DA_GN."""
    text, crlf = read(SPECIAL)

    def span(name):
        m = re.search(r'^%s\s*=\s*\{' % re.escape(name), text, re.M)
        if not m:
            raise SystemExit('%s: %s not found' % (SPECIAL, name))
        ob = text.index('{', m.start())
        return ob + 1, block_end(text, ob) - 1

    def ensure(name, line):
        nonlocal text
        a, b = span(name)
        core = line.split('#')[0].strip()
        if re.search(r'^[ \t]*' + re.escape(core) + r'[ \t]*(#[^\n]*)?$', text[a:b], re.M):
            return
        ls = text.rfind('\n', 0, b) + 1
        text = text[:ls] + '\t' + line + '\n' + text[ls:]
    for cls in CAL['classes']:
        ensure('DA_give_Unique_Metallurgy_modifiers_' + cls,
               'DA_if_flag_give_modifier_effect = { DA_unit = %s DA_type = PUNK DA_modifier = %s } # DA_GN' % (cls, CAL['token']))
        ensure('DA_remove_Unique_Metallurgy_modifiers_blueprints_' + cls,
               'remove_country_modifier = DA_Unique_mod.PUNK.%s.%s # DA_GN' % (cls, CAL['token']))
    ensure('DA_remove_Unique_Metallurgy_modifiers_flags', 'clr_country_flag = DA_Unique_mod.PUNK.Flag.$DA_unit$.%s # DA_GN' % CAL['token'])
    write(SPECIAL, text, crlf)


