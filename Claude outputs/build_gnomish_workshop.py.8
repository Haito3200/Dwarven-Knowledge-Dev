def gen_custom_loc():
    def dt(name, entries, fallback='DA_GN_empty'):
        o = ['defined_text = {', '\tname = %s' % name, '\trandom = no']
        for key, trig in entries:
            o.append('\ttext = {\n\t\tlocalisation_key = %s\n\t\ttrigger = { %s }\n\t}' % (key, trig))
        o.append('\ttext = {\n\t\tlocalisation_key = %s\n\t\ttrigger = { always = yes }\n\t}' % fallback)
        o.append('}')
        return '\n'.join(o)
    out = [HEAD]
    out.append(dt('DA_GN_get_lead', [('DA_GN_lead_%s' % s, 'DA_GN_lead_%s = yes' % s) for s in G.SCHOOLS], 'DA_GN_lead_none'))
    out.append(dt('DA_GN_get_lead_note', [
        ('DA_GN_lead_note_none', 'NOT = { has_country_flag = DA_PR_done.GN_Lead_School }'),
        ('DA_GN_lead_note_override', 'has_country_flag = DA_GN_lead_override'),
        ('DA_GN_lead_note_ask', 'DA_GN_lead_needs_pick = yes'),
        ('DA_GN_lead_note_pick', 'DA_GN_org_other = yes')], 'DA_GN_lead_note_org'))
    out.append(dt('DA_GN_get_fair_info', [('DA_GN_fair_info_closed', 'NOT = { has_country_flag = DA_PR_done.GN_Patent_Office }')],
                  'DA_GN_fair_info_open'))
    out.append(dt('DA_GN_get_bench_title', [
        ('DA_GN_bt_closed', 'NOT = { has_country_flag = DA_PR_done.GN_Workshop }'),
        ('DA_GN_bt_away', 'NOT = { DA_RH_primary_gnomish = yes }'),
        ('DA_GN_bt_busy', 'has_country_flag = DA_GN_bench_busy'),
        ('DA_GN_bt_study', 'DA_SCH_studying_any = yes')], 'DA_GN_bt_free'))
    jobs = [('DA_GN_bj.%d' % job_proto(p), 'has_country_flag = DA_GN_bench_busy ' + JOB % job_proto(p)) for p in P]
    jobs += [('DA_GN_bj.%d' % job_up(p, k), 'has_country_flag = DA_GN_bench_busy ' + JOB % job_up(p, k)) for p in P for k in (1, 2)]
    jobs += [('DA_GN_bj.%d' % c, 'has_country_flag = DA_GN_bench_busy ' + JOB % c) for c in (JOB_ENGINE, JOB_BRANCH, JOB_ASSAY)]
    jobs += [('DA_GN_bj_fair', 'has_country_flag = DA_GN_bench_busy ' + JOB % JOB_FAIR), ('DA_GN_bj_study', 'DA_SCH_studying_any = yes')]
    out.append(dt('DA_GN_get_bench_job', jobs, 'DA_GN_bj_none'))
    out.append(dt('DA_GN_get_engine_info', [
        ('DA_GN_eng_built', 'has_country_flag = DA_GN_engine_built'),
        ('DA_GN_eng_bench', 'DA_GN_st_bench_engine = yes'),
        ('DA_GN_eng_none', 'NOT = { has_country_flag = DA_PR_done.GN_Synthesis }')], 'DA_GN_eng_ready'))
    # the licensee's event (ROOT the licensee): the patent on offer
    out.append(dt('DA_GN_get_lic_offer', [('DA_GN_lic_offer.%d' % i_of(p), 'has_country_flag = DA_GN_lic_offer.%s' % p['id'])
                                          for p in P]))
    out.append(dt('DA_GN_get_study_name', [('DA_GN_study_%s' % s, 'DA_SCH_studying_%s = yes' % s)
                                           for s in ('Metallurgy', 'Magic_Theory', 'Mechanics', 'Alchemy', 'Medicine')]))
    out.append(dt('DA_GN_get_bench_desc', [
        ('DA_GN_bd_closed', 'NOT = { has_country_flag = DA_PR_done.GN_Workshop }'),
        ('DA_GN_bd_away', 'NOT = { DA_RH_primary_gnomish = yes }')], 'DA_GN_bd_rules'))
    out.append(dt('DA_GN_get_pat_name', [('DA_GN_pname.%d' % i_of(p), SEL % i_of(p)) for p in P], 'DA_GN_pname.0'))
    out.append(dt('DA_GN_get_pat_meta', [('DA_GN_pmeta.%d' % i_of(p), SEL % i_of(p)) for p in P]))
    st = []
    for p in P:
        i, pid = i_of(p), p['id']
        st += [('DA_GN_st_on', '%s has_country_flag = DA_GN_on.%s' % (SEL % i, pid)),
               ('DA_GN_st_bench', '%s DA_GN_st_bench_%s = yes' % (SEL % i, pid)),
               ('DA_GN_st_cooling', '%s has_country_flag = DA_GN_proto.%s NOT = { DA_SS_cooldown_finished = { flag = DA_GN_switch.%s days = %d } }'
                % (SEL % i, pid, pid, G.SWITCH_COOLDOWN)),
               ('DA_GN_st_off', '%s has_country_flag = DA_GN_proto.%s' % (SEL % i, pid)),
               ('DA_GN_st_misfire', '%s has_country_flag = DA_GN_misfire.%s' % (SEL % i, pid)),
               ('DA_GN_st_ready', '%s has_country_flag = %s' % (SEL % i, avail(p))),
               ('DA_GN_st_unrecovered' if p.get('precursor') else 'DA_GN_st_locked', SEL % i)]
    out.append(dt('DA_GN_get_pat_status', st))
    out.append(dt('DA_GN_get_pat_desc', [('DA_GN_pdesc.%d' % i_of(p), SEL % i_of(p)) for p in P]))
    out.append(dt('DA_GN_get_pat_proto', [('DA_GN_pproto.%d' % i_of(p), SEL % i_of(p)) for p in P]))
    out.append(dt('DA_GN_get_pat_on', [('DA_GN_pon.%d' % i_of(p), SEL % i_of(p)) for p in P]))
    out.append(dt('DA_GN_get_bar_text', [
        ('DA_GN_bt_closed', 'NOT = { has_country_flag = DA_PR_done.GN_Workshop }'),
        ('DA_GN_bt_away', 'NOT = { DA_RH_primary_gnomish = yes }'),
        ('DA_GN_bar_busy', 'has_country_flag = DA_GN_bench_busy'),
        ('DA_GN_bar_busy', 'DA_SCH_studying_any = yes')], 'DA_GN_bar_free'))
    for k in (1, 2):
        ent = []
        for p in P:
            i, pid = i_of(p), p['id']
            ent += [('DA_GN_pup.%d.%d.owned' % (i, k), '%s has_country_flag = DA_GN_up.%s.%d' % (SEL % i, pid, k)),
                    ('DA_GN_pup.%d.%d.bench' % (i, k), '%s has_country_flag = DA_GN_bench_busy %s' % (SEL % i, JOB % job_up(p, k))),
                    ('DA_GN_pup.%d.%d.todo' % (i, k), SEL % i)]
        out.append(dt('DA_GN_get_pat_up_%d' % k, ent))
        out.append(dt('DA_GN_get_pat_up_tt_%d' % k, [('DA_GN_puptt.%d.%d' % (i_of(p), k), SEL % i_of(p)) for p in P]))
    ent = []
    for p in P:
        i, pid = i_of(p), p['id']
        u1, u2 = 'has_country_flag = DA_GN_up.%s.1' % pid, 'has_country_flag = DA_GN_up.%s.2' % pid
        ent += [('DA_GN_peff.%d.12' % i, '%s %s %s' % (SEL % i, u1, u2)), ('DA_GN_peff.%d.1' % i, '%s %s' % (SEL % i, u1)),
                ('DA_GN_peff.%d.2' % i, '%s %s' % (SEL % i, u2)), ('DA_GN_peff.%d.0' % i, SEL % i)]
    out.append(dt('DA_GN_get_pat_effect', ent))
    for p in P:
        i, pid = i_of(p), p['id']
        out.append(dt('DA_GN_get_slot_state_%d' % i, [
            ('DA_GN_st_on', 'has_country_flag = DA_GN_on.%s' % pid), ('DA_GN_st_bench', 'DA_GN_st_bench_%s = yes' % pid),
            ('DA_GN_st_off', 'has_country_flag = DA_GN_proto.%s' % pid), ('DA_GN_st_misfire', 'has_country_flag = DA_GN_misfire.%s' % pid),
            ('DA_GN_st_ready', 'has_country_flag = %s' % avail(p))], 'DA_GN_st_unrecovered' if p.get('precursor') else 'DA_GN_st_locked'))
    rt = [('DA_GN_rt.%d' % r, 'is_variable_equal = { which = DA_GN_report value = %d }' % r) for r in (1, 2, 3, 4, 6, 7, 10, 11, 12)]
    out.append(dt('DA_GN_get_rep_title', rt, 'DA_GN_event.2.t'))
    rd = []
    for p in P:
        i = i_of(p)
        pv = 'is_variable_equal = { which = DA_GN_report_patent value = %d }' % i
        for r in (1, 2, 3):
            rd.append(('DA_GN_rd.%d.%d' % (r, i), 'is_variable_equal = { which = DA_GN_report value = %d } %s' % (r, pv)))
        for r in (4, 7):
            for k in (1, 2):
                rd.append(('DA_GN_rd.%d.%d.%d' % (r, i, k), 'is_variable_equal = { which = DA_GN_report value = %d } %s '
                           'is_variable_equal = { which = DA_GN_report_up value = %d }' % (r, pv, k)))
    rd.append(('DA_GN_rd.6', 'is_variable_equal = { which = DA_GN_report value = 6 }'))
    rd.append(('DA_GN_rd.10', 'is_variable_equal = { which = DA_GN_report value = 10 }'))
    # DA_EL (doc 72): an assay: the relic's leaning, or a Precursor patent
    for k in range(1, len(G.LEANINGS) + 1):
        lean = 'is_variable_equal = { which = DA_GN_report value = 11 } is_variable_equal = { which = DA_GN_assay_school value = %d }' % k
        rd.append(('DA_GN_rd.11.%d.2' % k, '%s %s' % (lean, TABLES)))
        rd.append(('DA_GN_rd.11.%d.1' % k, lean))
    for q in PRE:
        rd.append(('DA_GN_rd.12.%d' % i_of(q), 'is_variable_equal = { which = DA_GN_report value = 12 } '
                   'is_variable_equal = { which = DA_GN_report_patent value = %d }' % i_of(q)))
    out.append(dt('DA_GN_get_rep_desc', rd, 'DA_GN_rd.0'))
    # the over-capacity list: one defined text per patent, joined in the event text
    for p in P:
        out.append(dt('DA_GN_get_overcap_%d' % i_of(p), [('DA_GN_overcap.%d' % i_of(p), 'has_country_flag = DA_GN_overcap.%s' % p['id'])]))
    out.append(dt('DA_GN_get_slot_rule', [('DA_GN_slot_rule_bench', 'DA_GN_has_bench = yes')], 'DA_GN_slot_rule_research'))
    out.append(dt('DA_GN_get_grid_sum', [('DA_GN_gsum_back', PV)], 'DA_GN_gsum_pv'))     # DA_EL (doc 72)
    out.append(dt('DA_GN_get_pv_click', [('DA_GN_pv_click_off', PV)], 'DA_GN_pv_click_on'))
    out.append(dt('DA_GN_get_study_rule', [('DA_GN_study_rule_bench', 'DA_GN_has_bench = yes')], 'DA_GN_study_rule_slot'))
    return '\n\n'.join(out) + '\n'


def fix_overcap_loc(loc):
    # the event text lists every patent switched off: one defined text each
    return loc.replace('[Root.DA_GN_get_overcap]', ''.join('[Root.DA_GN_get_overcap_%d]' % i_of(p) for p in P))


