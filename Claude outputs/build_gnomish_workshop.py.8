def read(rel):
    raw = open(path(rel), 'rb').read()
    text = raw.decode('utf-8-sig') if rel.endswith('.yml') else raw.decode('latin-1')
    crlf = '\r\n' in text
    return text.replace('\r\n', '\n'), crlf


def block_end(text, open_brace):
    depth, i = 0, open_brace
    while i < len(text):
        c = text[i]
        if c == '{':
            depth += 1
        elif c == '}':
            depth -= 1
            if depth == 0:
                return i + 1
        elif c == '#':
            j = text.find('\n', i)
            i = len(text) if j < 0 else j
            continue
        i += 1
    raise SystemExit('unbalanced braces')


def patch_topbar():
    rel = 'interface/topbar.gui'
    text, crlf = read(rel)
    win = gen_window()
    marker = 'windowType = { #DA_GN_workshop'
    if marker in text:
        w = text.index(marker)
        start = text.rfind('\n', 0, w) + 1
        end = block_end(text, text.index('{', w))
        if text[end:end + 1] == '\n':
            end += 1
        text = text[:start] + win + text[end:]
    else:
        m = re.search(r'^[ \t]*# END DA_BLOCK windows', text, re.M)
        if not m:
            raise SystemExit('# END DA_BLOCK windows not found in topbar.gui')
        text = text[:m.start()] + win + '\n' + text[m.start():]
    write(rel, text, crlf)


