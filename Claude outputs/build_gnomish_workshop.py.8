ART = 'gfx/interface/DA_GN_Workshop'


def gen_gfx():
    def sp(name, file, frames=1, check=False):
        s = '\tspriteType = {\n\t\tname = "%s"\n\t\ttexturefile = "%s/%s.dds"\n' % (name, ART, file)
        if check:
            s += '\t\ttransparencecheck = yes\n'
        if frames > 1:
            s += '\t\tnoOfFrames = %d\n' % frames
        return s + '\t}\n'
    out = [HEAD, 'spriteTypes = {\n', sp('GFX_DA_GN_window', 'DA_GN_window', check=True)]
    for k in range(1, len(TAB_KEYS) + 1):
        out.append(sp('GFX_DA_GN_tab_%d' % k, 'DA_GN_tab_%d' % k, 2))
    for k in range(1, len(BIG_BUTTONS) + 1):
        out.append(sp('GFX_DA_GN_big_%d' % k, 'DA_GN_big_%d' % k))
    for p in P:
        out.append(sp('GFX_DA_GN_patent_%s' % p['id'], 'DA_GN_patent_%s' % p['id'], 5))
    out += [sp('GFX_DA_GN_grid', 'DA_GN_grid'), sp('GFX_DA_GN_page_rule', 'DA_GN_page_rule'), sp('GFX_DA_GN_bar_seg', 'DA_GN_bar_seg'),
            sp('GFX_DA_GN_slot_sel', 'DA_GN_slot_sel'), sp('GFX_DA_GN_button', 'DA_GN_button'),
            sp('GFX_DA_GN_button_wide', 'DA_GN_button_wide'), sp('GFX_DA_GN_plus', 'DA_GN_plus'),
            sp('GFX_DA_GN_counter_tip', 'DA_GN_counter_tip'),
            # DA_EL (doc 72): the Precursor view
            sp('GFX_DA_GN_grid_pv', 'DA_GN_grid_pv'), sp('GFX_DA_GN_assay', 'DA_GN_assay', 2), sp('GFX_DA_GN_survey', 'DA_GN_survey', 2),
            sp('GFX_DA_GN_cell_hit', 'DA_GN_cell_hit'), '}\n']
    return ''.join(out)


