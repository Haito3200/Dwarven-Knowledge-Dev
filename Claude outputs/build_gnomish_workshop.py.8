def cb(name, tooltip=None, potential='always = yes', trigger=None, effect=None, frames=None, extra=()):
    o = ['custom_button = {', '\tname = %s' % name]
    if tooltip:
        o.append('\ttooltip = %s' % tooltip)
    o.append('\tpotential = { %s }' % potential)
    for num, cond in (frames or []):
        o.append('\tframe = { number = %d trigger = { %s } }' % (num, cond))
    o += ['\t' + e for e in extra]
    if trigger:
        o += ['\ttrigger = {'] + ['\t\t' + l for l in trigger] + ['\t}']
    if effect:
        o += ['\teffect = {'] + ['\t\t' + l for l in effect] + ['\t}']
    return '\n'.join(o + ['}'])


def ctb(name, potential='always = yes', tooltip=None):
    return 'custom_text_box = {\n\tname = %s\n%s\tpotential = { %s }\n}' % (name, '\ttooltip = %s\n' % tooltip if tooltip else '', potential)


