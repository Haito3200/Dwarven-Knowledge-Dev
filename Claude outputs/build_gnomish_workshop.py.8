def gen_events():
    o = [HEAD, 'namespace = DA_GN_event', '']

    def ev(i, body, hidden=False, opts=(), descs=None):
        e = ['country_event = {', '\tid = DA_GN_event.%d' % i, '\ttitle = DA_GN_event.%d.t' % i]
        if descs:   # one description per case
            for key, trig in descs:
                e.append('\tdesc = { trigger = { %s } desc = %s }' % (trig, key))
        else:
            e.append('\tdesc = DA_GN_event.%d.d' % i)
        e.append('\tpicture = INVENTION_eventPicture')
        if hidden:
            e.append('\thidden = yes')
        e += ['\tis_triggered_only = yes', ''] + ['\t' + l for l in body]
        for name, lines in opts:
            e += ['\toption = {', '\t\tname = %s' % name] + ['\t\t' + l for l in lines] + ['\t}']
        return e + ['}', '']
    branch_rep = 'OR = { is_variable_equal = { which = DA_GN_report value = 8 } is_variable_equal = { which = DA_GN_report value = 9 } }'
    o += ev(1, [], opts=[('DA_GN_event.1.a', ['custom_tooltip = DA_GN_corps_effect_tt',
                                              'hidden_effect = { DA_GN_artificer_corps = yes }', 'ai_chance = { factor = 1 }'])])
    o += ev(2, ['immediate = {', '\tDA_GN_finish_job = yes', '\tif = {', '\t\tlimit = { ai = no NOT = { %s } }' % branch_rep,
                '\t\tcountry_event = { id = DA_GN_event.3 }', '\t}', '\tif = {', '\t\tlimit = { ai = no %s }' % branch_rep,
                '\t\tcountry_event = { id = DA_GN_event.7 }\t# a branch: the report names its host', '\t}', '}'],
            hidden=True, opts=[('DA_GN_event.2.a', [])])
    o += ev(3, [], opts=[('DA_GN_event.3.a', ['ai_chance = { factor = 1 }']),
                         ('DA_GN_event.3.b', ['hidden_effect = { DA_GN_open_workshop = yes }', 'ai_chance = { factor = 0 }'])])
    o += ev(4, [], opts=[('DA_GN_event.4.%s' % 'abc'[j], ['custom_tooltip = DA_GN_lead_becomes_tt.%s' % s,
                                                          'hidden_effect = { DA_GN_pick_lead = { school = %s } }' % s,
                                                          'ai_chance = { factor = 1 }'])
                         for j, s in enumerate(G.SCHOOLS)])
    o += ev(5, [], opts=[('DA_GN_event.5.%s' % 'abc'[j], ['custom_tooltip = DA_GN_lead_becomes_tt.%s' % s,
                                                          'hidden_effect = { DA_GN_override_lead = { school = %s } }' % s])
                         for j, s in enumerate(G.SCHOOLS)] +
                         [('DA_GN_event.5.e', ['custom_tooltip = DA_GN_lead_follow_tt', 'hidden_effect = { DA_GN_follow_org = yes }'])])
    o += ev(6, [], opts=[('DA_GN_event.6.a', ['hidden_effect = {'] + ['\tclr_country_flag = DA_GN_overcap.%s' % p['id'] for p in P]
                          + ['\tclr_country_flag = DA_GN_overcap', '}'])])
    # ---- step 2 ----
    o += ev(7, [], descs=[('DA_GN_event.7.d', 'is_variable_equal = { which = DA_GN_report value = 8 }'),
                          ('DA_GN_event.7.e', 'is_variable_equal = { which = DA_GN_report value = 9 }')],
            opts=[('DA_GN_event.7.a', ['ai_chance = { factor = 1 }']),
                  ('DA_GN_event.7.b', ['hidden_effect = { DA_GN_open_workshop = yes set_country_flag = DA_GN_view_gommo }',
                                       'ai_chance = { factor = 0 }'])])
    o += ev(9, [], opts=[('DA_GN_event.9.a', ['ai_chance = { factor = 1 }'])])
    # .10: which patent we offer (ROOT us; the licensee is the event target DA_GN_licensee)
    opts = []
    for p in P:
        i, pid = i_of(p), p['id']
        opts.append(('DA_GN_event.10.p%d' % i, [
            'trigger = {', '\thas_country_flag = DA_GN_on.%s' % pid,
            '\tevent_target:DA_GN_licensee = { NOT = { has_country_flag = DA_GN_lic_%s_@ROOT } }' % pid, '}',
            'custom_tooltip = DA_GN_lic_offer_tt.%d' % i, 'hidden_effect = {', '\tset_country_flag = DA_GN_lic_pending',
            '\tevent_target:DA_GN_licensee = {', '\t\tset_country_flag = DA_GN_lic_offer.%s' % pid,
            '\t\tcountry_event = { id = DA_GN_event.11 }', '\t}', '}', 'ai_chance = { factor = 1 }']))
    opts.append(('DA_GN_event.10.z', ['ai_chance = { factor = 0 }']))
    o += ev(10, [], opts=opts)
    # .11: the licensee answers (ROOT the licensee, FROM us)
    accept = []
    for p in P:
        pid = p['id']
        accept += ['if = {', '\tlimit = { has_country_flag = DA_GN_lic_offer.%s }' % pid,
                   '\tadd_country_modifier = { name = DA_GN_lic_%s duration = %d }' % (pid, LIC['days']),
                   '\thidden_effect = { set_country_flag = DA_GN_lic_%s_@FROM }' % pid, '}']
    clear = ['clr_country_flag = DA_GN_lic_offer.%s' % p['id'] for p in P]
    accept += ['add_opinion = { who = FROM modifier = DA_GN_licence }', 'custom_tooltip = DA_GN_lic_fee_tt',
               'hidden_effect = {'] + ['\t' + l for l in clear] + \
              ['\tFROM = { set_country_flag = DA_GN_lic_yes country_event = { id = DA_GN_event.12 } }', '}',
               'ai_chance = {', '\tfactor = 1',
               '\tmodifier = { factor = 0 NOT = { has_opinion = { who = FROM value = 1 } } }',
               '\tmodifier = { factor = 0 NOT = { treasury = %d } }' % LIC['ai_treasury'], '}']
    decline = ['hidden_effect = {'] + ['\t' + l for l in clear] + \
              ['\tFROM = { set_country_flag = DA_GN_lic_no country_event = { id = DA_GN_event.12 } }', '}',
               'ai_chance = {', '\tfactor = 1',
               '\tmodifier = { factor = 0 has_opinion = { who = FROM value = 1 } treasury = %d }' % LIC['ai_treasury'], '}']
    o += ev(11, [], opts=[('DA_GN_event.11.a', accept), ('DA_GN_event.11.b', decline)])
    # .12: the answer reaches us (ROOT us, FROM the licensee)
    o += ev(12, ['immediate = {', '\thidden_effect = {', '\t\tclr_country_flag = DA_GN_lic_pending',
                 '\t\tDA_GN_licences_upkeep = yes', '\t}', '}'],
            descs=[('DA_GN_event.12.d', 'has_country_flag = DA_GN_lic_yes'),
                   ('DA_GN_event.12.e', 'NOT = { has_country_flag = DA_GN_lic_yes }')],
            opts=[('DA_GN_event.12.a', ['hidden_effect = { clr_country_flag = DA_GN_lic_yes clr_country_flag = DA_GN_lic_no }',
                                        'ai_chance = { factor = 1 }'])])
    # .13: the E++ Patent Dispute (ROOT us; the goblins are the event target DA_GN_eplus_goblin)
    E = G.EPLUS
    o += ev(13, ['immediate = {', '\thidden_effect = {', '\t\tset_country_flag = DA_GN_eplus_done',
                 '\t\trandom_neighbor_country = {', '\t\t\tlimit = { DA_GN_eplus_goblin = yes }',
                 '\t\t\tsave_event_target_as = DA_GN_eplus_goblin', '\t\t}', '\t}', '}'],
            opts=[('DA_GN_event.13.a', ['add_prestige = %d' % E['prestige'],
                                        'event_target:DA_GN_eplus_goblin = { add_opinion = { who = ROOT modifier = DA_GN_patent_suit } }',
                                        'ai_chance = { factor = 1 }']),
                  ('DA_GN_event.13.b', ['trigger = { treasury = %d }' % E['price'], 'add_treasury = -%d' % E['price'],
                                        'event_target:DA_GN_eplus_goblin = { add_treasury = %d }' % E['price'],
                                        'change_innovativeness = %d' % E['innovativeness'],
                                        'capital_scope = { DA_Tech_prov.Metallurgy = { amount = %d } }' % E['xp'],
                                        'ai_chance = { factor = 1 }']),
                  ('DA_GN_event.13.c', ['define_advisor = {', '\ttype = %s' % E['advisor'], '\tskill = %d' % E['skill'],
                                        '\tculture = event_target:DA_GN_eplus_goblin', '\treligion = ROOT',
                                        '\tcost_multiplier = %s' % fmt(E['cost']), '}', 'ai_chance = { factor = 1 }'])])
    return '\n'.join(o)


