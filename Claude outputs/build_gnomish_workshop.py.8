def fmt(v):
    if isinstance(v, str):
        return v
    s = ('%.3f' % v).rstrip('0').rstrip('.')
    return s if s not in ('-0', '') else '0'


def gen_modifiers():
    o = [HEAD]
    for p in P:
        o += ['DA_GN_pat_%s = {' % p['id']] + ['\t%s = %s' % (k, fmt(v)) for k, v in p['mod'].items()]
        if p.get('art'):
            o.append('\tis_rajput_modifier = yes')
        o.append('}')
        for k, u in enumerate(p['ups'], 1):
            o += ['DA_GN_pat_%s_%d = {' % (p['id'], k)] + ['\t%s = %s' % (kk, fmt(v)) for kk, v in u['mod'].items()]
            if u.get('art'):
                o.append('\tis_rajput_modifier = yes')
            o.append('}')
    o += ['DA_GN_reclaimed_homeland = {', '\tlocal_development_cost = -0.15', '\tlocal_culture_conversion_cost = -0.25', '}']
    o += ['# Step 2: Gommo Branches (ours, by number; the host\'s city), licences (the licensee: the patent\'s base effect),',
          '# Gommo Calibration (the fixed effect of the Primary Technology, one per class).']
    for n in range(1, B_['max'] + 1):
        o += ['DA_GN_branches_%d = {' % n, '\tartificers_capacity = %d' % (n * B_['capacity']), '}']
    o += ['DA_GN_gommo_branch = {', '\tlocal_production_efficiency = %s' % fmt(B_['production']),
          '\tlocal_development_cost = %s' % fmt(B_['development']), '}']
    for p in P:
        o += ['DA_GN_lic_%s = {' % p['id']] + ['\t%s = %s' % (k, fmt(v)) for k, v in p['mod'].items()]
        if p.get('art'):
            o.append('\tis_rajput_modifier = yes')
        o.append('}')
    for cls in CAL['classes']:
        o += ['DA_Unique_mod.PUNK.%s.%s = {' % (cls, CAL['token'])] + \
             ['\t%s = %s' % (k, fmt(v)) for k, v in CAL['fixed'].items()] + ['\t%s = yes' % G.UNIT_MARK[cls], '}']
    return '\n'.join(o) + '\n'


