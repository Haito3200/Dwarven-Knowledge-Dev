LEGEND = {l.id: l for l in LEGENDS}
FIGHTS = [l for l in LEGENDS if not l.talk_only]     # the legends that have a fight: everything about rounds uses this list


# --- reference implementation -----------------------------------------------------------------

def army_strength(inf, cav, art, tech, disc=0.0, inf_power=0.0, cav_power=0.0, art_power=0.0,
                  wf=(0, 0, 0), wf_power=(0.0, 0.0, 0.0), mult=1.0):
    """Returns (melee strength, artillery strength, regiments counted). wf: Warforged regiments the country
    fields, by class; wf_power: the power of its current design, by class; mult: army_mult() (DA_GN)."""
    n = {'inf': min(inf, CAP['inf']), 'cav': min(cav, CAP['cav']), 'art': min(art, CAP['art'])}
    q = (1 + TECH_STEP * min(tech, MAX_TECH)) * (1 + disc)
    p = {}
    for k, base, own, i in (('inf', inf_power, 0, 0), ('cav', cav_power, 0, 1), ('art', art_power, 0, 2)):
        share = min(1.0, wf[i] / n[k]) if n[k] else 0.0
        p[k] = n[k] * UNIT_POWER[k] * (1 + base + share * wf_power[i])
    return (p['inf'] + p['cav']) * q * mult, p['art'] * q * mult, n['inf'] + n['cav'] + n['art']


def resolve_max(regiments, morale=0.0, ruler_leads=False, adm=0, levels=0):
    r = RESOLVE_PER_REGIMENT * regiments * (1 + morale)
    if ruler_leads:
        r += RULER_RESOLVE + RULER_RESOLVE_PER_ADM * adm + RULER_RESOLVE_PER_LEVEL * levels
    return r


def caster(school, ruler_leads, ruler_levels, estate_levels, mana, mil=0, has_estate=None):
    """Who casts a school this round: (source, level, strength, mana cost) or None.
    The battle mages cast at the highest level they know and can pay for; the ruler casts unless they
    know the school two levels better than he does."""
    r = ruler_levels.get(school, 0) if ruler_leads else 0
    e = estate_levels.get(school, 0)
    while e and mana < ESTATE_MANA[e]:
        e -= 1
    if has_estate is None:
        has_estate = bool(estate_levels)
    ruler = ('ruler', r, 1 + RULER_POWER_PER_MIL * mil + (CIRCLE_BONUS if has_estate else 0), 0) if r else None
    estate = ('estate', e, ESTATE_MULT, ESTATE_MANA[e]) if e else None
    if ruler and estate:
        return estate if e >= r + 2 else ruler
    return ruler or estate


class State:
    def __init__(self, legend, s_melee, s_art, resolve, weakness=False, hp=None):
        self.legend = legend
        self.s_melee, self.s_art = s_melee, s_art
        self.hp = legend.hp * legend.start_hp if hp is None else hp
        self.ward = legend.ward
        self.resolve = self.resolve_max = resolve
        self.round = 1
        self.rot = 0.0
        self.sunder = 0.0
        self.weakness = weakness
        self.revived = False
        self.ambush = bool(legend.ambush and weakness)
        self.cooldown = None
        self.move = None
        self.result = None


def resolve_round(st, order, spell, die_a, die_b, die_c):
    """One round. spell is None or (school, level, strength). Returns a dict of what happened."""
    L, mv = st.legend, st.move
    om, oa, _ = ORDERS[order]
    school, lvl, m = spell if spell else (None, 0, 0)
    val = lambda key: SPELLS[school][key][lvl - 1] * m
    rep = {}

    if school == 'divination':
        die_a = max(die_a, SPELLS['divination']['floor'][lvl - 1])
    var_ours = 0.85 + 0.015 * die_a
    var_theirs = 0.85 + 0.015 * die_b

    # our blow
    army = (st.s_melee * om + st.s_art * oa) * mv.out_mult[order]
    if mv.fear != 1.0 and school != 'enchantment' and order not in mv.fear_exempt_orders:
        army *= mv.fear
    if school == 'enchantment':
        army *= 1 + min(val('army'), SPELLS['enchantment']['army_cap'])
    if school == 'conjuration':
        army += val('flat')
    army *= var_ours
    if school == 'divination':
        army *= 1 + val('aim')
    else:
        army *= 1 - L.armor
    spell_dmg = val('damage') * (1 - L.spell_resist) if school == 'evocation' else 0
    vuln = 1 + st.sunder + (SCOUT_VULN if st.weakness else 0)
    total = (army + spell_dmg) * vuln
    rep['dealt'] = total
    if school == 'divination':
        st.hp -= total
        rep['warded'] = 0
    else:
        absorbed = min(st.ward, total)
        st.ward -= absorbed
        st.hp -= total - absorbed
        rep['warded'] = absorbed

    # lasting spells
    if school == 'necromancy':
        st.rot = min(st.rot + val('rot') * L.necro_mult * (1 - L.spell_resist), SPELLS['necromancy']['rot_cap'])
    st.hp -= st.rot
    rep['rot'] = st.rot
    if school == 'transmutation':
        st.sunder = min(st.sunder + val('sunder'), SPELLS['transmutation']['sunder_cap'])

    # is it dead?
    if st.hp <= 0:
        if L.revive and not st.revived and not st.weakness:
            st.revived = True
            st.hp = L.hp * L.revive
            st.ward = 0
            rep['revived'] = True
        else:
            st.hp = 0
            st.result = 'victory'
            return rep

    # its move
    if not rep.get('revived'):
        gain = mv.ward_gain * mv.ward_gain_order.get(order, 1.0)
        if mv.ward_gain_blocked_by and school == mv.ward_gain_blocked_by:
            gain = 0
        st.ward = min(st.ward + gain, max(L.ward_max, st.ward))
        if mv.heal and order not in mv.heal_blocked_orders and school != mv.heal_blocked_by:
            st.hp = min(st.hp + mv.heal, L.hp)
            rep['healed'] = True

    incoming = L.might * mv.might * mv.in_mult[order] * var_theirs
    if L.enrage_below and st.hp < L.hp * L.enrage_below:
        incoming *= L.enrage
    if school == 'abjuration':
        incoming *= 1 - min(val('block'), SPELLS['abjuration']['block_cap'])
    if school == 'conjuration':
        incoming *= 1 - min(val('screen'), SPELLS['conjuration']['screen_cap'])
    if school == 'illusion' and die_c * 5 <= min(val('miss'), SPELLS['illusion']['miss_cap']):
        incoming = 0
        rep['missed'] = True
    if st.ambush:
        incoming = 0
        st.ambush = False
        rep['ambush'] = True
    st.resolve -= incoming
    rep['taken'] = incoming

    st.cooldown = school
    if st.resolve <= 0:
        st.resolve = 0
        st.result = 'defeat'
    elif st.round >= MAX_ROUNDS:
        st.result = 'withdraw'
    else:
        st.round += 1
    return rep


def next_move(legend, current, rng):
    """Never the same move twice in a row."""
    pool = [m for m in legend.moves if m is not current]
    return rng.choices(pool, weights=[m.weight for m in pool])[0]


def regiments_lost(regiments, resolve, resolve_maximum, result):
    if resolve_maximum <= 0:
        return 0
    return int(regiments * (1 - resolve / resolve_maximum) * LOSS_SHARE[result])


# --- a player that plays sensibly, for the balance table ---------------------------------------

def best_play(st, ruler_leads, ruler_levels, estate_levels, mana, mil):
    """Looks one round ahead with average dice and picks the order and spell with the best trade."""
    import copy
    options = [None]
    for s in SCHOOLS:
        if s == st.cooldown or s in st.legend.immune:   # DA_EL: a school wasted on it cannot be cast
            continue
        c = caster(s, ruler_leads, ruler_levels, estate_levels, mana, mil)
        if c:
            options.append((s, c))
    best = None
    for order in ORDER_IDS:
        for opt in options:
            t = copy.copy(st)
            spell = (opt[0], opt[1][1], opt[1][2]) if opt else None
            hp0, ward0, res0, rot0, sun0 = t.hp, t.ward, t.resolve, t.rot, t.sunder
            resolve_round(t, order, spell, 10, 10, 20 if not opt or opt[0] != 'illusion' else 10)
            left = max(1, MAX_ROUNDS - st.round)
            gain = (hp0 + ward0) - (t.hp + t.ward) + (t.rot - rot0) * min(left, 5) + (t.sunder - sun0) * 60 * min(left, 6)
            loss = res0 - t.resolve
            if t.result == 'victory':
                score = 1e6
            elif t.result == 'defeat':
                score = -1e6
            else:
                # value our resolve by how much of the legend is left to kill
                need = (t.hp + t.ward) / max(1.0, st.legend.hp + st.legend.ward)
                score = gain / (st.legend.hp + st.legend.ward) - loss / max(1.0, st.resolve_max) * (0.6 + need)
            if best is None or score > best[0]:
                best = (score, order, opt)
    return best[1], best[2]


def play(legend, inf, cav, art, tech, disc=0.05, morale=0.10, ruler=None, estate=None, mana=200, adm=3, mil=3,
         weakness=False, seed=0, power=0.0, wf=(0, 0, 0), wf_power=(0, 0, 0)):
    rng = random.Random(seed)
    ruler_levels, estate_levels = ruler or {}, estate or {}
    leads = bool(ruler_levels)
    sm, sa, n = army_strength(inf, cav, art, tech, disc, power, power, power, wf, wf_power)
    st = State(legend, sm, sa, resolve_max(n, morale, leads, adm, sum(ruler_levels.values())), weakness)
    st.move = next_move(legend, None, rng)
    while not st.result:
        order, opt = best_play(st, leads, ruler_levels, estate_levels, mana, mil)
        spell = None
        if opt:
            spell = (opt[0], opt[1][1], opt[1][2])
            mana -= opt[1][3]
        resolve_round(st, order, spell, rng.randint(1, 20), rng.randint(1, 20), rng.randint(1, 20))
        st.move = next_move(legend, st.move, rng)
    return st, n


def table():
    mage3 = {'evocation': 3, 'abjuration': 3, 'enchantment': 2}
    mage2 = {'evocation': 2, 'conjuration': 1}
    arch = {'evocation': 3, 'abjuration': 3, 'illusion': 3, 'transmutation': 3, 'necromancy': 2}
    est = {'evocation': 2, 'abjuration': 2, 'enchantment': 1}
    cases = [
        ('10 regiments (7/0/3), tech 12, no magic', dict(inf=7, cav=0, art=3, tech=12)),
        ('20 regiments (12/0/8), tech 14, no magic', dict(inf=12, cav=0, art=8, tech=14)),
        ('20 regiments, tech 14, mage estate', dict(inf=12, cav=0, art=8, tech=14, estate=est)),
        ('20 regiments, tech 14, modest mage ruler', dict(inf=12, cav=0, art=8, tech=14, ruler=mage2)),
        ('20 regiments, tech 14, great mage ruler', dict(inf=12, cav=0, art=8, tech=14, ruler=mage3)),
        ('20 regiments, tech 14, weakness known', dict(inf=12, cav=0, art=8, tech=14, weakness=True)),
        ('30 regiments (16/4/10), tech 18, no magic', dict(inf=16, cav=4, art=10, tech=18)),
        ('30 regiments, tech 18, great mage ruler', dict(inf=16, cav=4, art=10, tech=18, ruler=mage3)),
        ('40 regiments (20/6/14), tech 22, no magic', dict(inf=20, cav=6, art=14, tech=22)),
        ('40 Warforged regiments (+50%), tech 22', dict(inf=20, cav=6, art=14, tech=22, wf=(20, 6, 14), wf_power=(0.5, 0.5, 0.5))),
        ('60 regiments (30/10/20), tech 26, no magic', dict(inf=30, cav=10, art=20, tech=26)),
        ('10 regiments, tech 12, great mage ruler', dict(inf=7, cav=0, art=3, tech=12, ruler=mage3)),
        ('great mage ruler alone', dict(inf=0, cav=0, art=0, tech=14, ruler=mage3, adm=4, mil=4)),
        ('archmage ruler alone', dict(inf=0, cav=0, art=0, tech=14, ruler=arch, adm=5, mil=5)),
    ]
    out = []
    for L in FIGHTS:
        out.append(f'\n{L.name} — vitality {L.hp}, ward {L.ward}, might {L.might}')
        out.append(f'{"case":48} {"win%":>5} {"rounds":>6} {"resolve left":>12} {"regiments lost":>14}')
        for name, kw in cases:
            wins, rounds, left, lost = 0, [], [], []
            N = 300
            for seed in range(N):
                st, n = play(L, seed=seed, **kw)
                if st.result == 'victory':
                    wins += 1
                    rounds.append(st.round)
                    left.append(st.resolve / st.resolve_max)
                lost.append(regiments_lost(n, st.resolve, st.resolve_max, st.result))
            r = sum(rounds) / len(rounds) if rounds else 0
            l = sum(left) / len(left) * 100 if left else 0
            out.append(f'{name:48} {wins * 100 // N:>4}% {r:>6.1f} {l:>11.0f}% {sum(lost) / N:>14.1f}')
    return '\n'.join(out)


if __name__ == '__main__':
    print(table())
