#!/usr/bin/env python3
"""Legendary Encounters: the rules, as data and as a Python reference.

Everything that is a number of the feature lives here. build_legendary_encounters.py turns these
tables into EU4 script; check_legendary_encounters.py runs the generated script in a small
interpreter and compares it with resolve_round() below, so the two cannot drift apart.

Run on its own for a balance table:

    python3 "Claude files/tools/le_rules.py"
"""
import random

MAX_ROUNDS = 15

# --- our side ---------------------------------------------------------------------------------
# Regiments of ours standing in the province that can come to grips (the rest wait in the tunnels).
CAP = {'inf': 30, 'cav': 10, 'art': 20}
UNIT_POWER = {'inf': 4.0, 'cav': 5.0, 'art': 6.0}
TECH_STEP = 0.03            # army strength +3% per military technology level
MAX_TECH = 40
RESOLVE_PER_REGIMENT = 10   # times (1 + morale modifier)
RULER_RESOLVE = 40          # a ruler who fights in person adds this ...
RULER_RESOLVE_PER_ADM = 10  # ... this per point of administrative skill ...
RULER_RESOLVE_PER_LEVEL = 12  # ... and this per spell level he has mastered (all schools added up)
RULER_POWER_PER_MIL = 0.04  # spell strength per point of military skill
CIRCLE_BONUS = 0.10         # a ruler who also has a mage estate behind him
ESTATE_MULT = 0.6           # spells cast by the estate's battle mages
ESTATE_MANA = {1: 15, 2: 30, 3: 50}
# DA_GN: bonuses that another feature gives our army against some legends. The gnomes' Dragonbreaker Harpoons (doc 48,
# gnomish_data.HARPOONS): a flag the gnomish scripts keep (DA_GN_sync), our strength x1.25 against the two dragons.
import gnomish_data as _GN  # noqa: E402
ARMY_BONUS = [dict(name='Dragonbreaker Harpoons', legends=tuple(_GN.HARPOONS['legends']), flag=_GN.HARPOONS['flag'],
                   mult=_GN.HARPOONS['mult'])]
# DA_EL: Wyrmbane (Evocation III of the Elven page, doc 68, section 10): our army x1.15 against the dragon legends while the
# tile is done and the Precursor heritage is active. DA_EL_sync and DA_EL_refresh keep the flag (build_elven_archive.py).
ARMY_BONUS.append(dict(name='Wyrmbane', legends=('dragon', 'hunter', 'challumaton'), flag='DA_EL_wyrmbane_on', mult=1.15))


def army_mult(legend_id, flags):
    """our army's strength multiplier against this legend, from the owner's flags (ARMY_BONUS)"""
    m = 1.0
    for b in ARMY_BONUS:
        if legend_id in b['legends'] and b['flag'] in flags:
            m *= b['mult']
    return m

# order -> (melee damage, artillery damage, losses taken)
ORDERS = {
    'assault': (1.00, 0.60, 1.25),
    'shield':  (0.45, 0.45, 0.55),
    'volley':  (0.20, 1.60, 1.00),
    'loose':   (0.65, 0.65, 0.85),
}
ORDER_IDS = list(ORDERS)
ORDER_NAMES = {'assault': 'Assault', 'shield': 'Shield Wall', 'volley': 'Volley', 'loose': 'Loose Order'}

SCHOOLS = ['abjuration', 'conjuration', 'divination', 'enchantment', 'evocation', 'illusion', 'necromancy', 'transmutation']
SCHOOL_NAMES = {s: s.capitalize() for s in SCHOOLS}

# school -> per level value (levels 1..3), multiplied by the caster's strength, then capped
SPELLS = {
    'evocation':     {'damage': (40, 75, 120)},
    'abjuration':    {'block': (0.30, 0.50, 0.70), 'block_cap': 0.85},
    'conjuration':   {'flat': (20, 40, 60), 'screen': (0.10, 0.15, 0.20), 'screen_cap': 0.40},
    'enchantment':   {'army': (0.20, 0.35, 0.50), 'army_cap': 0.90},
    'illusion':      {'miss': (25, 40, 55), 'miss_cap': 80},           # percent
    'divination':    {'aim': (0.10, 0.20, 0.30), 'floor': (10, 15, 20)},  # our die is at least this
    'necromancy':    {'rot': (8, 15, 24), 'rot_cap': 90},
    'transmutation': {'sunder': (0.08, 0.14, 0.20), 'sunder_cap': 0.50},
}

SCOUT_COST = 200
SCOUT_DAYS = 180
SCOUT_VULN = 0.15
CONTAIN_YEARS = 10
REGROUP_DAYS = {'defeat': 365, 'withdraw': 180}
STALE_DAYS = 30              # an unfinished fight can only be broken off after this
LOSS_SHARE = {'victory': 0.35, 'withdraw': 0.50, 'defeat': 0.70}   # regiments lost per share of resolve lost
KEEP_WOUNDS = 0.5            # share of its wounds a legend keeps after driving us off


class Move:
    def __init__(self, id, name, telegraph, might, weight, in_mult=None, out_mult=None, ward_gain=0,
                 ward_gain_order=None, ward_gain_blocked_by=None, heal=0, heal_blocked_orders=(),
                 heal_blocked_by=None, fear=1.0, fear_exempt_orders=(), report=''):
        self.id, self.name, self.telegraph, self.might, self.weight = id, name, telegraph, might, weight
        self.in_mult = {o: ORDERS[o][2] for o in ORDERS}
        self.in_mult.update(in_mult or {})
        self.out_mult = {o: 1.0 for o in ORDERS}
        self.out_mult.update(out_mult or {})
        self.ward_gain = ward_gain
        self.ward_gain_order = ward_gain_order or {}      # order -> multiplier on the ward it gains
        self.ward_gain_blocked_by = ward_gain_blocked_by  # school that cancels the gain
        self.heal = heal
        self.heal_blocked_orders = tuple(heal_blocked_orders)
        self.heal_blocked_by = heal_blocked_by            # school that cancels the healing
        self.fear = fear                                  # our army damage times this ...
        self.fear_exempt_orders = tuple(fear_exempt_orders)  # ... unless Enchantment or one of these orders
        self.report = report


class Legend:
    # What a legend may leave out.
    DEFAULTS = dict(
        start_hp=1.0,          # share of its vitality it has when we first meet it (below 1: already wounded)
        unlock_flag=None,      # country flag of the owner that opens the way to it ...
        unlock_trigger=None,   # ... or a trigger in the scope of its province
        talk_only=False,       # it cannot be fought, scouted or contained: the window shows it and offers Parley
        flees=False,           # one fight only: if we do not kill it, it leaves for good (rout or withdrawal alike)
        end_flag=None,         # province flag set when it is gone (killed, or fled if it flees)
        loss_province_effects=(),  # script lines for its province in the rout and withdrawal events of a legend that flees
        loss_effects=(),       # script lines for the country in those two events
        contain_cost=(),       # empty: it cannot be contained
        contain_modifier={},
        parley_event=None, raid_event=None, raid_chance=0,
        parley_if=None,        # DA_KB: a trigger in the scope of its province: whom it will hear (None: anyone; doc 62)
        contain_if=None,       # DA_EL: a trigger in the scope of its province: who can contain it (None: anyone who pays)
        immune=(),             # DA_EL: schools that are wasted on it: their spell buttons are refused against it
        ai_tech=None, ai_army=None,   # None: the AI never finishes it
        defeat_manpower=0, defeat_stability=0,
    )

    def __init__(self, **kw):
        self.__dict__.update(self.DEFAULTS)
        self.__dict__.update(kw)


