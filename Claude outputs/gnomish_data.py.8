def effect_text(mod, art=False, sep=', '):
    """'+10% Siege Ability, -10% Artillery Cost' with the game's colours. art: a modifier of the artificer regiments."""
    out = []
    for k, v in mod.items():
        label, pct, good_pos = KEY[k]
        num = round(v * 100, 2) if pct else v
        s = ('%+.2f' % num).rstrip('0').rstrip('.')
        if pct:
            s += '%'
        good = (v > 0) == good_pos
        out.append('%s%s§! %s%s' % ('§G' if good else '§R', s, 'Artificer ' if art else '', label))
    return sep.join(out)
