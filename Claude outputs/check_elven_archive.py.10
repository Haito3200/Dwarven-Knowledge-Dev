#!/usr/bin/env python3
"""Checks of the elves' and the Ruinborn's content (doc 68, doc 69): the Remnant Archive, the Elven page and the ruins.

    python3 "Claude files/tools/check_elven_archive.py" . [anbennar folder]

1. The generated files are what the builders write now (build_elven_archive.py, build_ruin_excavation.py).
2. Every scripted trigger and effect the new files call is defined, in the mod or in Anbennar.
3. Every localisation key the new files name exists: events, tooltips, defined texts, modifiers, window texts.
4. Every event the new files fire exists; every modifier they add or test exists.
5. The window: each scripted element has its custom_gui entry and back; each sprite is defined, its texture there at
   the size the layout wants.
6. The province view: two Excavation panels, three Unseal buttons, each element of the panel scripted and registered.
7. The Elven page: its 35 tiles in Projects & Research, their completion events and living bonuses; the page shows for
   elves and Ruinborn only; the Remnant Archive is a built hall of the hub.
8. Doc 72: the three legends are Legendary Encounters that agree with the Archive; Wyrmbane is an army bonus and its
   flag is kept; the arsenal is what build_elven_arsenal.py writes and passes its own check; the surveys' sites and
   events; Hire a Precursor Archaeologist free for the Precursor heritage.
Exit code 1 when something fails.
"""
import glob, os, re, struct, sys

ROOT = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else '.')
ANB = sys.argv[2] if len(sys.argv) > 2 else os.environ.get('DA_ANBENNAR') or os.path.join(os.path.dirname(ROOT), 'anbennar-eu4-dev-new-master')
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.argv = [sys.argv[0], ROOT, 'check']
import elven_data as E  # noqa: E402
import build_elven_archive as BA  # noqa: E402
import build_ruin_excavation as BR  # noqa: E402
import elven_archive_ui as UI  # noqa: E402

passed = failed = 0
problems = []


def ok(cond, msg):
    global passed, failed
    if cond:
        passed += 1
    else:
        failed += 1
        problems.append(msg)


def rd(rel, root=ROOT):
    p = os.path.join(root, rel)
    if not os.path.exists(p):
        return ''
    raw = open(p, 'rb').read()
    return raw.decode('utf-8-sig' if p.endswith('.yml') else 'latin-1').replace('\r\n', '\n')


def nocomment(t):
    return re.sub(r'#[^\n]*', '', t)


# ---- 1. up to date ----------------------------------------------------------------------------------------------
BA.ROOT = BR.ROOT = UI.ROOT = ROOT
files = BA.generated()
files.update(BR.generated())
for rel, text in files.items():
    ok(rd(rel) == text.replace('\r\n', '\n'), 'not what the builder writes now: %s (re-run the builders)' % rel)

# ---- definitions in the mod and in Anbennar ----------------------------------------------------------------------
defs = {'trig': set(), 'eff': set(), 'mod': set(), 'loc': set(), 'ev': set(), 'sprite': set(), 'dt': set()}
for root in (ROOT, ANB):
    for sub, kind in (('common/scripted_triggers', 'trig'), ('common/scripted_effects', 'eff')):
        for f in glob.glob(os.path.join(root, sub, '*.txt')):
            defs[kind] |= set(re.findall(r'^([A-Za-z_][\w.]*)\s*=\s*\{', nocomment(rd(os.path.relpath(f, root), root)), re.M))
    for sub in ('common/event_modifiers', 'common/static_modifiers', 'common/triggered_modifiers', 'common/opinion_modifiers'):
        for f in glob.glob(os.path.join(root, sub, '*.txt')):
            defs['mod'] |= set(re.findall(r'^([A-Za-z_][\w.]*)\s*=\s*\{', nocomment(rd(os.path.relpath(f, root), root)), re.M))
    for f in glob.glob(os.path.join(root, 'localisation', '**', '*.yml'), recursive=True):
        defs['loc'] |= set(re.findall(r'^\s*([\w.\-]+):\d*\s*"', rd(os.path.relpath(f, root), root), re.M))
    for f in glob.glob(os.path.join(root, 'events', '*.txt')):
        defs['ev'] |= set(re.findall(r'\bid\s*=\s*([\w.]+)', nocomment(rd(os.path.relpath(f, root), root))))
    for f in glob.glob(os.path.join(root, 'interface', '*.gfx')):
        defs['sprite'] |= set(re.findall(r'name\s*=\s*"([^"]+)"', rd(os.path.relpath(f, root), root)))
    for f in glob.glob(os.path.join(root, 'customizable_localization', '*.txt')):
        defs['dt'] |= set(re.findall(r'name\s*=\s*(\S+)', nocomment(rd(os.path.relpath(f, root), root))))
BUILTIN = {'always', 'ai', 'is_at_war', 'owned_by', 'is_capital', 'NOT', 'OR', 'AND'}
ours = {rel: nocomment(t) for rel, t in files.items() if not rel.endswith('.yml')}

# ---- 2. scripted triggers and effects ------------------------------------------------------------------------------
called = set()
for rel, t in ours.items():
    if rel.endswith('.gfx') or 'customizable_localization' in rel:
        continue
    called |= set(re.findall(r'\b(DA_[A-Za-z_][\w.]*)\s*=\s*(?:yes|no)\b', t))
    called |= set(re.findall(r'\b(DA_[A-Za-z_][\w.]*)\s*=\s*\{\s*(?:amount|pct|s|kind|lore|school)\s*=', t))
for c in sorted(called):
    ok(c in defs['trig'] or c in defs['eff'], 'called but not defined: %s' % c)
for rel in ('customizable_localization/DA_EL_custom_loc.txt', 'customizable_localization/DA_RX_custom_loc.txt'):
    for c in sorted(set(re.findall(r'\b(DA_[A-Za-z_][\w.]*)\s*=\s*yes\b', ours[rel]))):
        ok(c in defs['trig'], 'a defined text tests an unknown trigger: %s' % c)

# ---- 3. localisation keys ------------------------------------------------------------------------------------------
keys = set()
for rel, t in ours.items():
    keys |= set(re.findall(r'\b(?:tooltip|title|desc|name|localisation_key)\s*=\s*"?([A-Za-z_][\w.\-]*)"?', t))
    keys |= set(re.findall(r'\bcustom_tooltip\s*=\s*([A-Za-z_][\w.\-]*)', t))
    keys |= set(re.findall(r'\b(?:buttonText|text)\s*=\s*"([A-Za-z_][\w.\-]*)"', t))
win = UI.gen_window(E)
keys |= set(re.findall(r'\b(?:buttonText|text)\s*=\s*"([A-Za-z_][\w.\-]*)"', win))
panel = BR.gen_province_panel()
keys |= set(re.findall(r'\b(?:buttonText|text)\s*=\s*"([A-Za-z_][\w.\-]*)"', panel))
skip = re.compile(r'^(DA_EL_(art|cx|mv|lg|pr|as|up|sw|w|build|raise|tab|nav|pic|sel|cl|lv|lvs|pip|ws)_|DA_EL_close$|DA_RX_(charter_|mark_|row_|rn_|seal_|unseal|close|send|waygate)|'
                  r'DA_EL_archive$|DA_province_ruin_panel$|DA_EL_bg$|DA_EL_cover$|DA_RX_background$|DA_RX_banner$|DA_EL_survey$)')
for k in sorted(keys):
    if not k.startswith(('DA_EL', 'DA_RX', 'estate_da_archaeomancers', 'DA_Archaeomancers')) or k.endswith('.'):
        continue   # a key ending in "." takes its end from a parameter ($amount$): its texts are checked by amount below
    if k in defs['dt'] or k in defs['ev'] or k in defs['trig'] or k in defs['eff'] or k in defs['mod'] and k in defs['loc']:
        continue
    if skip.match(k) and k not in defs['loc'] and not k.endswith('_tt') and '_tt.' not in k:
        continue
    ok(k in defs['loc'], 'no text for %s' % k)

# ---- 4. events, modifiers --------------------------------------------------------------------------------------------
for rel, t in ours.items():
    for e in set(re.findall(r'\bid\s*=\s*((?:DA_EL|DA_RX)_event\.\d+)', t)):
        ok(e in defs['ev'], '%s: fires %s, which does not exist' % (rel, e))
    for m in set(re.findall(r'\b(?:add_country_modifier|add_province_modifier|add_permanent_province_modifier)\s*=\s*\{\s*name\s*=\s*([\w.]+)', t)):
        ok(m in defs['mod'], '%s: adds the modifier %s, which is not defined' % (rel, m))
    for m in set(re.findall(r'\bhas_(?:country|province)_modifier\s*=\s*([\w.]+)', t)):
        ok(m in defs['mod'], '%s: tests the modifier %s, which is not defined' % (rel, m))
for m in sorted(m for m in defs['mod'] if m.startswith(('DA_EL', 'DA_RX'))):
    ok(m in defs['loc'] or m in ('DA_EL_works_timer', 'DA_EL_mv_timer') or m in defs['loc'], 'modifier without a name: %s' % m)

# ---- 5. the window ---------------------------------------------------------------------------------------------------
cg = ours['common/custom_gui/DA_EL_Remnant_Archive.txt']
scripts = set(re.findall(r'^\s*name\s*=\s*(\S+)', cg, re.M)) - {UI.WIN}
elems = set(re.findall(r'name\s*=\s*"([^"]+)"', win))
scripted = set()
for m in re.finditer(r'(\w+Type)\s*=\s*\{(.*?)\n\t\t\t\}', win, re.S):
    if 'scripted = yes' in m.group(2):
        scripted.add(re.search(r'name\s*=\s*"([^"]+)"', m.group(2)).group(1))
for s in sorted(scripts):
    ok(s in elems, 'the Archive\'s script %s has no window element' % s)
for e in sorted(scripted - {UI.WIN}):
    ok(e in scripts, 'the Archive\'s element %s has no script' % e)
for k in ('DA_EL_has_lore_tt', 'DA_EL_has_mana_tt', 'DA_EL_lore_gain_tt', 'DA_EL_lore_cost_tt', 'DA_EL_mana_cost_tt'):
    for a in (1, 5, 10, 60, 100):
        ok('%s.%d' % (k, a) in defs['loc'], 'no text for %s.%d' % (k, a))
top = rd('interface/topbar.gui')
ok('windowType = { #DA_EL_archive' in top, 'the Remnant Archive is not in topbar.gui')
ok(win in top.replace('\r\n', '\n'), 'the Remnant Archive in topbar.gui is not what the builder writes now')
sizes = UI.texture_sizes(E)
for name, tex, frames, check in UI.sprites(E):
    p = os.path.join(ROOT, UI.ART, tex + '.dds')
    ok(os.path.exists(p), 'texture missing: %s (run ". art")' % tex)
    if os.path.exists(p):
        raw = open(p, 'rb').read(24)
        h, w = struct.unpack('<2I', raw[12:20])
        ok((w, h) == tuple(sizes[tex]), 'texture %s is %d x %d, the layout wants %s' % (tex, w, h, sizes[tex]))
for s in set(re.findall(r'"(GFX_DA_EL_\w+)"', win)):
    ok(s in defs['sprite'], 'sprite %s is not defined' % s)

# ---- 6. the province view ---------------------------------------------------------------------------------------------
pv = rd('interface/provinceview.gui')
ok(pv.count(BR.PANEL_BEGIN) == 2, 'the Excavation panel is not in the province view twice')
ok(pv.count(BR.BUTTON_BEGIN) == 3, 'the Unseal button is not in the three grids')
rx = ours['common/custom_gui/DA_RX_Ruin_Excavation.txt']
rx_scripts = set(re.findall(r'^\s*name\s*=\s*(\S+)', rx, re.M)) - {'DA_province_ruin_panel'}
rx_elems = set(re.findall(r'name\s*=\s*"([^"]+)"', panel)) | {'DA_RX_unseal_button'}
for s in sorted(rx_scripts):
    ok(s in rx_elems, 'the Excavation panel\'s script %s has no element' % s)
for name, tex, frames in BR.SPRITES:
    ok(os.path.exists(os.path.join(ROOT, BR.GFX, tex + '.dds')), 'texture missing: %s' % tex)
ok(not (set(E.GREAT) & set(E.LESSER)), 'a great ruin is also listed as a lesser one')

# ---- 7. the Elven page, the hall -------------------------------------------------------------------------------------
pr_tree = nocomment(rd('common/custom_gui/DA_PR_tree.txt'))
for nid in E.NODES:
    ok('DA_PR_start_%s' % nid in pr_tree, 'the tile %s is not on the Elven page' % nid)
m = re.search(r'name = DA_projects_research_Interface_%s\s*potential = \{(.*?)\n' % E.PAGE_ID, pr_tree)
ok(m and 'DA_RH_primary_elven = yes' in m.group(1) and 'DA_RH_primary_ruinborn = yes' in m.group(1),
   'the Elven page does not show for elves and Ruinborn')
pr_ev = rd('events/DA_PR_events.txt')
for nid, d in E.NODES.items():
    ok('# %s\n' % nid in pr_ev or '# %s\r\n' % nid in pr_ev, 'no completion event for %s' % nid)
rh = nocomment(rd('common/scripted_effects/DA_Racial_Heritage_effects.txt'))
for race, bid, mod in E.LIVING_ROWS:
    ok('DA_RH_grant_elven_%s = {' % bid in rh, 'the living bonus %s is not granted through the heritage' % bid)
m = re.search(r'DA_RH_sync_elven = \{(.*?)\n\}', rh, re.S)
ok(m and 'DA_RH_active_ruinborn = yes' in m.group(1), 'the Ruinborn do not keep the elven living bonuses')
ok('DA_RH_open_hall_elven = {' in rh, 'the Remnant Archive is not a built hall of the hub')
lv = re.search(r'DA_RH_leave_ruinborn = \{(.*?)\n\}', rh, re.S)
ok(lv and 'DA_RH_is_elven = yes' in lv.group(1), 'a Ruinborn who becomes elven would pause the Elven page')

# ---- 8. doc 72: the legends, Wyrmbane, the arsenal, the surveys, the archaeologist ----------------------------------
import le_rules as LR  # noqa: E402
import subprocess  # noqa: E402
le_trig = nocomment(rd('common/scripted_triggers/DA_Legendary_Encounter_triggers.txt'))
for g in E.LEGENDS:
    lg = LR.LEGEND.get(g['id'])
    ok(lg is not None, 'the legend %s is not a Legendary Encounter (le_rules.py)' % g['id'])
    if lg:
        ok(lg.province == g['prov'], 'the legend %s: the Archive says province %d, the encounter %d' % (g['id'], g['prov'], lg.province))
        ok(g['open'] == lg.unlock_trigger, 'the legend %s: the Archive and the encounter disagree on the way open' % g['id'])
        ok(bool(lg.contain_cost) == g['contain'], 'the legend %s: the Archive and the encounter disagree on containing it' % g['id'])
        ok(lg.end_flag == 'DA_EL_%s_done' % g['id'], 'the legend %s: its end flag is not the one the Archive reads' % g['id'])
        ok('DA_LE_is_%s = {' % g['id'] in le_trig, 'the legend %s is not in the encounters\' triggers' % g['id'])
        mt = re.search(r'^DA_LE_is_%s = \{(.*?)\n\}' % g['id'], le_trig, re.S | re.M)
        ok(mt and 'province_id = %d' % g['prov'] in mt.group(1), 'the legend %s is not tied to its province: every ruin would '
           'have it' % g['id'])
        for e in (lg.victory_event, lg.parley_event):
            ok(e is None or e in defs['ev'], 'the legend %s fires %s, which does not exist' % (g['id'], e))
wb = [b for b in LR.ARMY_BONUS if b['flag'] == 'DA_EL_wyrmbane_on']
ok(len(wb) == 1 and set(wb[0]['legends']) == {'dragon', 'hunter', 'challumaton'}, 'Wyrmbane is not in le_rules.ARMY_BONUS')
eff = nocomment(rd('common/scripted_effects/DA_EL_effects.txt'))
for host in ('DA_EL_sync', 'DA_EL_refresh'):
    m = re.search(r'^%s = \{(.*?)\n\}' % host, eff, re.S | re.M)
    ok(m and 'DA_EL_wyrmbane_sync = yes' in m.group(1), '%s does not keep the Wyrmbane flag' % host)
r = subprocess.run([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'build_elven_arsenal.py'), ROOT, 'check'],
                   capture_output=True, text=True)
out = r.stdout + r.stderr
ok(r.returncode == 0 and 'no problems found' in out, 'build_elven_arsenal.py check: %s' % out[-400:])
ok(not [l for l in out.splitlines() if l.startswith('would write')], 'the arsenal is not what build_elven_arsenal.py writes now')
ok(set(E.SURVEY_SITES) == set(E.GREAT) | set(E.LESSER), 'the survey sites are not the great and lesser ruins')
ok(len(E.SURVEY_SITES) == len(set(E.SURVEY_SITES)), 'a survey site is listed twice')
ok(all(p in E.SITE_NAMES for p in E.SURVEY_SITES), 'a survey site has no name')
ok(all(len(ps) <= 9 for _, _, ps in E.SURVEY_GROUPS), 'a region of the survey chooser has more than nine ruins')
rx_ev = ours['events/DA_RX_events.txt']
for n in list(range(60, 67)) + [70 + k for k in range(len(E.SURVEY_GROUPS))]:
    ok(re.search(r'\bid = DA_RX_event\.%d\b' % n, rx_ev), 'the survey event DA_RX_event.%d is missing' % n)
ok('DA_RX_open_survey = yes' in cg, 'the Archive does not send surveys')
dec = rd('decisions/DA_Ancient_dwarven_knowledge.txt')
ok('# DA_EL archaeologist' in dec, 'Hire a Precursor Archaeologist is not free for the Precursor heritage')
ok(nocomment(dec).count('{') == nocomment(dec).count('}'), 'the decisions file does not balance')

print('%d passed, %d failed' % (passed, failed))
for p in problems:
    print('  FAIL ' + p)
sys.exit(1 if failed else 0)
