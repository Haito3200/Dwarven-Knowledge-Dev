    if rel.endswith('.yml'):
        ok(raw.startswith(b'\xef\xbb\xbf'), rel + ': no BOM')
        raw.decode('utf-8')
    else:
        try:
            raw.decode('ascii')
            ok(True, '')
        except UnicodeDecodeError:
            ok(False, rel + ': not ASCII')
        t = re.sub(r'"[^"\n]*"', '', nocomment(raw.decode('latin-1')))
        ok(t.count('{') == t.count('}'), rel + ': braces do not balance')
