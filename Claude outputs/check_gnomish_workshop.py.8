#!/usr/bin/env python3
"""Offline check of the gnomes, steps 1 and 2 (doc 52, doc 53). Read-only.

    python3 "Claude files/tools/check_gnomish_workshop.py" . [ANBENNAR]

ANBENNAR defaults to the folder next to the mod (anbennar-eu4-dev-new-master); it is used for the sprites, the
modifier keys and the names of Anbennar's inventions.

1. The generated files are what the builders write now (build_gnomish_workshop.py, build_projects_research.py).
2. Encoding, braces; no else in the scripted effects; no dice in anything a button runs.
3. Every scripted trigger and effect that the gnome files call is defined; every text exists; every [Root.X] is a
   defined text or a variable; every window element has its script and the other way round; every sprite its texture.
4. Names: no patent or upgrade is named like an invention of Anbennar, a Pioneer invention, a Runesmith invention or a
   tile of Projects & Research.
5. The hooks: the Gnomish page and its window, the Start buttons and the half time of the lead school, the living
   bonuses, the pause of the page, the hub plaque, the shared slot (DA_available_research, DA_SCH_no_research_running,
   the attention markers), tile 26 closed after the Corps.
6. A small interpreter runs the generated scripts through a gnomish country's life: the Corps, a prototype on the
   bench, switching on and off, the cooldown, the Mechanist booking, over capacity, the estate lost, the heritage
   dormant, Serendipity and Misfire, the Inventors' Fair, the bench and the school studies.
7. Step 2, with several countries: a branch for an ally or a subject (opened, refused to strangers, closed when the
   alliance ends, refunded when the host is lost on the bench, paused while the heritage is dormant), licences
   (offered, accepted and declined, paid, ended by switching the patent off, by the alliance's end, by a dormant
   heritage and by their fifteen years), the Great Ideation Engine (once; commissions a quarter faster; innovativeness),
   Dragonbreaker Harpoons (the flag of the Legendary Encounters), the E++ dispute (once, with a goblin neighbour that
   has E++), and Gommo Calibration in the Unit Design (the option, its price rule, its grant, removal and Reset lines,
   its name in Secondary Technologies).
"""
import os, re, subprocess, sys

ROOT = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else '.')
ANB = os.path.abspath(sys.argv[2] if len(sys.argv) > 2 else os.path.join(os.path.dirname(ROOT), 'anbennar-eu4-dev-new-master'))
TOOLS = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, TOOLS)
import gnomish_data as G  # noqa: E402
import pdx  # noqa: E402

PASS, FAIL = [0], []


def ok(cond, msg):
    if cond:
        PASS[0] += 1
    else:
        FAIL.append(msg)


def rd(rel, root=ROOT):
    full = os.path.join(root, rel)
    raw = open(full, 'rb').read()
    return (raw.decode('utf-8-sig') if rel.endswith('.yml') else raw.decode('latin-1')).replace('\r\n', '\n')


def nocomment(t):
    return re.sub(r'#[^\n]*', '', t)


GN_FILES = ['common/scripted_triggers/DA_GN_triggers.txt', 'common/scripted_effects/DA_GN_effects.txt',
            'common/event_modifiers/DA_GN_modifiers.txt', 'common/triggered_modifiers/DA_GN_modifiers.txt',
            'common/on_actions/DA_GN_on_actions.txt', 'events/DA_GN_events.txt', 'common/custom_gui/DA_GN_Workshop.txt',
            'customizable_localization/DA_GN_custom_loc.txt', 'interface/DA_GN_Workshop.gfx',
            'common/opinion_modifiers/DA_GN_opinion_modifiers.txt', 'common/new_diplomatic_actions/DA_GN_diplomatic_actions.txt']
DIPLO = 'common/new_diplomatic_actions/DA_GN_diplomatic_actions.txt'

