ok('DA_GN_lic_cocolocogram' in aly.mods and 'DA_GN_lic_cocolocogram_GNO' in aly.flags and ('GNO', 'DA_GN_licence') in aly.opinions
   and 'DA_GN_lic_offer.cocolocogram' not in aly.flags and gno.events[-1:] == ['DA_GN_event.12'] and 'DA_GN_lic_yes' in gno.flags,
   'the licence is not granted')
act(gno, [], immediate('DA_GN_event.12'), gno, aly)
ok('DA_GN_lic_pending' not in gno.flags and gno.v('DA_GN_lic_count') == 1 and gno.v('DA_GN_lic_income') == L2['fee'],
   'the licence is not counted')
ok(not action('DA_GN_license_patent', aly), 'one patent licensed twice to one country')
ta, tb = gno.treasury, aly.treasury
WORLD.root, WORLD.from_ = gno, None
gno.run('DA_GN_licence_fees')
ok(gno.treasury == ta + L2['fee'] and aly.treasury == tb - L2['fee'], 'the licence fee')
ok(gno.button('DA_GN_can_off_cocolocogram', 'DA_GN_switch_off_cocolocogram'), 'licences: the patent does not switch off')
ok('DA_GN_lic_cocolocogram' not in aly.mods and 'DA_GN_lic_cocolocogram_GNO' not in aly.flags
   and ('GNO', 'DA_GN_licence') not in aly.opinions and gno.v('DA_GN_lic_count') == 0, 'switching a patent off keeps its licence')
# declined, then the other endings
gno.day += 400
gno.button('DA_GN_can_on_cocolocogram', 'DA_GN_switch_on_cocolocogram')
accept('DA_GN_license_patent', aly)
act(gno, *option('DA_GN_event.10', 'DA_GN_event.10.p1'), gno)
act(aly, *option('DA_GN_event.11', 'DA_GN_event.11.b'), aly, gno)
ok('DA_GN_lic_cocolocogram' not in aly.mods and 'DA_GN_lic_no' in gno.flags and 'DA_GN_lic_offer.cocolocogram' not in aly.flags,
   'a declined licence')
act(gno, [], immediate('DA_GN_event.12'), gno, aly)
ok(gno.v('DA_GN_lic_count') == 0 and 'DA_GN_lic_pending' not in gno.flags, 'a declined licence is counted')
for ending in ('alliance', 'dormant', 'years'):
    act(gno, *option('DA_GN_event.10', 'DA_GN_event.10.p1'), gno)
    act(aly, *option('DA_GN_event.11', 'DA_GN_event.11.a'), aly, gno)
    act(gno, [], immediate('DA_GN_event.12'), gno, aly)
    ok(gno.v('DA_GN_lic_count') == 1, 'licences: %s: not granted' % ending)
    if ending == 'alliance':
        WORLD.allies.discard(frozenset(('GNO', 'ALY')))
        WORLD.root, WORLD.from_ = gno, None
        gno.run('DA_GN_yearly')
        WORLD.allies.add(frozenset(('GNO', 'ALY')))
    elif ending == 'dormant':
        gno.active = gno.primary = False
        WORLD.root, WORLD.from_ = gno, None
        gno.run('DA_GN_sync')
        gno.active = gno.primary = True
        gno.day += 400
        gno.button('DA_GN_can_on_cocolocogram', 'DA_GN_switch_on_cocolocogram')
    else:
        aly.mods.discard('DA_GN_lic_cocolocogram')   # the 15 years are over
        WORLD.root, WORLD.from_ = gno, None
        gno.run('DA_GN_yearly')
    ok('DA_GN_lic_cocolocogram_GNO' not in aly.flags and gno.v('DA_GN_lic_count') == 0 and ('GNO', 'DA_GN_licence') not in aly.opinions,
       'licences: %s does not end the licence' % ending)
gno.vars['DA_GN_lic_count'] = L2['max']
ok(not action('DA_GN_license_patent', aly), 'a licence over the limit')
gno.vars['DA_GN_lic_count'] = 0

# The Great Ideation Engine
WORLD.root, WORLD.from_ = gno, None
ok(not gno.is_('DA_GN_can_engine'), 'the Engine before Grand Synthesis')
gno.flags['DA_PR_done.GN_Synthesis'] = 0
gno.treasury = 5000
gno.vars['DA_arcane_metal_total'] = E2['mats'][0][1] - 1
gno.vars['DA_enchanted_building_material_total'] = E2['mats'][1][1]
ok(not gno.is_('DA_GN_can_engine'), 'the Engine without its metal')
gno.vars['DA_arcane_metal_total'] += 1
ok(gno.button('DA_GN_can_engine', 'DA_GN_start_engine'), 'the Engine does not start')
ok(gno.v('DA_GN_job') == 600 and gno.v('DA_GN_job_months') == E2['months'] and gno.treasury == 5000 - E2['cost']
   and gno.v('DA_arcane_metal_total') == 0 and gno.v('DA_enchanted_building_material_total') == 0, 'the Engine starts wrongly')
ok(not gno.is_('DA_GN_can_engine'), 'a second Engine while the first is on the bench')
gno.month(E2['months'])
ok('DA_GN_engine_built' in gno.flags and gno.v('DA_GN_report') == 10 and not gno.is_('DA_GN_can_engine'), 'the Engine is not built')
gno.flags.pop('DA_GN_proto.dynamos', None)   # prototyped for the licence tests: build it again
gno.button('DA_GN_can_proto_dynamos', 'DA_GN_start_proto_dynamos')
ok(gno.v('DA_GN_job_months') == int(round(G.PROTO_MONTHS[1] * E2['faster'])), 'the Engine does not speed the commissions')
gno.month(G.PROTO_MONTHS[1])
gno.flags['DA_PR_done.GN_Brillite'] = 0
gno.flags['DA_PR_done.GN_Bombards'] = 0
gno.choice = 2
gno.button('DA_GN_can_proto_bombards', 'DA_GN_start_proto_bombards')
ok(gno.v('DA_GN_job_months') == int(round(G.PROTO_MONTHS[1] * G.BRILLITE_TIME * E2['faster'])), 'the Engine and the Brillite Method')
gno.month(G.PROTO_MONTHS[1])
i0 = gno.inno
WORLD.dice = 100            # no E++ roll here
gno.run('DA_GN_yearly')
ok(gno.inno == i0 + G.INTERNATIONAL_INNOVATIVENESS + E2['innovativeness'], 'innovativeness: the International Gommo and the Engine')
gno.active = gno.primary = False
i0 = gno.inno
gno.run('DA_GN_yearly')
ok(gno.inno == i0, 'innovativeness while the heritage is dormant')
gno.active = gno.primary = True

# Dragonbreaker Harpoons
gno.run('DA_GN_sync')
ok(G.HARPOONS['flag'] not in gno.flags, 'the harpoons before their tile')
gno.flags['DA_PR_done.GN_Harpoons'] = 0
gno.run('DA_GN_sync')
ok(G.HARPOONS['flag'] in gno.flags, 'the harpoons do not reach the Legendary Encounters')
gno.active = gno.primary = False
gno.run('DA_GN_sync')
ok(G.HARPOONS['flag'] not in gno.flags, 'the harpoons work while the heritage is dormant')
gno.active = gno.primary = True
gno.run('DA_GN_sync')

# The E++ Patent Dispute
WORLD.neighbours.add(frozenset(('GNO', 'GOB')))
gob.goblin = True
ok(not gno.is_('DA_GN_eplus_ready'), 'the dispute without E++')
gob.flags['unlocked_artifice_invention_eplusplus_compound'] = 0
ok(gno.is_('DA_GN_eplus_ready'), 'no dispute with a goblin neighbour that has E++')
WORLD.dice = 0
gno.events = []
gno.run('DA_GN_yearly')
ok('DA_GN_event.13' in gno.events, 'the yearly pulse does not start the dispute')
act(gno, [], immediate('DA_GN_event.13'), gno)
ok('DA_GN_eplus_done' in gno.flags and WORLD.targets.get('DA_GN_eplus_goblin') is gob and not gno.is_('DA_GN_eplus_ready'),
   'the dispute: its goblins, or it comes twice')
ta, tb, i0 = gno.treasury, gob.treasury, gno.inno
act(gno, *option('DA_GN_event.13', 'DA_GN_event.13.b'), gno)
ok(gno.treasury == ta - G.EPLUS['price'] and gob.treasury == tb + G.EPLUS['price'] and gno.inno == i0 + G.EPLUS['innovativeness']
   and gno.xp.get('Metallurgy') == G.EPLUS['xp'], 'buying the formula')
act(gno, *option('DA_GN_event.13', 'DA_GN_event.13.a'), gno)
ok(('GNO', 'DA_GN_patent_suit') in gob.opinions, 'the suit')
act(gno, *option('DA_GN_event.13', 'DA_GN_event.13.c'), gno)
ok(gno.advisors and gno.advisors[-1].get('type') == G.EPLUS['advisor'] and gno.advisors[-1].get('culture') == 'event_target:DA_GN_eplus_goblin',
   'the inventor')
for x in WORLD.countries:
    ok(not x.unknown, 'step 2: names the interpreter does not know (%s): %s' % (x.tag, sorted(set(x.unknown))))

# Gommo Calibration in the Unit Design
CAL = G.CALIBRATION
ok(CAL['cost'] == 1 + CAL['S'] + CAL['M'] + CAL['E'], 'Gommo Calibration breaks the price rule of the paths (1 + S + M + E)')
for cls in CAL['classes']:
    t = rd('events/DA_Metallurgy_events_%s_0.txt' % cls)
    a, o_, z = t.find('# BEGIN DA_GN '), t.find('# BEGIN DA_OBSIDIAN'), t.find('\n\tafter = {')
    ok(0 < a < z and (o_ < 0 or a < o_ < z), '%s: Gommo Calibration is not in the designer before the obsidian block' % cls)
    blk = t[a:t.find('# END DA_GN', a)]
    for key, val in (('DA_Cost', CAL['cost']), ('DA_Strength', CAL['S']), ('DA_Magic_Conductivity', CAL['M']),
                     ('DA_Electrical_Conductivity', CAL['E'])):
        ok(re.search(r'\b%s = %d\b' % (key, val), blk), '%s: Gommo Calibration %s' % (cls, key))
    ok('DA_disable_normal_BPs' not in blk and CAL['gate'] in blk and 'DA_Unique = %s' % CAL['token'] in blk
       and 'DA_SCH_pick = { unit = %s part = punk token = %s }' % (cls, CAL['token']) in blk, '%s: the Gommo Calibration option' % cls)
    ok(('DA_Unique_mod.PUNK.%s.%s' % (cls, CAL['token'])) in MODDEFS, '%s: no fixed effect for Gommo Calibration' % cls)
SPE = rd('common/scripted_effects/DA_Metallurgy_special_mod_effects.txt')
for line in ['DA_if_flag_give_modifier_effect = { DA_unit = %s DA_type = PUNK DA_modifier = %s } # DA_GN' % (c_, CAL['token'])
             for c_ in CAL['classes']] + ['remove_country_modifier = DA_Unique_mod.PUNK.%s.%s # DA_GN' % (c_, CAL['token'])
                                          for c_ in CAL['classes']] + \
        ['clr_country_flag = DA_Unique_mod.PUNK.Flag.$DA_unit$.%s # DA_GN' % CAL['token']]:
    ok(SPE.count(line) == 1, 'DA_Metallurgy_special_mod_effects.txt: %s' % line)
ok(CAL['token'] in rd('customizable_localization/DA_SCH_custom_loc.txt'),
   'Secondary Technologies does not name Gommo Calibration (run build_secondary_tech.py)')
# the Legendary Encounters read the harpoons; the Engine's key exists in the mod
LEE = nocomment(rd('common/scripted_effects/DA_Legendary_Encounter_effects.txt'))
ca = LEE[LEE.index('DA_LE_count_army = {'):]
ca = ca[:ca.index('\n}')]
ok('has_country_flag = %s' % G.HARPOONS['flag'] in ca and all('DA_LE_is_%s = yes' % l in ca for l in G.HARPOONS['legends']),
   'the Legendary Encounters ignore Dragonbreaker Harpoons (run build_legendary_encounters.py)')
ok('DA_LE_GetArmyBonus' in rd('customizable_localization/DA_Legendary_Encounter_custom_loc.txt'), 'the army tooltip ignores the harpoons')
PRELOAD = ''
for fn in os.listdir(os.path.join(ROOT, 'common', 'estates_preload')):
    PRELOAD += nocomment(rd(os.path.join('common', 'estates_preload', fn)))
ok('key = DA_fake_research_speed_gain_percentage' in PRELOAD, 'the Engine\'s research key is not a modifier of the mod')

# ---- 8. the Precursor Assays (doc 72) ---------------------------------------------------------------------------------
PRE = [p for p in G.PATENTS if p.get('precursor')]
ok(len(PRE) == 3 and [p['id'] for p in G.PATENTS[-3:]] == [p['id'] for p in PRE], 'the three Precursor patents are not the last three')
ok(len(G.PATENTS) - len(PRE) == 14 and len(G.NODES) == 33 and len(G.FAMILIES) == 8, 'the page: 33 tiles in 8 families, 14 patents and 3')
CG8 = nocomment(rd('common/custom_gui/DA_GN_Workshop.txt'))
for p in PRE:
    i = G.PATENTS.index(p) + 1
    m = re.search(r'name = DA_GN_slot_%d\s+tooltip = \S+\s+potential = \{([^\n]*)\}' % i, CG8)
    ok(m and 'has_country_flag = DA_GN_pv' in m.group(1) and 'NOT = { has_country_flag = DA_GN_pv }' not in m.group(1),
       'the Precursor patent %s is not in the Precursor view' % p['id'])
    ok('has_country_flag = DA_GN_pre.%s' % p['id'] in TRIG.get('DA_GN_can_proto_%s' % p['id'], ''),
       'the Precursor patent %s opens with a tile, not an assay' % p['id'])
for p in [q for q in G.PATENTS if not q.get('precursor')]:
    m = re.search(r'name = DA_GN_slot_%d\s+tooltip = \S+\s+potential = \{([^\n]*)\}' % (G.PATENTS.index(p) + 1), CG8)
    ok(m and 'NOT = { has_country_flag = DA_GN_pv }' in m.group(1), 'the patent %s shows in the Precursor view' % p['id'])
for name in ('DA_GN_pv_toggle', 'DA_GN_assay', 'DA_GN_survey', 'DA_GN_pv_info'):
    ok(re.search(r'name = %s\s' % name, CG8), 'the Precursor view lacks %s' % name)
ok('DA_GN_finish_assay = yes' in EFF.get('DA_GN_finish_job', ''), 'the end of a commission does not end an assay')
fa = EFF.get('DA_GN_finish_assay', '')
ok('random_list' in fa and 'DA_GN_pre.coils' in fa and 'DA_research_school_exp' in fa, 'Assay a Relic: its roll')
ok('DA_GN_samples' in EFF.get('DA_GN_start_assay', '') and 'DA_GN_samples' in TRIG.get('DA_GN_can_assay', ''),
   'Assay a Relic does not spend a relic sample')
ok('DA_GN_surveys' in TRIG and 'DA_RX_can_survey = yes' in TRIG.get('DA_GN_can_survey', ''), 'the Gommo Surveys')
ok(all('DA_GN_on.coils' not in l for l in EFF.get('DA_GN_over_capacity', '').splitlines() if 'DA_GN_switch_off_' in l)
   and 'DA_GN_switch_off_coils' not in EFF.get('DA_GN_over_capacity', ''), 'over capacity switches the Ley-Coils off')

print('passed: %d   failed: %d' % (PASS[0], len(FAIL)))
for f in FAIL:
    print('FAIL ' + f)
sys.exit(1 if FAIL else 0)
