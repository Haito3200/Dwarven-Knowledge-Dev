def option(eid, name):
    """(trigger, effects) of an option"""
    for op in pdx.get_all(EVENTS[eid], 'option'):
        if pdx.get(op.value, 'name').value == name:
            trig = pdx.get(op.value, 'trigger')
            return (trig.value if trig is not None else []), [x for x in op.value if x.key not in ('name', 'trigger', 'ai_chance')]
    raise KeyError(name)


def immediate(eid):
    return pdx.get(EVENTS[eid], 'immediate').value


def act(country, trigger, effects, root, frm=None):
    """an event option or a diplomatic action, run with its ROOT and FROM"""
    WORLD.root, WORLD.from_ = root, frm
    if country.t(trigger):
        country.e(effects)
        return True
    return False


