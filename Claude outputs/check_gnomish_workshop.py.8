# ---- 6. a life ------------------------------------------------------------------------------------------------------


class World:
    """Step 2 needs several countries: ROOT and FROM, alliances, subjects, neighbours, event targets."""

    def __init__(self):
        self.countries, self.root, self.from_ = [], None, None
        self.targets, self.allies, self.subjects, self.neighbours = {}, set(), {}, set()
        self.dice = 0            # random = { chance = N }: passes when dice < N

    def scope(self, word, cur):
        return {'ROOT': self.root, 'FROM': self.from_, 'THIS': cur}[word]


WORLD = World()


class Country:
    STUB_T = {'DA_RH_primary_gnomish': 'primary', 'DA_RH_is_gnomish': 'primary', 'DA_RH_active_gnomish': 'active',
              'DA_SCH_studying_any': 'studying', 'DA_RH_primary_goblin': 'goblin'}

    def __init__(self, tag='GNO'):
        self.tag = tag
        self.day = 0
        self.flags, self.mods, self.vars = {}, set(), {}
        self.treasury, self.inno = 5000.0, 10.0
        self.primary = self.active = True
        self.goblin = False
        self.studying = False
        self.estate = True
        self.privileges = set()
        self.completed = set()
        self.events, self.calls, self.unknown = [], [], []
        self.capital = set()          # the modifiers of its capital
        self.opinions = set()         # (tag, modifier): its opinion modifiers towards that country
        self.xp, self.advisors = {}, []
        self.choice = 2          # random_list: which branch (0-based)
        self.vars['MaxArtificePoints'] = 100
        self.vars['ArtificeUpkeep'] = 30
        self.flags['artificery_unlocked'] = 0
        self.flags['magic_artificery_mixed'] = 0
        self.update()
        WORLD.countries.append(self)
        if WORLD.root is None:
            WORLD.root = self

    def fl(self, name):
        """a flag name with @ROOT / @FROM replaced by the tag, as the game does"""
        name = name.replace('@ROOT', WORLD.root.tag)
        return name.replace('@FROM', WORLD.from_.tag) if WORLD.from_ else name

    def v(self, k):
        return self.vars.get(k, 0)

    def update(self):
        self.vars['RemainingArtificePoints'] = self.v('MaxArtificePoints') - self.v('ArtificeUpkeep')

    # ---- triggers
    def t(self, nodes):
        return all(self.t1(n) for n in nodes)

    def t1(self, n):
        k, v = n.key, n.value
        if k in ('OR',):
            return any(self.t1(x) for x in v)
        if k in ('AND', 'hidden_trigger'):
            return self.t(v)
        if k == 'NOT':
            return not any(self.t1(x) for x in v)
        if k == 'custom_trigger_tooltip':
            return self.t([x for x in v if x.key != 'tooltip'])
        if k in ('ROOT', 'FROM'):
            return WORLD.scope(k, self).t(v)
        if k.startswith('event_target:'):
            return WORLD.targets[k[len('event_target:'):]].t(v)
        if k == 'alliance_with':
            return frozenset((self.tag, WORLD.scope(v, self).tag)) in WORLD.allies
        if k == 'is_subject_of':
            return WORLD.subjects.get(self.tag) == WORLD.scope(v, self).tag
        if k == 'any_neighbor_country':
            return any(c.t(v) for c in WORLD.countries if frozenset((self.tag, c.tag)) in WORLD.neighbours)
        if k == 'has_opinion_modifier':
            return (WORLD.scope(pdx.get(v, 'who').value, self).tag, pdx.get(v, 'modifier').value) in self.opinions
        if k == 'has_country_flag':
            return self.fl(v) in self.flags
        if k == 'had_country_flag':
            f, days = self.fl(pdx.get(v, 'flag').value), int(pdx.get(v, 'days').value)
            return f in self.flags and self.day - self.flags[f] >= days
        if k == 'has_country_modifier':
            return v in self.mods
        if k == 'check_variable':
            w = [x.value for x in v if x.key == 'which']
            val = pdx.get(v, 'value')
            return self.v(w[0]) >= (float(val.value) if val is not None else self.v(w[1]))
        if k == 'is_variable_equal':
            return self.v(pdx.get(v, 'which').value) == float(pdx.get(v, 'value').value)
        if k == 'treasury':
            return self.treasury >= float(v)
        if k == 'innovativeness':
            return self.inno >= float(v)
        if k == 'has_estate':
            return self.estate
        if k == 'has_estate_privilege':
            return v in self.privileges
        if k == 'ai':
            return v == 'yes' and False or v == 'no'
        if k in self.STUB_T:
            return getattr(self, self.STUB_T[k]) == (v == 'yes')
        if k.startswith('DA_completed.'):
            return (k[13:] in self.completed) == (v == 'yes')
        if k in TRIG:
            body = TRIG[k]
            if not isinstance(v, str):
                for x in v:
                    body = body.replace('$%s$' % x.key, x.value)
                return self.t(pdx.parse(body)[0])
            return self.t(pdx.parse(body)[0]) == (v == 'yes')
        self.unknown.append(k)
        return False

    # ---- effects
    STUB_E = ('DA_enable_Metal_Infan', 'DA_initialize_metallurgy_variables', 'DA_remove_metallurgy_infcav_modifiers_effect',
              'DA_remove_Unique_Metallurgy_modifiers', 'DA_remove_Unique_Metallurgy_modifiers_flags')

    def e(self, nodes):
        for n in nodes:
            self.e1(n)

    def e1(self, n):
        k, v = n.key, n.value
        if k == 'if':
            lim = pdx.get(v, 'limit')
            if self.t(lim.value if lim is not None else []):
                self.e([x for x in v if x.key != 'limit'])
        elif k in ('hidden_effect',):
            self.e(v)
        elif k in ('custom_tooltip', 'every_owned_province', 'export_to_variable'):
            pass
        elif k == 'random_list':
            self.e(v[self.choice].value)
        elif k == 'random':
            if WORLD.dice < float(pdx.get(v, 'chance').value):
                self.e([x for x in v if x.key != 'chance'])
        elif k == 'set_country_flag':
            self.flags[self.fl(v)] = self.day
        elif k == 'clr_country_flag':
            self.flags.pop(self.fl(v), None)
        elif k in ('ROOT', 'FROM'):
            WORLD.scope(k, self).e(v)
        elif k.startswith('event_target:'):
            WORLD.targets[k[len('event_target:'):]].e(v)
        elif k == 'save_event_target_as':
            WORLD.targets[v] = self
        elif k in ('every_country', 'random_neighbor_country'):
            lim = pdx.get(v, 'limit')
            body = [x for x in v if x.key != 'limit']
            for c in list(WORLD.countries):
                if k == 'random_neighbor_country' and frozenset((self.tag, c.tag)) not in WORLD.neighbours:
                    continue
                if c.t(lim.value if lim is not None else []):
                    c.e(body)
                    if k.startswith('random'):
                        break
        elif k == 'capital_scope':
            for x in v:
                if x.key == 'add_province_modifier':
                    self.capital.add(pdx.get(x.value, 'name').value)
                elif x.key == 'remove_province_modifier':
                    self.capital.discard(x.value)
                elif x.key.startswith('DA_Tech_prov.'):
                    school = x.key.split('.', 1)[1]
                    self.xp[school] = self.xp.get(school, 0) + float(pdx.get(x.value, 'amount').value)
                else:
                    self.unknown.append('capital_scope: ' + x.key)
        elif k == 'add_opinion':
            self.opinions.add((WORLD.scope(pdx.get(v, 'who').value, self).tag, pdx.get(v, 'modifier').value))
        elif k == 'remove_opinion':
            self.opinions.discard((WORLD.scope(pdx.get(v, 'who').value, self).tag, pdx.get(v, 'modifier').value))
        elif k == 'define_advisor':
            self.advisors.append({x.key: x.value for x in v})
        elif k in ('set_variable', 'change_variable', 'subtract_variable', 'multiply_variable', 'divide_variable'):
            w = [x.value for x in v if x.key == 'which']
            val = pdx.get(v, 'value')
            num = float(val.value) if val is not None else self.v(w[1])
            cur = self.v(w[0])
            self.vars[w[0]] = {'set_variable': num, 'change_variable': cur + num, 'subtract_variable': cur - num,
                               'multiply_variable': cur * num, 'divide_variable': cur / num if num else cur}[k]
        elif k == 'add_country_modifier':
            self.mods.add(pdx.get(v, 'name').value)
        elif k == 'remove_country_modifier':
            self.mods.discard(v)
        elif k == 'add_treasury':
            self.treasury += float(v)
        elif k == 'change_innovativeness':
            self.inno += float(v)
        elif k == 'add_prestige':
            pass
        elif k == 'country_event':
            self.events.append(pdx.get(v, 'id').value)
        elif k == 'update_artifice_points':
            self.update()
        elif k in self.STUB_E:
            self.calls.append(k)
        elif k in EFF:
            body = EFF[k]
            if not isinstance(v, str):
                for x in v:
                    body = body.replace('$%s$' % x.key, x.value)
            self.e(pdx.parse(body)[0])
        else:
            self.unknown.append(k)

    def run(self, name):
        self.e(pdx.parse('%s = yes' % name)[0])

    def is_(self, name):
        return self.t(pdx.parse('%s = yes' % name)[0])

    def button(self, trig, eff):
        """a click: the effect runs only if the trigger holds"""
        if self.is_(trig):
            self.run(eff)
            return True
        return False

    def month(self, n=1):
        for _ in range(n):
            self.day += 30
            if 'DA_GN_bench_busy' in self.flags:
                self.run('DA_GN_bench_tick')
            while self.events:
                ev = self.events.pop(0)
                if ev == 'DA_GN_event.2':
                    self.e(pdx.parse('DA_GN_finish_job = yes')[0])


