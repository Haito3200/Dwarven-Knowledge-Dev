for script in ('build_gnomish_workshop.py', 'build_projects_research.py'):
    r = subprocess.run([sys.executable, os.path.join(TOOLS, script), ROOT, 'check'], capture_output=True, text=True)
    out = r.stdout + r.stderr
    ok(r.returncode == 0, '%s check failed: %s' % (script, out[-300:]))
    stale = [l for l in out.splitlines() if l.startswith(('changed', 'new ', 'would write'))]
    ok(not stale, '%s: files differ from what it writes now: %s' % (script, stale[:5]))

