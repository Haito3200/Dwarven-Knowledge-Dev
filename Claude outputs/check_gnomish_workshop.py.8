ok(not re.search(r'\belse(_if)?\s*=', EFF_TEXT), 'an else in DA_GN_effects.txt')


def defs(text):
    """name -> raw body of every top-level block"""
    out, i = {}, 0
    for m in re.finditer(r'^([A-Za-z_][\w.]*)\s*=\s*\{', text, re.M):
        if m.start() < i:
            continue
        d, j = 0, m.end() - 1
        while j < len(text):
            d += {'{': 1, '}': -1}.get(text[j], 0)
            if d == 0:
                break
            j += 1
        out[m.group(1)] = text[m.end():j]
        i = j
    return out


def load_defs(sub, roots):
    out = {}
    for root in roots:
        d = os.path.join(root, sub)
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if fn.endswith('.txt'):
                out.update(defs(nocomment(rd(os.path.join(sub, fn), root))))
    return out


