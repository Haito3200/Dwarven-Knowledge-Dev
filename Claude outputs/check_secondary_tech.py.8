#!/usr/bin/env python3
"""Offline checks of the rebuilt Secondary Technologies window (build_secondary_tech.py).

    python3 check_secondary_tech.py [<mod root> [<anbennar root>]]

Read-only. Checks that the files parse, that every custom GUI entry has its element and the reverse for the new
window, that every sprite, text, tooltip, customizable text, scripted trigger and effect the window uses exists, that
every variable it shows or tests is set somewhere, that every flag it tests is set somewhere, and that the hooks in the
events are where they should be. What only the game can show is listed in the project note.
"""
import os
import re
import sys
import glob
import collections

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
MOD = os.path.abspath(sys.argv[1]) if len(sys.argv) > 1 else os.path.abspath(os.path.join(HERE, '..', '..'))
ANB = os.path.abspath(sys.argv[2]) if len(sys.argv) > 2 else os.path.abspath(os.path.join(MOD, '..', 'anbennar-eu4-dev-new-master'))
sys.path.insert(0, HERE)
import pdx  # noqa: E402
import schools_layout as L  # noqa: E402

PASSED, FAILED, WARN = [0], [], []


def ok(cond, msg):
    if cond:
        PASSED[0] += 1
    else:
        FAILED.append(msg)
    return cond


def rd(root, rel):
    p = os.path.join(root, *rel.split('/'))
    data = open(p, 'rb').read()
    if data.startswith(b'\xef\xbb\xbf'):
        data = data[3:]
    return data.decode('utf-8' if rel.endswith('.yml') else 'latin-1')


def strip_comments(t):
    return re.sub(r'#[^\n]*', '', t)


def walk_files(root, sub, exts):
    out = []
    for dp, dn, fn in os.walk(os.path.join(root, sub)):
        for f in fn:
            if f.lower().endswith(exts):
                out.append(os.path.join(dp, f))
    return out


def text_of(path):
    data = open(path, 'rb').read()
    if data.startswith(b'\xef\xbb\xbf'):
        data = data[3:]
    return data.decode('latin-1')


ROOTS = [MOD] + ([ANB] if os.path.isdir(ANB) else [])
if len(ROOTS) == 1:
    WARN.append('Anbennar folder not found: names defined by Anbennar are reported as missing')

# ------------------------------------------------------------------ 1. the files parse
GENERATED = ['common/custom_gui/DA_SCH_interface.txt', 'common/scripted_triggers/DA_SCH_triggers.txt',
             'common/scripted_effects/DA_SCH_effects.txt', 'common/on_actions/DA_SCH_on_actions.txt',
             'customizable_localization/DA_SCH_custom_loc.txt', 'interface/DA_Schools.gfx']
PATCHED = ['interface/topbar.gui', 'common/custom_gui/DA_PR_tree.txt', 'common/scripted_effects/DA_interface_effects.txt',
           'common/scripted_triggers/DA_interface_triggers.txt', 'common/scripted_effects/DA_Alchemy_effects.txt',
           'common/scripted_effects/DA_Metallurgy_InfCav_effects.txt', 'events/DA_Tech_Tree_events.txt',
           'events/DA_Tech_Alchemy_Events.txt', 'events/DA_Tech_Medicine_Events.txt']
PATCHED += ['common/custom_gui/' + f for f in ['DA_Metallurgy_interface_main.txt', 'DA_Metallurgy_interface_alloy.txt',
                                               'DA_Tech_Interface_Alchemy.txt', 'DA_Tech_Interface_Arcane_Arts.txt',
                                               'DA_Tech_Interface_Mechanics.txt', 'DA_Tech_Interface_Medicine.txt',
                                               'DA_Tech_Interface_Medicine_illnesses.txt']]
PATCHED += ['events/' + os.path.basename(p) for p in sorted(glob.glob(os.path.join(MOD, 'events', 'DA_Metallurgy_events_*.txt')))]
for rel in GENERATED + PATCHED:
    if not ok(os.path.exists(os.path.join(MOD, rel)), 'missing file ' + rel):
        continue
    _, probs = pdx.parse(rd(MOD, rel))
    ok(not probs, '%s does not parse: %s' % (rel, probs[:3]))
loc_bytes = open(os.path.join(MOD, 'localisation', 'DA_SCH_l_english.yml'), 'rb').read()
ok(loc_bytes.startswith(b'\xef\xbb\xbf'), 'DA_SCH_l_english.yml has no BOM')

# ------------------------------------------------------------------ 2. indexes of the mod and Anbennar
LOC = {}
LOC_DUP = collections.Counter()
for root in ROOTS:
    for p in walk_files(root, 'localisation', ('_l_english.yml',)):
        for line in open(p, encoding='utf-8-sig', errors='replace'):
            m = re.match(r'\s*([^\s:#]+):\d*\s*"(.*)"\s*$', line)
            if m:
                if root == MOD:
                    LOC_DUP[m.group(1)] += 1
                LOC[m.group(1)] = m.group(2)
DEFINED_TEXT = {}
for root in ROOTS:
    for p in walk_files(root, 'customizable_localization', ('.txt',)):
        nodes, _ = pdx.parse(text_of(p))
        for nd in nodes:
            if nd.key == 'defined_text' and nd.is_block():
                n = pdx.get(nd.value, 'name')
                if n:
                    DEFINED_TEXT[n.value] = nd
SPRITES = {}
for root in ROOTS:
    for p in glob.glob(os.path.join(root, 'interface', '*.gfx')):
        for m in re.finditer(r'\bname\s*=\s*"?([\w.]+)"?', strip_comments(text_of(p))):
            SPRITES.setdefault(m.group(1), p)
TRIGGERS, EFFECTS = set(), set()
for root in ROOTS:
    for kind, bag in (('scripted_triggers', TRIGGERS), ('scripted_effects', EFFECTS)):
        for p in walk_files(root, 'common/' + kind, ('.txt',)):
            for m in re.finditer(r'^([\w.\-]+)\s*=\s*\{', strip_comments(text_of(p)), re.M):
                bag.add(m.group(1))
SCRIPT_TEXT = []
for root in ROOTS:
    for sub in ('common', 'events', 'decisions', 'missions', 'history/countries'):
        for p in walk_files(root, sub, ('.txt',)):
            SCRIPT_TEXT.append(strip_comments(text_of(p)))
ALL = '\n'.join(SCRIPT_TEXT)
VARS_SET = set(re.findall(r'\b(?:set_variable|change_variable|export_to_variable|subtract_variable|multiply_variable)\s*=\s*\{[^{}]*?'
                          r'\b(?:which|variable_name)\s*=\s*([\w.$]+)', ALL))
FLAGS_SET = set(re.findall(r'\bset_country_flag\s*=\s*([\w.$]+)', ALL))
MODIFIERS = set()
for root in ROOTS:
    for p in walk_files(root, 'common/event_modifiers', ('.txt',)) + walk_files(root, 'common/static_modifiers', ('.txt',)):
        for m in re.finditer(r'^([\w.\-]+)\s*=\s*\{', strip_comments(text_of(p)), re.M):
            MODIFIERS.add(m.group(1))


def var_known(v):
    if v in VARS_SET:
        return True
    return any('$' in s and re.fullmatch(re.sub(r'\\\$\w+\\\$', r'\\w+', re.escape(s)), v) for s in VARS_SET)


def flag_known(f):
    if f in FLAGS_SET:
        return True
    return any('$' in s and re.fullmatch(re.sub(r'\\\$\w+\\\$', r'[\\w.]+', re.escape(s)), f) for s in FLAGS_SET)


# ------------------------------------------------------------------ 3. the window
gui_text = rd(MOD, 'interface/topbar.gui')
root_nodes, _ = pdx.parse(gui_text)
win = None
for nd, d, par in pdx.walk(root_nodes):
    if nd.key == 'windowType' and nd.is_block() and (pdx.get(nd.value, 'name') or nd).value == 'DA_main_tech_interface':
        win = nd
        break
ok(win is not None, 'DA_main_tech_interface not in topbar.gui')
ok(gui_text.count('name = "DA_main_tech_interface"') == 1, 'DA_main_tech_interface is defined more than once')
ELEMENTS = collections.defaultdict(list)     # name -> [(kind, block)]
KIND_OF = {'custom_button': 'guiButtonType', 'custom_icon': 'iconType', 'custom_text_box': 'instantTextBoxType',
           'custom_window': 'windowType'}
GUI_ALL = collections.defaultdict(set)       # every element of every .gui file: name -> kinds
for root in ROOTS:
    for p in glob.glob(os.path.join(root, 'interface', '*.gui')):
        if root == ANB and os.path.basename(p) == 'topbar.gui':
            continue
        for m in re.finditer(r'(\w+Type)\s*=\s*\{\s*(?:#[^\n]*\n\s*)*name\s*=\s*"?([\w.]+)"?', text_of(p)):
            GUI_ALL[m.group(2)].add(m.group(1))


def props(block):
    return {c.key.lower(): c.value for c in block if c.key}


if win:
    for nd, d, par in pdx.walk(win.value):
        if nd.is_block() and nd.key in ('windowType', 'guiButtonType', 'iconType', 'instantTextBoxType'):
            n = pdx.get(nd.value, 'name')
            ELEMENTS[n.value if n else '?'].append((nd.key, nd.value))
    bg = (pdx.get(win.value, 'background') or win).value
    ok(isinstance(bg, str) and [k for k, b in ELEMENTS.get(bg, [])] == ['guiButtonType']
       and props(ELEMENTS[bg][0][1]).get('alwaystransparent') != 'yes',
       'the window needs a button as its background (dragging, and no clicks through to the map)')
    ok((pdx.get(win.value, 'moveable') or win).value == '1', 'the window is not moveable')
    dup = [n for n, v in ELEMENTS.items() if len(v) > 1]
    ok(not dup, 'element names used twice in the window: %s' % dup[:10])
    for name, items in ELEMENTS.items():
        for kind, b in items:
            pr = props(b)
            pos = pr.get('position')
            if isinstance(pos, list):
                xy = {c.key: c.value for c in pos if c.key}
                x, y = int(float(xy.get('x', 0))), int(float(xy.get('y', 0)))
                if name not in ('DA_close_main_tech_interface',) and kind != 'windowType':
                    ok(0 <= x <= L.W and 0 <= y <= L.H, '%s is placed outside the window (%d, %d)' % (name, x, y))
            spr = pr.get('spritetype') or pr.get('quadtexturesprite')
            if spr:
                ok(spr in SPRITES, '%s: sprite %s is not defined in any .gfx' % (name, spr))
            for k in ('text', 'buttontext'):
                t = pr.get(k)
                if t:
                    ok(t in LOC, '%s: text %s has no localisation' % (name, t))
            if kind == 'instantTextBoxType' and pr.get('scripted') == 'yes' and not pr.get('text'):
                ok(name in LOC, '%s: scripted text box without text, and no localisation named after it' % name)

# ------------------------------------------------------------------ 4. custom GUI entries
ENTRIES = collections.defaultdict(list)      # name -> [(file, kind, node)]
for p in walk_files(MOD, 'common/custom_gui', ('.txt',)) + walk_files(ANB, 'common/custom_gui', ('.txt',)):
    nodes, _ = pdx.parse(text_of(p))
    for nd in nodes:
        if nd.is_block() and nd.key in KIND_OF:
            n = pdx.get(nd.value, 'name')
            if n:
                ENTRIES[n.value].append((os.path.relpath(p, MOD), nd.key, nd))
dups = {n: [f for f, *_ in v] for n, v in ENTRIES.items()
        if len(v) > 1 and (n in ELEMENTS or n.startswith('DA_SCH')) and len({k for f, k, nd in v if not f.startswith('..')}) < len([1 for f, *_ in v if not f.startswith('..')])}
ok(not dups, 'custom GUI entries defined twice: %s' % list(dups.items())[:8])
new_entries = [n for n, v in ENTRIES.items() if any(f.endswith('DA_SCH_interface.txt') for f, *_ in v)]
for n in new_entries:
    kind = ENTRIES[n][0][1]
    found = [k for k, b in ELEMENTS.get(n, [])] or list(GUI_ALL.get(n, []))
    if not found and n.startswith('DA_SCH_pr_'):
        found = ['guiButtonType' if '_bar' in n or '_goto' in n else 'instantTextBoxType']
    ok(KIND_OF[kind] in found, 'custom GUI %s %s has no %s in the window (found %s)' % (kind, n, KIND_OF[kind], found))
    for k, b in ELEMENTS.get(n, []):
        # an element without "scripted = yes" ignores its entry: its potential, frames and effect do nothing
        ok(props(b).get('scripted') == 'yes', 'custom GUI entry %s points to an element that is not scripted' % n)
for name, items in ELEMENTS.items():
    for kind, b in items:
        if props(b).get('scripted') == 'yes' and name.startswith('DA_SCH') and kind in ('guiButtonType',):
            pr = props(b)
            # a scripted button without an entry does nothing; tabs and the like must have one
            ok(name in ENTRIES, 'scripted button %s has no custom GUI entry' % name)
OLD_FILES = ['DA_Metallurgy_interface_main.txt', 'DA_Metallurgy_interface_alloy.txt', 'DA_Tech_Interface_Alchemy.txt',
             'DA_Tech_Interface_Arcane_Arts.txt', 'DA_Tech_Interface_Mechanics.txt', 'DA_Tech_Interface_Medicine.txt',
             'DA_Tech_Interface_Medicine_illnesses.txt']
dead = []
for n, v in ENTRIES.items():
    for f, kind, nd in v:
        if os.path.basename(f) in OLD_FILES and n not in ELEMENTS and n not in GUI_ALL:
            dead.append(n)
ok(not dead, 'entries of the old files with no element left: %s' % dead[:10])

# tooltips, effects and triggers of the entries the window uses
used_entries = [n for n in ELEMENTS if n in ENTRIES]
TOOLTIPS = set()
CALLS = set()
for n in used_entries:
    for f, kind, nd in ENTRIES[n]:
        tt = pdx.get(nd.value, 'tooltip')
        if tt:
            TOOLTIPS.add((n, tt.value))
for n, t in TOOLTIPS:
    ok(t in LOC or t in DEFINED_TEXT, '%s: tooltip %s has no localisation' % (n, t))

# ------------------------------------------------------------------ 5. scripted triggers and effects called
BUILTIN_YES = {'always', 'ai', 'is_at_war', 'hidden_effect', 'hidden_trigger'}
gen_text = '\n'.join(strip_comments(rd(MOD, r)) for r in GENERATED if r.endswith('.txt'))
calls = set(re.findall(r'\b([A-Z][\w.]+)\s*=\s*(?:yes|no)\b', gen_text))
calls |= set(re.findall(r'\b(DA_[\w.]+)\s*=\s*\{', gen_text))
defined_here = set(re.findall(r'^([\w.]+)\s*=\s*\{', gen_text, re.M))
for c in sorted(calls):
    if c in defined_here or c.startswith('DA_SCH_cl_'):
        continue
    if c in ('DA_Alchemy_material',) or c.startswith(('DA_Disease.', 'DA_mechanics_upgrade.')):
        continue
    ok(c in TRIGGERS or c in EFFECTS or c in MODIFIERS or c in DEFINED_TEXT,
       'called but not defined as a scripted trigger or effect: %s' % c)
# every DA_SCH_* call anywhere in the mod is defined
mod_text = '\n'.join(strip_comments(text_of(p)) for sub in ('common', 'events') for p in walk_files(MOD, sub, ('.txt',)))
for c in sorted(set(re.findall(r'\b(DA_SCH_\w+)\s*=\s*(?:yes|\{)', mod_text))):
    if c.startswith(('DA_SCH_cl_',)):
        continue
    ok(c in TRIGGERS or c in EFFECTS or c in ENTRIES or c in ELEMENTS, 'DA_SCH call without definition: %s' % c)

# ------------------------------------------------------------------ 6. localisation, customizable texts, variables, flags
sch_loc = {}
for line in open(os.path.join(MOD, 'localisation', 'DA_SCH_l_english.yml'), encoding='utf-8-sig'):
    m = re.match(r'\s+([^\s:#]+):\d*\s*"(.*)"\s*$', line)
    if m:
        sch_loc[m.group(1)] = m.group(2)
dupl = [k for k in sch_loc if LOC_DUP[k] > 1]
ok(not dupl, 'keys of DA_SCH_l_english.yml also defined elsewhere: %s' % dupl[:10])
cl_text = rd(MOD, 'customizable_localization/DA_SCH_custom_loc.txt')
for k in re.findall(r'localisation_key\s*=\s*"?([^"\s]+)"?', cl_text):
    ok(k in LOC, 'customizable text points to a missing key: %s' % k)
refs = set()
for k, v in sch_loc.items():
    for r in re.findall(r'\[([^\]]+)\]', v):
        refs.add((k, r))
for k, r in sorted(refs):
    if r.startswith('Root.') and r.endswith('.GetValue'):
        var = r[5:-9]
        ok(var_known(var), '%s shows variable %s, which nothing sets' % (k, var))
    elif r.startswith('Root.'):
        dt = r[5:]
        ok(dt in DEFINED_TEXT or dt in ('GetName',), '%s uses [%s], which is not a customizable text' % (k, r))
    else:
        ok(r in DEFINED_TEXT, '%s uses [%s], which is not a customizable text' % (k, r))
tested = set(re.findall(r'\bwhich\s*=\s*(DA_[\w.$]+)', gen_text + '\n' + cl_text))
for v in sorted(tested):
    if '$' in v:
        continue
    ok(var_known(v), 'variable %s is used but nothing sets it' % v)
for f in sorted(set(re.findall(r'has_country_flag\s*=\s*([\w.$]+)', gen_text + '\n' + cl_text))):
    if '$' in f:
        continue
    ok(flag_known(f), 'flag %s is tested but nothing sets it' % f)
for m in sorted(set(re.findall(r'has_country_modifier\s*=\s*([\w.]+)', gen_text))):
    ok(m in MODIFIERS, 'modifier %s is not defined' % m)

# ------------------------------------------------------------------ 7. the hooks
tree = rd(MOD, 'events/DA_Tech_Tree_events.txt')
ok(len(re.findall(r'DA_SCH_next_chapter = \{ months = \d+ \} # DA_SCH chapter', tree)) >= 32, 'fewer chapter hooks than expected')
ok(tree.count('DA_SCH_study_done = yes') >= 20, 'fewer completion hooks than expected')
eff = rd(MOD, 'common/scripted_effects/DA_SCH_effects.txt')
ok(len(re.findall(r'DA_SCH_study_begin = \{ school = \d chapters = \d months = \d+ \}', eff)) == 20,
   'DA_SCH_start_study_* should hold 20 study starts')
alc = rd(MOD, 'events/DA_Tech_Alchemy_Events.txt')
ok(alc.count('DA_SCH_ingredient = { n =') >= 70, 'material options without the ingredient hook')
ok(alc.count('# DA_SCH potion') == 6, 'potion phase hooks: expected 6, found %d' % alc.count('# DA_SCH potion'))
med = rd(MOD, 'events/DA_Tech_Medicine_Events.txt')
ok(med.count('clr_country_flag = DA_SCH_cure_research.') == 18, 'cure research flags: expected 18 clears')
gui_custom = '\n'.join(rd(MOD, 'common/custom_gui/' + f) for f in OLD_FILES)
ok(gui_custom.count('set_country_flag = DA_SCH_cure_research.') == 18, 'cure buttons: expected 18 research flags')
ok('DA_SCH always the Overview' in gui_custom, 'the top-bar button does not open the Overview')
ok(gui_custom.count('# DA_SCH frame') == 12, 'mechanics category buttons without their two frames')
ok('DA_SCH_pick_clear = { unit = $DA_unit$ }' in rd(MOD, 'common/scripted_effects/DA_Metallurgy_InfCav_effects.txt'),
   'DA_initialize_metallurgy_variables does not forget the picked parts')
ok('eight to twelve months' not in rd(MOD, 'localisation/DA_Government_l_english.yml'), 'the opening event still says eight to twelve months')
picks = 0
for p in glob.glob(os.path.join(MOD, 'events', 'DA_Metallurgy_events_*.txt')):
    picks += len(re.findall(r'DA_SCH_pick(?:_rune)? = \{', text_of(p)))
PICKS = 1097 + 85 + 2 + 6 + 43   # + 85 obsidian options: 4 paths, 33 blueprints, 48 runes (build_obsidian_tech.py, 17 November 2026)
#                        + 43 elven options: 4 paths, 15 blueprints, 24 sigils (build_elven_arsenal.py, doc 72)
#                        + 2 Gommo Calibration, artillery and artificers (build_gnomish_workshop.py, doc 53)
#                        (the 15 goblin options of doc 56 went with the goblin remake, doc 65)
#                        + 6 kobold options: Draconic Grafts and Wyrmframe, infantry, cavalry, artificers (DA_KB, doc 61)
ok(picks == PICKS, 'designer options with a pick hook: %d, expected %d' % (picks, PICKS))
ok('DA_SCH_due_' in rd(MOD, 'common/scripted_triggers/DA_Attention_Markers_triggers.txt'),
   'the attention markers still read the old level-up markers (run build_attention_markers.py)')

# ------------------------------------------------------------------ 8. layout: text boxes inside their boxes
for name, items in ELEMENTS.items():
    for kind, b in items:
        pr = props(b)
        if kind == 'instantTextBoxType' and pr.get('maxwidth'):
            pos = {c.key: c.value for c in pr.get('position') if c.key}
            x = int(float(pos.get('x', 0)))
            ok(x + int(pr['maxwidth']) <= L.W - 40, '%s runs past the right edge of the body (x %d + %s)' % (name, x, pr['maxwidth']))

print('passed: %d   failed: %d' % (PASSED[0], len(FAILED)))
for f in FAILED:
    print('FAIL ' + f)
for w in WARN:
    print('warn ' + w)
sys.exit(1 if FAILED else 0)
