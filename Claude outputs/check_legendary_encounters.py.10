#!/usr/bin/env python3
"""Offline check of the Legendary Encounter window. It does not run EU4.

    python3 "Claude files/tools/check_legendary_encounters.py" . ../anbennar-eu4-dev-new-master

Part 1 runs the generated scripted effects in a small interpreter (fixed-point variables with three decimals,
flags, scopes, scripted effects with parameters) and plays hundreds of random fights next to the Python
reference in le_rules.py: every round the two must agree on vitality, ward, resolve and outcome.
Part 2 checks that every name resolves: window elements and their custom_gui logic, sprites and textures,
localisation keys, defined texts, scripted triggers and effects, events; that the old duel is gone; that dice are
only rolled inside events; that the generated files are what the builder writes now. Exit code 1 on any failure.
"""
import os
import random
import re
import struct
import sys

MOD, ANB = sys.argv[1], sys.argv[2]
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import build_legendary_encounters as B  # noqa: E402
import le_rules as R  # noqa: E402
import pdx  # noqa: E402

FAIL = []
PASSES = 0


def check(cond, msg):
    global PASSES
    if cond:
        PASSES += 1
    elif len(FAIL) < 60:
        FAIL.append(msg)


def read(p):
    return open(p, encoding='utf-8-sig' if p.endswith('.yml') else 'latin-1', errors='replace').read().replace('\r\n', '\n')


def strip_comments(t):
    return re.sub(r'#[^\n]*', '', t)


def files(root, sub, ext):
    out = []
    for dp, dn, fn in os.walk(os.path.join(root, sub)):
        for f in fn:
            if f.lower().endswith(ext):
                out.append(os.path.join(dp, f))
    return out


# =============================================================================================
# Part 1. The interpreter
# =============================================================================================
SCOPE_WORDS = {'owner', 'PREV', 'ROOT', 'FROM'}
FX = 1000


def fx(s):
    """Text -> fixed point."""
    neg = s.startswith('-')
    whole, _, frac = s.lstrip('-').partition('.')
    v = int(whole or 0) * FX + int((frac + '000')[:3])
    return -v if neg else v


def trunc_div(a, b):
    q = abs(a) // abs(b)
    return q if (a >= 0) == (b >= 0) else -q


class Scope:
    def __init__(self, kind):
        self.kind = kind
        self.vars = {}
        self.flags = set()
        self.mods = set()
        self.id = 0                  # DA_EL: the province's id (province_id)


class World:
    def __init__(self):
        self.prov = Scope('province')
        self.country = Scope('country')
        self.ruler_flags = set()
        self.personality = set()
        self.skill = {'adm': 0, 'dip': 0, 'mil': 0}
        self.tech = 0
        self.estate = False
        self.units = {'infantry': 0, 'cavalry': 0, 'artillery': 0}
        self.export = {}
        self.flag_days = {}          # province flag -> days since it was set
        self.events = []
        self.killed = {'infantry': 0, 'cavalry': 0, 'artillery': 0}
        self.added_mods = []
        self.rng = random.Random(0)


class Runner:
    def __init__(self, effects_text, triggers_text):
        self.effects = {n.key: n.value for n in pdx.parse(strip_comments(effects_text))[0] if n.is_block()}
        self.triggers = {n.key: n.value for n in pdx.parse(strip_comments(triggers_text))[0] if n.is_block()}
        self.unknown = set()

    # ---- parameters
    def subst(self, nodes, params):
        if not params:
            return nodes
        def s(x):
            if isinstance(x, str):
                for k, v in params.items():
                    x = x.replace('$' + k + '$', v)
            return x
        out = []
        for n in nodes:
            v = self.subst(n.value, params) if n.is_block() else s(n.value)
            out.append(pdx.Node(s(n.key), n.op, v, n.line))
        return out

    def scope_of(self, w, word, stack):
        if word == 'owner':
            return w.country
        if word == 'PREV':
            return stack[-2]
        if word == 'ROOT':
            return stack[0]
        raise KeyError(word)

    # ---- triggers
    def var_args(self, w, node, stack):
        cur = stack[-1]
        whiches = [n.value for n in node.value if n.key == 'which']
        value = [n.value for n in node.value if n.key == 'value']
        a = cur.vars.get(whiches[0], 0)
        b = fx(value[0]) if value else cur.vars.get(whiches[1], 0)
        return a, b

    def test(self, w, nodes, stack):
        return all(self.test1(w, n, stack) for n in nodes)

    def test1(self, w, n, stack):
        k, v, cur = n.key, n.value, stack[-1]
        if k == 'NOT':
            return not any(self.test1(w, c, stack) for c in v)
        if k == 'OR':
            return any(self.test1(w, c, stack) for c in v)
        if k == 'AND':
            return self.test(w, v, stack)
        if k == 'always':
            return v == 'yes'
        if k == 'custom_trigger_tooltip':
            return self.test(w, [c for c in v if c.key != 'tooltip'], stack)
        if k in ('owner', 'PREV', 'ROOT'):
            return self.test(w, v, stack + [self.scope_of(w, k, stack)])
        if k == 'check_variable':
            a, b = self.var_args(w, n, stack)
            return a >= b
        if k == 'is_variable_equal':
            a, b = self.var_args(w, n, stack)
            return a == b
        if k == 'has_province_flag':
            return v in w.prov.flags
        if k == 'had_province_flag':
            d = {c.key: c.value for c in v}
            return d['flag'] in w.prov.flags and w.flag_days.get(d['flag'], 0) >= int(d['days'])
        if k == 'has_province_modifier':
            return v in w.prov.mods
        if k == 'has_country_flag':
            return v in w.country.flags
        if k == 'has_ruler_flag':
            return v in w.ruler_flags
        if k in ('has_country_modifier', 'has_ruler_modifier'):
            return v in w.country.mods
        if k == 'has_estate':
            return w.estate
        if k == 'ruler_has_personality':
            return v in w.personality
        if k == 'has_regency':
            return v == 'no'
        if k in ('adm', 'dip', 'mil'):
            return w.skill[k] >= int(v)
        if k == 'mil_tech':
            return w.tech >= int(v)
        if k in ('tag', 'any_country'):   # DA_EL: the Challúmaton's closures; the check's world has no other country
            return False
        if k == 'province_id':            # DA_EL
            return int(v) == w.prov.id
        if k == 'num_of_units_in_province':
            d = {c.key: c.value for c in v}
            have = w.units[d['type']] if 'type' in d else sum(w.units.values())
            return have >= int(d['amount'])
        if k in self.triggers:
            params = {c.key: c.value for c in v} if n.is_block() else {}
            return self.test(w, self.subst(self.triggers[k], params), stack)
        self.unknown.add('trigger ' + str(k))
        return False

    # ---- effects
    def run(self, w, nodes, stack):
        for n in nodes:
            self.run1(w, n, stack)

    def run1(self, w, n, stack):
        k, v, cur = n.key, n.value, stack[-1]
        if k in ('set_variable', 'change_variable', 'subtract_variable', 'multiply_variable', 'divide_variable'):
            whiches = [c.value for c in v if c.key == 'which']
            value = [c.value for c in v if c.key == 'value']
            name = whiches[0]
            if value:
                b = fx(value[0])
            elif whiches[1] in SCOPE_WORDS:
                b = self.scope_of(w, whiches[1], stack).vars.get(name, 0)
            else:
                b = cur.vars.get(whiches[1], 0)
            a = cur.vars.get(name, 0)
            if k == 'set_variable':
                a = b
            elif k == 'change_variable':
                a += b
            elif k == 'subtract_variable':
                a -= b
            elif k == 'multiply_variable':
                a = trunc_div(a * b, FX)
            else:
                assert b != 0, f'division by zero of {name} (line {n.line})'
                a = trunc_div(a * FX, b)
            assert abs(a) < 2_000_000 * FX, f'{name} overflows'
            cur.vars[name] = a
        elif k == 'if':
            lim = [c for c in v if c.key == 'limit']
            assert len(lim) == 1, f'if without one limit (line {n.line})'
            if self.test(w, lim[0].value, stack):
                self.run(w, [c for c in v if c.key != 'limit'], stack)
        elif k == 'while':
            lim = [c for c in v if c.key == 'limit'][0]
            body = [c for c in v if c.key != 'limit']
            for _ in range(1000):
                if not self.test(w, lim.value, stack):
                    break
                self.run(w, body, stack)
            else:
                raise AssertionError('while does not end')
        elif k == 'hidden_effect':
            self.run(w, v, stack)
        elif k in ('owner', 'PREV', 'ROOT'):
            self.run(w, v, stack + [self.scope_of(w, k, stack)])
        elif k == 'set_province_flag':
            w.prov.flags.add(v)
            w.flag_days[v] = 0
        elif k == 'clr_province_flag':
            w.prov.flags.discard(v)
        elif k == 'set_country_flag':
            w.country.flags.add(v)
        elif k == 'clr_country_flag':
            w.country.flags.discard(v)
        elif k == 'export_to_variable':
            d = {c.key: c.value for c in v}
            cur.vars[d['which']] = fx('%.3f' % w.export.get(d['value'], 0))
        elif k == 'random_list':
            pool = [(int(c.key), c.value) for c in v]
            pick = w.rng.choices(pool, weights=[p[0] for p in pool])[0]
            self.run(w, pick[1], stack)
        elif k == 'kill_units':
            d = {c.key: c.value for c in v}
            assert w.units[d['type']] >= int(d['amount']), 'kills a regiment that is not there'
            w.units[d['type']] -= int(d['amount'])
            w.killed[d['type']] += int(d['amount'])
        elif k == 'add_province_modifier':
            d = {c.key: c.value for c in v}
            w.prov.mods.add(d['name'])
            w.added_mods.append((d['name'], int(d['duration'])))
        elif k == 'remove_province_modifier':
            w.prov.mods.discard(v)
        elif k in ('province_event', 'country_event'):
            w.events.append([c.value for c in v if c.key == 'id'][0])
        elif k == 'change_mana':
            d = {c.key: c.value for c in v}
            cur.vars['currentMana'] = cur.vars.get('currentMana', 0) + fx(d['amount'])
        elif k == 'add_treasury':
            cur.vars['__treasury'] = cur.vars.get('__treasury', 0) + fx(v)
        elif k in self.effects:
            params = {c.key: c.value for c in v} if n.is_block() else {}
            self.run(w, self.subst(self.effects[k], params), stack)
        else:
            self.unknown.add('effect ' + str(k))

    def call(self, w, name, **params):
        self.run(w, self.subst(self.effects[name], params), [w.prov])


def pv(w, name):
    return w.prov.vars.get('DA_LE_' + name, 0) / FX


def make_world(rng, legend):
    w = World()
    w.rng = random.Random(rng.random())
    for line in legend.present.split('\n'):        # whatever says that the legend is there
        m = re.match(r'has_province_(flag|modifier) = (\S+)$', line.strip())
        v = re.match(r'check_variable = \{ which = (\S+) value = (\d+) \}$', line.strip())   # DA_EL: a ring unsealed
        pid = re.match(r'province_id = (\d+)$', line.strip())   # DA_EL: the legends of the ruins name their province
        if pid:
            w.prov.id = int(pid.group(1))
        elif m:
            (w.prov.flags if m.group(1) == 'flag' else w.prov.mods).add(m.group(2))
        elif v:
            w.prov.vars[v.group(1)] = fx(v.group(2))
        else:
            assert line.strip().startswith('NOT = {'), f'{legend.id}: the check cannot set up "{line}"'
    if legend.unlock_flag:
        w.country.flags.add(legend.unlock_flag)
    w.units = {'infantry': rng.choice([0, 3, 8, 14, 22, 35]), 'cavalry': rng.choice([0, 0, 2, 6, 12]), 'artillery': rng.choice([0, 0, 4, 9, 16, 24])}
    w.tech = rng.randint(5, 32)
    ab = lambda: rng.choice([0, 0, 0.05, 0.1, 0.2])
    w.export = {'modifier:discipline': ab(), 'modifier:infantry_power': ab(), 'modifier:cavalry_power': ab(),
                'modifier:artillery_power': ab(), 'modifier:land_morale': ab(),
                'trigger_value:num_of_musketeers': rng.choice([0, 0, 5, 40]), 'trigger_value:num_of_qizilbash': rng.choice([0, 0, 3, 20]),
                'trigger_value:num_of_streltsy': rng.choice([0, 0, 6, 30])}
    for code in ('INFAN', 'CAVAL', 'ARTIL'):
        w.country.vars['DA_power_TOTAL_' + code] = fx('%.2f' % rng.choice([0, 0, 0.25, 0.6, 1.0]))
    w.skill = {'adm': rng.randint(0, 6), 'dip': rng.randint(0, 6), 'mil': rng.randint(0, 6)}
    ruler, estate = {}, {}
    if rng.random() < 0.6:
        w.personality.add('mage_personality')
        for s in rng.sample(R.SCHOOLS, rng.randint(1, 5)):
            ruler[s] = rng.randint(1, 3)
            w.ruler_flags.add(f'{s}_{ruler[s]}')
    if rng.random() < 0.6:
        w.estate = True
        for s in rng.sample(R.SCHOOLS, rng.randint(0, 5)):
            estate[s] = rng.randint(1, 3)
            for k in range(1, estate[s] + 1):      # an estate may keep its lower flags; the script must cope
                if k == estate[s] or rng.random() < 0.5:
                    w.country.flags.add(f'{s}_{k}')
    w.country.vars['currentMana'] = rng.choice([0, 20, 60, 140, 400]) * FX
    weakness = rng.random() < 0.4
    if weakness:
        w.prov.flags.add('DA_LE_scouting')
        w.flag_days['DA_LE_scouting'] = 400
    elif rng.random() < 0.3:
        w.prov.flags.add('DA_LE_scouting')         # scouts still out: must not count
        w.flag_days['DA_LE_scouting'] = 20
    leads = bool(ruler) and rng.random() < 0.8
    if leads:
        w.prov.flags.add('DA_LE_ruler_leads')
    return w, ruler, estate, leads, weakness


def near(a, b, tol=0.005, absol=0.3):
    return abs(a - b) <= max(absol, tol * max(abs(a), abs(b)))


def play_one(run, seed):
    rng = random.Random(seed)
    legend = rng.choice(R.FIGHTS)
    w, ruler, estate, leads, weakness = make_world(rng, legend)
    if random.Random(seed * 31 + 7).random() < 0.35:   # DA_GN: the owner has a bonus such as Dragonbreaker Harpoons
        for b in R.ARMY_BONUS:
            w.country.flags.add(b['flag'])
    tag = f'fight {seed} ({legend.id})'
    ex = w.export
    wf = (ex['trigger_value:num_of_musketeers'], ex['trigger_value:num_of_qizilbash'], ex['trigger_value:num_of_streltsy'])
    wfp = tuple(w.country.vars['DA_power_TOTAL_' + c] / FX for c in ('INFAN', 'CAVAL', 'ARTIL'))

    def strength():
        return R.army_strength(w.units['infantry'], w.units['cavalry'], w.units['artillery'], w.tech, ex['modifier:discipline'],
                               ex['modifier:infantry_power'], ex['modifier:cavalry_power'], ex['modifier:artillery_power'], wf, wfp,
                               R.army_mult(legend.id, w.country.flags))   # DA_GN

    hp0 = None
    if rng.random() < 0.3:      # a legend already wounded in an earlier fight
        hp0 = legend.hp * rng.uniform(0.3, 0.9)
        w.prov.vars['DA_LE_hp'] = int(hp0 * FX)
        w.prov.flags.add('DA_LE_hp_init')
    if rng.random() < 0.3 and legend.contain_cost:
        w.prov.mods.add('DA_LE_contained_' + legend.id)
    check(run.test(w, run.triggers['DA_LE_is_' + legend.id], [w.prov]), f'{tag}: the legend is not present')
    run.call(w, 'DA_LE_engage')
    check('DA_LE_engaged' in w.prov.flags and w.events == [B.NS + '.1'], f'{tag}: engaging does not start the fight')
    check(not any(m.startswith('DA_LE_contained') for m in w.prov.mods), f'{tag}: engaging leaves the containment in place')
    w.events.clear()
    run.call(w, 'DA_LE_roll_move')          # what event .1 does
    sm, sa, n = strength()
    st = R.State(legend, sm, sa, R.resolve_max(n, ex['modifier:land_morale'], leads, w.skill['adm'], sum(ruler.values())), weakness, hp0)
    check(near(pv(w, 's_melee'), sm) and near(pv(w, 's_art'), sa), f'{tag}: strength {pv(w, "s_melee")}+{pv(w, "s_art")} vs {sm}+{sa}')
    check(near(pv(w, 'resolve_max'), st.resolve_max) and near(pv(w, 'resolve'), st.resolve_max), f'{tag}: resolve {pv(w, "resolve_max")} vs {st.resolve_max}')
    check(near(pv(w, 'hp'), st.hp) and near(pv(w, 'ward'), st.ward), f'{tag}: starting vitality or ward')
    mana = w.country.vars['currentMana'] / FX
    last_move = None
    for _ in range(R.MAX_ROUNDS + 2):
        moves = [i for i in range(1, 5) if f'DA_LE_move_{i}' in w.prov.flags]
        check(len(moves) == 1, f'{tag}: {len(moves)} moves announced')
        if len(moves) != 1:
            return
        check(moves[0] != last_move, f'{tag}: the same move twice in a row')
        last_move = moves[0]
        st.move = legend.moves[moves[0] - 1]
        order = rng.choice(R.ORDER_IDS)
        school = rng.choice(R.SCHOOLS + [None, None])
        dice = [rng.randint(1, 20) for _ in range(3)]
        if rng.random() < 0.1:          # regiments leave or arrive between rounds
            w.units['infantry'] = max(0, w.units['infantry'] + rng.choice([-3, 4]))
            st.s_melee, st.s_art, n = strength()
        spell = None
        if school and school != st.cooldown:
            c = R.caster(school, leads, ruler, estate, mana, w.skill['mil'], w.estate)
            if c:
                spell = (school, c[1], c[2])
                mana -= c[3]
        if school:
            w.prov.flags.add('DA_LE_sel_' + school)
        w.prov.flags.add('DA_LE_order_' + order)
        for name, d in zip('abc', dice):
            w.prov.vars['DA_LE_die_' + name] = d * FX
        units_before = dict(w.units)
        resolve_before, round_before = st.resolve, st.round
        run.call(w, 'DA_LE_resolve_round')
        rep = R.resolve_round(st, order, spell, *dice)
        where = f'{tag} round {round_before} ({st.move.id}, {order}, {spell})'
        check(near(w.country.vars['currentMana'] / FX, mana, 0, 0.01), f'{where}: mana {w.country.vars["currentMana"] / FX} vs {mana}')
        if st.result:
            lost = R.regiments_lost(n, st.resolve, st.resolve_max, st.result)
            killed = sum(w.killed.values())
            check(abs(killed - min(lost, sum(units_before.values()))) <= 1, f'{where}: {killed} regiments destroyed, expected {lost}')
            check('DA_LE_engaged' not in w.prov.flags, f'{where}: the fight does not end ({st.result})')
            idx = R.FIGHTS.index(legend) + 1   # DA_EL: the builder numbers the fights (a legend that only talks has none)
            want = {'victory': legend.victory_event, 'defeat': f'{B.NS}.{idx * 100 + 2}', 'withdraw': f'{B.NS}.{idx * 100 + 3}'}[st.result]
            check(w.events == [want], f'{where}: events {w.events}, expected {want}')
            gone = st.result == 'victory' or legend.flees
            if gone:
                check(not {'DA_LE_hp_init', 'DA_LE_scouting', 'DA_LE_open', 'DA_LE_fled'} & w.prov.flags, f'{where}: a legend that is gone keeps its state')
                if legend.end_flag:
                    check(legend.end_flag in w.prov.flags and not run.test(w, run.triggers['DA_LE_is_' + legend.id], [w.prov]),
                          f'{where}: the legend is still there')
                check(not any(m == 'DA_LE_regroup' for m, _ in w.added_mods), f'{where}: regrouping although the legend is gone')
                check(('DA_LE_ruler_led' in w.country.flags) == (st.result == 'defeat' and leads), f'{where}: ruler wound flag')
            else:
                keep = st.hp + (legend.hp - st.hp) * (1 - R.KEEP_WOUNDS)
                check(near(pv(w, 'hp'), keep), f'{where}: wounds kept {pv(w, "hp")} vs {keep}')
                check(('DA_LE_regroup', R.REGROUP_DAYS[st.result]) in w.added_mods, f'{where}: no regrouping period')
                check(('DA_LE_ruler_led' in w.country.flags) == (st.result == 'defeat' and leads), f'{where}: ruler wound flag')
            leftovers = [f for f in w.prov.flags if re.match(r'DA_LE_(move|sel|cd|order|cast|next|rep)_', f)]
            check(not leftovers, f'{where}: flags left behind {leftovers}')
            return
        ok = (near(pv(w, 'hp'), st.hp) and near(pv(w, 'ward'), st.ward) and near(pv(w, 'resolve'), st.resolve)
              and near(pv(w, 'rot'), st.rot) and near(pv(w, 'sunder'), st.sunder, 0.01, 0.002) and pv(w, 'round') == st.round)
        check(ok, f'{where}: script hp {pv(w, "hp"):.1f} ward {pv(w, "ward"):.1f} resolve {pv(w, "resolve"):.1f} rot {pv(w, "rot"):.1f} '
                  f'round {pv(w, "round"):.0f} | reference hp {st.hp:.1f} ward {st.ward:.1f} resolve {st.resolve:.1f} rot {st.rot:.1f} round {st.round}')
        if not ok:
            return
        # rounding in three decimals must not pile up over a long fight: carry on from the script's own numbers
        st.hp, st.ward, st.resolve, st.rot, st.sunder = pv(w, 'hp'), pv(w, 'ward'), pv(w, 'resolve'), pv(w, 'rot'), pv(w, 'sunder')
        check(('DA_LE_rep_revived' in w.prov.flags) == bool(rep.get('revived')) and ('DA_LE_rep_missed' in w.prov.flags) == bool(rep.get('missed'))
              and ('DA_LE_rep_ambush' in w.prov.flags) == bool(rep.get('ambush')), f'{where}: report flags')
        cds = [f[len('DA_LE_cd_'):] for f in w.prov.flags if f.startswith('DA_LE_cd_')]
        check(cds == ([st.cooldown] if st.cooldown else []), f'{where}: cooldown {cds} vs {st.cooldown}')
    check(False, f'{tag}: the fight never ends')


def part1():
    mod_text = lambda rel: read(os.path.join(MOD, rel))
    run = Runner(mod_text('common/scripted_effects/DA_Legendary_Encounter_effects.txt'),
                 mod_text('common/scripted_triggers/DA_Legendary_Encounter_triggers.txt'))
    for seed in range(600):
        try:
            play_one(run, seed)
        except AssertionError as e:
            check(False, f'fight {seed}: {e}')
    check(not run.unknown, f'the interpreter met script it does not know: {sorted(run.unknown)}')
    # the moves come out in their weights, and all of them come out
    for legend in R.FIGHTS:
        w = make_world(random.Random(1), legend)[0]
        seen = {}
        for _ in range(4000):
            run.call(w, 'DA_LE_roll_move')
            m = [i for i in range(1, 5) if f'DA_LE_move_{i}' in w.prov.flags]
            seen[m[0]] = seen.get(m[0], 0) + 1
        check(len(seen) == len(legend.moves) and min(seen.values()) > 400, f'{legend.id}: move frequencies {seen}')
    # scouting and containing take the money they say
    for legend in R.FIGHTS:
        w = make_world(random.Random(2), legend)[0]
        w.prov.flags.discard('DA_LE_scouting')
        run.call(w, 'DA_LE_scout')
        check(w.country.vars.get('__treasury') == -R.SCOUT_COST * FX and 'DA_LE_scouting' in w.prov.flags, f'{legend.id}: scouting')
        w.country.vars['__treasury'] = 0
        if not legend.contain_cost:
            run.call(w, 'DA_LE_contain')
            check(w.country.vars['__treasury'] == 0 and not any(m.startswith('DA_LE_contained') for m, _ in w.added_mods),
                  f'{legend.id}: it cannot be contained, yet containing does something')
            check(not run.test(w, run.triggers['DA_LE_can_be_contained'], [w.prov]), f'{legend.id}: the contain button is not refused')
            continue
        check(run.test(w, run.triggers['DA_LE_can_be_contained'], [w.prov]), f'{legend.id}: the contain button is refused')
        paid = []
        for _ in range(len(legend.contain_cost) + 2):
            before = w.country.vars['__treasury']
            run.call(w, 'DA_LE_contain')
            paid.append((before - w.country.vars['__treasury']) // FX)
        want = list(legend.contain_cost) + [legend.contain_cost[-1]] * 2
        check(paid == want and ('DA_LE_contained_' + legend.id, R.CONTAIN_YEARS * 365) in w.added_mods, f'{legend.id}: containment costs {paid}, expected {want}')


# =============================================================================================
# Part 2. Names and files
# =============================================================================================
def dds_size(p):
    raw = open(p, 'rb').read(32)
    h, w = struct.unpack_from('<II', raw, 12)
    return w, h


def part2():
    gen = B.build_all()
    for rel, text in gen.items():
        p = os.path.join(MOD, rel)
        check(os.path.exists(p), f'missing file {rel}')
        if not os.path.exists(p):
            continue
        check(read(p) == text, f'{rel} is not what the builder writes now: re-run the builder')
        if not rel.endswith('.yml'):
            raw = open(p, 'rb').read()
            check(all(b < 128 for b in raw), f'{rel} is not plain ASCII')
            t = strip_comments(text)
            check(t.count('{') == t.count('}'), f'{rel}: unbalanced braces')
            check(not pdx.parse(t)[1], f'{rel}: does not parse')

    effects = gen['common/scripted_effects/DA_Legendary_Encounter_effects.txt']
    triggers = gen['common/scripted_triggers/DA_Legendary_Encounter_triggers.txt']
    cgui = gen['common/custom_gui/DA_Legendary_Encounter_interface.txt']
    cloc = gen['customizable_localization/DA_Legendary_Encounter_custom_loc.txt']
    events = gen['events/DA_Legendary_Encounter_events.txt']
    gfx = gen['interface/DA_Legendary_Encounter.gfx']
    onact = gen['common/on_actions/DA_Legendary_Encounter_on_actions.txt']
    mods = gen['common/event_modifiers/DA_Legendary_Encounter_modifiers.txt']
    loc_text = gen['localisation/DA_Legendary_Encounter_l_english.yml']
    loc = dict(re.findall(r'^ ([^\s:]+):\d* "(.*)"$', loc_text, re.M))

    # no else in the effects; dice only where an event calls them
    check(not re.search(r'\belse(_if)?\b', strip_comments(effects)), 'else / else_if in the scripted effects')
    eff = {n.key: n for n in pdx.parse(strip_comments(effects))[0]}
    for name, node in eff.items():
        has_random = any(nd.key in ('random', 'random_list') for nd, _, _ in pdx.walk(node.value))
        check(has_random == (name in ('DA_LE_roll_die', 'DA_LE_roll_move', 'DA_LE_five_year_pulse')), f'{name}: random roll where it must not be (or missing)')
    check('random' not in strip_comments(cgui), 'a random roll in the custom GUI')
    # the dice effects are only reached from the two hidden events and from each other
    for name in ('DA_LE_roll_die', 'DA_LE_roll_move'):
        callers = [k for k, node in eff.items() if any(nd.key == name for nd, _, _ in pdx.walk(node.value))]
        check(set(callers) <= {'DA_LE_resolve_round'}, f'{name} is called from {callers}')
        check(name not in cgui, f'{name} is called from a button')
    check('DA_LE_resolve_round' not in cgui, 'a button resolves a round without the event')

    # every DA_LE scripted effect / trigger that is called is defined; every other one exists in the mod or Anbennar
    trig = {n.key for n in pdx.parse(strip_comments(triggers))[0]}
    known = set(eff) | trig
    for text, where in ((effects, 'effects'), (triggers, 'triggers'), (cgui, 'custom gui'), (cloc, 'custom loc'), (events, 'events'), (onact, 'on_actions')):
        for name in set(re.findall(r'\b(DA_LE_[A-Za-z_]+) = (?:yes|\{)', strip_comments(text))):
            if re.match(r'DA_LE_(Get|contained_|regroup)', name):
                continue
            check(name in known, f'{where}: {name} is not defined')
    outside = ''
    for root in (MOD, ANB):
        for sub in ('common/scripted_effects', 'common/scripted_triggers'):
            for p in files(root, sub, '.txt'):
                outside += read(p)
    for name in ('change_mana',):
        check(re.search(r'^' + name + r' = \{', outside, re.M), f'{name} is not defined in the mod or Anbennar')
    for name in ('estate_mages', 'has_mages_estate_equiv', 'banned_magic', 'mages_strike', 'bd_wounded_ruler', 'mage_personality',
                 'ancestor_mage_personality', 'currentMana', 'DA_power_TOTAL_', 'DA_continous_Undeads', 'DA_Dragon_raids',
                 'DA_Verkal_koz_warning3', 'DA_can_duel_lich', 'DA_can_duel_Dragon',
                 'DA_Titanium_Vault_found_Hunter_of_the_deeps', 'DA_Hunter_gone', 'DA_Hunter_rampage', 'DA_Titanium_Vault = {'):
        found = False
        for root in (MOD, ANB):
            for sub in ('common', 'events'):
                for p in files(root, sub, '.txt'):
                    if 'DA_Legendary_Encounter' in p or 'backup' in p:
                        continue
                    if name in read(p):
                        found = True
                        break
                if found:
                    break
            if found:
                break
        check(found, f'{name} is used but appears nowhere else in the mod or Anbennar')

    # events
    all_events = ''
    for p in files(MOD, 'events', '.txt'):
        all_events += strip_comments(read(p))
    ids = set(re.findall(r'\bid\s*=\s*([A-Za-z_]+\.\d+)', all_events))
    for text in (effects, cgui, events):
        for ev in set(re.findall(r'_event = \{ id = ([A-Za-z_]+\.\d+)', strip_comments(text))):
            check(ev in ids, f'event {ev} is fired but not defined')
    check(re.search(r'namespace = ' + B.NS + r'\b', events), 'namespace')

    # the old duel is gone
    for rel in B.RETIRED:
        check(not os.path.exists(os.path.join(MOD, rel)), f'{rel} is still in the mod')
        check(os.path.exists(os.path.join(MOD, B.BACKUP, rel)), f'{rel} is not in the backup folder')
    for sub, ext in (('common', '.txt'), ('events', '.txt'), ('decisions', '.txt'), ('localisation', '.yml'), ('interface', '.gui'), ('missions', '.txt')):
        for p in files(MOD, sub, ext):
            t = read(p)
            for word in ('DA_magic_duel', 'DA_cast_spell', 'DA_process_magical_turn', 'DA_fight_Lich', 'DA_fight_Dragon_Khugdihr',
                         'npc_lich', 'npc_Dragon_Khugdihr', 'DA_Verkal_Kozenad_event.5', 'DA_Khugdihr_event.3'):
                check(word not in t, f'{os.path.relpath(p, MOD)} still mentions {word}')

    # GUI: panel twice, button three times, every scripted element has its custom_gui entry and the other way round
    pv_gui = read(os.path.join(MOD, 'interface/provinceview.gui'))
    panels = re.findall(re.escape(B.PANEL_BEGIN) + r'\n(.*?)' + re.escape(B.PANEL_END), pv_gui, re.S)
    check(len(panels) == 2, f'the panel is in provinceview.gui {len(panels)} times')
    check(pv_gui.count(B.BUTTON_BEGIN) == 3, 'the entry button is not in all three button layouts')
    t = strip_comments(pv_gui)
    check(t.count('{') == t.count('}'), 'provinceview.gui: unbalanced braces')
    cg_names = {}
    for kind, name in re.findall(r'^(custom_\w+) = \{\n\tname = (\S+)', cgui, re.M):
        check(name not in cg_names, f'custom gui {name} defined twice')
        cg_names[name] = kind
    kinds = {'guiButtonType': 'custom_button', 'iconType': 'custom_icon', 'instantTextBoxType': 'custom_text_box'}
    sprites = dict(re.findall(r'name = "(GFX_[^"]+)"\s*\n\s*texturefile = "([^"]+)"', gfx))
    frames = {m[0]: int(m[1]) for m in re.findall(r'name = "(GFX_[^"]+)"\s*\n\s*texturefile = "[^"]+"\s*\n\s*noOfFrames = (\d+)', gfx)}
    all_gfx = ''
    for root in (MOD, ANB):
        for p in files(root, 'interface', '.gfx'):
            all_gfx += read(p)
    for pi, panel in enumerate(panels):
        seen, rects = set(), []
        for kind, body in re.findall(r'(guiButtonType|iconType|instantTextBoxType) = \{\n(.*?)\n\t*\}', panel, re.S):
            g = lambda k: (re.search(r'\b' + k + r' = "?([^"\n]+)"?', body) or [None, None])[1]
            name = g('name')
            x, y = map(int, re.search(r'x = (-?\d+) y = (-?\d+)', body).groups())
            seen.add(name)
            scripted = 'scripted = yes' in body
            check(scripted == (name in cg_names), f'{name}: scripted = {scripted} but custom gui entry = {name in cg_names}')
            if name in cg_names:
                check(cg_names[name] == kinds[kind], f'{name}: {kind} with a {cg_names[name]}')
            spr = g('spriteType') or g('quadTextureSprite')
            if spr:
                check(f'"{spr}"' in all_gfx, f'{name}: sprite {spr} is not defined')
                if spr in sprites and pi == 0:
                    tex = os.path.join(MOD, sprites[spr])
                    check(os.path.exists(tex), f'{spr}: texture {sprites[spr]} is missing')
                    if os.path.exists(tex):
                        w_, h_ = dds_size(tex)
                        w_ //= frames.get(spr, 1)
                        check(x >= 0 and y >= 0 and x + w_ <= B.PANEL_W and y + h_ <= B.PANEL_H, f'{name} leaves the panel')
                        if kind == 'guiButtonType':
                            rects.append((name, x, y, w_, h_))
            if kind == 'instantTextBoxType':
                key = g('text')
                check(key in loc, f'{name}: text {key} has no localisation')
                w_, h_ = int(g('maxWidth')), int(g('maxHeight'))
                check(x >= 0 and x + w_ <= B.PANEL_W and y + h_ <= B.PANEL_H, f'{name} leaves the panel')
        check({n for n in cg_names if n.startswith('DA_LE_')} <= seen, f'custom gui entries without an element: {sorted(set(n for n in cg_names if n.startswith("DA_LE_")) - seen)}')
        # buttons that can be on screen together must not overlap
        idle = {'DA_LE_scout', 'DA_LE_contain', 'DA_LE_parley', 'DA_LE_engage'}
        for i, a in enumerate(rects):
            for b in rects[i + 1:]:
                if (a[0] in idle) != (b[0] in idle) and a[0] not in ('DA_LE_close', 'DA_LE_ruler_toggle') and b[0] not in ('DA_LE_close', 'DA_LE_ruler_toggle'):
                    continue
                over = a[1] < b[1] + b[3] and b[1] < a[1] + a[3] and a[2] < b[2] + b[4] and b[2] < a[2] + a[4]
                check(not over, f'{a[0]} overlaps {b[0]}')
    check('DA_Legendary_Encounter_Province_Button' in cg_names and 'DA_province_legendary_encounter_panel' in cg_names, 'entry button or window logic missing')
    for spr, tex in sprites.items():
        p = os.path.join(MOD, tex)
        check(os.path.exists(p), f'{spr}: texture {tex} is missing')
        if os.path.exists(p) and spr in frames:
            check(dds_size(p)[0] % frames[spr] == 0, f'{spr}: width does not divide into {frames[spr]} frames')
    bg = os.path.join(MOD, sprites['GFX_DA_LE_panel_bg'])
    if os.path.exists(bg):
        check(dds_size(bg) == (B.PANEL_W, B.PANEL_H), 'the panel background is not the size of the panel')

    # localisation: tooltips, defined texts, variables shown
    for key in set(re.findall(r'tooltip = ([A-Za-z_]\S*)', cgui)) | set(re.findall(r'localisation_key = (\S+)', cloc)):
        check(key in loc or key == 'DA_province_panel_close_tt', f'localisation key {key} is missing')
    for key in set(re.findall(r'(?:title|desc|name|custom_tooltip) = (' + B.NS + r'\.[\w.]+)', events)):
        check(key in loc, f'event text {key} is missing')
    for name in re.findall(r'^(DA_LE_\w+) = \{', mods, re.M):
        check(name in loc and 'desc_' + name in loc, f'modifier {name} has no name or description')
    defined = set(re.findall(r'name = (DA_LE_Get\w+)', cloc))
    hold_loc = read(os.path.join(MOD, 'localisation/DA_Hold_Verkal_kozenad_l_english.yml')) + read(os.path.join(MOD, 'localisation/DA_Hold_Khugdihr_l_english.yml'))
    gor_loc = read(os.path.join(MOD, 'localisation/DA_Hold_Gor_Vazumbrog_l_english.yml'))
    gor_keys = set(re.findall(r'^ ?([^\s:#]+):\d* "', gor_loc, re.M))
    # a legend that flees: its texts, and whatever its lost-fight events use from the hold's own files
    for l in R.LEGENDS:
        t = B.TEXT[l.id]
        need = ['subtitle', 'traits', 'traits_tt', 'locked', 'idle', 'scout_tt', 'contain', 'contain_tt', 'parley_tt',
                ] + (['guest_a', 'guest_b', 'no_fight_tt'] if l.talk_only else ['defeat_t', 'defeat_d', 'defeat_a', 'withdraw_t', 'withdraw_d', 'withdraw_a']) \
            + (['withdraw_tt', 'engage_note'] if l.flees else [])
        check(all(t.get(k) for k in need), f'{l.id}: texts missing: {[k for k in need if not t.get(k)]}')
        check(l.talk_only or (len(l.moves) == 4 and all(m.id in B.MOVE_TT for m in l.moves)), f'{l.id}: four moves, each with its explanation')
        check(not l.talk_only or (l.parley_event and not l.moves and not l.contain_cost and l.ai_army is None), f'{l.id}: a legend that can only be spoken to has Parley and nothing else')
        check(bool(l.unlock_flag) != bool(l.unlock_trigger), f'{l.id}: exactly one of unlock_flag and unlock_trigger')
        check(not l.flees or l.end_flag, f'{l.id}: a legend that flees needs an end flag')
        check(l.ai_army is None or l.unlock_flag, f'{l.id}: the AI pulse needs an unlock flag')
    for key in set(re.findall(r'custom_tooltip = (\S+)', strip_comments(events))):
        check(key in loc or key in gor_keys, f'event tooltip {key} has no text')
    all_mods = ''
    for p in files(MOD, 'common/event_modifiers', '.txt'):
        all_mods += strip_comments(read(p))
    for name in set(re.findall(r'add_province_modifier = \{ name = (\S+)', strip_comments(events))):
        check(re.search(r'^' + re.escape(name) + r' = \{', all_mods, re.M), f'province modifier {name} is not defined')
        check(name in loc or name in gor_keys, f'province modifier {name} has no name')
    set_vars = set(re.findall(r'which = (DA_LE_\w+)', effects))
    for text in list(loc.values()) + re.findall(r'"(.*)"', hold_loc + gor_loc):
        for ref in re.findall(r'\[Root\.(DA_LE_Get\w+)\]', text):
            check(ref in defined, f'[Root.{ref}] has no defined_text')
        for var in re.findall(r'\[Root\.(DA_LE_\w+)\.GetValue\]', text):
            check(var in set_vars, f'[Root.{var}.GetValue]: nothing sets this variable')
    check(all(re.search(r'\[Root\.' + d + r'\]', loc_text) for d in defined), 'a defined_text is never shown')
    for key, value in loc.items():
        check(all(ord(c) < 256 for c in value), f'{key}: a character EU4 cannot show')
        check(value.count('§') % 2 == 0, f'{key}: unbalanced colour codes')
    for key in ('DA_Verkal_Kozenad_event.4.d', 'DA_Khugdihr_event.2.d', 'DA_ADK_explore.216.tooltip', 'DA_Verkal_Kozenad_event.2.a.tt'):
        check(re.search(r'^ ' + re.escape(key) + r':', hold_loc, re.M), f'{key} is missing from the hold texts')
    check('magic duel' not in hold_loc.lower(), 'the hold texts still speak of a magic duel')

    # hooks into the hand-written files
    verkal = read(os.path.join(MOD, 'events/DA_Hold_Verkal_Kozenad.txt'))
    check('NOT = { has_province_modifier = DA_LE_contained_lich }' in verkal, 'sealing the palace does not stop the undead')
    check(not strip_comments(read(os.path.join(MOD, 'decisions/DA_Ancient_dwarven_knowledge.txt'))).count('{') -
          strip_comments(read(os.path.join(MOD, 'decisions/DA_Ancient_dwarven_knowledge.txt'))).count('}'), 'decisions file: unbalanced braces')


part1()
part2()
print(f'{PASSES} checks passed, {len(FAIL)} failed')
for f in FAIL:
    print('FAIL:', f)
sys.exit(1 if FAIL else 0)
