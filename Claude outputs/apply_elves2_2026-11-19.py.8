#!/usr/bin/env python3
"""Install the rest of the elven content and the gnomes' Precursor Assays (doc 68; implemented 19 November 2026, doc 72).

    python3 "Claude files/tools/elves2_2026-11-19/apply_elves2_2026-11-19.py" .

Run from the mod folder (the one with Dwarven-Knowledge-Dev.mod), with Anbennar next to it
(../anbennar-eu4-dev-new-master, or DA_ANBENNAR): the encounter banners, the school icons and the patent buttons are
drawn from Anbennar's pictures. The first elven install (doc 69) must be in. Safe to run again. Every file that changes
is backed up once, before its first change, in "Claude files/backup_before_2026-11-19_elves2/"; each run is added to
"Claude files/reports/apply_elves2_2026-11-19.log".

What it does
  1. Checks that the shared tools it replaces are still the versions this payload was made from (its _base folder),
     so that nothing written since is overwritten; then installs the tools of this payload into "Claude files/tools/":
     le_rules.py, build_legendary_encounters.py, make_legendary_encounter_art.py, check_legendary_encounters.py (the
     three legends, Wyrmbane); elven_data.py, build_elven_archive.py, elven_archive_ui.py, check_elven_archive.py (the
     Marvels page's legends, the legends' events, the survey plate, Spellblades and Wyrmbane); build_ruin_excavation.py
     (surveys abroad, the gnomes' rings and relic samples, the Seedthralls, Hire a Precursor Archaeologist);
     build_elven_arsenal.py (new: Dragonguard Spellforms, eight blueprints, six sigils); gnomish_data.py,
     build_gnomish_workshop.py, check_gnomish_workshop.py (the Precursor Assays); check_secondary_tech.py (the count of
     the designer's options).
  2. Runs the builders: the encounters (and their art), the Archive (art, then scripts), the ruins, the Workshop (art,
     then scripts), the arsenal, Projects & Research (and its art), the secondary technologies, racial heritage, the
     hub; then the previews.
"""
import datetime, filecmp, hashlib, json, os, re, shutil, subprocess, sys, tempfile

ROOT = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else '.')
TOOLS = os.path.join(ROOT, 'Claude files', 'tools')
PAYLOAD = os.path.join(TOOLS, 'elves2_2026-11-19')
BASE = os.path.join(PAYLOAD, '_base')
REPLACED = ['le_rules.py', 'build_legendary_encounters.py', 'make_legendary_encounter_art.py', 'check_legendary_encounters.py',
            'elven_data.py', 'build_elven_archive.py', 'elven_archive_ui.py', 'build_ruin_excavation.py', 'check_elven_archive.py',
            'gnomish_data.py', 'build_gnomish_workshop.py', 'check_gnomish_workshop.py', 'check_secondary_tech.py']
NEW_TOOLS = REPLACED + ['build_elven_arsenal.py']
BACKUP = os.path.join(ROOT, 'Claude files', 'backup_before_2026-11-19_elves2')
REPORT = os.path.join(ROOT, 'Claude files', 'reports', 'apply_elves2_2026-11-19.log')
ANBENNAR = os.environ.get('DA_ANBENNAR') or os.path.join(os.path.dirname(ROOT), 'anbennar-eu4-dev-new-master')
LOG = []
TRACK = ['common', 'events', 'localisation', 'customizable_localization', 'interface', 'decisions',
         'gfx/interface/DA_projects_research', 'gfx/interface/DA_Racial_Heritage', 'gfx/interface/DA_EL_Remnant_Archive',
         'gfx/interface/DA_Ruin_Excavation', 'gfx/interface/DA_GN_Workshop', 'gfx/interface/DA_Legendary_Encounter',
         'Claude files/tools']
NEW_LIST = os.path.join(BACKUP, '_new_files.txt')


def log(s):
    LOG.append(s)
    print(s)


def p(rel):
    return os.path.join(ROOT, rel)


def md5(path):
    return hashlib.md5(open(path, 'rb').read()).hexdigest()


# ---------------------------------------------------------------------------
# 1. the tools
# ---------------------------------------------------------------------------
def check_bases():
    """a shared tool is replaced only if it is still the version this payload was made from (or already this one)"""
    for f in REPLACED:
        cur, base, new = os.path.join(TOOLS, f), os.path.join(BASE, f), os.path.join(PAYLOAD, f)
        if not os.path.exists(cur):
            raise SystemExit('STOP: Claude files/tools/%s is missing' % f)
        if md5(cur) not in (md5(base), md5(new)):
            raise SystemExit('STOP: Claude files/tools/%s has changed since this payload was made from it. Nothing was '
                             'written. Compare it with %s.' % (f, os.path.relpath(base, ROOT)))


def install_tools():
    for f in NEW_TOOLS:
        src, dst = os.path.join(PAYLOAD, f), os.path.join(TOOLS, f)
        if os.path.exists(dst) and filecmp.cmp(src, dst, shallow=False):
            log('done    tools/%s (already this version)' % f)
            continue
        shutil.copy2(src, dst)
        log('copied  tools/%s from %s' % (f, os.path.basename(PAYLOAD)))


def made_by_install():
    return set(open(NEW_LIST, encoding='utf-8').read().splitlines()) if os.path.exists(NEW_LIST) else set()


def note_new(rel):
    if rel in made_by_install():
        return
    os.makedirs(BACKUP, exist_ok=True)
    with open(NEW_LIST, 'a', encoding='utf-8') as f:
        f.write(rel + '\n')


def run(script, *args, root=True):
    cmd = [sys.executable, os.path.join(TOOLS, script)] + ([ROOT] if root else []) + list(args)
    log('run     ' + ' '.join([script] + (['.'] if root else []) + [os.path.relpath(a, ROOT) if os.path.isabs(a) else a
                                                                     for a in args]))
    env = dict(os.environ, DA_ANBENNAR=ANBENNAR)
    r = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT, env=env)
    for line in (r.stdout + r.stderr).splitlines():
        if line.startswith('same'):
            continue
        log('        ' + line)
    if r.returncode != 0:
        raise SystemExit('STOP: %s failed' % script)


# ---------------------------------------------------------------------------
# 2. snapshot, backups
# ---------------------------------------------------------------------------
def walk_tracked():
    for top in TRACK:
        base = p(top)
        if not os.path.isdir(base):
            continue
        for d, _, files in os.walk(base):
            if '__pycache__' in d or re.search(r'_\d{4}-\d{2}-\d{2}([\\/]|$)', os.path.relpath(d, TOOLS)):
                continue
            for f in files:
                yield os.path.relpath(os.path.join(d, f), ROOT)
    for f in os.listdir(ROOT):
        if f.endswith('.txt') and os.path.isfile(p(f)):
            yield f


SNAP = os.path.join(tempfile.gettempdir(), 'elves2_snapshot_' + hashlib.md5(ROOT.encode('utf-8')).hexdigest()[:10])


def snapshot():
    done = os.path.join(SNAP, '_complete.json')
    if os.path.exists(done):
        hashes = json.load(open(done, encoding='utf-8'))
        log('note    a run stopped half-way: its snapshot of %d files is used' % len(hashes))
        return SNAP, hashes
    shutil.rmtree(SNAP, ignore_errors=True)
    hashes = {}
    for rel in walk_tracked():
        hashes[rel] = md5(p(rel))
        dst = os.path.join(SNAP, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(p(rel), dst)
    with open(done, 'w', encoding='utf-8') as f:
        json.dump(hashes, f)
    return SNAP, hashes


def changed_files(hashes):
    now = {rel: md5(p(rel)) for rel in walk_tracked()}
    changed = sorted(r for r in now if r in hashes and now[r] != hashes[r])
    new = sorted(r for r in now if r not in hashes)
    gone = sorted(r for r in hashes if r not in now)
    return changed, new, gone


def keep_originals(changed, new, snap):
    made = made_by_install()
    for rel in changed:
        dst = os.path.join(BACKUP, rel)
        if rel in made or os.path.exists(dst):
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(os.path.join(snap, rel), dst)
        log('backup  ' + rel)
    for rel in new:
        note_new(rel)


# ---------------------------------------------------------------------------
# 3. preflight, builders
# ---------------------------------------------------------------------------
def preflight():
    if not os.path.exists(p('Dwarven-Knowledge-Dev.mod')):
        raise SystemExit('STOP: run it from the mod folder (Dwarven-Knowledge-Dev.mod not found in %s)' % ROOT)
    for f in NEW_TOOLS:
        if not os.path.exists(os.path.join(PAYLOAD, f)):
            raise SystemExit('STOP: %s is missing from %s' % (f, PAYLOAD))
    for f in REPLACED:
        if not os.path.exists(os.path.join(BASE, f)):
            raise SystemExit('STOP: %s is missing from %s' % (f, BASE))
    for f in ('build_projects_research.py', 'racial_heritage_data.py', 'build_racial_heritage.py', 'build_racial_hub.py',
              'build_secondary_tech.py', 'build_obsidian_tech.py', 'build_goblin_arsenal.py', 'pdx.py', 'eu4_gui.py', 'eu4_text.py'):
        if not os.path.exists(os.path.join(TOOLS, f)):
            raise SystemExit('STOP: %s is missing from Claude files/tools' % f)
    for rel in ('gfx/interface/custom_gui/magic', 'gfx/interface/custom_gui/artificery', 'gfx/event_pictures/LOOMING_DEATH_eventPicture.dds'):
        if not os.path.exists(os.path.join(ANBENNAR, rel)):
            raise SystemExit('STOP: Anbennar is not next to the mod (%s: %s missing). Set DA_ANBENNAR to its folder.' % (ANBENNAR, rel))
    if 'windowType = { #DA_EL_archive' not in open(p('interface/topbar.gui'), encoding='latin-1').read():
        raise SystemExit('STOP: the Remnant Archive (doc 69) is not installed: this install goes after it')
    dec = open(p('decisions/DA_Ancient_dwarven_knowledge.txt'), encoding='latin-1').read().replace('\r\n', '\n')
    if '# DA_EL archaeologist' not in dec and 'DA_Find_translator = {' not in dec:
        raise SystemExit('STOP: Hire a Precursor Archaeologist (DA_Find_translator) is not in decisions/DA_Ancient_dwarven_knowledge.txt')
    for art in ('Claude files/art_sources/elven_marvels/spire_gardens.png', 'Claude files/art_sources/elven_marvels/gleaming_laboratory.png'):
        if not os.path.exists(p(art)):
            raise SystemExit('STOP: %s is missing (the encounter banners are cut from it)' % art)


def builders(prev):
    # the encounters first (the Archive's Marvels page reads their triggers), the Archive's texts before Projects &
    # Research (the requirement lines of the Elven page are read from them), the Archive once more at the end (as in
    # the first install), then the previews
    return [('build_legendary_encounters.py',), ('make_legendary_encounter_art.py', ANBENNAR),
            ('build_elven_archive.py', 'art'), ('build_elven_archive.py',),
            ('build_ruin_excavation.py', 'art'), ('build_ruin_excavation.py',),
            ('build_gnomish_workshop.py', 'art'), ('build_gnomish_workshop.py',),
            ('build_elven_arsenal.py',),
            ('build_projects_research.py',), ('build_projects_research.py', 'art'), ('build_secondary_tech.py',),
            ('build_racial_heritage.py',), ('build_racial_hub.py',),
            ('build_elven_archive.py',),
            ('build_ruin_excavation.py', 'preview', os.path.join(prev, 'ruin_excavation.png')),
            ('build_elven_archive.py', 'preview', os.path.join(prev, 'remnant_archive.png')),
            ('build_gnomish_workshop.py', 'preview', os.path.join(prev, 'gommo_workshop_precursor.png'), 'precursor')]


def main():
    preflight()
    check_bases()
    snap, hashes = snapshot()
    install_tools()
    prev = os.path.join(ROOT, 'Claude files', 'previews')
    os.makedirs(prev, exist_ok=True)
    for b in builders(prev):
        run(*b)
    changed, new, gone = changed_files(hashes)
    keep_originals(changed, new, snap)
    log('changed %d file(s), new %d file(s), gone %d file(s)' % (len(changed), len(new), len(gone)))
    for rel in changed:
        log('  changed ' + rel)
    for rel in new:
        log('  new     ' + rel)
    for rel in gone:
        log('  gone    ' + rel)
    os.makedirs(os.path.dirname(REPORT), exist_ok=True)
    with open(REPORT, 'a', encoding='utf-8') as f:
        f.write('=== run of %s UTC\n' % datetime.datetime.utcnow().strftime('%Y-%m-%d %H:%M'))
        f.write('\n'.join(LOG) + '\n\n')
    shutil.rmtree(snap, ignore_errors=True)
    print('log: ' + os.path.relpath(REPORT, ROOT))


if __name__ == '__main__':
    main()
