    L(V('rep_theirs_missed'), 'Our illusions drew the blow: §Git cost us nothing§!.')
    L(V('rep_theirs_ambush'), 'We struck first, from where it could not reach us: §Git cost us nothing§!.')
    o += defined_text('DA_LE_GetRepExtra', [
