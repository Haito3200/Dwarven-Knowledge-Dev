def gen_province_panel():
    body = '\n'.join(['name = "DA_province_legendary_encounter_panel"', 'position = { x = %d y = %d }',
                      f'size = {{ x = {PANEL_W} y = {PANEL_H} }}', 'scripted = yes', 'moveable = 0'] + panel_elements())
    return 'windowType = {\n' + '\n'.join(ind(body.split('\n'))) + '\n}'


def gen_gfx():
    def sprite(name, tex, frames=None):
        s = [f'name = "{name}"', f'texturefile = "gfx/interface/DA_Legendary_Encounter/{tex}"']
        if frames:
            s.append(f'noOfFrames = {frames}')
        s.append('transparencecheck = yes')
        return B('spriteType', s)
    sp = sprite('GFX_DA_LE_panel_bg', 'DA_LE_panel_bg.dds')
    sp += sprite('GFX_DA_LE_banner', 'DA_LE_banner.dds', len(R.LEGENDS))
    for c in ('red', 'blue', 'green'):
        sp += sprite(f'GFX_DA_LE_bar_{c}', f'DA_LE_bar_{c}.dds', BAR_FRAMES)
    for s in R.SCHOOLS:
        sp += sprite(f'GFX_DA_LE_spell_{s}', f'DA_LE_spell_{s}.dds', 4)
    sp += sprite('GFX_DA_LE_order_button', 'DA_LE_order_button.dds')
    sp += sprite('GFX_DA_LE_withdraw_button', 'DA_LE_withdraw_button.dds')
    sp += sprite('GFX_DA_LE_checkbox', 'DA_LE_checkbox.dds', 2)
    sp += sprite('GFX_DA_LE_recount', 'DA_LE_recount.dds')
    sp += sprite('GFX_DA_Legendary_Encounter_Province_Button', 'DA_Legendary_Encounter_Province_Button.dds')
    return HEADER + text_block(B('spriteTypes', sp))


def gen_loc():
    L(V('hp_label'), 'Vitality')
