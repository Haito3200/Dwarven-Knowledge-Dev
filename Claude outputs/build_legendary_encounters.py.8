    'common/scripted_triggers/DA_Legendary_Encounter_triggers.txt': gen_triggers,
    'common/scripted_effects/DA_Legendary_Encounter_effects.txt': gen_effects,
    'common/event_modifiers/DA_Legendary_Encounter_modifiers.txt': gen_modifiers,
