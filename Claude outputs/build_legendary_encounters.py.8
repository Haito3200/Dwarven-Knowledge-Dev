'''


# ---------------------------------------------------------------------------------------------
# File I/O and patches
# ---------------------------------------------------------------------------------------------
def path(rel):
    return os.path.join(ROOT, rel)


def read(rel):
    raw = open(path(rel), 'rb').read()
    enc = 'utf-8-sig' if rel.endswith('.yml') else 'latin-1'
    text = raw.decode(enc)
    return text.replace('\r\n', '\n'), {'crlf': '\r\n' in text, 'enc': enc}


def write(rel, text, crlf=True, enc=None):
    enc = enc or ('utf-8-sig' if rel.endswith('.yml') else 'latin-1')
    if crlf:
        text = text.replace('\n', '\r\n')
    data = text.encode('utf-8' if enc == 'utf-8-sig' else enc)
    if enc == 'utf-8-sig':
        data = b'\xef\xbb\xbf' + data
    full = path(rel)
    old = open(full, 'rb').read() if os.path.exists(full) else None
    if old != data:
        os.makedirs(os.path.dirname(full) or '.', exist_ok=True)
        open(full, 'wb').write(data)
        print('wrote ', rel)
    else:
        print('same  ', rel)


def backup(rel):
    dst = path(os.path.join(BACKUP, rel))
    if os.path.exists(path(rel)) and not os.path.exists(dst):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(path(rel), dst)
        print('backup', rel)


def rewrite(rel, fn):
    text, meta = read(rel)
    new = fn(text)
    if new != text:
        backup(rel)
    write(rel, new, crlf=meta['crlf'], enc=meta['enc'])


def strip_comments(text):
    return re.sub(r'#[^\n]*', lambda m: ' ' * len(m.group(0)), text)


def block_end(text, open_brace):
    clean = strip_comments(text)
    depth = 0
    for i in range(open_brace, len(clean)):
        if clean[i] == '{':
            depth += 1
        elif clean[i] == '}':
            depth -= 1
            if depth == 0:
                return i + 1
    raise SystemExit('unbalanced braces')


def remove_block(text, start_re):
    """Removes the block whose head matches start_re (and the line it starts on, with a comment-only tail)."""
    m = re.search(start_re, text)
    if not m:
        return text
    a = text.rfind('\n', 0, m.start()) + 1
    b = block_end(text, text.index('{', m.start()))
    b = text.find('\n', b)
    b = len(text) if b < 0 else b + 1
    return text[:a] + text[b:]


def remove_event(text, event_id):
    m = re.search(r'\bid\s*=\s*' + re.escape(event_id) + r'\b', text)
    if not m:
        return text
    a = max(text.rfind('country_event = {', 0, m.start()), text.rfind('province_event = {', 0, m.start()))
    b = block_end(text, text.index('{', a))
    b = text.find('\n', b)
    return text[:a] + text[(len(text) if b < 0 else b + 1):]


def set_loc(text, key, value):
    value = value.replace('"', "'").replace('\n', '\\n')
    pat = re.compile(r'^ ' + re.escape(key) + r':\d* ".*"[ \t]*(#.*)?$', re.M)
    if not pat.search(text):
        raise SystemExit(f'localisation key {key} not found')
    return pat.sub(lambda m: f' {key}:0 "{value}"', text, count=1)


def drop_loc(text, key):
    return re.sub(r'^ ' + re.escape(key) + r':\d* ".*"[ \t]*(#.*)?\n', '', text, flags=re.M)


RETIRED = ['events/DA_MagicDuel.txt', 'common/scripted_effects/DA_magic_duel_effects.txt', 'localisation/DA_Magic_duels_l_english.yml']

BUTTON_BEGIN, BUTTON_END = '# BEGIN DA_LEGENDARY_ENCOUNTER_BUTTON', '# END DA_LEGENDARY_ENCOUNTER_BUTTON'
PANEL_BEGIN, PANEL_END = '# BEGIN DA_LEGENDARY_ENCOUNTER_PANEL', '# END DA_LEGENDARY_ENCOUNTER_PANEL'


def patch_existing():
    # 1. the old duel leaves: its files go to the backup folder, its two decisions are removed
    for rel in RETIRED:
        if os.path.exists(path(rel)):
            dst = path(os.path.join(BACKUP, rel))
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            if os.path.exists(dst):
                raise SystemExit(f'{rel} exists again although it was retired; look at it before re-running')
            os.replace(path(rel), dst)
            print('retired', rel)

    rewrite('decisions/DA_Ancient_dwarven_knowledge.txt', remove_duel_decisions)

    # 2. hold events: the duel's defeat events go; sealing the palace stops the undead
    def verkal(t):
        t = remove_event(t, 'DA_Verkal_Kozenad_event.5')
        if 'DA_LE_contained_lich' not in t:
            t = t.replace('\t\thas_province_modifier = DA_continous_Undeads\n\t\tNOT = { has_province_modifier = DA_undeads_spawn_CD }',
                          '\t\thas_province_modifier = DA_continous_Undeads\n\t\tNOT = { has_province_modifier = DA_undeads_spawn_CD }\n'
                          '\t\tNOT = { has_province_modifier = DA_LE_contained_lich }\t# the palace is sealed (Legendary Encounter window)', 1)
            if 'DA_LE_contained_lich' not in t:
                raise SystemExit('undead spawn trigger not found in DA_Hold_Verkal_Kozenad.txt')
        return t
    rewrite('events/DA_Hold_Verkal_Kozenad.txt', verkal)
    rewrite('events/DA_Hold_Khugdihr.txt', lambda t: remove_event(t, 'DA_Khugdihr_event.3'))

    # 3. texts of the two holds
    def verkal_loc(t):
        t = t.replace('We have reached the palace, but only a powerful mage can hope to face off against the maddened lich and free him of his torment. '
                      'We hope your highness will find a way to see this problem to its end.',
                      'We have reached the palace. Whoever goes in will face the maddened lich himself: an army can do it, at a price, and '
                      'a powerful mage at its head would lower that price. We hope your highness will find a way to see this problem to its end.')
        t = set_loc(t, 'DA_Verkal_Kozenad_event.2.a.tt',
                    'We can now deal with the Cursed King: select §YVerkal Kozenad§! and open §YLegendary Encounter§! among its province buttons.')
        t = set_loc(t, 'DA_Verkal_Kozenad_event.4.t', 'The Cursed King Destroyed')
        t = set_loc(t, 'DA_Verkal_Kozenad_event.4.d', TEXT['lich']['victory_d'])
        t = set_loc(t, 'DA_Verkal_Kozenad_event.4.a', TEXT['lich']['victory_a'])
        for k in ('DA_fight_Lich_title', 'DA_fight_Lich_desc', 'DA_start_duel_lich', 'DA_Verkal_Kozenad_event.5.t',
                  'DA_Verkal_Kozenad_event.5.d', 'DA_Verkal_Kozenad_event.5.a'):
            t = drop_loc(t, k)
        return t
    rewrite('localisation/DA_Hold_Verkal_kozenad_l_english.yml', verkal_loc)

    def khugdihr_loc(t):
        t = t.replace("As a dragon is an unbelievable enemy to defeat for a mortal it was suggested that a powerful great mage should be able to take care of it...\\n"
                      "Everyone looks at you in awkwardness",
                      "A dragon is more than any one mortal can face. It was suggested that an army might do it, with every gun the hold can spare, "
                      "and that a powerful mage at its head would spare a great many lives...\\nEveryone looks at you in awkwardness")
        t = set_loc(t, 'DA_ADK_explore.216.a', 'How many regiments does one send against a dragon?')
        t = set_loc(t, 'DA_ADK_explore.216.tooltip',
                    'We can now deal with the dragon: select §YKhugdihr§! and open §YLegendary Encounter§! among its province buttons. '
                    'As long as it lives it will raid the hold from time to time.')
        t = set_loc(t, 'desc_DA_Dragon_raids',
                    'A dragon nests in the depths of this hold and may come out at any moment. It can be fought, or paid off for a while, '
                    'from the Legendary Encounter window of this province.')
        t = set_loc(t, 'DA_Khugdihr_event.2.t', 'The Dragon is Dead')
        t = set_loc(t, 'DA_Khugdihr_event.2.d', TEXT['dragon']['victory_d'])
        t = set_loc(t, 'DA_Khugdihr_event.2.a', TEXT['dragon']['victory_a'])
        for k in ('DA_fight_Dragon_Khugdihr_title', 'DA_fight_Dragon_Khugdihr_desc', 'DA_start_duel_Dragon_Khugdihr',
                  'DA_Khugdihr_event.3.t', 'DA_Khugdihr_event.3.d', 'DA_Khugdihr_event.3.a'):
            t = drop_loc(t, k)
        return t
    rewrite('localisation/DA_Hold_Khugdihr_l_english.yml', khugdihr_loc)

    # 4. province view: the entry button in the three button layouts, the panel in both windows
    def provinceview(t):
        t = re.sub(r'[ \t]*' + re.escape(BUTTON_BEGIN) + r'\n.*?' + re.escape(BUTTON_END) + r'\n', '', t, flags=re.S)
        t = re.sub(r'[ \t]*' + re.escape(PANEL_BEGIN) + r'\n.*?' + re.escape(PANEL_END) + r'\n', '', t, flags=re.S)
        out, pos, count = [], 0, 0
        for m in re.finditer(r'(\t*)#Row  3 Slot 3 - region specific interactions\n', t):
            tabs = m.group(1)
            # the first layout stacks its slots in columns, the two others in rows
            xy = (112, 131) if count == 0 else (124, 124)
            btn = gui('guiButtonType', name='DA_Legendary_Encounter_Province_Button',
                      quadTextureSprite='GFX_DA_Legendary_Encounter_Province_Button', position=xy, scripted='yes')
            out.append(t[pos:m.end()])
            out.append('\n'.join(ind([BUTTON_BEGIN] + btn.split('\n') + [BUTTON_END], len(tabs))) + '\n')
            pos = m.end()
            count += 1
        if count != 3:
            raise SystemExit(f'expected 3 "Row 3 Slot 3" markers in provinceview.gui, found {count}')
        out.append(t[pos:])
        t = ''.join(out)
        panel = gen_province_panel()
        out, pos, count = [], 0, 0
        for m in re.finditer(r'(\t*)windowType = \{\n\t*name = "DA_province_medicine_panel"', t):
            tabs = m.group(1)
            xy = (490, 95) if count == 0 else (10, 142)     # province_window, then buildings_window
            blk = '\n'.join(ind((panel % xy).split('\n'), len(tabs)))
            out.append(t[pos:m.start()])
            out.append(f'{tabs}{PANEL_BEGIN}\n{blk}\n{tabs}{PANEL_END}\n')
            pos = m.start()
            count += 1
        if count != 2:
            raise SystemExit(f'expected 2 medicine panels in provinceview.gui, found {count}')
        out.append(t[pos:])
        return ''.join(out)
    rewrite('interface/provinceview.gui', provinceview)


def remove_duel_decisions(t):
    t = remove_block(t, r'(?m)^\tDA_fight_Lich = \{')
    return remove_block(t, r'(?m)^\tDA_fight_Dragon_Khugdihr = \{')


