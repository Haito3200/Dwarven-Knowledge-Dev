    'customizable_localization/DA_Legendary_Encounter_custom_loc.txt': gen_custom_loc,
    'events/DA_Legendary_Encounter_events.txt': gen_events,
    'interface/DA_Legendary_Encounter.gfx': gen_gfx,
    'DA_Legendary_Encounter_tester.txt': gen_tester,
    'localisation/DA_Legendary_Encounter_l_english.yml': gen_loc,     # last: the others fill LOC
}


def build_all():
    """Returns {relative path: text}. Also used by the check script."""
    LOC.clear()
    return {rel: fn() for rel, fn in GENERATED.items()}


def main():
    global ROOT
    if len(sys.argv) < 2:
        raise SystemExit(__doc__)
    ROOT = sys.argv[1]
    files = build_all()
    for rel, text in files.items():
        text.encode('utf-8' if rel.endswith('.yml') else 'latin-1')
        write(rel, text)
    patch_existing()


if __name__ == '__main__':
    main()
