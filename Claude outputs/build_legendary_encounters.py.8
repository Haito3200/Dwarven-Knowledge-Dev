def cg(kind, name, lines):
    return B(kind, [f'name = {name}'] + lines) + ['']


OWNED = 'owned_by = FROM'
FIGHTER = 'NOT = { ' + V('talk_only') + ' = yes }'     # a legend with a fight
TALKER = V('talk_only') + ' = yes'
ENGAGED = FLAG('engaged')
IDLE = NOFLAG('engaged')


def gen_custom_gui():
    o = [HEADER.rstrip(), '# Province view: ROOT is the selected province, FROM the viewing country. Only the owner sees any of it.', '']

    # entry button
    o += cg('custom_button', 'DA_Legendary_Encounter_Province_Button', [
        'tooltip = DA_Legendary_Encounter_Province_Button_tt',
        'potential = {', f'\t{OWNED}', f'\t{V("province_has_legend")} = yes', '}',
        f'trigger = {{ {OWNED} }}',
        'effect = {'] + ind(B('FROM', [f'clr_country_flag = {f}' for f in OTHER_PANELS])
                        + B('if', ['limit = { ' + FLAG('open') + ' }', CLRF('open')])
                        + B('else', [SETF('open')] + B('hidden_effect', IF([NOFLAG('seen'), V('ruler_can_lead') + ' = yes'], [SETF('ruler_leads')])
                                                      + [SETF('seen'), f'{V("refresh")} = yes']))) + ['}'])
    L('DA_Legendary_Encounter_Province_Button_tt', '§YLegendary Encounter§!\nSomething old and dangerous lives in this province. '
      'Open the window to see what we know of it and what we can do about it.')

    # The window belongs to the province: it is open where it was opened, and hides while another province panel is up.
    panel_pot = ['potential = {', f'\t{OWNED}', f'\t{V("province_has_legend")} = yes', '\t' + FLAG('open'),
                 '\tFROM = { ' + ' '.join(f'NOT = {{ has_country_flag = {f} }}' for f in OTHER_PANELS) + ' }', '}']
    o += cg('custom_window', 'DA_province_legendary_encounter_panel', panel_pot)
    o += cg('custom_button', V('close'), ['tooltip = DA_province_panel_close_tt', 'potential = { always = yes }', 'trigger = { always = yes }',
                                         f'effect = {{ {CLRF("open")} }}'])

    # banner, bars
    frames = [f'frame = {{ number = {i} trigger = {{ {IS(l)} }} }}' for i, l in enumerate(R.LEGENDS, 1)]
    o += cg('custom_icon', V('banner'), ['potential = { always = yes }'] + frames)

    def bar(name, var, pot):
        fr = []
        for f in range(BAR_FRAMES, 1, -1):
            fr.append(f'frame = {{ number = {f} trigger = {{ check_variable = {{ which = {V(var)} value = {num((f - 1.5) * 100 / (BAR_FRAMES - 1))} }} }} }}')
        fr.append('frame = { number = 1 trigger = { always = yes } }')
        return cg('custom_icon', V(name), [f'potential = {{ {pot} }}'] + fr)

    o += bar('bar_hp', 'hp_pct', FIGHTER)
    o += bar('bar_ward', 'ward_pct', V('has_ward') + ' = yes')
    o += bar('bar_resolve', 'resolve_pct', FIGHTER)

    def tb(name, pot='always = yes', tt=None):
        return cg('custom_text_box', V(name), [f'potential = {{ {pot} }}'] + ([f'tooltip = {V(name)}_tt'] if tt else []))

    o += tb('name') + tb('subtitle') + tb('round', ENGAGED) + tb('hp_label', FIGHTER) + tb('hp_value', FIGHTER) + tb('ward_label', V('has_ward') + ' = yes')
    o += tb('ward_value', V('has_ward') + ' = yes') + tb('traits', FIGHTER, tt=True) + tb('army', FIGHTER, tt=True)
    o += tb('resolve_label', FIGHTER) + tb('resolve_value', FIGHTER, tt=True)
    o += tb('guest_traits', TALKER, tt=True) + tb('guest_a', TALKER) + tb('guest_b', TALKER)
    o += tb('magic', FIGHTER, tt=True) + tb('ruler_label', FIGHTER) + tb('status', IDLE) + tb('next', ENGAGED, tt=True) + tb('report', ENGAGED)
    o += tb('spell_label', ENGAGED)
    for b in ('scout', 'contain', 'parley', 'engage'):
        o += tb(b + '_text', IDLE)
    for od in R.ORDER_IDS + ['withdraw']:
        o += tb(od + '_text', ENGAGED)

    o += cg('custom_button', V('recount'), [f'tooltip = {V("recount")}_tt', f'potential = {{ {FIGHTER} }}', f'trigger = {{ {OWNED} }}',
                                           f'effect = {{ hidden_effect = {{ {V("refresh")} = yes }} }}'])
    L(V('recount_tt'), '§YCount again§!\nThe numbers in this window are taken when it is opened and after every round. Press this after moving regiments in or out.')

    # the ruler in person
    o += cg('custom_button', V('ruler_toggle'), [
        f'tooltip = {V("ruler_toggle")}_tt', f'potential = {{ {FIGHTER} }}',
        'trigger = {', f'\t{OWNED}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("not_engaged_tt")} {IDLE} }}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("ruler_can_lead_tt")} {V("ruler_can_lead")} = yes }}', '}',
        'effect = {'] + ind(B('if', ['limit = { ' + FLAG('ruler_leads') + ' }', CLRF('ruler_leads')]) + B('else', [SETF('ruler_leads')])
                        + [f'hidden_effect = {{ {V("refresh")} = yes }}']) + ['}',
        'frame = { number = 2 trigger = { ' + FLAG('ruler_leads') + ' } }', 'frame = { number = 1 trigger = { always = yes } }'])

    # idle buttons
    o += cg('custom_button', V('scout'), [
        f'tooltip = {V("scout")}_tt', f'potential = {{ {IDLE} }}',
        'trigger = {', f'\t{OWNED}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("unlocked_tt")} {V("unlocked")} = yes }}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("can_be_fought_tt")} {FIGHTER} }}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("not_scouted_tt")} {NOFLAG("scouting")} {NOFLAG("weakness_given")} }}',
        f'\towner = {{ treasury = {R.SCOUT_COST} }}', '}',
        f'effect = {{ {V("scout")} = yes }}'])
    contain_cost = []
    for l in R.FIGHTS:
        for k, cost in enumerate(l.contain_cost):
            cond = [IS(l), GE('contain_n', k)] + ([LT('contain_n', k + 1)] if k < len(l.contain_cost) - 1 else [])
            contain_cost += ind(B('if', ['limit = { ' + ' '.join(cond) + ' }', f'owner = {{ treasury = {cost} }}']))
    refuse = ['AND = { %s NOT = { %s } }' % (IS(l), l.contain_if) for l in R.FIGHTS if l.contain_cost and l.contain_if]  # DA_EL
    o += cg('custom_button', V('contain'), [
        f'tooltip = {V("contain")}_tt', f'potential = {{ {IDLE} }}',
        'trigger = {', f'\t{OWNED}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("unlocked_tt")} {V("unlocked")} = yes }}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("can_be_contained_tt")} {V("can_be_contained")} = yes }}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("not_contained_tt")} NOT = {{ {V("contained")} = yes }} }}']
        + ([f'\tcustom_trigger_tooltip = {{ tooltip = {V("contain_refused_tt")} NOT = {{ OR = {{ {" ".join(refuse)} }} }} }}']
           if refuse else []) + contain_cost + ['}',   # DA_EL: whose magic can hold it (le_rules contain_if)
        f'effect = {{ {V("contain")} = yes }}'])
    deaf = [IS(l) for l in R.LEGENDS if not l.parley_event]
    deaf += ['AND = { %s NOT = { %s } }' % (IS(l), l.parley_if) for l in R.LEGENDS if l.parley_event and l.parley_if]  # DA_KB
    talk = []
    for l in R.LEGENDS:
        if l.parley_event:
            talk += IF(IS(l), [f'owner = {{ country_event = {{ id = {l.parley_event} }} }}'])
    o += cg('custom_button', V('parley'), [
        f'tooltip = {V("parley")}_tt', f'potential = {{ {IDLE} }}',
        'trigger = {', f'\t{OWNED}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("unlocked_tt")} {V("unlocked")} = yes }}']
        + ([f'\tcustom_trigger_tooltip = {{ tooltip = {V("parley_refused_tt")} NOT = {{ OR = {{ {" ".join(deaf)} }} }} }}'] if deaf else [])
        + ['}', 'effect = {'] + ind(talk) + ['}'])
    o += cg('custom_button', V('engage'), [
        f'tooltip = {V("engage")}_tt', f'potential = {{ {IDLE} }}',
        'trigger = {', f'\t{OWNED}', '\tcontrolled_by = FROM',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("unlocked_tt")} {V("unlocked")} = yes }}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("can_be_fought_tt")} {FIGHTER} }}',
        f'\tcustom_trigger_tooltip = {{ tooltip = {V("not_regrouping_tt")} NOT = {{ has_province_modifier = {V("regroup")} }} }}',
        f'\tcustom_trigger_tooltip = {{', f'\t\ttooltip = {V("someone_fights_tt")}',
        f'\t\tOR = {{ {FLAG("ruler_leads")} num_of_units_in_province = {{ who = FROM amount = 1 }} }}', '\t}', '}',
        f'effect = {{ hidden_effect = {{ {V("engage")} = yes }} }}'])

    # spells
    for i, s in enumerate(R.SCHOOLS):
        others = [CLRF('sel_' + x) for x in R.SCHOOLS if x != s]
        deaf_to = [l for l in R.FIGHTS if s in l.immune]   # DA_EL
        ready = f'{V("school_ready")} = {{ school = {s} }}' + (
            f' NOT = {{ OR = {{ {" ".join(IS(l) for l in deaf_to)} }} }}' if deaf_to else '')
        o += cg('custom_button', V('spell_' + s), [
            f'tooltip = {V("spell_" + s)}_tt', f'potential = {{ {ENGAGED} }}',
            'trigger = {', f'\t{OWNED}',
            f'\tcustom_trigger_tooltip = {{ tooltip = {V("not_stale_tt")} NOT = {{ {V("stale")} = yes }} }}',
            f'\tcustom_trigger_tooltip = {{ tooltip = {V("school_ready_tt")} {V("school_ready")} = {{ school = {s} }} }}']
            + ([f'\tcustom_trigger_tooltip = {{ tooltip = {V("immune_tt")} NOT = {{ OR = {{ {" ".join(IS(l) for l in deaf_to)} }} }} }}']
               if deaf_to else []) + ['}',   # DA_EL: a school wasted on this legend (le_rules immune)
            'effect = {'] + ind(others + B('if', ['limit = { ' + FLAG('sel_' + s) + ' }', CLRF('sel_' + s)]) + B('else', [SETF('sel_' + s)])) + ['}',
            'frame = { number = 2 trigger = { ' + FLAG('sel_' + s) + ' } }',
            'frame = { number = 3 trigger = { ' + FLAG('cd_' + s) + ' } }',
            f'frame = {{ number = 1 trigger = {{ {ready} }} }}',
            'frame = { number = 4 trigger = { always = yes } }'])

    # orders
    for od in R.ORDER_IDS:
        o += cg('custom_button', V('order_' + od), [
            f'tooltip = {V("order_" + od)}_tt', f'potential = {{ {ENGAGED} }}',
            'trigger = {', f'\t{OWNED}',
            f'\tcustom_trigger_tooltip = {{ tooltip = {V("not_stale_tt")} NOT = {{ {V("stale")} = yes }} }}', '}',
            f'effect = {{ hidden_effect = {{ {SETF("order_" + od)} province_event = {{ id = {NS}.2 }} }} }}'])
    o += cg('custom_button', V('withdraw'), [
        f'tooltip = {V("withdraw")}_tt', f'potential = {{ {ENGAGED} }}', f'trigger = {{ {OWNED} }}',
        f'effect = {{ hidden_effect = {{ {V("count_army")} = yes {V("end_withdraw")} = yes }} }}'])
    return text_block(o)


# ---------------------------------------------------------------------------------------------
# Customizable localisation and the window's texts
# ---------------------------------------------------------------------------------------------
def defined_text(name, texts):
    body = [f'name = {name}', 'random = no']
    for key, trig in texts:
        if trig is None:
            body.append(f'text = {{ localisation_key = {key} }}')
        else:
            body += B('text', [f'localisation_key = {key}'] + B('trigger', trig if isinstance(trig, list) else [trig]))
    return B('defined_text', body) + ['']


def mult(x):
    return 'x' + num(x)


def gen_custom_loc():
    o = [HEADER.rstrip(), '# Province scope: ROOT is the legend\'s province.', '']

    def per_legend(getter, key_fn, text_fn):
        entries = []
        for l in R.LEGENDS:
            L(key_fn(l), text_fn(l))
            entries.append((key_fn(l), IS(l)))
        entries.append((V('blank'), None))
        return defined_text(getter, entries)

    L(V('blank'), '')
