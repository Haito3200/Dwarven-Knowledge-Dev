    L(V('ward_label'), 'Ward')
    L(V('ward_value'), '§Y[Root.DA_LE_ward_show.GetValue]§!')
    L(V('resolve_label'), 'Resolve')
    L(V('resolve_value'), '§Y[Root.DA_LE_resolve_show.GetValue]§! / [Root.DA_LE_resolve_max_show.GetValue]')
    L(V('resolve_value_tt'),
      '§YResolve§! is how much more our side can take: §Y10§! for every regiment in the fight, raised by our morale, plus our '
