def gui(kind, **kw):
    lines = [f'{kind} = {{']
    for k, v in kw.items():
        if k == 'position':
            v = f'{{ x = {v[0]} y = {v[1]} }}'
        elif isinstance(v, str) and k in ('name', 'spriteType', 'quadTextureSprite', 'text', 'font'):
            v = f'"{v}"'
        lines.append(f'\t{k} = {v}')
    lines.append('}')
    return '\n'.join(lines)


def txt(name, x, y, w, h, font='garamond_12', fmt='left', scripted=True, **kw):
    d = dict(name=V(name), position=(x, y), font=font, text=V(name), maxWidth=w, maxHeight=h, format=fmt)
    if scripted:
        d['scripted'] = 'yes'
    d.update(kw)
    return gui('instantTextBoxType', **d)


