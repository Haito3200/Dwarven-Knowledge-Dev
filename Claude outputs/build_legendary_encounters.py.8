            for i, mv in enumerate(l.moves, 1):
                om, oa, base_in = R.ORDERS[od]
                parts = [f'our losses {mult(mv.might * mv.in_mult[od])} its usual harm']
                out = mv.out_mult[od] * (mv.fear if (mv.fear != 1.0 and od not in mv.fear_exempt_orders) else 1.0)
                parts.append(f'our damage {mult(out)}' if abs(out - 1) > 1e-9 else 'our damage as usual')
