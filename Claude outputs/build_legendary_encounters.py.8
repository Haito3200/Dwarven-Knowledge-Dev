    L(V('rep_ours_ward'), 'We dealt §G[Root.DA_LE_rep_dealt.GetValue]§! damage, §Y[Root.DA_LE_rep_warded.GetValue]§! of it spent on its ward.')
    L(V('rep_ours_rot'), 'We dealt §G[Root.DA_LE_rep_dealt.GetValue]§! damage, and withering took §G[Root.DA_LE_rep_rot.GetValue]§! more.')
    L(V('rep_ours_both'), 'We dealt §G[Root.DA_LE_rep_dealt.GetValue]§! damage (§Y[Root.DA_LE_rep_warded.GetValue]§! on its ward); '
