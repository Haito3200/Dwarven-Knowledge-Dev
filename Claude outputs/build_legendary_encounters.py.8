LOC = {}


def L(key, text):
    if key in LOC and LOC[key] != text:
        raise SystemExit(f'conflicting localisation for {key}')
    LOC[key] = text


# ---------------------------------------------------------------------------------------------
# Small script-writing helpers. Everything is a list of lines.
# ---------------------------------------------------------------------------------------------
def num(v):
    s = ('%.3f' % v).rstrip('0').rstrip('.')
    return s if s not in ('-0', '') else '0'


def V(name):
    return 'DA_LE_' + name


def ind(lines, n=1):
    return ['\t' * n + l if l else l for l in lines]


def B(head, body):
    return [head + ' = {'] + ind(body) + ['}']


def IF(limit, body):
    lim = limit if isinstance(limit, list) else [limit]
    if len(lim) == 1 and len(lim[0]) < 110:
        return B('if', ['limit = { ' + lim[0] + ' }'] + body)
    return B('if', B('limit', lim) + body)


def _op(op, var, x):
    if isinstance(x, str):
        return f'{op} = {{ which = {V(var)} which = {V(x)} }}'
    return f'{op} = {{ which = {V(var)} value = {num(x)} }}'


def SET(var, x): return _op('set_variable', var, x)
def ADD(var, x): return _op('change_variable', var, x)
def SUB(var, x): return _op('subtract_variable', var, x)
def MUL(var, x): return _op('multiply_variable', var, x)
def DIV(var, x): return _op('divide_variable', var, x)
def GE(var, x): return _op('check_variable', var, x)
def LT(var, x): return 'NOT = { ' + GE(var, x) + ' }'
def FLAG(f): return f'has_province_flag = {V(f)}'
def NOFLAG(f): return 'NOT = { ' + FLAG(f) + ' }'
def SETF(f): return f'set_province_flag = {V(f)}'
def CLRF(f): return f'clr_province_flag = {V(f)}'
def IS(l): return f'{V("is_" + l.id)} = yes'


def UNLOCK(l):
    """What opens the way to a legend, in the scope of its province."""
    return l.unlock_trigger if l.unlock_trigger else f'owner = {{ has_country_flag = {l.unlock_flag} }}'


def ANY(conds):
    return B('OR', conds) if conds else ['always = no']


def FLOOR(var):
    """Whole numbers for display: three decimals are all a variable keeps."""
    return [DIV(var, 1000), MUL(var, 1000)]


def SHOW(src):
    return [SET(src + '_show', src)] + FLOOR(src + '_show')


def text_block(lines):
    return '\n'.join(lines) + '\n'


# ---------------------------------------------------------------------------------------------
# Scripted triggers
# ---------------------------------------------------------------------------------------------
def gen_triggers():
    out = [HEADER.rstrip(), '# Province scope unless the name says otherwise. "owner" is the only country ever involved.', '']
    for l in R.LEGENDS:
        out += B(V('is_' + l.id), l.present.split('\n')) + ['']
    out += B(V('province_has_legend'), B('OR', [IS(l) for l in R.LEGENDS])) + ['']
    out += B(V('unlocked'), B('OR', [f'AND = {{ {IS(l)} {UNLOCK(l)} }}' for l in R.LEGENDS])) + ['']
    warded = [IS(l) for l in R.FIGHTS if l.ward_max > 0]
    out += B(V('has_ward'), B('OR', warded) if warded else ['always = no']) + ['']
    # a weakness is learned from our scouts, or given by a find (DA_LE_weakness_given: the Wardwrights' Cells of Verkal Kozenad)
    out += B(V('weakness_known'), B('OR', [f'had_province_flag = {{ flag = {V("scouting")} days = {R.SCOUT_DAYS} }}', FLAG('weakness_given')])) + ['']
    out += B(V('scouts_out'), [FLAG('scouting'), f'NOT = {{ had_province_flag = {{ flag = {V("scouting")} days = {R.SCOUT_DAYS} }} }}',
                               NOFLAG('weakness_given')]) + ['']
    out += B(V('contained'), ANY([f'has_province_modifier = {V("contained_" + l.id)}' for l in R.FIGHTS if l.contain_cost])) + ['']
    out += B(V('can_be_contained'), ANY([IS(l) for l in R.FIGHTS if l.contain_cost])) + ['']
    out += ['# One fight only: if we do not kill it, it is gone.']
    out += B(V('flees'), ANY([IS(l) for l in R.FIGHTS if l.flees])) + ['']
    out += ['# It can only be spoken to: no fight, no scouts, nothing to contain.']
    out += B(V('talk_only'), ANY([IS(l) for l in R.LEGENDS if l.talk_only])) + ['']
    out += B(V('stale'), [f'had_province_flag = {{ flag = {V("engaged")} days = {R.STALE_DAYS} }}']) + ['']
    out += B(V('has_battle_mages'), B('owner', [
        'OR = { has_estate = estate_mages has_country_flag = has_mages_estate_equiv }',
        'NOT = { has_country_flag = banned_magic }',
        'NOT = { has_country_flag = LF_mages_banned }',
        'NOT = { has_country_modifier = mages_strike }',
        'NOT = { has_country_modifier = block_magic_temp_modifier }'])) + ['']
    out += B(V('ruler_can_lead'), B('owner', [
        'OR = { ruler_has_personality = mage_personality ruler_has_personality = ancestor_mage_personality }',
        'has_regency = no',
        'NOT = { has_ruler_modifier = bd_wounded_ruler }',
        'NOT = { has_country_flag = banned_magic }'])) + ['']
    out += ['# A school somebody on our side can cast this round.']
    out += B(V('school_ready'), [
        f'NOT = {{ has_province_flag = {V("cd_$school$")} }}',
    ] + B('OR', B('AND', [
        FLAG('ruler_leads'),
        'owner = { OR = { has_ruler_flag = $school$_1 has_ruler_flag = $school$_2 has_ruler_flag = $school$_3 } }',
    ]) + B('AND', [
        V('has_battle_mages') + ' = yes',
        'owner = {',
        '\tOR = { has_country_flag = $school$_1 has_country_flag = $school$_2 has_country_flag = $school$_3 }',
        f'\tcheck_variable = {{ which = currentMana value = {R.ESTATE_MANA[1]} }}',
        '}',
    ]))) + ['']
    out += ['# Country scope: a legend this country could still deal with.']
    out += B('DA_LE_country_has_legend', B('any_owned_province', [V('province_has_legend') + ' = yes'])) + ['']
    return text_block(out)


# ---------------------------------------------------------------------------------------------
# Scripted effects
# ---------------------------------------------------------------------------------------------
def gen_effects():
    o = [HEADER.rstrip(),
         '# Province scope (the legend\'s province). The owner is reached with "owner"; "owner = { PREV = { ... who = PREV } }"',
         '# is how a unit trigger or effect names him. Dice are only ever rolled inside the events of',
         f'# {NS}, because random rolls made from a button always give the same result.',
         '# Nothing here uses else / else_if: every branch is an "if" whose condition was fixed beforehand.', '']

    # --- counting the army -------------------------------------------------------------------
    body = [SET('inf', 0), SET('cav', 0), SET('art', 0)]
    ladder = []
    for kind, typ in (('inf', 'infantry'), ('cav', 'cavalry'), ('art', 'artillery')):
        for k in range(1, R.CAP[kind] + 1):
            ladder += IF(f'num_of_units_in_province = {{ who = PREV type = {typ} amount = {k} }}', [SET(kind, k)])
    body += B('owner', B('PREV', ladder))
    for var, mod in (('q_disc', 'discipline'), ('q_inf', 'infantry_power'), ('q_cav', 'cavalry_power'),
                     ('q_art', 'artillery_power'), ('q_morale', 'land_morale')):
        body.append(f'export_to_variable = {{ which = {V(var)} value = modifier:{mod} who = owner }}')
    # Warforged regiments: how many the country fields, and the power of its current designs
    for var, trig in (('wfn_inf', 'num_of_musketeers'), ('wfn_cav', 'num_of_qizilbash'), ('wfn_art', 'num_of_streltsy')):
        body.append(f'export_to_variable = {{ which = {V(var)} value = trigger_value:{trig} who = owner }}')
    for kind, code in (('inf', 'INFAN'), ('cav', 'CAVAL'), ('art', 'ARTIL')):
        body += [f'owner = {{ set_variable = {{ which = {V("wfp_" + kind)} which = DA_power_TOTAL_{code} }} }}',
                 f'set_variable = {{ which = {V("wfp_" + kind)} which = owner }}']
    body += [SET('q_tech', 1)]
    for t in range(1, R.MAX_TECH + 1):
        body += IF(f'owner = {{ mil_tech = {t} }}', [SET('q_tech', 1 + R.TECH_STEP * t)])
    body += [SET('tmp', 1), ADD('tmp', 'q_disc'), MUL('q_tech', 'tmp')]
    for kind in ('inf', 'cav', 'art'):
        body += [
            f'# {kind}: regiments x {num(R.UNIT_POWER[kind])} x (1 + combat ability + Warforged share x design power)',
            SET('share', 0)]
        body += IF(GE(kind, 1), [SET('share', 'wfn_' + kind), DIV('share', kind)])
        body += IF(GE('share', 1), [SET('share', 1)])
        body += [MUL('share', 'wfp_' + kind), SET('p_' + kind, 1), ADD('p_' + kind, 'q_' + kind), ADD('p_' + kind, 'share'),
                 MUL('p_' + kind, kind), MUL('p_' + kind, R.UNIT_POWER[kind])]
    body += [SET('s_melee', 'p_inf'), ADD('s_melee', 'p_cav'), MUL('s_melee', 'q_tech'),
             SET('s_art', 'p_art'), MUL('s_art', 'q_tech'),
             SET('n', 'inf'), ADD('n', 'cav'), ADD('n', 'art')]
    for b in R.ARMY_BONUS:   # DA_GN: a bonus of another feature against some legends (le_rules.ARMY_BONUS)
        body += IF(ANY([IS(R.LEGEND[i]) for i in b['legends']]) + [f'owner = {{ has_country_flag = {b["flag"]} }}'],
                   [f'# {b["name"]}', MUL('s_melee', b['mult']), MUL('s_art', b['mult'])])
    body += [SET('strength', 's_melee'), ADD('strength', 's_art')]
    body += SHOW('strength')
    o += B(V('count_army'), body) + ['']

    # --- resolve ------------------------------------------------------------------------------
    body = [SET('resolve_max', 'n'), MUL('resolve_max', R.RESOLVE_PER_REGIMENT), SET('tmp', 1), ADD('tmp', 'q_morale'),
            MUL('resolve_max', 'tmp')]
    ruler = [ADD('resolve_max', R.RULER_RESOLVE)]
    for k in range(1, 7):
        ruler += IF(f'owner = {{ adm = {k} NOT = {{ adm = {k + 1} }} }}', [ADD('resolve_max', R.RULER_RESOLVE_PER_ADM * k)])
    ruler += [SET('levels', 0)]
    for s in R.SCHOOLS:
        ruler += [SET('tmp', 0)]
        for k in (1, 2, 3):
            ruler += IF(f'owner = {{ has_ruler_flag = {s}_{k} }}', [SET('tmp', k)])
        ruler += [ADD('levels', 'tmp')]
    ruler += [SET('tmp', 'levels'), MUL('tmp', R.RULER_RESOLVE_PER_LEVEL), ADD('resolve_max', 'tmp')]
    body += IF(FLAG('ruler_leads'), ruler)
    o += B(V('compute_resolve_max'), body) + ['']

    # --- the legend's numbers -----------------------------------------------------------------
    body = []
    for l in R.FIGHTS:
        body += IF(IS(l), [SET('hp_max', l.hp), SET('hp_start', l.hp * l.start_hp), SET('ward_start', l.ward), SET('ward_max', l.ward_max), SET('might', l.might),
                           SET('armor', l.armor), SET('resist', l.spell_resist), SET('necro', l.necro_mult),
                           SET('enrage_at', l.hp * l.enrage_below), SET('enrage', l.enrage), SET('revive', l.hp * l.revive)])
    o += B(V('load_legend'), body) + ['']

    body = [SET('mv_might', 1), SET('mv_in', 1), SET('mv_out', 1), SET('mv_gain', 0), SET('mv_heal', 0), SET('mv_fear', 1)]
    for l in R.FIGHTS:
        per = []
        for i, mv in enumerate(l.moves, 1):
            blk = [f'# {mv.name}', SET('mv_might', mv.might)]
            for od in R.ORDER_IDS:
                ob = [SET('mv_in', mv.in_mult[od]), SET('mv_out', mv.out_mult[od])]
                if mv.ward_gain:
                    ob.append(SET('mv_gain', mv.ward_gain * mv.ward_gain_order.get(od, 1.0)))
                if mv.heal and od not in mv.heal_blocked_orders:
                    ob.append(SET('mv_heal', mv.heal))
                if mv.fear != 1.0 and od not in mv.fear_exempt_orders:
                    ob.append(SET('mv_fear', mv.fear))
                blk += IF(FLAG('order_' + od), ob)
            if mv.ward_gain_blocked_by:
                blk += IF(FLAG('cast_' + mv.ward_gain_blocked_by), [SET('mv_gain', 0)])
            if mv.heal_blocked_by:
                blk += IF(FLAG('cast_' + mv.heal_blocked_by), [SET('mv_heal', 0)])
            per += IF(FLAG(f'move_{i}'), blk)
        body += IF(IS(l), per)
    o += ['# What the announced move does against the order we gave (and the spell we cast).']
    o += B(V('load_move'), body) + ['']

    # --- dice and the next move (events only) -------------------------------------------------
    o += B(V('roll_die'), B('random_list', [f'1 = {{ set_variable = {{ which = {V("die_$die$")} value = {k} }} }}' for k in range(1, 21)])) + ['']
    body = [CLRF(f'next_{i}') for i in range(1, 5)]
    for l in R.FIGHTS:
        per = []
        idx = range(1, len(l.moves) + 1)
        none = ' '.join(NOFLAG(f'move_{i}') for i in idx)
        per += IF(none, B('random_list', [f'{mv.weight} = {{ {SETF(f"next_{i}")} }}' for i, mv in enumerate(l.moves, 1)]))
        for cur in idx:
            per += IF(FLAG(f'move_{cur}'), B('random_list', [f'{mv.weight} = {{ {SETF(f"next_{i}")} }}'
                                                               for i, mv in enumerate(l.moves, 1) if i != cur]))
        body += IF(IS(l), per)
    body += [CLRF(f'move_{i}') for i in range(1, 5)]
    for i in range(1, 5):
        body += IF(FLAG(f'next_{i}'), [SETF(f'move_{i}'), CLRF(f'next_{i}')])
    o += ['# Never the same move twice in a row.']
    o += B(V('roll_move'), body) + ['']

    # --- who casts ----------------------------------------------------------------------------
    o += B(V('spell_value'), IF(f'is_variable_equal = {{ which = {V("lvl")} value = 1 }}', [SET('val', 0) .replace('value = 0', 'value = $l1$')])
           + IF(f'is_variable_equal = {{ which = {V("lvl")} value = 2 }}', [SET('val', 0).replace('value = 0', 'value = $l2$')])
           + IF(f'is_variable_equal = {{ which = {V("lvl")} value = 3 }}', [SET('val', 0).replace('value = 0', 'value = $l3$')])
           + [MUL('val', 'm')]) + ['']
    o += B(V('cap_val'), IF(f'check_variable = {{ which = {V("val")} value = $cap$ }}', [SET('val', 0).replace('value = 0', 'value = $cap$')])) + ['']

    body = [SET('r', 0), SET('e', 0)]
    rl = []
    for k in (1, 2, 3):
        rl += IF(f'owner = {{ has_ruler_flag = $school$_{k} }}', [SET('r', k)])
    body += IF(FLAG('ruler_leads'), rl)
    el = []
    for k in (1, 2, 3):
        el += IF(f'owner = {{ has_country_flag = $school$_{k} }}', [SET('e', k)])
    for k in (3, 2, 1):
        el += IF([f'is_variable_equal = {{ which = {V("e")} value = {k} }}',
                  f'NOT = {{ owner = {{ check_variable = {{ which = currentMana value = {R.ESTATE_MANA[k]} }} }} }}'], [SET('e', k - 1)])
    body += IF(V('has_battle_mages') + ' = yes', el)
    # the ruler casts unless the battle mages know the school two levels better
    body += [SET('tmp', 'r'), ADD('tmp', 2), CLRF('cast_ruler'), CLRF('cast_estate')]
    body += IF([GE('r', 1), LT('e', 'tmp')], [SETF('cast_ruler')])
    body += IF([GE('e', 1), NOFLAG('cast_ruler')], [SETF('cast_estate')])
    rb = [SET('lvl', 'r'), SET('m', 1)]
    for k in range(1, 7):
        rb += IF(f'owner = {{ mil = {k} NOT = {{ mil = {k + 1} }} }}', [ADD('m', R.RULER_POWER_PER_MIL * k)])
    rb += IF(V('has_battle_mages') + ' = yes', [ADD('m', R.CIRCLE_BONUS)])
    body += IF(FLAG('cast_ruler'), rb + [SETF('cast_$school$')])
    eb = [SET('lvl', 'e'), SET('m', R.ESTATE_MULT)]
    for k in (1, 2, 3):
        eb += IF(f'is_variable_equal = {{ which = {V("e")} value = {k} }}', [f'owner = {{ change_mana = {{ amount = -{R.ESTATE_MANA[k]} }} }}'])
    body += IF(FLAG('cast_estate'), eb + [SETF('cast_$school$')])
    o += ['# Sets DA_LE_lvl and DA_LE_m and the flag DA_LE_cast_<school>; the battle mages pay their mana here.']
    o += B(V('cast_school'), body) + ['']

    body = [SET('lvl', 0), SET('m', 0), CLRF('cast_ruler'), CLRF('cast_estate')] + [CLRF('cast_' + s) for s in R.SCHOOLS]
    for s in R.SCHOOLS:
        body += IF([FLAG('sel_' + s), NOFLAG('cd_' + s)], [f'{V("cast_school")} = {{ school = {s} }}'])
    o += B(V('pick_caster'), body) + ['']

    # --- one round ----------------------------------------------------------------------------
    sp = R.SPELLS

    def spell(school, key):
        a, b, c = sp[school][key]
        return f'{V("spell_value")} = {{ l1 = {num(a)} l2 = {num(b)} l3 = {num(c)} }}'

    def cap(v):
        return f'{V("cap_val")} = {{ cap = {num(v)} }}'

    rep_flags = ['rep_missed', 'rep_ambush', 'rep_revived', 'rep_healed', 'dead', 'will_revive', 'won', 'lost_fight', 'stalemate']
    body = [CLRF(f) for f in rep_flags]
    body += [f'{V("count_army")} = yes', f'{V("pick_caster")} = yes', f'{V("load_legend")} = yes', f'{V("load_move")} = yes', '']
    # dice
    for k, floor in zip((1, 2, 3), sp['divination']['floor']):
        body += IF([FLAG('cast_divination'), f'is_variable_equal = {{ which = {V("lvl")} value = {k} }}', LT('die_a', floor)], [SET('die_a', floor)])
    body += [SET('var_ours', 'die_a'), MUL('var_ours', 0.015), ADD('var_ours', 0.85),
             SET('var_theirs', 'die_b'), MUL('var_theirs', 0.015), ADD('var_theirs', 0.85), '', '# our blow']
    for od in R.ORDER_IDS:
        om, oa, _ = R.ORDERS[od]
        body += IF(FLAG('order_' + od), [SET('army', 's_melee'), MUL('army', om), SET('tmp', 's_art'), MUL('tmp', oa), ADD('army', 'tmp')])
    body += [MUL('army', 'mv_out')]
    body += IF(NOFLAG('cast_enchantment'), [MUL('army', 'mv_fear')])
    body += IF(FLAG('cast_enchantment'), [spell('enchantment', 'army'), cap(sp['enchantment']['army_cap']), ADD('val', 1), MUL('army', 'val')])
    body += IF(FLAG('cast_conjuration'), [spell('conjuration', 'flat'), ADD('army', 'val')])
    body += [MUL('army', 'var_ours')]
    body += IF(FLAG('cast_divination'), [spell('divination', 'aim'), ADD('val', 1), MUL('army', 'val')])
    body += IF(NOFLAG('cast_divination'), [SET('tmp', 1), SUB('tmp', 'armor'), MUL('army', 'tmp')])
    body += [SET('spell_dmg', 0)]
    body += IF(FLAG('cast_evocation'), [spell('evocation', 'damage'), SET('tmp', 1), SUB('tmp', 'resist'), MUL('val', 'tmp'), SET('spell_dmg', 'val')])
    body += [SET('vuln', 1), ADD('vuln', 'sunder')]
    body += IF(V('weakness_known') + ' = yes', [ADD('vuln', R.SCOUT_VULN)])
    body += [SET('total', 'army'), ADD('total', 'spell_dmg'), MUL('total', 'vuln'), SET('rep_dealt', 'total'), SET('rep_warded', 0), '']
    body += IF(FLAG('cast_divination'), [SUB('hp', 'total')])
    body += [SET('left', 'ward'), SUB('left', 'total'), '# left = what remains of the ward; below zero it is what goes through']
    body += IF([NOFLAG('cast_divination'), GE('left', 0)], [SET('rep_warded', 'total'), SET('ward', 'left')])
    body += IF([NOFLAG('cast_divination'), LT('left', 0)], [SET('rep_warded', 'ward'), SET('ward', 0), ADD('hp', 'left')])
    body += ['', '# lasting spells']
    body += IF(FLAG('cast_necromancy'), [spell('necromancy', 'rot'), MUL('val', 'necro'), SET('tmp', 1), SUB('tmp', 'resist'), MUL('val', 'tmp'),
                                         ADD('rot', 'val')] + IF(GE('rot', sp['necromancy']['rot_cap']), [SET('rot', sp['necromancy']['rot_cap'])]))
    body += [SUB('hp', 'rot'), SET('rep_rot', 'rot')]
    body += IF(FLAG('cast_transmutation'), [spell('transmutation', 'sunder'), ADD('sunder', 'val')]
               + IF(GE('sunder', sp['transmutation']['sunder_cap']), [SET('sunder', sp['transmutation']['sunder_cap'])]))
    body += ['', '# is it dead?']
    body += IF(LT('hp', 0.001), [SETF('dead')])
    body += IF([FLAG('dead'), GE('revive', 1), NOFLAG('revived'), f'NOT = {{ {V("weakness_known")} = yes }}'], [SETF('will_revive')])
    body += IF([FLAG('dead'), NOFLAG('will_revive')], [SET('hp', 0), SETF('won')])
    body += IF(FLAG('will_revive'), [SETF('revived'), SETF('rep_revived'), SET('hp', 'revive'), SET('ward', 0)])
    # its move
    mv = ['# its move']
    mv += IF(NOFLAG('rep_revived'), [ADD('ward', 'mv_gain')] + IF(GE('ward', 'ward_max'), [SET('ward', 'ward_max')])
             + IF(GE('mv_heal', 1), [ADD('hp', 'mv_heal'), SETF('rep_healed')] + IF(GE('hp', 'hp_max'), [SET('hp', 'hp_max')])))
    mv += [SET('incoming', 'might'), MUL('incoming', 'mv_might'), MUL('incoming', 'mv_in'), MUL('incoming', 'var_theirs')]
    mv += IF([GE('enrage_at', 1), LT('hp', 'enrage_at')], [MUL('incoming', 'enrage')])
    mv += IF(FLAG('cast_abjuration'), [spell('abjuration', 'block'), cap(sp['abjuration']['block_cap']), SET('tmp', 1), SUB('tmp', 'val'), MUL('incoming', 'tmp')])
    mv += IF(FLAG('cast_conjuration'), [spell('conjuration', 'screen'), cap(sp['conjuration']['screen_cap']), SET('tmp', 1), SUB('tmp', 'val'), MUL('incoming', 'tmp')])
    mv += IF(FLAG('cast_illusion'), [spell('illusion', 'miss'), cap(sp['illusion']['miss_cap']), SET('tmp', 'die_c'), MUL('tmp', 5)]
             + IF(GE('val', 'tmp'), [SET('incoming', 0), SETF('rep_missed')]))
    mv += IF(FLAG('ambush'), [SET('incoming', 0), CLRF('ambush'), SETF('rep_ambush')])
    mv += [SUB('resolve', 'incoming'), SET('rep_taken', 'incoming'), '', '# a school needs a round to settle before it can be cast again']
    mv += [CLRF('cd_' + s) for s in R.SCHOOLS]
    for s in R.SCHOOLS:
        mv += IF(FLAG('cast_' + s), [SETF('cd_' + s)])
    mv += IF(LT('resolve', 0.001), [SET('resolve', 0), SETF('lost_fight')])
    mv += IF([NOFLAG('lost_fight'), GE('round', R.MAX_ROUNDS)], [SETF('stalemate')])
    mv += IF([NOFLAG('lost_fight'), NOFLAG('stalemate')], [ADD('round', 1), f'{V("roll_move")} = yes'])
    body += IF(NOFLAG('won'), mv)
    body += ['', SETF('rep_any')] + [CLRF('sel_' + s) for s in R.SCHOOLS] + [CLRF('order_' + od) for od in R.ORDER_IDS]
    body += FLOOR('rep_dealt') + FLOOR('rep_warded') + FLOOR('rep_rot') + FLOOR('rep_taken')
    body += [f'{V("update_show")} = yes']
    body += IF(FLAG('won'), [f'{V("end_victory")} = yes'])
    body += IF(FLAG('lost_fight'), [f'{V("end_defeat")} = yes'])
    body += IF(FLAG('stalemate'), [f'{V("end_withdraw")} = yes'])
    o += ['# One round. Called from the round event after the three dice are rolled; the order is the flag DA_LE_order_<id>.',
          '# check_legendary_encounters.py runs this against resolve_round() in le_rules.py.']
    o += B(V('resolve_round'), body) + ['']

    # --- display ------------------------------------------------------------------------------
    body = SHOW('hp') + SHOW('ward') + SHOW('resolve') + SHOW('resolve_max') + SHOW('hp_max')
    for var, mx in (('hp', 'hp_max'), ('resolve', 'resolve_max'), ('ward', 'ward_max')):
        body += [SET(var + '_pct', 0)]
        body += IF(GE(mx, 1), [SET(var + '_pct', var), MUL(var + '_pct', 100), DIV(var + '_pct', mx)])
    body += ['set_variable = { which = currentMana which = owner }', f'set_variable = {{ which = {V("mana_show")} which = currentMana }}'] + FLOOR('mana_show')
    o += B(V('update_show'), body) + ['']

    # --- opening the window, engaging -----------------------------------------------------------
    body = [f'{V("load_legend")} = yes']
    body += IF(NOFLAG('hp_init'), [SET('hp', 'hp_start'), SETF('hp_init')])
    body += IF([FLAG('ruler_leads'), f'NOT = {{ {V("ruler_can_lead")} = yes }}', NOFLAG('engaged')], [CLRF('ruler_leads')])
    body += [f'{V("count_army")} = yes']
    body += IF(NOFLAG('engaged'), [SET('ward', 'ward_start'), f'{V("compute_resolve_max")} = yes', SET('resolve', 'resolve_max')])
    body += [f'{V("update_show")} = yes']
    o += ['# Brings the numbers in the window up to date. Safe to call at any time.']
    o += B(V('refresh'), body) + ['']

    body = [f'remove_province_modifier = {V("contained_" + l.id)}' for l in R.FIGHTS if l.contain_cost]
    body += [CLRF(f) for f in ['revived', 'ambush', 'rep_any', 'rep_missed', 'rep_ambush', 'rep_revived', 'rep_healed',
                                'won', 'lost_fight', 'stalemate', 'dead', 'will_revive']]
    body += [CLRF(f'move_{i}') for i in range(1, 5)] + [CLRF('sel_' + s) for s in R.SCHOOLS] + [CLRF('cd_' + s) for s in R.SCHOOLS]
    body += [CLRF('order_' + od) for od in R.ORDER_IDS]
    body += [SET('round', 1), SET('rot', 0), SET('sunder', 0), f'{V("refresh")} = yes']
    for l in R.FIGHTS:
        if l.ambush:
            body += IF([IS(l), V('weakness_known') + ' = yes'], [SETF('ambush')])
    body += [SETF('engaged'), f'province_event = {{ id = {NS}.1 }}']
    o += B(V('engage'), body) + ['']

    # --- the end of a fight ---------------------------------------------------------------------
    body = [SET('lost', 0)]
    body += IF(GE('resolve_max', 1), [SET('tmp', 'resolve'), DIV('tmp', 'resolve_max'), SET('lost', 1), SUB('lost', 'tmp'), MUL('lost', 'n'),
                                      SET('tmp', 0).replace('value = 0', 'value = $share$'), MUL('lost', 'tmp')] + FLOOR('lost'))
    body += [SET('last_lost', 'lost'), SET('last_rounds', 'round'), CLRF('killed')]
    kill = []
    for kind, typ in (('inf', 'infantry'), ('cav', 'cavalry'), ('art', 'artillery')):
        kill += IF([NOFLAG('killed'), GE(kind, 1)], [f'kill_units = {{ who = PREV type = {typ} amount = 1 }}', SUB(kind, 1), SETF('killed')])
    kill += [CLRF('killed'), SUB('lost', 1)]
    body += B('owner', B('PREV', B('while', ['limit = { ' + GE('lost', 1) + ' }'] + kill)))
    body += ['owner = {', f'\tset_variable = {{ which = {V("last_lost")} which = PREV }}', f'\tset_variable = {{ which = {V("last_rounds")} which = PREV }}', '}']
    o += ['# Regiments lost = regiments x share of resolve lost x $share$, infantry first.']
    o += B(V('casualties'), body) + ['']

    stop = [CLRF(f) for f in ['engaged', 'revived', 'ambush', 'rep_any', 'rep_missed', 'rep_ambush', 'rep_revived', 'rep_healed',
                               'won', 'lost_fight', 'stalemate', 'dead', 'will_revive', 'cast_ruler', 'cast_estate']]
    stop += [CLRF(f'move_{i}') for i in range(1, 5)] + [CLRF('sel_' + s) for s in R.SCHOOLS] + [CLRF('cd_' + s) for s in R.SCHOOLS]
    stop += [CLRF('cast_' + s) for s in R.SCHOOLS] + [CLRF('order_' + od) for od in R.ORDER_IDS]
    o += B(V('stop_fight'), stop) + ['']

    keep = [SET('tmp', 'hp_max'), SUB('tmp', 'hp'), MUL('tmp', 1 - R.KEEP_WOUNDS), ADD('hp', 'tmp')]
    o += ['# A legend that drives us off keeps part of its wounds.']
    o += B(V('keep_wounds'), keep) + ['']

    body = [f'{V("casualties")} = {{ share = {num(R.LOSS_SHARE["victory"])} }}']
    forget = [CLRF(f) for f in ['hp_init', 'scouting', 'weakness_given', 'ruler_leads', 'seen', 'open']] + [SET('contain_n', 0)]
    for i, l in enumerate(R.FIGHTS, 1):
        body += IF(IS(l), [f'owner = {{ country_event = {{ id = {l.victory_event} }} }}']
                   + ([f'set_province_flag = {l.end_flag}'] if l.end_flag else []))
    body += [f'{V("stop_fight")} = yes'] + forget
    o += B(V('end_victory'), body) + ['']

    # A legend that flees is gone after the fight, so everything about it is forgotten as after a victory.
    # DA_LE_fled is taken first: once its end flag is set the legend is no longer "present".
    for res, ev in (('defeat', 2), ('withdraw', 3)):
        body = [CLRF('fled')] + IF(f'{V("flees")} = yes', [SETF('fled')])
        body += [f'{V("casualties")} = {{ share = {num(R.LOSS_SHARE[res])} }}']
        body += IF(NOFLAG('fled'), [f'{V("keep_wounds")} = yes',
                                    f'add_province_modifier = {{ name = {V("regroup")} duration = {R.REGROUP_DAYS[res]} }}'])
        if res == 'defeat':
            body += IF(FLAG('ruler_leads'), [f'owner = {{ set_country_flag = {V("ruler_led")} }}'])
        for i, l in enumerate(R.FIGHTS, 1):
            body += IF(IS(l), [f'owner = {{ country_event = {{ id = {NS}.{i * 100 + ev} }} }}']
                       + ([f'set_province_flag = {l.end_flag}'] if l.flees and l.end_flag else []))
        body += [f'{V("stop_fight")} = yes']
        body += IF(NOFLAG('fled'), [f'{V("refresh")} = yes'])
        body += IF(FLAG('fled'), forget + [CLRF('fled')])
        o += B(V('end_' + res), body) + ['']

    # --- scouting and containing ----------------------------------------------------------------
    o += B(V('scout'), [f'owner = {{ add_treasury = -{R.SCOUT_COST} }}', SETF('scouting')]) + ['']
    body = []
    for l in R.FIGHTS:
        if not l.contain_cost:
            continue
        per = [CLRF('paid')]
        for k, cost in enumerate(l.contain_cost):
            cond = [NOFLAG('paid'), GE('contain_n', k)] + ([LT('contain_n', k + 1)] if k < len(l.contain_cost) - 1 else [])
            per += IF(cond, [f'owner = {{ add_treasury = -{cost} }}', SETF('paid')])
        per += [CLRF('paid'), f'add_province_modifier = {{ name = {V("contained_" + l.id)} duration = {R.CONTAIN_YEARS * 365} }}']
        body += IF(IS(l), per)
    body += ['hidden_effect = { %s }' % ADD('contain_n', 1)]   # DA_VV: the count of containments, not for the tooltip
    o += B(V('contain'), body) + ['']

    # --- country scope: the five-year pulse -------------------------------------------------------
    body = ['# raids of a legend that is neither dead nor contained']
    for d in R.FIGHTS:
        if d.raid_event:
            body += IF([f'owns = {d.province}', f'{d.province} = {{ {IS(d)} NOT = {{ {V("contained")} = yes }} {NOFLAG("engaged")} }}'],
                       B('random', [f'chance = {d.raid_chance}', f'country_event = {{ id = {d.raid_event} }}']))
    body += ['# the AI has no window: once it is strong enough it gets a chance to finish a legend every five years']
    for l in R.FIGHTS:
        if l.ai_army is None:
            continue
        body += IF(['ai = yes', f'owns = {l.province}', f'has_country_flag = {l.unlock_flag}', f'mil_tech = {l.ai_tech}', f'army_size = {l.ai_army}',
                    f'{l.province} = {{ {IS(l)} }}'],
                   B('random', ['chance = 35', f'add_manpower = -{l.ai_army // 5}', f'country_event = {{ id = {l.victory_event} }}']))
    o += B('DA_LE_five_year_pulse', body) + ['']
    return text_block(o)


# ---------------------------------------------------------------------------------------------
# Modifiers, on-actions, events
# ---------------------------------------------------------------------------------------------
def gen_modifiers():
    o = [HEADER.rstrip(), '']
    for l in R.FIGHTS:
        if not l.contain_cost:
            continue
        o += B(V('contained_' + l.id), [f'{k} = {num(v)}' for k, v in l.contain_modifier.items()]) + ['']
        L(V('contained_' + l.id), {'lich': 'The Palace Re-sealed', 'dragon': 'Tribute to the Dragon',
                                   'challumaton': 'The Blue House Warded', 'mother': 'The Mother of Seeds in Stasis'   # DA_EL
                                   }.get(l.id, f'{l.name} Contained'))
        L('desc_' + V('contained_' + l.id), TEXT[l.id]['contained'])
    o += B(V('regroup'), ['local_manpower_modifier = -0.1']) + ['']
    L(V('regroup'), 'Regrouping after a Legendary Encounter')
    L('desc_' + V('regroup'), 'Our forces here are counting their dead. They cannot engage the legend again until this passes.')
    return text_block(o)


def gen_on_actions():
    o = [HEADER.rstrip(), '# Additive hooks: they merge with the other files\' on-actions.', '']
    o += B('on_five_year_pulse', IF('DA_LE_country_has_legend = yes', ['DA_LE_five_year_pulse = yes'])) + ['']
    o += ['# ROOT = province, FROM = previous owner: a fight does not survive a change of owner']
    o += B('on_province_owner_change', IF(FLAG('engaged'), [f'{V("stop_fight")} = yes']) + IF(FLAG('open'), [CLRF('open')])) + ['']
    return text_block(o)


def gen_events():
    o = [HEADER.rstrip(), f'namespace = {NS}', '',
         '# .1 and .2 exist only because dice rolled from a button always fall the same way.', '']
    o += B('province_event', [f'id = {NS}.1', f'title = {NS}.hidden', f'desc = {NS}.hidden', 'picture = BATTLE_eventPicture',
                              'hidden = yes', 'is_triggered_only = yes',
                              'immediate = {', f'\t{V("roll_move")} = yes', '}',
                              f'option = {{ name = {NS}.hidden }}']) + ['']
    o += B('province_event', [f'id = {NS}.2', f'title = {NS}.hidden', f'desc = {NS}.hidden', 'picture = BATTLE_eventPicture',
                              'hidden = yes', 'is_triggered_only = yes',
                              'immediate = {'] + ind([f'{V("roll_die")} = {{ die = a }}', f'{V("roll_die")} = {{ die = b }}',
                                                      f'{V("roll_die")} = {{ die = c }}', f'{V("resolve_round")} = yes']) + ['}',
                              f'option = {{ name = {NS}.hidden }}']) + ['']
    L(f'{NS}.hidden', 'Legendary Encounter')
    wound = []
    for stat in ('mil', 'dip', 'adm'):
        wound += B('random', ['chance = 50', f'change_{stat} = -1', f'random = {{ chance = 25 change_{stat} = -1 }}'])
    wound += ['add_ruler_modifier = { name = bd_wounded_ruler duration = 365 }']
    for i, l in enumerate(R.FIGHTS, 1):
        t = TEXT[l.id]
        # defeat
        lost_tt = f'{NS}.fled_tt' if l.flees else f'{NS}.lost_tt'
        opt = [f'name = {NS}.{i * 100 + 2}.a', f'goto = {l.province}', f'custom_tooltip = {lost_tt}']
        prov = [f'add_devastation = {l.defeat_devastation}']
        if l.defeat_manpower:
            prov.append(f'add_base_manpower = {l.defeat_manpower}')
        if l.flees:
            prov += list(l.loss_province_effects)
        opt += B(str(l.province), prov)
        if l.defeat_stability:
            opt.append(f'add_stability = {l.defeat_stability}')
        if l.flees:
            opt += list(l.loss_effects)
        opt += IF(f'has_country_flag = {V("ruler_led")}', [f'custom_tooltip = {NS}.ruler_wounded_tt'] + wound)
        o += B('country_event', [f'id = {NS}.{i * 100 + 2}', f'title = {NS}.{i * 100 + 2}.t', f'desc = {NS}.{i * 100 + 2}.d',
                                 'picture = COUNTRY_COLLAPSE_eventPicture', 'is_triggered_only = yes']
               + B('option', opt) + B('after', [f'clr_country_flag = {V("ruler_led")}'])) + ['']
        L(f'{NS}.{i * 100 + 2}.t', t['defeat_t'])
        L(f'{NS}.{i * 100 + 2}.d', t['defeat_d'])
        L(f'{NS}.{i * 100 + 2}.a', t['defeat_a'])
        # withdrawal
        o += B('country_event', [f'id = {NS}.{i * 100 + 3}', f'title = {NS}.{i * 100 + 3}.t', f'desc = {NS}.{i * 100 + 3}.d',
                                 'picture = BATTLE_eventPicture', 'is_triggered_only = yes']
               + B('option', [f'name = {NS}.{i * 100 + 3}.a', f'goto = {l.province}', f'custom_tooltip = {lost_tt}']
                   + ((B(str(l.province), [f'add_devastation = {l.defeat_devastation}'] + list(l.loss_province_effects))
                       + list(l.loss_effects)) if l.flees else []))) + ['']
        L(f'{NS}.{i * 100 + 3}.t', t['withdraw_t'])
        L(f'{NS}.{i * 100 + 3}.d', t['withdraw_d'])
        L(f'{NS}.{i * 100 + 3}.a', t['withdraw_a'])
    L(f'{NS}.lost_tt', 'The fight lasted §Y[Root.DA_LE_last_rounds.GetValue]§! rounds and cost us §R[Root.DA_LE_last_lost.GetValue]§! regiments. '
                       'The legend keeps half of the wounds we gave it, and our forces there must regroup before they can engage again.')
    L(f'{NS}.fled_tt', 'The fight lasted §Y[Root.DA_LE_last_rounds.GetValue]§! rounds and cost us §R[Root.DA_LE_last_lost.GetValue]§! regiments. '
                       'The legend is gone from its lair.')
    L(f'{NS}.ruler_wounded_tt', '§ROur ruler was carried out of the fight§!, and may never be quite the same:')
    return text_block(o)


