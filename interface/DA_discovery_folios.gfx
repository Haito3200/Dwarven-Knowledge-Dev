spriteTypes = {
	# Wide title crown, then native-width body: world x=0..570.
	# Pictures fill their apertures proportionally; the original source art is preserved.
	# 680x1600 title icon centered at (285,55); upper painting x=-55.
	# A separate narrow stats box ends above the normal description parchment.
	# Stats start at description row 12; prose at row 21. No trailing padding.
	# Description and Excellent option retain their normal engine layout.

