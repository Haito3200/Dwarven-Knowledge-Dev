#####################################################################
# To avoid errors, avoid allowing scripted instantTextBoxType and	#
# iconType elements interact with the mouse. topbar.gui is bugged	#
# and will throw errors on mouseover.								#
# Use alwaystransparent = yes to prevent this.						#
# For iconType elements, tooltips can be defined in this file.		#
#####################################################################

### Constant values - EU4 converts @word to the specified value
#Magic school icon frames
@abjuration_icon = 1
@conjuration_icon = 2
@divination_icon = 3
@enchantment_icon = 4
